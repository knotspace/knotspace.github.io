---
import Layout from '../layouts/Layout.astro';
import bank from '../data/study-questions.json';
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const science = bank.filter((q) => q.subject === 'science').length;
const social = bank.filter((q) => q.subject === 'social').length;
const topics = [...new Set(bank.map((q) => q.topic))];
const structuredData = {'@context':'https://schema.org','@type':'WebApplication',name:'KNOT Study',applicationCategory:'EducationalApplication',operatingSystem:'Any',inLanguage:'ja-JP',description:'中学理科・社会の問題演習アプリ'};
---
<Layout title="KNOT Study｜理科・社会の学習スペース" description="理科・社会の問題演習。基礎から発展まで、自分のペースで学べるKNOT Study。" structuredData={structuredData}>
<main class="study-home">
<header class="hero"><span class="eyebrow">KNOT / LEARNING SPACE</span><h1>Study<span>.</span></h1><p>知識をつなげて、考えて解ける力へ。</p><a class="start" href={`${BASE}study/solve/`}>演習ルームへ進む <span>→</span></a><div class="note">ブログとは別の、学習専用スペース。</div></header>
<section class="stats" aria-label="問題数"><div><strong>{bank.length}</strong><span>収録問題</span></div><div><strong>{science}</strong><span>理科</span></div><div><strong>{social}</strong><span>社会</span></div><div><strong>{topics.length}</strong><span>分野</span></div></section>
<section class="subjects"><article class="subject science"><div class="symbol">01 / SCIENCE</div><h2>理科</h2><p>物理・化学・生物など、基本事項から発展問題まで。</p><strong>{science}<small> QUESTIONS</small></strong><a href={`${BASE}study/solve/`}>理科を学習する →</a></article><article class="subject social"><div class="symbol">02 / SOCIAL STUDIES</div><h2>社会</h2><p>地理・歴史・公民の知識を整理して、得点力につなげる。</p><strong>{social}<small> QUESTIONS</small></strong><a href={`${BASE}study/solve/`}>社会を学習する →</a></article></section>
<section class="features"><div><span class="eyebrow">YOUR OWN PACE</span><h2>学び方を選べる。</h2></div><ul><li><b>難易度別</b><span>基礎・標準・発展から選択</span></li><li><b>分野別</b><span>苦手な単元を集中演習</span></li><li><b>苦手問題</b><span>間違えた問題を自動で記録</span></li><li><b>テーマ切替</b><span>ライト・ダークに対応</span></li></ul></section>
<footer>学習記録はこの端末のブラウザに保存されます。<a href={`${BASE}`}>KNOTトップへ戻る</a></footer>
</main>
<style>
.study-home{max-width:920px;margin:auto;padding:42px 22px 70px;color:var(--text)}.hero{padding:40px 0 34px}.eyebrow,.symbol{font-size:11px;letter-spacing:.16em;font-weight:800;color:var(--muted)}.hero h1{font-size:clamp(54px,10vw,92px);letter-spacing:-.09em;line-height:1;margin:18px 0 12px}.hero h1 span{color:var(--accent)}.hero p{color:var(--muted);font-size:16px}.start{display:inline-flex;gap:30px;align-items:center;margin-top:22px;padding:15px 19px;background:var(--text);color:var(--bg);border-radius:10px;font-weight:800;text-decoration:none}.note{margin-top:13px;color:var(--muted);font-size:12px}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin:12px 0 25px}.stats div{padding:17px;background:var(--surface);display:flex;flex-direction:column;gap:3px;border-right:1px solid var(--border)}.stats div:last-child{border:0}.stats strong{font-size:25px;font-variant-numeric:tabular-nums}.stats span{font-size:11px;color:var(--muted)}.subjects{display:grid;grid-template-columns:1fr 1fr;gap:14px}.subject{padding:23px;border:1px solid var(--border);border-radius:15px;background:var(--surface)}.subject h2{font-size:28px;margin:16px 0 6px}.subject p{min-height:48px;color:var(--muted);font-size:13px;line-height:1.8}.subject>strong{display:block;font-size:30px;margin:18px 0}.subject small{font-size:10px;color:var(--muted);letter-spacing:.1em}.subject a{display:inline-block;color:var(--accent);font-size:13px;font-weight:800;text-decoration:none}.features{display:grid;grid-template-columns:1fr 1.2fr;gap:35px;margin:60px 0 35px;padding:27px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.features h2{font-size:24px;letter-spacing:-.05em}.features ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:17px}.features li{display:flex;flex-direction:column;gap:5px}.features li b{font-size:13px}.features li span,footer{font-size:11px;color:var(--muted)}footer{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}footer a{color:var(--accent);text-decoration:none}@media(max-width:620px){.study-home{padding:22px 18px 55px}.hero{padding:30px 0}.stats{grid-template-columns:1fr 1fr}.stats div:nth-child(2){border-right:0}.stats div:nth-child(-n+2){border-bottom:1px solid var(--border)}.subjects,.features{grid-template-columns:1fr}.subject p{min-height:0}.features{gap:10px}.features ul{gap:14px}}
</style>
</Layout>