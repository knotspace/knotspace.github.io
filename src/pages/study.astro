---
import Layout from '../layouts/Layout.astro';
import bank from '../data/study-questions.json';
const science = bank.filter(q => q.subject === 'science').length;
const social = bank.filter(q => q.subject === 'social').length;
const topics = [...new Set(bank.map(q => q.topic))].length;
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="Study｜KNOT" description="理科・社会の問題を解いて、苦手を少しずつ減らす学習スペース。">
<main class="study-home">
  <div class="intro"><p class="eyebrow">KNOTの学習スペース</p><h1>毎日少しずつ、<br><span>できる</span>を増やそう。</h1><p class="lead">理科と社会の問題演習。分野や難易度を選んで、自分のペースで取り組めます。</p></div>
  <section class="summary"><div><strong>{bank.length.toLocaleString('ja-JP')}</strong><span>収録問題</span></div><div><strong>{science}</strong><span>理科</span></div><div><strong>{social}</strong><span>社会</span></div><div><strong>{topics}</strong><span>分野</span></div></section>
  <div class="heading"><h2>どの教科を勉強する？</h2><p>教科を選んで演習を始めよう。</p></div>
  <section class="subjects">
    <a class="subject science" href={`${BASE}study/solve/?subject=science`}><span class="symbol">理</span><div><small>SCIENCE</small><h3>理科</h3><p>物理・化学・生物・地学を学ぶ</p><b>{science} 問収録 <span>→</span></b></div></a>
    <a class="subject social" href={`${BASE}study/solve/?subject=social`}><span class="symbol">社</span><div><small>SOCIAL STUDIES</small><h3>社会</h3><p>地理・歴史・公民を学ぶ</p><b>{social} 問収録 <span>→</span></b></div></a>
  </section>
  <section class="how"><h2>使い方</h2><ol><li><b>1</b><span><strong>教科・分野を選ぶ</strong><small>苦手な単元だけに絞ることもできます。</small></span></li><li><b>2</b><span><strong>問題を解く</strong><small>選択肢を選ぶと、その場で正誤と解説が表示されます。</small></span></li><li><b>3</b><span><strong>結果を確認する</strong><small>間違えた問題は記録して、あとから解き直せます。</small></span></li></ol></section>
  <p class="back"><a href={BASE}>← KNOTトップへ戻る</a></p>
</main>
<style>
.study-home{max-width:900px;margin:0 auto;padding:38px 0 30px}.intro{padding:22px 0 38px}.eyebrow{font-size:13px;font-weight:800;color:var(--accent);margin:0 0 18px}.intro h1{font-size:clamp(34px,6vw,58px);font-weight:900;letter-spacing:-.055em;line-height:1.35;margin:0}.intro h1 span{color:var(--accent)}.lead{font-size:14px;line-height:2;color:var(--muted);margin:16px 0 0}.summary{display:grid;grid-template-columns:repeat(4,1fr);background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}.summary div{padding:17px 20px;border-right:1px solid var(--line);display:grid;gap:4px}.summary div:last-child{border:0}.summary strong{font-size:25px;font-weight:900}.summary span{font-size:11px;color:var(--muted)}.heading{margin:48px 0 16px}.heading h2,.how h2{font-size:22px;font-weight:850;margin:0}.heading p{font-size:12px;color:var(--muted);margin:7px 0}.subjects{display:grid;grid-template-columns:1fr 1fr;gap:16px}.subject{display:flex;align-items:flex-start;gap:18px;padding:25px;border:1px solid var(--line);border-radius:15px;background:var(--surface);transition:border-color .15s,transform .15s}.subject:hover{border-color:var(--accent);transform:translateY(-2px)}.symbol{display:grid;place-items:center;width:54px;height:54px;border-radius:13px;background:var(--surface-soft);font-size:25px;font-weight:900;color:var(--accent);flex:none}.subject small{font-size:10px;color:var(--muted);font-weight:800;letter-spacing:.08em}.subject h3{font-size:27px;margin:4px 0;font-weight:900}.subject p{font-size:12px;color:var(--muted);margin:0 0 17px}.subject b{font-size:12px}.subject b span{color:var(--accent);margin-left:8px}.how{margin-top:45px;padding:25px;border:1px solid var(--line);border-radius:14px}.how ol{padding:0;margin:20px 0 0;list-style:none;display:grid;gap:17px}.how li{display:flex;align-items:center;gap:14px}.how li>b{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--surface-soft);color:var(--accent)}.how li span{display:grid;gap:3px}.how li strong{font-size:13px}.how li small{font-size:11px;color:var(--muted)}.back{margin-top:30px;font-size:12px;color:var(--muted)}.back a:hover{color:var(--accent)}
@media(max-width:650px){.study-home{padding:25px 0}.summary div{padding:13px 10px}.summary strong{font-size:20px}.subjects{grid-template-columns:1fr}.subject{padding:20px}.how{padding:20px}.intro{padding-top:12px}}
</style>
</Layout>