---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'KNOT Study',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  inLanguage: 'ja-JP',
  description: '中学理科・社会を学べる無料の学習ツール。',
  url: 'https://knotspace.github.io/study/',
  isAccessibleForFree: true,
};
---

<Layout
  title="KNOT Study｜理科・社会の学習アプリ"
  description="中学理科・社会の問題演習と詳しい解説で、入試に向けた学習をサポート。"
  structuredData={structuredData}
>
  <main class="study-app"><link rel="manifest" href="/study/manifest.webmanifest"><meta name="theme-color" content="#101827">
    <header class="study-heading">
      <div class="eyebrow">KNOT / LEARNING TOOL</div>
      <h1>Study<span>.</span></h1><p><a href="/study/solve/" style="display:inline-block;margin-top:12px;padding:11px 16px;border-radius:10px;background:var(--text);color:var(--bg);text-decoration:none;font-weight:750">理科・社会の演習を始める →</a></p>
      <p>知識をつなげて、考えて解ける力を身につける。</p>
      <div class="study-meta"><span>中学1〜3年</span><span>理科・社会の2教科</span><span>入試対策</span><span>記録はこの端末に保存</span></div>
    </header>

    <section class="study-dashboard" aria-label="学習記録">
      <div><span class="dash-label">解答数</span><strong id="total-answered">0</strong></div>
      <div><span class="dash-label">正解数</span><strong id="total-correct">0</strong></div>
      <div><span class="dash-label">正答率</span><strong id="accuracy">—</strong></div>
      <div><span class="dash-label">苦手問題</span><strong id="wrong-count">0</strong></div>
    </section>

    <section class="progress-panel" aria-label="教科別の進捗">
      <div class="section-top"><div><div class="eyebrow">YOUR PROGRESS</div><h2>教科別の進捗</h2></div><span class="quiet">解いた問題の割合</span></div>
      <div class="progress-rings">
        <div class="ring-card"><div class="progress-ring" id="science-ring" style="--progress:0deg"><span id="science-percent">0%</span></div><b>理科</b><small id="science-count">0 / 460問</small></div>
        <div class="ring-card"><div class="progress-ring" id="social-ring" style="--progress:0deg"><span id="social-percent">0%</span></div><b>社会</b><small id="social-count">0 / 460問</small></div>
      </div>
    </section>

    <section class="study-panel" aria-labelledby="subject-title">
      <div class="section-top"><div><div class="eyebrow">01 / SELECT</div><h2 id="subject-title">教科を選ぶ</h2></div><span class="quiet">好きなところから始めよう</span></div>
      <div class="subject-grid" id="subject-grid">
        <button class="subject active" data-subject="理科"><span>⚗️</span><b>理科</b><small>物理・化学・生物・地学</small></button>
        <button class="subject" data-subject="社会"><span>🌏</span><b>社会</b><small>地理・歴史・公民</small></button>
      </div>
      <div class="filters">
        <label>学年<select id="grade"><option value="all">全学年</option><option value="1">中1</option><option value="2">中2</option><option value="3">中3</option></select></label>
        <label>出題範囲<select id="mode"><option value="all">すべて</option><option value="wrong">間違えた問題</option></select></label>
        <button class="primary" id="start-btn" type="button">学習を始める <span>→</span></button>
      </div>
    </section>

    <section class="study-panel quiz-panel" id="quiz-panel" hidden aria-live="polite">
      <div class="quiz-top"><div><div class="eyebrow" id="quiz-subtitle">MATHEMATICS</div><h2 id="quiz-title">問題</h2></div><span class="counter" id="question-counter">1 / 1</span></div>
      <div class="question-card">
        <div class="question-tags"><span id="question-grade">中3</span><span id="question-topic">二次方程式</span></div>
        <p class="question-text" id="question-text"></p>
        <div class="answer-list" id="answer-list"></div>
        <div class="explanation" id="explanation" hidden></div>
        <div class="quiz-actions"><button class="text-button" id="quit-btn" type="button">教科選択に戻る</button><button class="primary" id="next-btn" type="button" disabled>次の問題 →</button></div>
      </div>
    </section>

    <section class="study-panel wrong-panel">
      <div class="section-top"><div><div class="eyebrow">02 / REVIEW</div><h2>苦手問題</h2></div><span class="quiet">間違えた問題を自動保存</span></div>
      <p class="review-copy">解答すると、この端末に学習記録が保存されるよ。理科・社会の苦手問題をまとめて復習できる。</p>
      <button class="outline" id="review-btn" type="button">苦手問題を復習する <span id="review-total">0問</span></button>
      <button class="reset-link" id="reset-btn" type="button">学習記録をリセット</button>
    </section>
    <footer class="study-footer">KNOT Study <span>・</span> 学習を積み重ねよう</footer>
  </main>

  <style>
    .study-app{max-width:900px;margin:0 auto;padding:46px 22px 76px;color:var(--text)}
    .study-heading{padding:10px 0 28px}.eyebrow{font-size:.69rem;letter-spacing:.16em;color:var(--muted);font-weight:750}.study-heading h1{font-size:clamp(2.5rem,7vw,4.2rem);letter-spacing:-.07em;line-height:1;margin:13px 0}.study-heading h1 span{color:var(--accent,#6b9cff)}.study-heading p{color:var(--muted);margin:0}.study-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.study-meta span,.question-tags span{font-size:.72rem;border:1px solid var(--border);border-radius:30px;padding:5px 10px;color:var(--muted)}
    .study-dashboard{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin:10px 0 26px}.study-dashboard>div{background:var(--surface, var(--card));padding:15px 17px;display:flex;flex-direction:column;gap:5px}.dash-label{font-size:.72rem;color:var(--muted)}.study-dashboard strong{font-size:1.5rem;font-variant-numeric:tabular-nums}
    .study-panel{border:1px solid var(--border);border-radius:16px;padding:23px;margin:18px 0;background:var(--surface,transparent)}.section-top,.quiz-top{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:20px}.section-top h2,.quiz-top h2{font-size:1.22rem;margin:5px 0 0;letter-spacing:-.03em}.quiet{font-size:.76rem;color:var(--muted)}.subject-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.subject{min-height:112px;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:12px;padding:13px 8px;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:5px;min-width:0;transition:border-color .15s,background .15s}.subject>span{font-size:1.7rem;font-weight:800;height:27px}.subject b{font-size:.9rem}.subject small{font-size:.68rem;color:var(--muted);line-height:1.4}.subject.active{border-color:var(--accent,#6b9cff);background:color-mix(in srgb,var(--accent,#6b9cff) 9%,transparent)}
    .filters{display:flex;align-items:end;gap:12px;margin-top:20px;flex-wrap:wrap}.filters label{display:flex;flex-direction:column;gap:6px;font-size:.72rem;color:var(--muted);flex:1;min-width:125px}.filters select{background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:9px;padding:10px;font:inherit}.primary,.outline{border:0;border-radius:9px;padding:11px 16px;font-weight:750;cursor:pointer;background:var(--text);color:var(--bg)}.primary:disabled{opacity:.4;cursor:not-allowed}.primary span{margin-left:10px}.outline{background:transparent;color:var(--text);border:1px solid var(--border)}.quiz-panel[hidden]{display:none}.counter{font-size:.78rem;color:var(--muted);font-variant-numeric:tabular-nums}.question-card{border:1px solid var(--border);border-radius:13px;padding:20px}.question-tags{display:flex;gap:7px}.question-text{font-size:1.12rem;line-height:1.85;font-weight:650;white-space:pre-wrap;margin:18px 0}.answer-list{display:grid;gap:9px}.answer-option{padding:12px 14px;text-align:left;border:1px solid var(--border);border-radius:9px;background:transparent;color:var(--text);font:inherit;cursor:pointer}.answer-option:hover:not(:disabled){border-color:var(--accent,#6b9cff)}.answer-option.correct{border-color:#299b68;background:rgba(41,155,104,.1)}.answer-option.incorrect{border-color:#d65c5c;background:rgba(214,92,92,.1)}.explanation{margin-top:15px;padding:13px 15px;border-radius:10px;background:var(--bg);font-size:.88rem;line-height:1.8}.quiz-actions{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:18px}.text-button,.reset-link{border:0;background:none;color:var(--muted);cursor:pointer;font:inherit;font-size:.8rem;padding:8px 0}.review-copy{font-size:.86rem;color:var(--muted);line-height:1.8}.outline span{margin-left:12px;color:var(--muted);font-size:.78rem}.reset-link{display:block;margin-top:10px;font-size:.72rem}.study-footer{text-align:center;color:var(--muted);font-size:.75rem;padding:25px}.study-footer span{padding:0 6px}
    .progress-panel{border:1px solid var(--border);border-radius:16px;padding:22px;margin:18px 0;background:var(--surface,transparent)}.progress-rings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.ring-card{display:flex;flex-direction:column;align-items:center;gap:7px;padding:18px 10px;border:1px solid var(--border);border-radius:14px;background:var(--surface,var(--card))}.ring-card b{font-size:.95rem}.ring-card small{font-size:.75rem;color:var(--muted)}.progress-ring{--progress:0deg;width:112px;height:112px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--accent,#f28b36) var(--progress),var(--border) 0);position:relative}.progress-ring:before{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--bg)}.progress-ring span{position:relative;font-size:1.25rem;font-weight:850;font-variant-numeric:tabular-nums}.subject.active{border-color:#f28b36;background:color-mix(in srgb,#f28b36 10%,transparent);box-shadow:0 4px 16px rgba(242,139,54,.10)}@media(max-width:650px){.study-app{padding:30px 15px 55px}.study-panel{padding:17px}.subject-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.study-dashboard>div{padding:12px 10px}.study-dashboard strong{font-size:1.25rem}.dash-label{font-size:.65rem}.quiet{display:none}.filters{gap:9px}.filters label{min-width:calc(50% - 8px)}.filters .primary{width:100%}.question-card{padding:15px}.question-text{font-size:1rem}}

    /* Dedicated full-screen solving view */
    #quiz-panel:not([hidden]){position:fixed;inset:0;z-index:9999;overflow-y:auto;margin:0;border:0;border-radius:0;padding:clamp(20px,5vh,56px) 20px 40px;background:var(--bg);box-shadow:none;overscroll-behavior:contain}
    #quiz-panel .quiz-top,#quiz-panel .question-card{width:min(100%,820px);margin-left:auto;margin-right:auto}
    #quiz-panel .quiz-top{margin-bottom:22px}
    #quiz-panel .question-card{padding:clamp(20px,4vw,34px);min-height:320px}
    #quiz-panel .question-text{font-size:clamp(1.12rem,2.4vw,1.45rem);line-height:1.9;margin:26px 0}
    #quiz-panel .answer-list{grid-template-columns:1fr 1fr;gap:12px}
    #quiz-panel .answer-option{min-height:58px;font-size:1rem;padding:15px 17px}
    #quiz-panel .quiz-actions{margin-top:26px}
    @media(max-width:600px){#quiz-panel{padding:18px 13px 28px}#quiz-panel .answer-list{grid-template-columns:1fr}#quiz-panel .question-card{padding:17px;min-height:0}#quiz-panel .quiz-actions{position:sticky;bottom:0;background:var(--bg);padding:12px 0 4px}}

    @media(prefers-reduced-motion:reduce){.subject{transition:none}}
  </style>

  <script is:inline>if("serviceWorker" in navigator){window.addEventListener("load",()=>navigator.serviceWorker.register("/study/sw.js",{scope:"/study/"}).catch(console.error))}</script>
  <script is:inline>
    (() => {
      const bank = [
        {id:'m1',s:'数学',g:1,t:'正負の数',q:'−3 + 8 の答えは？',a:['−11','−5','5','11'],c:2,e:'正負の数の加法。異符号なので絶対値の差 8−3=5 を計算し、絶対値が大きい正の符号をつける。'},
        {id:'m2',s:'数学',g:1,t:'文字式',q:'x=3 のとき、2x²−5x の値は？',a:['−3','3','−9','9'],c:0,e:'2×3²−5×3=18−15=3。正解は「3」。'},
        {id:'m3',s:'数学',g:2,t:'連立方程式',q:'x+y=7、x−y=1 のとき、x の値は？',a:['2','3','4','6'],c:2,e:'2つの式を足すと 2x=8。したがって x=4。'},
        {id:'m4',s:'数学',g:2,t:'一次関数',q:'y=−3x+2 の傾きは？',a:['−3','−2','2','3'],c:0,e:'一次関数 y=ax+b の傾きは x の係数 a。よって −3。'},
        {id:'m5',s:'数学',g:3,t:'平方根',q:'√50 を簡単にすると？',a:['2√5','5√2','10√5','25√2'],c:1,e:'√50=√(25×2)=5√2。'},
        {id:'m6',s:'数学',g:3,t:'二次方程式',q:'x²−5x+6=0 の解は？',a:['1, 6','−2, −3','2, 3','−2, 3'],c:2,e:'(x−2)(x−3)=0 より x=2,3。'},
        {id:'m7',s:'数学',g:3,t:'相似',q:'相似比が 2:3 の2つの図形。面積比は？',a:['2:3','4:9','8:27','1:3'],c:1,e:'面積比は相似比の2乗。2²:3²=4:9。'},
        {id:'e1',s:'英語',g:1,t:'be動詞',q:'「彼は学生です。」を英語にすると？',a:['He am a student.','He is a student.','He are a student.','He be a student.'],c:1,e:'主語が三人称単数の He なので be動詞は is。'},
        {id:'e2',s:'英語',g:1,t:'一般動詞',q:'She (　) tennis every day. に入る語は？',a:['play','plays','playing','played'],c:1,e:'現在形で主語が三人称単数のとき、一般動詞に s をつける。'},
        {id:'e3',s:'英語',g:2,t:'不定詞',q:'「私は本を読むために図書館へ行った。」の「読むために」は？',a:['read','to read','reading','reads'],c:1,e:'目的を表す「〜するために」は to + 動詞の原形。'},
        {id:'e4',s:'英語',g:2,t:'比較',q:'「富士山は日本で最も高い山です。」に合う表現は？',a:['high','higher','the highest','highest than'],c:2,e:'最上級は the + 形容詞est。'},
        {id:'e5',s:'英語',g:3,t:'現在完了',q:'I have lived here (　) 2020. に入る語は？',a:['for','since','during','from'],c:1,e:'since は過去のある時点、for は期間を表す。2020という時点なので since。'},
        {id:'e6',s:'英語',g:3,t:'受動態',q:'This book (　) by many people. に入る語は？',a:['read','reads','is read','is reading'],c:2,e:'受動態は be動詞 + 過去分詞。主語が単数なので is read。'},
        {id:'k1',s:'国語',g:1,t:'文法',q:'「美しい」の品詞は？',a:['名詞','動詞','形容詞','形容動詞'],c:2,e:'「美しい」は言い切りが「い」で終わり、活用する形容詞。'},
        {id:'k2',s:'国語',g:2,t:'文法',q:'「静かな町」の「静かな」の品詞は？',a:['形容詞','形容動詞','副詞','連体詞'],c:1,e:'「静かだ」と言い切ることができる形容動詞。'},
        {id:'k3',s:'国語',g:3,t:'文法',q:'「走っている」の「て」は何の助詞？',a:['格助詞','接続助詞','副助詞','終助詞'],c:1,e:'「走って」と後ろの「いる」をつなぐ接続助詞。'},
        {id:'k4',s:'国語',g:2,t:'敬語',q:'「先生がおっしゃる」は何語？',a:['尊敬語','謙譲語','丁寧語','美化語'],c:0,e:'相手や話題の人物の動作を高める尊敬語。'},
        {id:'k5',s:'国語',g:3,t:'古文',q:'古文の「いと」の意味は？',a:['少し','とても','すぐに','決して'],c:1,e:'「いと」は「とても」「たいそう」という意味。'},
        {id:'s1',s:'理科',g:1,t:'生物',q:'植物が光を受けてデンプンなどをつくるはたらきは？',a:['呼吸','蒸散','光合成','消化'],c:2,e:'光エネルギーを使い、二酸化炭素と水から養分をつくる光合成。'},
        {id:'s2',s:'理科',g:2,t:'化学',q:'水の化学式は？',a:['CO₂','O₂','H₂O','NaCl'],c:2,e:'水は水素原子2個と酸素原子1個からなる H₂O。'},
        {id:'s3',s:'理科',g:2,t:'物理',q:'電圧6V、抵抗3Ωのとき、電流は？',a:['0.5A','2A','3A','18A'],c:1,e:'オームの法則 I=V/R。6÷3=2A。'},
        {id:'s4',s:'理科',g:3,t:'化学',q:'酸とアルカリが互いの性質を打ち消し合う反応は？',a:['酸化','還元','中和','分解'],c:2,e:'酸の水素イオンとアルカリの水酸化物イオンが反応する中和。'},
        {id:'s5',s:'理科',g:3,t:'地学',q:'地震が発生した地下の場所を何という？',a:['震央','震源','震度','断層'],c:1,e:'地震が最初に発生した地下の場所が震源。その真上の地表が震央。'},
        {id:'s6',s:'理科',g:1,t:'地学',q:'マグマが冷えて固まってできた岩石は？',a:['堆積岩','変成岩','火成岩','石灰岩'],c:2,e:'マグマが冷え固まってできる岩石を火成岩という。'},
        {id:'h1',s:'社会',g:1,t:'地理',q:'赤道の緯度は？',a:['北緯90度','北緯0度','南緯23.4度','南緯90度'],c:1,e:'赤道は緯度0度。'},
        {id:'h2',s:'社会',g:2,t:'歴史',q:'鎌倉幕府を開いた人物は？',a:['藤原道長','源頼朝','足利尊氏','徳川家康'],c:1,e:'源頼朝は1192年（現在は1185年説も重視）に鎌倉幕府を開いた。'},
        {id:'h3',s:'社会',g:2,t:'歴史',q:'大化の改新が始まった年は？',a:['538年','645年','710年','794年'],c:1,e:'645年、中大兄皇子や中臣鎌足らが蘇我氏を倒し改革を始めた。'},
        {id:'h4',s:'社会',g:3,t:'公民',q:'日本国憲法の三大原則に含まれないものは？',a:['国民主権','基本的人権の尊重','平和主義','議院内閣制'],c:3,e:'三大原則は国民主権・基本的人権の尊重・平和主義。'},
        {id:'h5',s:'社会',g:3,t:'公民',q:'法律を制定する国の機関は？',a:['内閣','裁判所','国会','地方議会'],c:2,e:'国会は国権の最高機関であり、唯一の立法機関。'},
        {id:'h6',s:'社会',g:1,t:'地理',q:'日本で最も面積が大きい都道府県は？',a:['岩手県','長野県','北海道','新潟県'],c:2,e:'北海道が日本で最も面積の大きい都道府県。'}
      ];
      bank.push(
        {id:"sx127651",s:"理科",g:1,t:"植物の分類",q:"被子植物のうち、子葉が1枚で、葉脈が平行脈、根がひげ根であるものはどれ？",a:["双子葉類", "単子葉類", "裸子植物", "シダ植物"],c:1,e:"正解は単子葉類。子葉が1枚であることに加え、葉脈は平行脈、根はひげ根、茎の維管束は散らばる傾向がある。トウモロコシやイネが代表例。双子葉類は子葉2枚・網状脈・主根と側根が基本。"},
        {id:"sx171973",s:"理科",g:1,t:"光合成",q:"光合成が行われる細胞内のつくりはどれ？",a:["核", "ミトコンドリア", "葉緑体", "液胞"],c:2,e:"葉緑体には緑色の色素クロロフィルがあり、光エネルギーを吸収する。光合成では二酸化炭素と水を材料に、デンプンなどの有機物をつくり、酸素を放出する。"},
        {id:"sx171732",s:"理科",g:1,t:"植物の蒸散",q:"蒸散が最も盛んに行われることが多い場所はどこ？",a:["根の先端", "葉の気孔", "茎の中心", "花粉"],c:1,e:"蒸散は植物体内の水が水蒸気として外へ出る現象。多くは葉の気孔から起こる。蒸散には、根からの水の吸収を促すはたらきや、植物体の温度上昇を抑えるはたらきがある。"},
        {id:"sx181400",s:"理科",g:1,t:"動物の分類",q:"背骨をもつ動物のなかまを何という？",a:["節足動物", "軟体動物", "脊椎動物", "刺胞動物"],c:2,e:"背骨をもつ動物は脊椎動物。魚類・両生類・は虫類・鳥類・哺乳類に分類する。昆虫やエビなどの節足動物は背骨をもたない無脊椎動物。"},
        {id:"sx146206",s:"理科",g:1,t:"火山",q:"ねばりけの強いマグマからできやすい火山の形は？",a:["傾斜がゆるやかな形", "ドーム状の形", "必ず円すい形", "平らな形"],c:1,e:"マグマのねばりけが強いと流れにくく、火口付近にたまりやすいため、盛り上がったドーム状の火山になりやすい。ねばりけが弱い溶岩は遠くまで流れ、傾斜のゆるい火山をつくる。"},
        {id:"sx182000",s:"理科",g:1,t:"地層",q:"れき・砂・泥が粒の大きさで分かれて積もる主な原因は？",a:["磁力", "水の流れの速さの変化", "地球の自転", "生物の呼吸"],c:1,e:"流水で運ばれた粒は、流れが弱まると大きく重いものから先に沈みやすい。一般にれき、砂、泥の順に粒が小さい。地層の粒や化石から、当時の環境を推定できる。"},
        {id:"sx160454",s:"理科",g:1,t:"音",q:"音の高さを決める主な要素は？",a:["振幅", "振動数", "音の伝わる距離", "媒質の色"],c:1,e:"音の高さは振動数で決まる。1秒間の振動回数が多いほど高い音になる。音の大きさは主に振幅と関係し、振幅が大きいほど大きな音になる。"},
        {id:"sx162496",s:"理科",g:1,t:"光",q:"凸レンズで物体を焦点距離より外側に置いたとき、スクリーンに映る像は？",a:["正立の虚像", "倒立の実像", "必ず同じ大きさの像", "像はできない"],c:1,e:"物体を焦点距離より外側に置くと、レンズを通った光が実際に集まる位置に倒立の実像ができる。スクリーンに映せるのが実像。焦点距離以内では正立の虚像となり、スクリーンには映せない。"},
        {id:"sx186829",s:"理科",g:1,t:"力",q:"質量100gの物体にはたらく重力の大きさを約1Nとする。質量500gなら約何N？",a:["0.5N", "1N", "5N", "50N"],c:2,e:"100gに約1Nの重力がはたらくので、500gはその5倍。したがって約5N。質量の単位g・kgと、力の単位Nを混同しないこと。"},
        {id:"sx290958",s:"理科",g:2,t:"消化",q:"デンプンを分解する消化酵素はどれ？",a:["ペプシン", "アミラーゼ", "リパーゼ", "トリプシン"],c:1,e:"アミラーゼはデンプンを麦芽糖などに分解する酵素。だ液やすい液に含まれる。ペプシンやトリプシンはタンパク質、リパーゼは脂肪の分解に関係する。"},
        {id:"sx240373",s:"理科",g:2,t:"血液循環",q:"酸素を多く含む血液が肺から心臓へ戻る血管は？",a:["肺動脈", "肺静脈", "大静脈", "大動脈"],c:1,e:"肺で酸素を受け取った血液は肺静脈を通って左心房へ戻る。「動脈・静脈」は心臓から出るか戻るかで決まり、酸素の多さだけでは決まらない。肺動脈は酸素の少ない血液を心臓から肺へ運ぶ。"},
        {id:"sx286234",s:"理科",g:2,t:"電流",q:"抵抗6Ωに3Aの電流を流すために必要な電圧は？",a:["2V", "9V", "18V", "36V"],c:2,e:"オームの法則 V=RI を使う。R=6Ω、I=3Aなので V=6×3=18V。単位を確認し、電圧・電流・抵抗のどれを求めるかに応じて式を変形する。"},
        {id:"sx22636",s:"理科",g:2,t:"電力",q:"100Vの電源で2Aの電流が流れる電気器具の電力は？",a:["50W", "100W", "200W", "2000W"],c:2,e:"電力Pは P=VI。100V×2A=200W。電力は1秒あたりに使う電気エネルギーの大きさを表す。電力量を求めるときは電力×時間を使う。"},
        {id:"sx248580",s:"理科",g:2,t:"化学変化",q:"酸化銅から酸素を取り除く反応を何という？",a:["酸化", "還元", "中和", "電離"],c:1,e:"物質から酸素が取り除かれる反応は還元。酸化銅と炭素を加熱すると、酸化銅が還元されて銅になり、炭素は酸化される。酸化と還元は同時に起こることが多い。"},
        {id:"sx2516",s:"理科",g:2,t:"化学変化と質量",q:"密閉容器内で化学変化を起こしたとき、反応前後の全体の質量はどうなる？",a:["必ず増える", "必ず減る", "変化しない", "温度によって必ず変わる"],c:2,e:"密閉容器では外部との物質の出入りがないため、反応前後の全体の質量は保存される。気体が発生しても容器から逃げなければ質量は変わらない。これを質量保存の法則という。"},
        {id:"sx257024",s:"理科",g:2,t:"天気",q:"気温が同じとき、空気中に含むことのできる水蒸気量の限界に達した状態は？",a:["乾燥", "飽和", "凝固", "昇華"],c:1,e:"空気が含むことのできる水蒸気量には限界があり、その限界まで含んだ状態を飽和という。飽和水蒸気量は気温が高いほど大きい。湿度は実際の水蒸気量÷飽和水蒸気量×100で求める。"},
        {id:"sx244308",s:"理科",g:2,t:"前線",q:"暖気が寒気の上にはい上がり、広い範囲で弱い雨が長く続きやすい前線は？",a:["寒冷前線", "温暖前線", "停滞前線のみ", "閉塞前線"],c:1,e:"温暖前線では暖気が寒気の上をゆるやかにはい上がる。広い範囲に雲が広がり、比較的弱い雨が長く続きやすい。寒冷前線では積乱雲が発達し、短時間の強い雨になりやすい。"},
        {id:"sx38992",s:"理科",g:3,t:"遺伝",q:"遺伝子の本体である物質は？",a:["タンパク質", "DNA", "脂肪", "デンプン"],c:1,e:"遺伝子の本体はDNA（デオキシリボ核酸）。DNAの塩基配列が遺伝情報を担う。遺伝情報はタンパク質の合成などに関係し、形質の現れ方に影響する。"},
        {id:"sx353492",s:"理科",g:3,t:"生殖",q:"受精卵が細胞分裂を繰り返して個体になる過程を何という？",a:["発芽", "発生", "蒸散", "消化"],c:1,e:"受精卵は体細胞分裂を繰り返して細胞数を増やし、組織や器官がつくられて個体へ成長する。この一連の過程を発生という。"},
        {id:"sx393893",s:"理科",g:3,t:"イオン",q:"塩化ナトリウムが水に溶けたときにできるイオンの組み合わせは？",a:["Na⁺とCl⁻", "Na⁻とCl⁺", "H⁺とOH⁻", "Ca²⁺とO²⁻"],c:0,e:"塩化ナトリウムは水中でナトリウムイオンNa⁺と塩化物イオンCl⁻に分かれる。陽イオンは正、陰イオンは負の電気を帯びる。"},
        {id:"sx354155",s:"理科",g:3,t:"酸・アルカリ",q:"水溶液が酸性を示す原因となるイオンは？",a:["水酸化物イオン", "水素イオン", "ナトリウムイオン", "塩化物イオン"],c:1,e:"酸性の水溶液には水素イオンH⁺が含まれる。アルカリ性の水溶液には水酸化物イオンOH⁻が含まれる。中性では両者の濃度が等しい。"},
        {id:"sx378846",s:"理科",g:3,t:"運動",q:"物体にはたらく力がつり合っているとき、静止していた物体はどうなる？",a:["必ず加速する", "静止し続ける", "必ず円運動する", "質量がゼロになる"],c:1,e:"力がつり合うと合力は0になる。静止していた物体は静止し続け、運動していた物体は同じ速さ・同じ向きで運動し続ける。これが慣性の法則に関係する。"},
        {id:"sx360320",s:"理科",g:3,t:"仕事",q:"物体に力を加えて力の向きに2m動かした。力が10Nなら仕事は？",a:["5J", "12J", "20J", "40J"],c:2,e:"仕事[J]=力[N]×力の向きに動いた距離[m]。10×2=20J。力を加えても物体が動かなければ、物理でいう仕事は0Jとなる。"},
        {id:"sx346476",s:"理科",g:3,t:"天体",q:"季節によって真夜中に見える星座が変わる主な理由は？",a:["地球の自転", "地球の公転", "月の公転", "太陽の自転"],c:1,e:"地球が太陽の周りを公転するため、夜に地球から見える宇宙の方向が季節によって変わる。日周運動の原因は地球の自転なので区別する。"},
        {id:"sx360859",s:"理科",g:3,t:"月",q:"月の形が日ごとに変わって見える主な理由は？",a:["月自身が光る量を変える", "太陽・地球・月の位置関係が変わる", "月の大きさが変化する", "地球の自転が止まる"],c:1,e:"月は太陽の光を反射して見える。月が地球の周りを公転することで、光って見える部分の見え方が変わり、満ち欠けが起こる。"},
        {id:"hx156571",s:"社会",g:1,t:"世界の地域構成",q:"経度0度の経線が通るイギリスの旧グリニッジ天文台を基準とする時刻は？",a:["日本標準時", "世界標準時の基準", "日付変更線", "夏時間"],c:1,e:"経度0度の本初子午線を基準に世界の時刻を考える。経度が15度違うと時刻は約1時間ずれる。日本標準時は東経135度を基準にしているため、世界協定時より9時間進んでいる。"},
        {id:"hx162702",s:"社会",g:1,t:"世界の気候",q:"赤道付近に広がり、年中高温で雨が多い気候は？",a:["地中海性気候", "熱帯雨林気候", "ツンドラ気候", "砂漠気候"],c:1,e:"熱帯雨林気候は赤道付近に分布し、年中高温で降水量が多い。高温多雨の環境では常緑広葉樹が発達し、熱帯雨林が広がる。"},
        {id:"hx127358",s:"社会",g:1,t:"アジア州",q:"季節によって風向きが変わり、アジアの気候や農業に大きく影響する風を何という？",a:["偏西風", "季節風（モンスーン）", "貿易風", "極東風"],c:1,e:"季節風（モンスーン）は季節によって風向きが変わる風。夏は海から湿った空気が流れ込み雨が多くなり、冬は大陸から乾燥した冷たい空気が吹き出す地域が多い。"},
        {id:"hx194171",s:"社会",g:1,t:"日本の地形",q:"日本の国土に占める山地・丘陵地の割合は、およそどれくらい？",a:["約10%", "約25%", "約75%", "約95%"],c:2,e:"日本は山地や丘陵地が多く、国土の約4分の3を占める。平野は河川の下流や海岸沿いに分布し、人口や都市、農業が集中しやすい。"},
        {id:"hx116022",s:"社会",g:1,t:"日本の気候",q:"日本海側で冬に雪が多くなる主な理由は？",a:["太平洋から乾いた風が吹くから", "大陸からの季節風が日本海で水蒸気を含むから", "地震が多いから", "黒潮が雪を降らせるから"],c:1,e:"冬は大陸から北西の季節風が吹き、日本海を渡る間に水蒸気を含む。山地にぶつかって上昇し、雪を降らせる。山を越えた太平洋側では乾燥した風になりやすい。"},
        {id:"hx170132",s:"社会",g:1,t:"農業",q:"稲作で、田に水を引いて育てる農業を何という？",a:["畑作", "稲作", "酪農", "促成栽培"],c:1,e:"稲作は水田で米を生産する農業。日本では高温多雨の夏を利用して広く行われてきた。北海道や東北などは米の生産が盛んな地域として知られる。"},
        {id:"hx148213",s:"社会",g:1,t:"古代文明",q:"メソポタミア文明が栄えた地域を流れる川の組み合わせは？",a:["ナイル川とコンゴ川", "チグリス川とユーフラテス川", "黄河と長江", "インダス川とガンジス川"],c:1,e:"メソポタミア文明はチグリス川・ユーフラテス川流域で発達した。大河の周辺では農業が発展し、都市や文字、法などが生まれた。"},
        {id:"hx168158",s:"社会",g:1,t:"日本の古代",q:"大和政権が勢力を広げた時代に、各地の有力者が築いた大きな墓を何という？",a:["貝塚", "古墳", "城郭", "条里"],c:1,e:"古墳は有力者や王の墓として築かれた。前方後円墳は代表的な形で、大和政権の勢力拡大と関係が深い。"},
        {id:"hx169981",s:"社会",g:1,t:"飛鳥時代",q:"聖徳太子が役人の心構えを示すために定めたとされるものは？",a:["御成敗式目", "十七条の憲法", "武家諸法度", "大宝律令"],c:1,e:"十七条の憲法は604年に制定されたとされ、役人の道徳や政治の心構えを示した。冠位十二階は家柄にとらわれず才能や功績で役人を登用する制度。"},
        {id:"hx174065",s:"社会",g:1,t:"奈良時代",q:"奈良時代に国ごとに建てられた寺を何という？",a:["国分寺", "東大寺", "法隆寺", "平等院"],c:0,e:"聖武天皇は仏教の力で国を守ろうとして、国ごとに国分寺・国分尼寺を建てる命令を出した。総国分寺にあたるのが東大寺。"},
        {id:"hx282943",s:"社会",g:2,t:"江戸時代",q:"江戸幕府が大名を統制するために定めた法令は？",a:["武家諸法度", "御成敗式目", "十七条の憲法", "大日本帝国憲法"],c:0,e:"武家諸法度は江戸幕府が大名を統制するために定めた法令。参勤交代などを通じて大名の力を抑え、幕府の支配体制を維持した。"},
        {id:"hx261374",s:"社会",g:2,t:"江戸時代",q:"参勤交代の主な目的として最も適切なものは？",a:["農民を増やす", "大名の経済力を弱め、幕府への服従を示させる", "外国との貿易を自由にする", "キリスト教を広める"],c:1,e:"大名に江戸と領地を往復させることで、多額の費用を負担させ、妻子を江戸に住まわせて統制した。交通や宿場町の発達にも影響した。"},
        {id:"hx285519",s:"社会",g:2,t:"江戸時代",q:"鎖国中、オランダや中国との貿易が行われた場所は？",a:["長崎", "横浜", "神戸", "函館"],c:0,e:"江戸時代、長崎ではオランダや中国との貿易が行われた。オランダ商館は出島に置かれ、海外の知識や文化が日本に伝わる窓口となった。"},
        {id:"hx294295",s:"社会",g:2,t:"幕末",q:"日米和親条約を結び、日本が開国するきっかけをつくった人物は？",a:["ペリー", "ハリス", "マッカーサー", "シーボルト"],c:0,e:"アメリカのペリーが1853年に浦賀へ来航し、翌年の日米和親条約で下田・函館を開港した。日米修好通商条約はその後、ハリスとの交渉で結ばれた。"},
        {id:"hx261770",s:"社会",g:2,t:"明治維新",q:"明治政府が藩を廃止して府県を置いた改革は？",a:["地租改正", "廃藩置県", "文明開化", "徴兵令"],c:1,e:"1871年の廃藩置県で藩を廃止し、中央政府が任命する府知事・県令を置いた。各地の大名による支配をなくし、中央集権国家をつくる改革だった。"},
        {id:"hx260600",s:"社会",g:2,t:"明治時代",q:"地租改正で、土地の所有者が地価を基準に納めるようになった税は？",a:["米", "地租", "関税", "所得税"],c:1,e:"地租改正では土地の所有者に地券を発行し、地価の一定割合を現金で納めさせた。政府は安定した現金収入を得られるようになった。"},
        {id:"hx229674",s:"社会",g:2,t:"近代日本",q:"日清戦争後に結ばれた講和条約は？",a:["ポーツマス条約", "下関条約", "ベルサイユ条約", "サンフランシスコ平和条約"],c:1,e:"日清戦争は1894年に始まり、1895年に下関条約が結ばれた。清は朝鮮の独立を認め、台湾などを日本に割譲した。"},
        {id:"hx28521",s:"社会",g:2,t:"近代世界",q:"第一次世界大戦が始まった年は？",a:["1904年", "1914年", "1918年", "1939年"],c:1,e:"第一次世界大戦は1914年に始まり、1918年に終結した。サラエボ事件をきっかけにヨーロッパの同盟関係を通じて戦争が拡大した。"},
        {id:"hx236672",s:"社会",g:2,t:"近代日本",q:"普通選挙法が成立した1925年、同じ年に制定された思想・社会運動を取り締まる法律は？",a:["治安維持法", "国家総動員法", "大日本帝国憲法", "労働基準法"],c:0,e:"1925年に普通選挙法が成立し、満25歳以上の男子に選挙権が認められた。同じ年に治安維持法も制定され、社会主義・共産主義運動などへの取り締まりが強化された。"},
        {id:"hx34361",s:"社会",g:3,t:"日本国憲法",q:"日本国憲法が施行された日は？",a:["1945年8月15日", "1946年11月3日", "1947年5月3日", "1952年4月28日"],c:2,e:"日本国憲法は1946年11月3日に公布され、1947年5月3日に施行された。公布日と施行日を区別して覚える。5月3日は憲法記念日。"},
        {id:"hx358790",s:"社会",g:3,t:"国会",q:"衆議院と参議院で議決が異なる場合、一定の条件で衆議院の議決が優先されるしくみは？",a:["違憲審査制", "衆議院の優越", "直接請求", "議院内閣制"],c:1,e:"衆議院の優越は、予算の議決や条約の承認、内閣総理大臣の指名などで認められる。衆議院は任期が短く解散もあるため、国民の意思をより反映しやすいと考えられている。"},
        {id:"hx384774",s:"社会",g:3,t:"内閣",q:"内閣総理大臣を指名する機関は？",a:["国会", "内閣", "最高裁判所", "天皇"],c:0,e:"内閣総理大臣は国会議員の中から国会が指名する。その後、天皇が任命する。国会が内閣総理大臣を指名する点と、天皇の国事行為として任命される点を区別する。"},
        {id:"hx358432",s:"社会",g:3,t:"裁判所",q:"法律や命令などが憲法に違反していないかを判断する権限は？",a:["行政権", "違憲審査権", "立法権", "条約締結権"],c:1,e:"違憲審査権は、法律・命令・規則・処分が憲法に適合するかを裁判所が判断する権限。最高裁判所は「憲法の番人」と呼ばれる。"},
        {id:"hx340871",s:"社会",g:3,t:"選挙",q:"選挙で、選挙区ごとに最多得票者などを選ぶ制度は？",a:["比例代表制", "小選挙区制", "間接民主制", "大選挙区完全比例制"],c:1,e:"小選挙区制は一つの選挙区から原則1人を選ぶ制度。政権が安定しやすい一方、少数意見が議席に反映されにくいことがある。比例代表制は得票率に応じて議席を配分する。"},
        {id:"hx350258",s:"社会",g:3,t:"経済",q:"需要量が供給量を上回ると、一般に価格はどうなりやすい？",a:["下がる", "上がる", "必ず一定", "ゼロになる"],c:1,e:"需要が供給を上回ると品不足になり、買いたい人どうしの競争が起きて価格は上がりやすい。反対に供給が需要を上回ると価格は下がりやすい。"},
        {id:"hx365169",s:"社会",g:3,t:"金融",q:"日本銀行の役割として適切でないものは？",a:["紙幣の発行", "銀行の銀行", "政府の銀行", "国の予算案の議決"],c:3,e:"日本銀行は紙幣を発行し、金融政策を行う「銀行の銀行」「政府の銀行」。国の予算案を議決するのは国会であり、日本銀行の役割ではない。"},
        {id:"hx398",s:"社会",g:3,t:"国際社会",q:"国際連合の安全保障理事会で、拒否権を持つ常任理事国は何か国？",a:["3か国", "5か国", "10か国", "15か国"],c:1,e:"安全保障理事会の常任理事国はアメリカ・イギリス・フランス・ロシア・中国の5か国。実質事項の決定では、常任理事国の反対票に拒否権がある。"}
      );

      bank.push(
        {"id":"v9q001","s":"理科","g":1,"t":"植物","q":"葉の表皮にあり、気体の出入りや蒸散に関係する小さな穴は？","a":["気孔","維管束","胚珠","やく"],"c":0,"e":"気孔。主に葉の裏側に多く、二酸化炭素の取り込みや酸素・水蒸気の放出に関係する。水の通り道である維管束とは役割が違う。"},
        {"id":"v9q002","s":"理科","g":1,"t":"植物","q":"根の先端付近にあり、水や水に溶けた養分を吸収しやすくするつくりは？","a":["根冠","根毛","子房","気孔"],"c":1,"e":"根毛。表面積を大きくして水や無機養分を吸収しやすくする。根冠は根の先端を保護する部分。"},
        {"id":"v9q003","s":"理科","g":1,"t":"植物","q":"花粉がめしべの柱頭につくことを何という？","a":["受精","受粉","発芽","蒸散"],"c":1,"e":"受粉。花粉が柱頭についた後、花粉管が伸びて胚珠に精細胞が届き、受精が起こる。受粉と受精は別の段階。"},
        {"id":"v9q004","s":"理科","g":1,"t":"動物","q":"魚類の呼吸器官は？","a":["肺","えら","気管","皮膚だけ"],"c":1,"e":"えら。水中に溶けた酸素を取り込む。両生類の成体は肺や皮膚、昆虫は気管で呼吸する。"},
        {"id":"v9q005","s":"理科","g":1,"t":"動物","q":"昆虫の体は大きく分けて何部からできている？","a":["頭・胸・腹","頭・胴","頭・胸","胸・腹・尾"],"c":0,"e":"頭部・胸部・腹部の3つ。脚は胸部に3対、つまり6本つく。クモは昆虫ではなく、脚が4対の節足動物。"},
        {"id":"v9q006","s":"理科","g":1,"t":"物質","q":"密度を求める式は？","a":["質量×体積","質量÷体積","体積÷質量","質量＋体積"],"c":1,"e":"密度＝質量÷体積。単位はg/cm³など。体積が同じなら質量が大きい物質ほど密度が大きい。"},
        {"id":"v9q007","s":"理科","g":1,"t":"物質","q":"物質が液体から気体に変化する状態変化は？","a":["凝固","融解","気化","凝縮"],"c":2,"e":"気化。液体が気体になる変化で、沸騰と蒸発がある。気体から液体になる凝縮と混同しない。"},
        {"id":"v9q008","s":"理科","g":1,"t":"物質","q":"水を加熱し続けて沸騰している間、水の温度はどうなる？","a":["上がり続ける","一定になる","下がる","0℃になる"],"c":1,"e":"一定になる。沸騰中は加えた熱が状態変化に使われるため、一定の圧力では温度がほぼ一定に保たれる。"},
        {"id":"v9q009","s":"理科","g":1,"t":"光","q":"光が鏡で反射するとき、入射角と反射角の関係は？","a":["入射角の2倍","反射角の2倍","等しい","和が90度"],"c":2,"e":"入射角＝反射角。どちらも鏡の面ではなく、反射面に垂直な法線から測る点が重要。"},
        {"id":"v9q010","s":"理科","g":1,"t":"音","q":"音が空気中を伝わるとき、空気の何が伝わっている？","a":["空気そのものが音源まで移動","振動","光","電流"],"c":1,"e":"空気の振動が周囲へ伝わる。音は物質を媒質として伝わる波で、真空中では伝わらない。"},
        {"id":"v9q011","s":"理科","g":1,"t":"力","q":"ばねの伸びは、ばねを引く力とどのような関係？","a":["反比例","比例","無関係","常に一定"],"c":1,"e":"弾性の限界内では、ばねの伸びは加えた力に比例する。これをフックの法則という。"},
        {"id":"v9q012","s":"理科","g":1,"t":"地層","q":"地層が下から上へ順に積み重なると考える基本法則は？","a":["地層累重の法則","質量保存の法則","慣性の法則","反射の法則"],"c":0,"e":"地層累重の法則。地層が逆転していなければ、下にある地層ほど古い。断層や褶曲がある場合は注意する。"},
        {"id":"v9q013","s":"理科","g":1,"t":"地震","q":"P波とS波のうち、速く伝わり初期微動を起こすのは？","a":["P波","S波","表面波だけ","どちらも同じ"],"c":0,"e":"P波は速く伝わり、小さな揺れである初期微動を起こす。遅いS波が到着すると主要動が始まる。"},
        {"id":"v9q014","s":"理科","g":1,"t":"地震","q":"震度が表すものは何？","a":["地震そのものの規模","ある地点での揺れの強さ","震源までの距離","地震の発生回数"],"c":1,"e":"震度は各地点での揺れの強さ。地震そのものの規模を表すマグニチュードとは別の指標。"},
        {"id":"v9q015","s":"理科","g":1,"t":"火山","q":"火山岩に見られる、斑晶が石基に散らばったつくりは？","a":["斑状組織","等粒状組織","層状組織","結晶格子"],"c":0,"e":"斑状組織。マグマが地表付近で急に冷え、細かい石基の中に大きめの斑晶ができる。深成岩はゆっくり冷えて等粒状組織になりやすい。"},
        {"id":"v9q016","s":"理科","g":2,"t":"消化","q":"タンパク質の消化が胃で始まるときに働く酵素は？","a":["アミラーゼ","ペプシン","リパーゼ","マルターゼ"],"c":1,"e":"ペプシン。胃液に含まれ、タンパク質を分解する。胃液には酸性の塩酸も含まれ、ペプシンが働きやすい環境をつくる。"},
        {"id":"v9q017","s":"理科","g":2,"t":"消化","q":"小腸の内壁にある柔毛の主な役割は？","a":["食物をかみ砕く","養分を吸収する表面積を増やす","胆汁をつくる","胃酸を分泌する"],"c":1,"e":"柔毛は小腸の表面積を大きくし、消化された養分を効率よく吸収する。吸収された養分は毛細血管やリンパ管へ入る。"},
        {"id":"v9q018","s":"理科","g":2,"t":"血液","q":"酸素を運ぶ赤血球に含まれる色素は？","a":["ヘモグロビン","葉緑素","メラニン","インスリン"],"c":0,"e":"ヘモグロビン。酸素と結びつき、肺から全身へ酸素を運ぶ。白血球は病原体への防御、血小板は血液凝固に関係する。"},
        {"id":"v9q019","s":"理科","g":2,"t":"血液","q":"心臓から肺へ血液を送る血管は？","a":["肺静脈","肺動脈","大静脈","大動脈"],"c":1,"e":"肺動脈。心臓から出る血管なので動脈。酸素が少ない血液が流れるため「動脈＝酸素が多い」と覚えるのは誤り。"},
        {"id":"v9q020","s":"理科","g":2,"t":"植物","q":"光合成で発生する気体を確かめる実験で使う試薬は？","a":["石灰水","BTB溶液","線香の火","塩化コバルト紙"],"c":2,"e":"線香の火が激しく燃えることで酸素を確かめられる。石灰水は二酸化炭素、塩化コバルト紙は水の検出に使う。"},
        {"id":"v9q021","s":"理科","g":2,"t":"化学","q":"鉄と硫黄を混ぜて加熱するとできる物質は？","a":["酸化鉄","硫化鉄","塩化鉄","水酸化鉄"],"c":1,"e":"硫化鉄。鉄と硫黄が化合して別の物質になる。磁石につくか、塩酸を加えたときの気体の性質などで混合物と区別できる。"},
        {"id":"v9q022","s":"理科","g":2,"t":"化学","q":"炭酸水素ナトリウムを加熱したときに発生する気体は？","a":["酸素","水素","二酸化炭素","窒素"],"c":2,"e":"二酸化炭素と水などが生じる。発生した二酸化炭素は石灰水を白くにごらせる。試験管の口を少し下げて加熱するのは水の逆流を防ぐため。"},
        {"id":"v9q023","s":"理科","g":2,"t":"化学","q":"水に溶けた物質を取り出すため、水溶液を冷やして結晶を得る操作は？","a":["蒸留","再結晶","ろ過","昇華"],"c":1,"e":"再結晶。温度による溶解度の差を利用して純粋な結晶を取り出す。ろ過は液体に溶けない固体を分ける操作。"},
        {"id":"v9q024","s":"理科","g":2,"t":"電流","q":"電流の単位は？","a":["V","A","Ω","W"],"c":1,"e":"アンペア（A）。電圧はボルト（V）、抵抗はオーム（Ω）、電力はワット（W）。単位の取り違えに注意。"},
        {"id":"v9q025","s":"理科","g":2,"t":"電流","q":"直列回路で、回路の各部分を流れる電流はどうなる？","a":["どこでも等しい","抵抗が大きいほど大きい","電源に近いほど大きい","場所ごとに必ず異なる"],"c":0,"e":"直列回路では電流の通り道が1本なので、どの部分でも電流は等しい。電圧は各抵抗に分かれる。"},
        {"id":"v9q026","s":"理科","g":2,"t":"電流","q":"並列回路で、枝分かれする前後の電流の関係は？","a":["枝の電流の和が全体の電流","全体の電流は必ず0","枝の電流は必ず等しい","電圧の和が全体の電流"],"c":0,"e":"並列回路では、分かれた枝を流れる電流の和が分岐前の電流に等しい。枝の抵抗が同じ場合に限り枝の電流も等しくなる。"},
        {"id":"v9q027","s":"理科","g":2,"t":"天気","q":"湿度を求める式として正しいものは？","a":["飽和水蒸気量÷実際の水蒸気量×100","実際の水蒸気量÷飽和水蒸気量×100","気温÷気圧×100","気圧÷気温×100"],"c":1,"e":"湿度(%)＝実際の水蒸気量÷その気温での飽和水蒸気量×100。分母と分子を逆にしない。"},
        {"id":"v9q028","s":"理科","g":2,"t":"天気","q":"低気圧の中心付近で空気は一般にどう動く？","a":["下降して発散","上昇して収束","水平に停止","必ず下降"],"c":1,"e":"低気圧では地表付近の空気が中心へ集まり、上昇する。上昇気流で雲ができやすく、天気が崩れやすい。"},
        {"id":"v9q029","s":"理科","g":2,"t":"天気","q":"寒冷前線が通過するときに起こりやすい天気の変化は？","a":["弱い雨が広く長時間続く","短時間に強い雨が降り、気温が下がる","必ず晴天が続く","気温が急上昇する"],"c":1,"e":"寒冷前線では寒気が暖気を押し上げ、積乱雲が発達しやすい。通過時に強い雨や雷、通過後に気温低下が起こりやすい。"},
        {"id":"v9q030","s":"理科","g":2,"t":"動物","q":"刺激を受け取る感覚器官から中枢へ情報を伝える神経は？","a":["運動神経","感覚神経","自律神経だけ","末しょう神経ではない"],"c":1,"e":"感覚神経は感覚器官から脳やせきずいへ信号を伝える。運動神経は中枢から筋肉などへ命令を伝える。"},
        {"id":"v9q031","s":"理科","g":3,"t":"遺伝","q":"対になった遺伝子のうち、形質として現れやすいものを何という？","a":["劣性形質","顕性形質","突然変異","獲得形質"],"c":1,"e":"顕性形質（旧称・優性形質）。対になる遺伝子が異なる場合に現れる形質。現れにくい方は潜性形質（旧称・劣性形質）。"},
        {"id":"v9q032","s":"理科","g":3,"t":"細胞分裂","q":"体細胞分裂の前に、細胞内で複製されるものは？","a":["細胞壁だけ","DNAを含む染色体","細胞膜だけ","ミトコンドリアだけ"],"c":1,"e":"DNAを含む染色体が複製され、分裂後の2つの細胞に同じ遺伝情報が分配される。分裂前にDNA量が増える。"},
        {"id":"v9q033","s":"理科","g":3,"t":"イオン","q":"原子が電子を失ってできる粒子は？","a":["陰イオン","陽イオン","中性子","同位体だけ"],"c":1,"e":"電子を失うと負の電荷が減るため、全体として正に帯電した陽イオンになる。電子を受け取ると陰イオンになる。"},
        {"id":"v9q034","s":"理科","g":3,"t":"電池","q":"化学エネルギーを電気エネルギーに変換する装置は？","a":["電熱線","化学電池","電磁石","変圧器"],"c":1,"e":"化学電池は化学変化に伴う電子の移動を利用して電流を取り出す。充電できる電池では外部から電気を加えて逆向きの反応を進める。"},
        {"id":"v9q035","s":"理科","g":3,"t":"中和","q":"塩酸と水酸化ナトリウム水溶液の中和でできる塩は？","a":["硫酸ナトリウム","塩化ナトリウム","炭酸カルシウム","硝酸カリウム"],"c":1,"e":"塩酸の塩化物イオンと水酸化ナトリウムのナトリウムイオンから塩化ナトリウムができ、水も生じる。H⁺とOH⁻が結びついて水になる。"},
        {"id":"v9q036","s":"理科","g":3,"t":"運動","q":"物体の速さを求める式は？","a":["時間÷距離","距離÷時間","距離×時間","質量÷時間"],"c":1,"e":"速さ＝距離÷時間。例えば120mを20秒で進むなら6m/s。単位をそろえて計算する。"},
        {"id":"v9q037","s":"理科","g":3,"t":"運動","q":"水平面上で物体にはたらく摩擦力の向きは？","a":["運動の向きと同じ","運動や動こうとする向きと反対","常に上向き","常に下向き"],"c":1,"e":"摩擦力は接触面に沿って、相対的な運動や動こうとする向きを妨げる向きにはたらく。垂直抗力や重力とは向きが異なる。"},
        {"id":"v9q038","s":"理科","g":3,"t":"仕事とエネルギー","q":"仕事率の単位は？","a":["J","N","W","Pa"],"c":2,"e":"仕事率の単位はワット(W)。仕事率＝仕事[J]÷時間[s]。同じ仕事なら短い時間で行うほど仕事率が大きい。"},
        {"id":"v9q039","s":"理科","g":3,"t":"天体","q":"太陽の南中高度が一年で最も高くなるのは北半球のいつ？","a":["春分","夏至","秋分","冬至"],"c":1,"e":"北半球では夏至ごろに太陽の南中高度が最も高く、昼の長さも最も長い。冬至は南中高度が最も低い。"},
        {"id":"v9q040","s":"理科","g":3,"t":"天体","q":"太陽や星が東から西へ動いて見える日周運動の原因は？","a":["地球の公転","地球の自転","月の公転","太陽の公転"],"c":1,"e":"地球が西から東へ自転しているため、天体は東から西へ動くように見える。季節による星座の変化は地球の公転が原因。"},
        {"id":"v9q041","s":"理科","g":3,"t":"天体","q":"金星が真夜中に見えない主な理由は？","a":["金星は光らないから","地球より内側を公転し、太陽から大きく離れて見えないから","地球の影に常に入るから","月に隠れるから"],"c":1,"e":"金星は地球より内側を公転する内惑星で、地球から見ると太陽の近くにしか見えない。明け方や夕方に観察しやすい。"},
        {"id":"v9q042","s":"理科","g":3,"t":"環境","q":"生態系で、植物のように光合成で有機物をつくる生物を何という？","a":["消費者","分解者","生産者","捕食者"],"c":2,"e":"生産者は無機物から有機物をつくる植物など。消費者は他の生物を食べ、分解者は遺体や排出物を分解する。"},
        {"id":"v9q043","s":"理科","g":3,"t":"環境","q":"食物連鎖で、上位の消費者ほど個体数が少なくなりやすい主な理由は？","a":["エネルギーが段階ごとに一部失われるから","上位ほど必ず小さいから","酸素がなくなるから","水が消えるから"],"c":0,"e":"食べられた有機物のエネルギーのすべてが次の段階へ移るわけではなく、呼吸などで熱として失われる。そのため高次の栄養段階ほど利用できるエネルギーが少ない。"},
        {"id":"v9q044","s":"理科","g":3,"t":"科学技術","q":"放射線のうち、紙で止められやすいものは？","a":["α線","β線","γ線","X線"],"c":0,"e":"α線は透過力が弱く、紙や皮膚の表面で止められやすい。β線は薄い金属板、γ線やX線は厚い鉛やコンクリートなどで遮へいする。"},
        {"id":"v9q045","s":"社会","g":1,"t":"世界地理","q":"六大陸のうち、面積が最も大きい大陸は？","a":["アフリカ大陸","ユーラシア大陸","北アメリカ大陸","南アメリカ大陸"],"c":1,"e":"ユーラシア大陸。ヨーロッパとアジアを合わせた大陸で、世界最大。オーストラリア大陸は最も小さい。"},
        {"id":"v9q046","s":"社会","g":1,"t":"世界地理","q":"世界で最も面積が大きい国は？","a":["カナダ","中国","ロシア","アメリカ"],"c":2,"e":"ロシア。ユーラシア大陸の北部に広がり、ヨーロッパとアジアの両方にまたがる。"},
        {"id":"v9q047","s":"社会","g":1,"t":"世界地理","q":"赤道付近に広がる熱帯雨林の代表的な地域は？","a":["アマゾン川流域","サハラ砂漠","シベリア","地中海沿岸"],"c":0,"e":"アマゾン川流域は赤道に近く、高温多雨で熱帯雨林が広がる。サハラ砂漠は乾燥帯。"},
        {"id":"v9q048","s":"社会","g":1,"t":"世界地理","q":"地中海性気候の特徴として正しいものは？","a":["一年中雨が多い","夏に乾燥し、冬に比較的雨が多い","一年中寒冷","夏に必ず雪が降る"],"c":1,"e":"地中海性気候は夏に高温で乾燥し、冬に雨が比較的多い。オリーブやぶどう、柑橘類などの栽培が盛ん。"},
        {"id":"v9q049","s":"社会","g":1,"t":"世界地理","q":"EUの共通通貨として使われているものは？","a":["ドル","ポンド","ユーロ","元"],"c":2,"e":"ユーロ。EU加盟国すべてが導入しているわけではない点に注意。イギリスはEUを離脱し、通貨はポンド。"},
        {"id":"v9q050","s":"社会","g":1,"t":"日本地理","q":"日本の標準時子午線が通る兵庫県の市は？","a":["神戸市","姫路市","明石市","西宮市"],"c":2,"e":"明石市付近を通る東経135度が日本標準時の基準。経度15度で時刻は約1時間ずれる。"},
        {"id":"v9q051","s":"社会","g":1,"t":"日本地理","q":"日本の三大急流に含まれない川は？","a":["最上川","富士川","球磨川","利根川"],"c":3,"e":"三大急流は最上川・富士川・球磨川。利根川は流域面積が日本最大の川として重要。"},
        {"id":"v9q052","s":"社会","g":1,"t":"日本地理","q":"扇状地で水はけがよい土地に発達しやすい農業は？","a":["果樹栽培","稲作だけ","漁業","酪農だけ"],"c":0,"e":"扇状地は水はけがよく、果樹園などに利用されやすい。扇端では地下水が湧き出し、水田に利用されることもある。"},
        {"id":"v9q053","s":"社会","g":1,"t":"日本地理","q":"三角州が形成されやすい場所は？","a":["山頂","河口付近","火山の火口","海溝"],"c":1,"e":"河口付近で川の流れが弱まり、運ばれた土砂が堆積して三角州ができる。低く平らで水田や市街地に利用される。"},
        {"id":"v9q054","s":"社会","g":1,"t":"日本地理","q":"日本で促成栽培が盛んな地域の例として適切なのは？","a":["高知平野","十勝平野","根釧台地","石狩平野"],"c":0,"e":"高知平野などでは温暖な気候を利用し、ビニールハウスで野菜を早く出荷する促成栽培が行われる。"},
        {"id":"v9q055","s":"社会","g":1,"t":"日本地理","q":"北海道で大規模な畑作や酪農が盛んな理由として適切なのは？","a":["平地が少ないから","広い土地を利用しやすいから","一年中高温だから","人口密度が高いから"],"c":1,"e":"北海道には広い平野や台地があり、大規模な畑作・酪農に適する。冷涼な気候も作物や乳牛の飼育に関係する。"},
        {"id":"v9q056","s":"社会","g":1,"t":"古代文明","q":"エジプト文明が発達した大河は？","a":["ナイル川","黄河","インダス川","アマゾン川"],"c":0,"e":"エジプト文明はナイル川流域で発達した。定期的な氾濫が肥沃な土をもたらし、農業を支えた。"},
        {"id":"v9q057","s":"社会","g":1,"t":"古代日本","q":"弥生時代に広まった農業は？","a":["稲作","焼畑だけ","小麦の大規模栽培","じゃがいも栽培"],"c":0,"e":"弥生時代には大陸から稲作や金属器などが伝わり、水田稲作が広がった。縄文時代の狩猟・採集中心の生活と比較する。"},
        {"id":"v9q058","s":"社会","g":1,"t":"古代日本","q":"邪馬台国の女王として中国の歴史書に記された人物は？","a":["推古天皇","卑弥呼","持統天皇","北条政子"],"c":1,"e":"卑弥呼。魏に使いを送り、親魏倭王の称号などを受けたとされる。邪馬台国の場所は現在も議論がある。"},
        {"id":"v9q059","s":"社会","g":1,"t":"奈良時代","q":"奈良時代に都が置かれた場所は？","a":["平安京","平城京","藤原京","長岡京"],"c":1,"e":"710年に平城京へ遷都した。794年に平安京へ移るまで、奈良を中心に政治が行われた。"},
        {"id":"v9q060","s":"社会","g":1,"t":"平安時代","q":"平安京に都を移した天皇は？","a":["聖武天皇","桓武天皇","後醍醐天皇","白河天皇"],"c":1,"e":"桓武天皇が794年に平安京へ遷都した。奈良の仏教勢力の影響を避け、政治を立て直す狙いもあった。"},
        {"id":"v9q061","s":"社会","g":2,"t":"鎌倉時代","q":"鎌倉幕府で将軍を補佐し、北条氏が代々就いた役職は？","a":["関白","執権","管領","老中"],"c":1,"e":"執権。北条氏が実権を握り、将軍を補佐する立場から幕府政治を主導した。"},
        {"id":"v9q062","s":"社会","g":2,"t":"鎌倉時代","q":"御成敗式目を制定した人物は？","a":["源頼朝","北条泰時","足利義満","徳川家康"],"c":1,"e":"北条泰時が1232年に制定。武士社会の慣習や道理に基づく裁判の基準を示した。"},
        {"id":"v9q063","s":"社会","g":2,"t":"鎌倉時代","q":"元が日本に攻めてきた2度の出来事を何という？","a":["応仁の乱","元寇","承久の乱","壬申の乱"],"c":1,"e":"元寇。1274年の文永の役、1281年の弘安の役。御家人は十分な恩賞を得られず、幕府への不満が高まった。"},
        {"id":"v9q064","s":"社会","g":2,"t":"室町時代","q":"室町幕府を開いた人物は？","a":["足利尊氏","足利義満","後醍醐天皇","北条時宗"],"c":0,"e":"足利尊氏が京都に幕府を開いた。3代将軍足利義満の時代に南北朝が統一され、幕府の力が強まった。"},
        {"id":"v9q065","s":"社会","g":2,"t":"室町時代","q":"足利義満が建てた、金閣で知られる寺院は？","a":["銀閣寺","鹿苑寺","東大寺","中尊寺"],"c":1,"e":"金閣は鹿苑寺にある。足利義満の北山文化を代表し、武家文化と公家文化、中国文化などが融合した。"},
        {"id":"v9q066","s":"社会","g":2,"t":"戦国時代","q":"鉄砲が日本に伝わった年として一般に学ぶのは？","a":["1192年","1333年","1543年","1600年"],"c":2,"e":"1543年、ポルトガル人を乗せた船が種子島に漂着し、鉄砲が伝わったとされる。"},
        {"id":"v9q067","s":"社会","g":2,"t":"安土桃山時代","q":"豊臣秀吉が全国の田畑の面積や収穫高を調べた政策は？","a":["刀狩","太閤検地","楽市・楽座","参勤交代"],"c":1,"e":"太閤検地。土地の面積や収穫高を統一基準で調べ、年貢徴収や支配を安定させた。刀狩は農民から武器を取り上げる政策。"},
        {"id":"v9q068","s":"社会","g":2,"t":"安土桃山時代","q":"豊臣秀吉が農民から刀や鉄砲などを取り上げた政策は？","a":["刀狩","地租改正","廃藩置県","班田収授"],"c":0,"e":"刀狩。兵農分離を進め、農民の一揆を防ぎ、武士と農民の身分を分ける政策の一つとなった。"},
        {"id":"v9q069","s":"社会","g":2,"t":"江戸時代","q":"江戸幕府がキリスト教を禁止し、貿易や海外渡航を制限した政策は？","a":["鎖国","開国","文明開化","富国強兵"],"c":0,"e":"鎖国。完全に外国との交流を断ったわけではなく、長崎・対馬・薩摩・松前などを通じた限定的な交流は続いた。"},
        {"id":"v9q070","s":"社会","g":2,"t":"江戸時代","q":"享保の改革を行った将軍は？","a":["徳川家康","徳川吉宗","徳川慶喜","徳川家光"],"c":1,"e":"徳川吉宗。倹約や新田開発、公事方御定書の制定、目安箱の設置などで幕府財政の立て直しを図った。"},
        {"id":"v9q071","s":"社会","g":2,"t":"江戸時代","q":"江戸時代の三大改革に含まれないものは？","a":["享保の改革","寛政の改革","天保の改革","明治の改革"],"c":3,"e":"三大改革は享保・寛政・天保。いずれも幕府財政や社会秩序の立て直しを目指した。"},
        {"id":"v9q072","s":"社会","g":2,"t":"幕末","q":"大政奉還を行った江戸幕府最後の将軍は？","a":["徳川家光","徳川吉宗","徳川慶喜","徳川家茂"],"c":2,"e":"徳川慶喜が1867年に政権を朝廷へ返上した。大政奉還の後、王政復古の大号令などを経て戊辰戦争へ進んだ。"},
        {"id":"v9q073","s":"社会","g":2,"t":"明治時代","q":"明治政府が国民に兵役の義務を課した制度は？","a":["徴兵令","地租改正","学制","廃藩置県"],"c":0,"e":"徴兵令は1873年。国民から兵士を集める制度で、近代的な軍隊を整備する目的があった。"},
        {"id":"v9q074","s":"社会","g":2,"t":"明治時代","q":"明治政府が近代産業を育てるために進めた政策は？","a":["殖産興業","鎖国","参勤交代","楽市・楽座"],"c":0,"e":"殖産興業。官営工場の設立や鉄道・電信の整備などを通じて産業の近代化を進めた。富国強兵とも結びつく。"},
        {"id":"v9q075","s":"社会","g":2,"t":"近代日本","q":"日本で最初の内閣総理大臣は？","a":["伊藤博文","大久保利通","板垣退助","西郷隆盛"],"c":0,"e":"伊藤博文。1885年に内閣制度が創設され、初代内閣総理大臣となった。大日本帝国憲法の制定にも関わった。"},
        {"id":"v9q076","s":"社会","g":2,"t":"近代世界","q":"第二次世界大戦が始まった年は？","a":["1914年","1929年","1939年","1945年"],"c":2,"e":"1939年にドイツのポーランド侵攻をきっかけにヨーロッパで始まった。1945年に終結した。"},
        {"id":"v9q077","s":"社会","g":3,"t":"憲法","q":"日本国憲法の三大原則に含まれるものはどれ？","a":["軍部主権","国民主権","身分制度","天皇主権"],"c":1,"e":"三大原則は国民主権・基本的人権の尊重・平和主義。憲法前文や各条文と結びつけて理解する。"},
        {"id":"v9q078","s":"社会","g":3,"t":"人権","q":"日本国憲法で保障される、思想・良心の自由は何権に分類される？","a":["自由権","社会権","参政権","請求権"],"c":0,"e":"思想・良心の自由は精神の自由に含まれる自由権。国家から不当に干渉されない権利の一つ。"},
        {"id":"v9q079","s":"社会","g":3,"t":"人権","q":"健康で文化的な最低限度の生活を営む権利は？","a":["自由権","生存権","参政権","請求権"],"c":1,"e":"生存権。社会権の一つで、憲法25条に定められている。国に社会保障や生活環境の整備を求める考え方につながる。"},
        {"id":"v9q080","s":"社会","g":3,"t":"人権","q":"選挙で投票する権利は何権に分類される？","a":["自由権","社会権","参政権","平等権"],"c":2,"e":"参政権。政治に参加する権利で、選挙権や被選挙権などがある。請願権などの請求権とは区別する。"},
        {"id":"v9q081","s":"社会","g":3,"t":"国会","q":"国会が「唯一の立法機関」とされる意味は？","a":["法律を実際に執行する","国の法律を制定する中心機関である","裁判を行う","予算を執行する"],"c":1,"e":"国会は法律を制定する唯一の立法機関。内閣は行政、裁判所は司法を担当し、三権分立で権力を抑制し合う。"},
        {"id":"v9q082","s":"社会","g":3,"t":"内閣","q":"内閣が国会に対して連帯して責任を負う仕組みは？","a":["議院内閣制","大統領制","三審制","直接民主制"],"c":0,"e":"議院内閣制。内閣は国会の信任に基づいて成立し、衆議院で不信任決議が可決されると、内閣は総辞職か衆議院解散を選ぶ。"},
        {"id":"v9q083","s":"社会","g":3,"t":"裁判","q":"民事裁判の主な目的は？","a":["犯罪者に刑罰を科す","個人や企業間の権利・義務の争いを解決する","法律を制定する","外交交渉を行う"],"c":1,"e":"民事裁判は貸金・契約・損害賠償などの争いを解決する。犯罪の有罪・無罪や刑罰を判断するのは刑事裁判。"},
        {"id":"v9q084","s":"社会","g":3,"t":"裁判","q":"刑事裁判で、被告人が有罪と確定するまでは無罪として扱う原則は？","a":["罪刑法定主義","推定無罪","三審制","司法権の独立"],"c":1,"e":"推定無罪。検察側が犯罪を立証する責任を負い、疑いが残る場合に安易に有罪としてはならない。"},
        {"id":"v9q085","s":"社会","g":3,"t":"地方自治","q":"地方公共団体の長や議会の議員を住民が直接選ぶ原則は？","a":["間接選挙","直接選挙","任命制","世襲制"],"c":1,"e":"地方自治では住民が首長や議員を直接選挙で選ぶ。住民自治と団体自治が地方自治の基本的な考え方。"},
        {"id":"v9q086","s":"社会","g":3,"t":"地方自治","q":"住民が条例の制定・改廃などを求める制度は？","a":["直接請求","違憲審査","国政調査","弾劾裁判"],"c":0,"e":"直接請求。一定数の署名を集めて条例制定・改廃や議会解散などを請求できる。請求先や必要署名数は内容によって異なる。"},
        {"id":"v9q087","s":"社会","g":3,"t":"経済","q":"企業が商品やサービスを生産・販売し、利益を得ようとする経済の仕組みは？","a":["市場経済","計画経済だけ","物々交換だけ","自給自足経済"],"c":0,"e":"市場経済では価格を手がかりに需要と供給が調整される。現実の日本は市場の働きと政府の役割を組み合わせている。"},
        {"id":"v9q088","s":"社会","g":3,"t":"経済","q":"物価が継続的に上昇することを何という？","a":["デフレーション","インフレーション","円高","景気後退だけ"],"c":1,"e":"インフレーション（インフレ）。一般的な物価水準が継続的に上がること。反対に継続的に下がることをデフレーションという。"},
        {"id":"v9q089","s":"社会","g":3,"t":"経済","q":"円高になると、一般に輸入品の円での価格はどうなりやすい？","a":["高くなる","安くなる","必ず変わらない","輸入できなくなる"],"c":1,"e":"円高では同じ外貨をより少ない円で買えるため、輸入品は円換算で安くなりやすい。輸出企業には不利に働く場合がある。"},
        {"id":"v9q090","s":"社会","g":3,"t":"財政","q":"国や地方公共団体が公共サービスなどのために支出するお金は？","a":["歳入","歳出","税率","貿易収支"],"c":1,"e":"歳出は政府の支出。歳入は税金や国債などの収入。予算では歳入と歳出を見比べて財政状況を考える。"},
        {"id":"v9q091","s":"社会","g":3,"t":"金融","q":"日本銀行が景気や物価の安定を目指して行う政策は？","a":["財政政策","金融政策","外交政策","教育政策"],"c":1,"e":"金融政策。金利や資金供給などを調整し、物価の安定を目指す。政府が税や公共事業で景気に働きかけるのは財政政策。"},
        {"id":"v9q092","s":"社会","g":3,"t":"国際社会","q":"国際連合の本部がある都市は？","a":["ジュネーブ","ニューヨーク","パリ","ロンドン"],"c":1,"e":"国際連合の本部はアメリカのニューヨーク。国際司法裁判所はオランダのハーグにある。"},
        {"id":"v9q093","s":"社会","g":3,"t":"国際社会","q":"国際連合で、教育・科学・文化の分野で国際協力を進める機関は？","a":["WHO","UNESCO","UNICEF","ILO"],"c":1,"e":"UNESCO（ユネスコ）は教育・科学・文化を通じた国際協力を進める。WHOは保健、UNICEFは子どもの支援、ILOは労働に関係する。"},
        {"id":"v9q094","s":"社会","g":3,"t":"国際社会","q":"発展途上国への資金・技術協力などを行う政府開発援助の略称は？","a":["ODA","WHO","WTO","NATO"],"c":0,"e":"ODAは政府開発援助。資金協力や技術協力などを通じて、開発途上国の経済・社会の発展を支援する。"}
      );


      const $ = (id) => document.getElementById(id);
      const subjects = [...document.querySelectorAll('.subject')];
      const COOKIE = 'knot_study_v1';
      const empty = () => ({answered:0,correct:0,wrong:[]});
      function readCookie(){try{const row=document.cookie.split('; ').find(x=>x.startsWith(COOKIE+'='));if(!row)return empty();const v=JSON.parse(decodeURIComponent(row.split('=').slice(1).join('=')));return {answered:Number(v.answered)||0,correct:Number(v.correct)||0,wrong:Array.isArray(v.wrong)?v.wrong.filter(x=>bank.some(q=>q.id===x)).slice(0,30):[]};}catch{return empty();}}
      let stats=readCookie(), selected='理科', list=[], index=0, answered=false;
      function save(){const data=encodeURIComponent(JSON.stringify(stats));document.cookie=`${COOKIE}=${data}; Max-Age=31536000; Path=/; SameSite=Lax`+(location.protocol==='https:'?'; Secure':'');}
      function renderStats(){try{const r=JSON.parse(localStorage.getItem('knot-study-record')||'{"answered":0,"correct":0,"wrong":[],"seen":[]}');const seen=Array.isArray(r.seen)?r.seen:[];for(const [key,prefix] of [['science','sci-'],['social','soc-']]){const n=seen.filter(id=>String(id).startsWith(prefix)).length;const pct=Math.round(n/460*100);$(key+'-percent').textContent=pct+'%';$(key+'-count').textContent=n+' / 460問';$(key+'-ring').style.setProperty('--progress',(pct*3.6)+'deg');}}catch{}$('total-answered').textContent=stats.answered;$('total-correct').textContent=stats.correct;$('accuracy').textContent=stats.answered?Math.round(stats.correct/stats.answered*100)+'%':'—';$('wrong-count').textContent=stats.wrong.length;$('review-total').textContent=stats.wrong.length+'問';}
      subjects.forEach(btn=>btn.addEventListener('click',()=>{selected=btn.dataset.subject;subjects.forEach(x=>x.classList.toggle('active',x===btn));$('quiz-panel').hidden=true;}));
      function begin(wrongOnly=false){const grade=$('grade').value;list=bank.filter(q=>(wrongOnly?stats.wrong.includes(q.id):q.s===selected)&&(grade==='all'||String(q.g)===grade));if(!list.length){alert(wrongOnly?'この条件の苦手問題はまだないよ。':'この条件に合う問題はまだないよ。');return;}list=[...list].sort(()=>Math.random()-.5);index=0;$('quiz-panel').hidden=false;$('quiz-panel').scrollIntoView({behavior:'smooth',block:'start'});showQuestion();}
      function showQuestion(){answered=false;const q=list[index];$('quiz-subtitle').textContent=q.s.toUpperCase();$('quiz-title').textContent=q.s+'の問題';$('question-counter').textContent=(index+1)+' / '+list.length;$('question-grade').textContent='中'+q.g;$('question-topic').textContent=q.t;$('question-text').textContent=q.q;$('explanation').hidden=true;$('next-btn').disabled=true;$('next-btn').textContent=index===list.length-1?'学習を終了':'次の問題 →';const area=$('answer-list');area.replaceChildren();q.a.forEach((answer,i)=>{const b=document.createElement('button');b.type='button';b.className='answer-option';b.textContent=(i+1)+'. '+answer;b.addEventListener('click',()=>choose(i));area.append(b);});}
      function choose(choice){if(answered)return;answered=true;const q=list[index], correct=choice===q.c;stats.answered++;if(correct){stats.correct++;stats.wrong=stats.wrong.filter(x=>x!==q.id);}else if(!stats.wrong.includes(q.id))stats.wrong.push(q.id);save();renderStats();[...$('answer-list').children].forEach((b,i)=>{b.disabled=true;if(i===q.c)b.classList.add('correct');else if(i===choice)b.classList.add('incorrect');});$('explanation').hidden=false;$('explanation').textContent=(correct?'正解！ ':'不正解。正解は「'+q.a[q.c]+'」。 ')+q.e;$('next-btn').disabled=false;}
      $('start-btn').addEventListener('click',()=>begin($('mode').value==='wrong'));$('review-btn').addEventListener('click',()=>{$('grade').value='all';$('mode').value='wrong';begin(true);});$('next-btn').addEventListener('click',()=>{if(index<list.length-1){index++;showQuestion();}else{$('quiz-panel').hidden=true;alert('おつかれさま！学習記録を保存したよ。');}});$('quit-btn').addEventListener('click',()=>$('quiz-panel').hidden=true);
      $('reset-btn').addEventListener('click',()=>{if(confirm('この端末に保存した学習記録を削除する？')){stats=empty();save();renderStats();}});
      renderStats();
    })();
  </script>
</Layout>
