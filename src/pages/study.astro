---
import Layout from '../layouts/Layout.astro';
import foundation from '../data/study-foundation.json';
import kosen from '../data/kosen-questions.json';
const science = foundation.filter(q => q.subject === 'science').length;
const social = foundation.filter(q => q.subject === 'social').length;
---
<Layout studyMode title="Study｜KNOT" description="基礎網羅問題、高専入試対策、公式過去問模試。入試本番まで一緒に学ぶKNOT Study。">
<main class="study-home">
  <header class="intro">
    <p class="eyebrow">KNOT / LEARNING SPACE</p>
    <h1>入試本番まで、<span>一緒に走り抜こう。</span></h1>
    <p>基礎固めから高専入試の過去問演習まで。今日やることを選んで、ここから始めよう。</p>
    <div class="stats"><div><b>{foundation.length}</b><small>基礎問題</small></div><div><b>{science}</b><small>理科</small></div><div><b>{social}</b><small>社会</small></div><div><b>{kosen.length}</b><small>高専対策問題</small></div></div>
  </header>
  <section class="section">
    <div class="section-title"><div><p class="eyebrow">01 / FOUNDATION</p><h2>基礎網羅問題</h2><p>理科・社会の重要語句と基本事項を分野別に確認。</p></div><span class="status active">公開中</span></div>
    <a class="main-card" href={`${import.meta.env.BASE_URL}study/foundation/`}><span class="card-icon">基</span><div><small>FOUNDATION PRACTICE</small><h3>まずは基礎を完璧に。</h3><p>{foundation.length}問を収録。分野・問題数を選び、苦手問題を繰り返し演習できる。</p><b>基礎問題を解く <span>→</span></b></div></a>
  </section>
  <section class="section">
    <div class="section-title"><div><p class="eyebrow">02 / KNOWLEDGE BASE</p><h2>要点まとめ</h2><p>理科・社会の7分野を単元別に整理。入試頻出事項と資料を確認。</p></div><span class="status active">公開中</span></div>
    <a class="main-card" href={`${import.meta.env.BASE_URL}study/summary/`}><span class="card-icon">要</span><div><small>SUBJECT SUMMARIES / 7 FIELDS</small><h3>理社の重要事項を、単元ごとに。</h3><p>物理・化学・生物・地学・地理・歴史・公民の7ページ。頻出用語、公式、資料の読み方をまとめた。</p><b>要点まとめを見る <span>→</span></b></div></a>
  </section>
  <section class="section">
    <div class="section-title"><div><p class="eyebrow">03 / KO SEN EXAM</p><h2>高専入試特化</h2><p>資料読解・思考力を鍛えるオリジナル演習。</p></div><span class="status active">公開中</span></div>
    <a class="main-card" href={`${import.meta.env.BASE_URL}study/kosen/`}><span class="card-icon">専</span><div><small>EXAM PREPARATION</small><h3>知識を使って、考える。</h3><p>{kosen.length}問を収録。高専入試を意識した問題で実戦力を磨こう。</p><b>高専対策を始める <span>→</span></b></div></a>
  </section>
  <section class="section">
    <div class="section-title"><div><p class="eyebrow">04 / MOCK EXAM</p><h2>過去問で模試</h2><p>国立高専機構の公式過去問で本番形式の演習。</p></div><span class="status active">利用可能</span></div>
    <a class="main-card" href={`${import.meta.env.BASE_URL}study/mock/`}><span class="card-icon">模</span><div><small>OFFICIAL PAST PAPERS</small><h3>高専過去問 模試モード</h3><p>令和8・7年度の公式問題を教科別または5教科で挑戦。制限時間・解答確認に対応。</p><b>模試を始める <span>→</span></b></div></a>
  </section>
  <section class="section">
    <div class="section-title"><div><p class="eyebrow">05 / FOCUS TOOLS</p><h2>学習ツール</h2><p>時間を管理して、集中力を高めよう。</p></div><span class="status active">利用可能</span></div>
    <a class="main-card" href={`${import.meta.env.BASE_URL}study/tools/`}><span class="card-icon">⏱</span><div><small>POMODORO / STOPWATCH</small><h3>ポモドーロタイマー・ストップウォッチ</h3><p>25分集中・5分休憩のタイマーと、ラップ対応のストップウォッチ。</p><b>学習ツールを開く <span>→</span></b></div></a>
  </section>
  <div class="feature-links">
    <a class="why-link" href={`${import.meta.env.BASE_URL}study/why/`}><span><small>WHY WE LEARN / FEATURE</small><strong>なぜ勉強するのか。</strong><em>学ぶ意味と、未来の選択肢について考える</em></span><b>特集を読む ↗</b></a>
    <a class="why-link" href={`${import.meta.env.BASE_URL}study/university/`}><span><small>CAMPUS LIFE / FEATURE</small><strong>もし、あの大学に行ったら。</strong><em>大学ごとのキャンパスライフを想像する</em></span><b>大学特集を見る ↗</b></a>
  </div>
  <p class="back"><a href="../">← KNOTトップへ戻る</a></p>
</main>
<style>
.study-home{max-width:900px;margin:0 auto;padding:40px 0 45px}.intro{padding:10px 0 28px}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800;margin:0 0 12px}.intro h1{font-size:clamp(32px,6vw,52px);font-weight:900;letter-spacing:-.065em;line-height:1.25;margin:0}.intro h1 span{color:var(--accent)}.intro>p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.8}.stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:22px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface)}.stats div{padding:12px 15px;border-right:1px solid var(--line);display:grid;gap:3px}.stats div:last-child{border:0}.stats b{font-size:22px}.stats small{font-size:10px;color:var(--muted)}.section{margin-top:25px}.section-title{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:11px}.section-title .eyebrow{margin:0 0 5px}.section-title h2{font-size:20px;margin:0}.section-title p:last-child{font-size:11px;color:var(--muted);margin:5px 0 0}.status{font-size:9px;font-weight:800;letter-spacing:.08em;padding:7px 9px;border-radius:5px;white-space:nowrap}.active{color:#25895e;background:color-mix(in srgb,#25895e 12%,var(--surface))}.main-card{display:flex;align-items:flex-start;gap:17px;padding:20px;border:1px solid var(--line);border-radius:13px;background:var(--surface);transition:border-color .15s,transform .15s}.main-card:hover{border-color:var(--accent);transform:translateY(-2px)}.card-icon{display:grid;place-items:center;flex:none;width:46px;height:46px;border-radius:11px;background:var(--surface-soft);color:var(--accent);font-size:21px;font-weight:900}.main-card small{font:9px ui-monospace,monospace;color:var(--muted);letter-spacing:.1em}.main-card h3{font-size:19px;margin:6px 0}.main-card p{font-size:12px;line-height:1.8;color:var(--muted);margin:0 0 11px}.main-card b{font-size:11px}.main-card b span{color:var(--accent);margin-left:10px}.feature-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:30px}.why-link{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:0;padding:18px 20px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.why-link span{display:grid;gap:5px}.why-link small{font:9px ui-monospace,monospace;color:var(--accent);letter-spacing:.1em}.why-link strong{font-size:16px}.why-link em{font-size:11px;color:var(--muted);font-style:normal}.why-link>b{font-size:11px;white-space:nowrap;color:var(--accent)}.back{margin-top:25px;font-size:11px;color:var(--muted)}@media(max-width:620px){.feature-links{grid-template-columns:1fr}.study-home{padding:25px 0}.stats div{padding:10px 7px}.stats b{font-size:18px}.section-title h2{font-size:18px}.main-card{padding:16px;gap:12px}.card-icon{width:40px;height:40px}.why-link{align-items:flex-start;flex-direction:column}}
</style>
</Layout>