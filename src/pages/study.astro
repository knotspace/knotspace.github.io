---
import StudyLayout from '../layouts/StudyLayout.astro';
import foundation from '../data/study/study-foundation.json';
import kosen from '../data/study/kosen-questions.json';
import quotes from '../data/study/study-quotes.json';
const science = foundation.filter(q => q.subject === 'science').length;
const social = foundation.filter(q => q.subject === 'social').length;
const fields = [
  { name: '物理', en: 'PHYSICS', href: 'physics', desc: '力・運動・電流・エネルギー', icon: '⚡', group: 'science' },
  { name: '化学', en: 'CHEMISTRY', href: 'chemistry', desc: '物質・化学変化・イオン', icon: '⚗', group: 'science' },
  { name: '生物', en: 'BIOLOGY', href: 'biology', desc: '植物・人体・遺伝・生態系', icon: '⌁', group: 'science' },
  { name: '地学', en: 'EARTH SCIENCE', href: 'earth', desc: '天気・地震・火山・天体', icon: '◉', group: 'science' },
  { name: '地理', en: 'GEOGRAPHY', href: 'geography', desc: '地形・気候・産業・統計', icon: '◎', group: 'social' },
  { name: '歴史', en: 'HISTORY', href: 'history', desc: '古代から現代までの流れ', icon: '⌛', group: 'social' },
  { name: '公民', en: 'CIVICS', href: 'civics', desc: '憲法・政治・経済・国際社会', icon: '§', group: 'social' },
];
---
<StudyLayout title="KNOT Study｜学習ホーム" description="KNOT Study。基礎演習・高専対策・模試・要点まとめをひとつにした学習アプリ。">
<main class="study-dashboard">
  <section class="welcome">
    <div class="welcome-copy"><p class="eyebrow">YOUR DAILY LEARNING</p><p class="date-line" id="today-date">KNOT STUDY</p><h1>今日も、<span>一歩ずつ。</span></h1><p class="welcome-desc">小さな積み重ねが、合格につながる。今日の自分を少しだけ更新しよう。</p><a class="start-button" href="./foundation/">今日の学習を始める <span>→</span></a></div>
    <div class="welcome-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-core">K<span>.</span></div><div class="art-dot dot-one"></div><div class="art-dot dot-two"></div><div class="art-dot dot-three"></div></div>
  </section>

  <section class="daily-quote" id="daily-quote" data-quotes={JSON.stringify(quotes)}>
    <div class="daily-quote-top"><div><p class="eyebrow">WORDS TO KEEP</p><h2>今日のひとこと</h2></div><a href="./quotes/">偉人の名言集を読む <span>↗</span></a></div>
    <blockquote id="daily-quote-text">「学び続けることが、未来を変える。」</blockquote>
    <div class="daily-quote-bottom"><span id="daily-quote-author">KNOT Study</span><button type="button" id="next-quote">別の名言を見る ↻</button></div>
  </section>

  <section class="stats-strip" aria-label="学習問題数">
    <div><small>FOUNDATION</small><strong>{foundation.length.toLocaleString('ja-JP')}</strong><span>基礎問題</span></div>
    <div><small>KO SEN</small><strong>{kosen.length.toLocaleString('ja-JP')}</strong><span>高専対策問題</span></div>
    <div><small>SCIENCE / SOCIAL</small><strong>7</strong><span>学習分野</span></div>
  </section>

  <section class="section-block">
    <div class="section-heading"><div><p class="eyebrow">PICK UP</p><h2>学習メニュー</h2></div><span>今日やることを選ぼう</span></div>
    <div class="menu-grid">
      <a class="menu-card primary-card" href="./foundation/"><span class="menu-icon">✎</span><small>FOUNDATION</small><h3>基礎演習</h3><p>{foundation.length.toLocaleString('ja-JP')}問から、分野を選んでテンポよく解こう。</p><b>演習を始める <i>→</i></b></a>
      <a class="menu-card" href="./kosen/"><span class="menu-icon">⌁</span><small>KO SEN EXAM</small><h3>高専対策</h3><p>{kosen.length.toLocaleString('ja-JP')}問の思考力問題で、入試に向けて鍛える。</p><b>挑戦する <i>→</i></b></a>
      <a class="menu-card" href="./mock/"><span class="menu-icon">▤</span><small>MOCK EXAM</small><h3>過去問模試</h3><p>公式過去問を使って、本番形式で実力を試そう。</p><b>模試を受ける <i>→</i></b></a>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading"><div><p class="eyebrow">SUBJECT LIBRARY</p><h2>分野別要点まとめ</h2></div><a href="./summary/">7分野をすべて見る →</a></div>
    <div class="subject-group"><div class="group-title"><span>SCIENCE</span><h3>理科</h3></div><div class="field-grid">{fields.filter(f=>f.group==='science').map(f=><a class="field-card" href={`./summary/${f.href}/`}><span class="field-icon">{f.icon}</span><span class="field-meta">{f.en}</span><strong>{f.name}</strong><small>{f.desc}</small><b>学習する ↗</b></a>)}</div></div>
    <div class="subject-group"><div class="group-title"><span>SOCIAL STUDIES</span><h3>社会</h3></div><div class="field-grid social-grid">{fields.filter(f=>f.group==='social').map(f=><a class="field-card" href={`./summary/${f.href}/`}><span class="field-icon">{f.icon}</span><span class="field-meta">{f.en}</span><strong>{f.name}</strong><small>{f.desc}</small><b>学習する ↗</b></a>)}</div></div>
  </section>

  <section class="section-block record-block">
    <div class="section-heading"><div><p class="eyebrow">YOUR RECORD</p><h2>学習の記録</h2></div></div>
    <div class="record-grid"><div><small>累計回答数</small><strong id="record-answered">0</strong><span>問</span></div><div><small>正答率</small><strong id="record-accuracy">—</strong><span>%</span></div><div><small>復習したい問題</small><strong id="record-weak">0</strong><span>問</span></div></div>
    <p class="record-note" id="record-note">まずは基礎演習を10問。解いた分だけ、ここに記録されるよ。</p>
  </section>

  <section class="bottom-tools"><a href="./tools/"><span>◷</span><div><strong>集中タイマー・学習ログ</strong><small>時間を計って学習習慣をつくる</small></div><b>→</b></a><a href="./why/"><span>✦</span><div><strong>学ぶ理由と、その先の大学生活</strong><small>勉強する意味から大学での毎日を想像する</small></div><b>→</b></a></section>
  <footer class="dashboard-footer"><a href="../">KNOT本体へ戻る ↗</a><span>KNOT STUDY · KEEP LEARNING</span></footer>
</main>
<script>
const quoteBox=document.getElementById('daily-quote');
if(quoteBox){
 try{
  const pool=JSON.parse(quoteBox.dataset.quotes||'[]');
  const showQuote=()=>{
   if(!pool.length)return;
   const quote=pool[Math.floor(Math.random()*pool.length)];
   document.getElementById('daily-quote-text').textContent='「'+quote.text+'」';
   document.getElementById('daily-quote-author').textContent=quote.name+' · '+quote.era;
  };
  showQuote();
  document.getElementById('next-quote')?.addEventListener('click',showQuote);
 }catch{}
}
const dateEl=document.getElementById('today-date');
if(dateEl)dateEl.textContent=new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric',weekday:'long'}).format(new Date());
try{
 const readRecord = key => {
  try {
   const value = JSON.parse(localStorage.getItem(key) || 'null') || {};
   return {
    answered: Number.isFinite(value.answered) ? value.answered : 0,
    correct: Number.isFinite(value.correct) ? value.correct : 0,
    wrong: Array.isArray(value.wrong) ? value.wrong.filter(id => typeof id === 'string') : []
   };
  } catch { return { answered: 0, correct: 0, wrong: [] }; }
 };
 const foundationRecord = readRecord('knot-foundation-v1');
 const kosenRecord = readRecord('knot-kosen-record-v1');
 const answered = foundationRecord.answered + kosenRecord.answered;
 const correct = foundationRecord.correct + kosenRecord.correct;
 const wrong = new Set([...foundationRecord.wrong, ...kosenRecord.wrong]).size;
 document.getElementById('record-answered').textContent = answered.toLocaleString('ja-JP');
 document.getElementById('record-accuracy').textContent = answered ? Math.round(correct / answered * 100) : '—';
 document.getElementById('record-weak').textContent = wrong.toLocaleString('ja-JP');
 document.getElementById('record-note').textContent = answered
  ? `基礎演習と高専対策で合計${answered}問に挑戦。苦手な問題を復習していこう。`
  : 'まずは基礎演習か高専対策を10問。解いた分だけ、ここに記録されるよ。';
}catch{}
</script>
<style>
.daily-quote{margin:0 0 24px;padding:19px 23px;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:15px;background:var(--surface)}.daily-quote-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.daily-quote-top .eyebrow{margin-bottom:4px}.daily-quote-top h2{font-size:16px;margin:0;letter-spacing:-.03em}.daily-quote-top>a{font-size:10px;color:var(--accent);font-weight:800}.daily-quote-top>a span{margin-left:5px}.daily-quote blockquote{font-size:clamp(17px,2.5vw,22px);font-weight:800;line-height:1.7;letter-spacing:-.03em;margin:18px 0 13px}.daily-quote-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px}.daily-quote-bottom>span{font-size:10px;color:var(--muted)}.daily-quote-bottom button{border:0;background:var(--surface-soft);color:var(--text);border-radius:8px;padding:8px 11px;font:inherit;font-size:10px;cursor:pointer}.daily-quote-bottom button:hover{color:var(--accent)}
.study-dashboard{width:min(100%,1080px);margin:0 auto;padding:27px 0 34px}.eyebrow{font:9px ui-monospace,monospace;letter-spacing:.17em;color:var(--accent);font-weight:850;margin:0 0 10px}.welcome{position:relative;display:flex;align-items:center;justify-content:space-between;min-height:260px;overflow:hidden;padding:34px 40px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(115deg,color-mix(in srgb,var(--accent) 13%,var(--surface)),var(--surface) 65%)}.welcome-copy{position:relative;z-index:2;max-width:590px}.date-line{font-size:10px;color:var(--muted);letter-spacing:.08em;margin:0 0 8px}.welcome h1{font-size:clamp(34px,5vw,52px);line-height:1.15;letter-spacing:-.07em;margin:0}.welcome h1 span{color:var(--accent)}.welcome-desc{max-width:450px;color:var(--muted);font-size:12px;line-height:1.9;margin:13px 0 20px}.start-button{display:inline-flex;align-items:center;gap:22px;padding:13px 17px;border-radius:10px;background:var(--accent);color:#071426;font-size:12px;font-weight:900;box-shadow:0 7px 20px color-mix(in srgb,var(--accent) 22%,transparent)}.start-button span{font-size:17px}.welcome-art{position:absolute;right:55px;top:50%;width:220px;height:220px;transform:translateY(-50%);display:grid;place-items:center;opacity:.9}.orbit{position:absolute;border:1px solid color-mix(in srgb,var(--accent) 35%,transparent);border-radius:50%}.orbit-one{inset:12px}.orbit-two{inset:37px;border-style:dashed}.art-core{display:grid;place-items:center;width:100px;height:100px;border-radius:28px;background:linear-gradient(145deg,var(--accent),color-mix(in srgb,var(--accent) 45%,#10213b));color:#071426;font-size:58px;font-weight:950;letter-spacing:-.1em;box-shadow:0 15px 45px color-mix(in srgb,var(--accent) 30%,transparent)}.art-core span{color:#fff}.art-dot{position:absolute;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 18px var(--accent)}.dot-one{top:22px;left:54px}.dot-two{right:12px;top:90px;width:8px;height:8px}.dot-three{bottom:18px;left:94px;width:7px;height:7px}.stats-strip{display:grid;grid-template-columns:repeat(3,1fr);margin:15px 0 35px;border:1px solid var(--line);border-radius:14px;background:var(--surface);overflow:hidden}.stats-strip>div{display:grid;gap:3px;padding:13px 19px;border-right:1px solid var(--line)}.stats-strip>div:last-child{border:0}.stats-strip small,.record-grid small{font:8px ui-monospace,monospace;letter-spacing:.1em;color:var(--muted)}.stats-strip strong{font-size:22px;letter-spacing:-.04em}.stats-strip span{font-size:10px;color:var(--muted)}.section-block{margin:31px 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:14px}.section-heading .eyebrow{margin-bottom:5px}.section-heading h2{font-size:21px;letter-spacing:-.04em;margin:0}.section-heading>span,.section-heading>a{font-size:10px;color:var(--muted)}.menu-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}.menu-card{display:flex;flex-direction:column;min-height:205px;padding:17px;border:1px solid var(--line);border-radius:14px;background:var(--surface);transition:transform .16s,border-color .16s}.menu-card:hover,.field-card:hover{transform:translateY(-3px);border-color:var(--accent)}.menu-card.primary-card{background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 12%,var(--surface)),var(--surface))}.menu-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--surface-soft);color:var(--accent);font-size:18px;margin-bottom:14px}.menu-card>small{font:8px ui-monospace,monospace;letter-spacing:.12em;color:var(--muted)}.menu-card h3{font-size:17px;margin:5px 0}.menu-card p{font-size:10px;line-height:1.75;color:var(--muted);margin:0 0 15px}.menu-card>b{display:flex;justify-content:space-between;margin-top:auto;font-size:10px;color:var(--accent)}.menu-card i{font-style:normal;font-size:15px}.subject-group{margin:18px 0 25px}.group-title{display:flex;align-items:baseline;gap:11px;margin-bottom:10px}.group-title span{font:8px ui-monospace,monospace;letter-spacing:.15em;color:var(--accent)}.group-title h3{font-size:14px;margin:0}.field-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.social-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.field-card{display:grid;grid-template-columns:auto 1fr;column-gap:10px;align-items:center;padding:13px;border:1px solid var(--line);border-radius:12px;background:var(--surface);transition:transform .16s,border-color .16s}.field-icon{grid-row:span 2;display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:var(--surface-soft);color:var(--accent);font-size:18px}.field-meta{font:7px ui-monospace,monospace;letter-spacing:.08em;color:var(--muted)}.field-card strong{font-size:14px}.field-card small{grid-column:1/-1;font-size:9px;color:var(--muted);margin:10px 0}.field-card b{grid-column:1/-1;font-size:9px;color:var(--accent);font-weight:750}.record-block{padding:18px;border:1px solid var(--line);border-radius:15px;background:var(--surface)}.record-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.record-grid>div{display:flex;align-items:baseline;gap:5px;padding:13px;border-radius:10px;background:var(--surface-soft)}.record-grid small{display:block;width:100%;font:9px system-ui;color:var(--muted)}.record-grid strong{font-size:24px;letter-spacing:-.05em}.record-grid span{font-size:10px;color:var(--muted)}.record-note{font-size:10px;color:var(--muted);margin:12px 2px 0}.bottom-tools{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0}.bottom-tools>a{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.bottom-tools>a>span{font-size:20px;color:var(--accent)}.bottom-tools>a div{display:grid;gap:4px;flex:1}.bottom-tools strong{font-size:11px}.bottom-tools small{font-size:9px;color:var(--muted)}.bottom-tools b{color:var(--accent)}.dashboard-footer{display:flex;justify-content:space-between;padding:18px 2px 5px;border-top:1px solid var(--line);font-size:9px;color:var(--muted)}.dashboard-footer a{color:var(--accent)}.dashboard-footer span{font:8px ui-monospace,monospace;letter-spacing:.1em}@media(max-width:850px){.menu-grid{grid-template-columns:repeat(2,1fr)}.field-grid{grid-template-columns:repeat(2,1fr)}.social-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:600px){.study-dashboard{padding:15px 0 22px}.welcome{min-height:235px;padding:24px 20px}.welcome-art{right:-75px;opacity:.28}.welcome h1{font-size:36px}.welcome-desc{max-width:280px}.stats-strip>div{padding:11px 9px}.stats-strip strong{font-size:18px}.stats-strip small{font-size:7px}.menu-grid{gap:8px}.menu-card{min-height:185px;padding:13px}.menu-card h3{font-size:15px}.field-grid,.social-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.record-block{padding:13px}.record-grid{gap:5px}.record-grid>div{display:block;padding:10px 8px}.record-grid strong{font-size:21px}.bottom-tools{grid-template-columns:1fr}.dashboard-footer{gap:10px;flex-wrap:wrap}.section-heading h2{font-size:19px}}
</style>
</StudyLayout>