---
import Layout from '../layouts/Layout.astro';
import foundation from '../data/study-foundation.json';
import quotes from '../data/study-quotes.json';
const science = foundation.filter(q => q.subject === 'science').length;
const social = foundation.filter(q => q.subject === 'social').length;
---
<Layout title="Study｜KNOT" description="教科書の基礎を網羅し、学びを積み上げるKNOTの学習スペース。">
<main class="study-home">
  <div class="beta-notice"><span>β</span><div><strong>Study は現在 β版です</strong><p>機能・問題・表示内容は開発中です。問題数や採点機能は順次拡張します。</p></div></div>
  <header class="intro">
    <p class="eyebrow">KNOT / LEARNING SPACE</p>
    <h1>理科と社会、<span>ここで練習</span>しよう。</h1>
    <p>理科と社会の大事なところを、ここで一緒に確認しよう。</p>
    <div class="stats"><div><b>{foundation.length}</b><small>基礎問題</small></div><div><b>{science}</b><small>理科</small></div><div><b>{social}</b><small>社会</small></div><div><b>7</b><small>分野</small></div></div>
  </header>

  <section class="why-study" aria-labelledby="why-study-title">
    <p class="eyebrow">WHY WE LEARN / 学ぶ理由</p>
    <h2 id="why-study-title">勉強は、<span>未来の選択肢</span>を増やすためにある。</h2>
    <p class="why-lead">勉強する意味は、テストでいい点を取ることだけじゃない。<br>自分の人生を、自分で選べるようにすることだ。</p>
    <div class="why-grid">
      <article><span class="why-no">01</span><h3>将来の選択肢が増える</h3><p>行きたい高校・大学、学びたい分野、就きたい仕事。今の勉強が、未来に選べる道を増やしてくれる。知らなかった進路を知ったとき、「自分には無理」と最初から諦めずに済む。選択肢を持っていることは、人生の大きな強みになる。</p></article>
      <article><span class="why-no">02</span><h3>「なりたい自分」に近づける</h3><p>情報、科学、医療、ものづくり、法律、経済。どんな分野に進むとしても、基礎になる知識や考える力が必要になる。今すぐ夢が決まっていなくても大丈夫。学んでおけば、あとから興味を持った道へ進みやすくなる。</p></article>
      <article><span class="why-no">03</span><h3>自分の頭で判断できる</h3><p>数学は筋道を立てる力、国語は言葉を正確に読み取る力、理科と社会は世界の仕組みを理解する力につながる。情報があふれる時代だからこそ、根拠を確かめ、誰かの意見をそのまま信じず、自分で考えて決める力が大切になる。</p></article>
      <article><span class="why-no">04</span><h3>努力が自信に変わる</h3><p>昨日は解けなかった問題が、今日は解ける。何度も間違えた単元が、少しずつわかる。その積み重ねは「自分は成長できる」という実感になる。自信は最初からあるものじゃない。小さな達成を重ねて、自分でつくっていくものだ。</p></article>
      <article><span class="why-no">05</span><h3>挑戦できる場所が広がる</h3><p>学力は、受験だけでなく、資格、研究、コンテスト、新しい技術への挑戦にもつながる。基礎が身についていれば、難しいことに出会ったときも理解する土台がある。できることが増えるほど、挑戦できる場所も増えていく。</p></article>
      <article><span class="why-no">06</span><h3>未来の自分に投資できる</h3><p>勉強の成果は、すぐに目に見えるとは限らない。でも、今日覚えた知識や解けるようになった問題は、あとで別の学びと結びつくことがある。今の努力が、数か月後・数年後の自分を助ける。学びは、自分自身に積み立てていく財産だ。</p></article>
    </div>
    <div class="why-reality"><strong>ただし、勉強だけが人生のすべてじゃない。</strong><p>休むことも、遊ぶことも、人と話すことも大切。勉強は自分を追い詰めるためではなく、自分の可能性を広げるためにするもの。完璧を目指さなくていい。昨日より一問多く解く、十分だけ集中する。その一歩でいい。</p></div>
    <div class="why-call"><p>未来の自分に、選べる道を残そう。</p><strong>今日の一問が、いつか大きな選択肢になる。</strong></div>
  </section>

  <section class="section">
    <div class="section-title"><div><p class="eyebrow">01 / FOUNDATION</p><h2>基礎網羅問題</h2><p>教科書に出てくる大事な語句や基本を、分野ごとにチェック。</p></div><span class="status active">公開中</span></div>
    <a class="main-card" href="foundation/"><span class="card-icon">基</span><div><small>FOUNDATION PRACTICE</small><h3>まずは基本から確認しよう。</h3><p>理科4分野・社会3分野を収録。間違えた問題はあとから復習できるよ。</p><b>学習を始める <span>→</span></b></div></a>
  </section>

  <section class="section">
    <div class="section-title"><div><p class="eyebrow">02 / KO SEN EXAM</p><h2>高専入試特化</h2><p>高専入試の出題傾向を意識した、資料読解・思考力型の演習。</p></div><span class="status active">公開開始</span></div>
    <a class="main-card" href="kosen/"><span class="card-icon">専</span><div><small>EXAM PREPARATION</small><h3>高専入試の対策問題</h3><p>オリジナル問題で実戦演習。まずは社会の資料読解・地理・歴史から挑戦しよう。</p><b>高専対策を始める <span>→</span></b></div></a>
  </section>


  <section class="section">
    <div class="section-title"><div><p class="eyebrow">03 / MOCK EXAM</p><h2>過去問で模試</h2><p>国立高専機構が公開している過去問を使って、本番形式で挑戦。</p></div><span class="status active">利用可能</span></div>
    <a class="main-card" href="mock/"><span class="card-icon">模</span><div><small>OFFICIAL PAST PAPERS</small><h3>高専過去問 模試モード</h3><p>令和8・7年度の公式問題を教科別または5教科で演習。制限時間・解答確認にも対応。</p><b>模試を始める <span>→</span></b></div></a>
  </section>
  <section class="daily-quote" aria-live="polite">
    <p class="eyebrow">A LITTLE INSPIRATION</p>
    <p class="daily-quote-label">今日のひとこと</p>
    <blockquote id="daily-quote-text">「{quotes[0].text}」</blockquote>
    <p class="daily-quote-author" id="daily-quote-author">— {quotes[0].name} / {quotes[0].era}</p>
    <p class="daily-quote-note" id="daily-quote-note"></p>
    <a href="quotes/">ほかの名言も見る <span>↗</span></a>
  </section>
  <section class="notification-card">
    <div><p class="eyebrow">STUDY REMINDER</p><h2>KNOTからのお知らせ</h2><p id="notification-status">通知を許可すると、このブラウザで学習リマインダーを表示できるよ。</p></div>
    <div class="reminder-settings"><label><input type="checkbox" id="reminder-morning" /> 朝 <input type="time" id="time-morning" value="07:00" /></label><label><input type="checkbox" id="reminder-noon" /> 昼 <input type="time" id="time-noon" value="12:30" /></label><label><input type="checkbox" id="reminder-evening" /> 夜 <input type="time" id="time-evening" value="19:00" /></label><div class="notification-actions"><button id="enable-notifications" type="button">通知を許可する</button><button id="save-reminders" type="button">設定を保存</button><button id="test-notification" type="button" hidden>テスト通知</button></div></div>
  </section>
  <p class="back"><a href="../">← KNOTトップへ戻る</a></p>
</main>
<style>
.notification-card{margin-top:20px;padding:21px;border:1px solid var(--line);border-radius:13px;background:var(--surface);display:flex;align-items:center;justify-content:space-between;gap:18px}
.notification-card .eyebrow{margin:0 0 7px}.notification-card h2{font-size:17px;margin:0 0 6px}.notification-card p:not(.eyebrow){font-size:11px;line-height:1.7;color:var(--muted);margin:0;max-width:500px}
.reminder-settings{display:grid;gap:9px;min-width:240px}.reminder-settings>label{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--text)}.reminder-settings input[type=time]{margin-left:auto;padding:7px;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--text)}.notification-actions{display:flex;gap:8px;flex-wrap:wrap}.notification-actions button{border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;cursor:pointer}.notification-actions button[hidden]{display:none}
@media(max-width:620px){.notification-card{align-items:flex-start;flex-direction:column}.notification-actions{width:100%}}

.beta-notice{display:flex;gap:12px;align-items:center;margin:0 0 22px;padding:13px 15px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.beta-notice>span{display:grid;place-items:center;width:30px;height:30px;border-radius:8px;background:var(--accent);color:#fff;font-size:11px;font-weight:900}.beta-notice strong{font-size:12px}.beta-notice p{font-size:10px;color:var(--muted);margin:3px 0 0;line-height:1.6}.study-home{max-width:900px;margin:0 auto;padding:40px 0 35px}.intro{padding:10px 0 35px}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800;margin:0 0 12px}.intro h1{font-size:clamp(34px,6vw,54px);font-weight:900;letter-spacing:-.065em;margin:0}.intro h1 span{color:var(--accent)}.intro>p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.8}.stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:25px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface)}.stats div{padding:13px 17px;border-right:1px solid var(--line);display:grid;gap:3px}.stats div:last-child{border:0}.stats b{font-size:23px}.stats small{font-size:10px;color:var(--muted)}.section{margin-top:34px}.section-title{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:13px}.section-title .eyebrow{margin:0 0 5px}.section-title h2{font-size:21px;margin:0}.section-title p:last-child{font-size:11px;color:var(--muted);margin:5px 0 0}.status{font-size:9px;font-weight:800;letter-spacing:.08em;padding:7px 9px;border-radius:5px;white-space:nowrap}.active{color:#25895e;background:color-mix(in srgb,#25895e 12%,var(--surface))}.soon{color:var(--muted);border:1px solid var(--line)}.main-card,.soon-card{display:flex;align-items:flex-start;gap:18px;padding:23px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.main-card{transition:border-color .15s,transform .15s}.main-card:hover{border-color:var(--accent);transform:translateY(-2px)}.card-icon{display:grid;place-items:center;flex:none;width:48px;height:48px;border-radius:11px;background:var(--surface-soft);color:var(--accent);font-size:21px;font-weight:900}.main-card small,.soon-card small{font:9px ui-monospace,monospace;color:var(--muted);letter-spacing:.1em}.main-card h3,.soon-card h3{font-size:20px;margin:6px 0}.main-card p,.soon-card p{font-size:12px;line-height:1.8;color:var(--muted);margin:0 0 13px}.main-card b{font-size:11px}.main-card b span,.quote-banner a span{color:var(--accent);margin-left:10px}.soon-card{background:var(--surface-soft);opacity:.85}.soon-label{display:inline-block;font:9px ui-monospace,monospace;letter-spacing:.1em;color:var(--muted);border:1px solid var(--line);padding:6px 8px;border-radius:4px}.daily-quote{margin-top:42px;padding:24px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.daily-quote .eyebrow{margin:0 0 12px}.daily-quote-label{font-size:11px;color:var(--muted);margin:0 0 8px}.daily-quote blockquote{font-size:clamp(19px,3.5vw,27px);font-weight:800;line-height:1.7;letter-spacing:-.03em;margin:0 0 12px}.daily-quote-author{font-size:12px;font-weight:750;margin:0 0 5px}.daily-quote-note{font-size:11px;line-height:1.7;color:var(--muted);margin:0 0 15px}.daily-quote>a{font-size:11px;font-weight:750}.daily-quote>a span{color:var(--accent);margin-left:8px}.back{margin-top:30px;font-size:11px;color:var(--muted)}@media(max-width:620px){.study-home{padding:25px 0}.stats div{padding:11px 8px}.stats b{font-size:19px}.section-title h2{font-size:18px}.main-card,.soon-card{padding:17px;gap:12px}.card-icon{width:40px;height:40px}.daily-quote{padding:19px}}

.why-study{margin:28px 0 42px;padding:clamp(20px,4vw,34px);border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,var(--surface),var(--surface-soft))}
.why-study>.eyebrow{margin:0 0 10px}.why-study>h2{font-size:clamp(25px,4.5vw,38px);line-height:1.35;letter-spacing:-.045em;margin:0}.why-study>h2 span{color:var(--accent)}.why-lead{font-size:14px;font-weight:750;line-height:1.9;margin:13px 0 24px}
.why-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.why-grid article{padding:17px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}.why-no{font:10px ui-monospace,monospace;color:var(--accent);font-weight:900;letter-spacing:.12em}.why-grid h3{font-size:15px;margin:7px 0}.why-grid p,.why-reality p{font-size:11px;line-height:1.95;color:var(--muted);margin:0}
.why-reality{margin-top:13px;padding:16px;border-left:3px solid var(--accent);background:var(--surface)}.why-reality strong{display:block;font-size:12px;margin-bottom:6px}.why-call{text-align:center;padding:24px 12px 4px}.why-call p{font-size:12px;color:var(--muted);margin:0 0 5px}.why-call strong{font-size:clamp(17px,3vw,23px);letter-spacing:-.03em}
@media(max-width:620px){.why-grid{grid-template-columns:1fr}.why-grid article{padding:15px}.why-lead{font-size:12px}}
</style>
<script>
  const enableNotifications = document.getElementById('enable-notifications');
  const testNotification = document.getElementById('test-notification');
  const notificationStatus = document.getElementById('notification-status');
  const updateNotificationUi = () => {
    if (!('Notification' in window)) {
      notificationStatus.textContent = 'このブラウザは通知に対応していないよ。';
      enableNotifications.disabled = true;
      return;
    }
    if (Notification.permission === 'granted') {
      notificationStatus.textContent = 'このブラウザで通知を受け取れる設定になっているよ。';
      enableNotifications.hidden = true;
      testNotification.hidden = false;
    } else if (Notification.permission === 'denied') {
      notificationStatus.textContent = '通知はブロック中。ブラウザのサイト設定から許可してね。';
      enableNotifications.disabled = true;
    }
  };
  updateNotificationUi();
  enableNotifications?.addEventListener('click', async () => {
    if (!('Notification' in window)) return;
    const permission = await Notification.requestPermission();
    updateNotificationUi();
    if (permission === 'granted') notificationStatus.textContent = '通知を許可したよ。テスト通知で表示を確認できるよ。';
  });
  testNotification?.addEventListener('click', async () => {
    if (Notification.permission !== 'granted') return;
    try {
      const registration = await navigator.serviceWorker?.ready;
      if (registration) await registration.showNotification('KNOT Study', { body: '通知が届いたよ！学習を少しずつ進めよう。', icon: '/favicon.svg', badge: '/favicon.svg' });
      else new Notification('KNOT Study', { body: '通知が届いたよ！学習を少しずつ進めよう。' });
      notificationStatus.textContent = 'テスト通知を送ったよ。';
    } catch { notificationStatus.textContent = '通知を表示できなかったよ。ブラウザの設定を確認してね。'; }
  });
</script>
<script define:vars={{ quotes }}>
  const quote = quotes[Math.floor(Math.random() * quotes.length)];
  document.getElementById('daily-quote-text').textContent = `「${quote.text}」`;
  document.getElementById('daily-quote-author').textContent = `— ${quote.name} / ${quote.era}`;
  document.getElementById('daily-quote-note').textContent = quote.note;
</script>
<script>
(() => {
  const enableNotifications=document.getElementById('enable-notifications');
  const testNotification=document.getElementById('test-notification');
  const saveButton=document.getElementById('save-reminders');
  const status=document.getElementById('notification-status');
  const slots=['morning','noon','evening'];
  const defaults={morning:{enabled:false,time:'07:00'},noon:{enabled:false,time:'12:30'},evening:{enabled:false,time:'19:00'}};
  let settings=defaults;
  try{const saved=JSON.parse(localStorage.getItem('knot-study-reminders')||'null');if(saved)settings={...defaults,...saved};}catch{}
  function apply(){slots.forEach(slot=>{document.getElementById('reminder-'+slot).checked=!!settings[slot].enabled;document.getElementById('time-'+slot).value=settings[slot].time||defaults[slot].time;});}
  function read(){const next={};slots.forEach(slot=>next[slot]={enabled:document.getElementById('reminder-'+slot).checked,time:document.getElementById('time-'+slot).value||defaults[slot].time});return next;}
  function update(){if(!('Notification'in window)){status.textContent='このブラウザは通知に対応していません。';enableNotifications.disabled=true;return;}if(Notification.permission==='granted'){enableNotifications.hidden=true;testNotification.hidden=false;status.textContent='通知許可済み。設定した時刻に、このStudyページを開いている間リマインダーを表示します。';}else if(Notification.permission==='denied'){status.textContent='通知がブロックされています。ブラウザのサイト設定から許可してください。';enableNotifications.disabled=true;}else{status.textContent='朝・昼・夜の時刻を設定し、通知を許可してください。';}}
  async function notify(title,body){const reg=await navigator.serviceWorker.ready;await reg.showNotification(title,{body,icon:'/favicon.svg',badge:'/favicon.svg',tag:'knot-study-'+title,renotify:false});}
  function scheduleCheck(){if(Notification.permission!=='granted')return;const now=new Date(),date=[now.getFullYear(),String(now.getMonth()+1).padStart(2,'0'),String(now.getDate()).padStart(2,'0')].join('-'),clock=String(now.getHours()).padStart(2,'0')+':'+String(now.getMinutes()).padStart(2,'0');slots.forEach(slot=>{const item=settings[slot],key='knot-reminder-sent-'+date+'-'+slot;if(item.enabled&&item.time===clock&&localStorage.getItem(key)!=='1'){localStorage.setItem(key,'1');notify('KNOT Study',({morning:'おはよう！今日の学習を始めよう。',noon:'お昼の学習リマインダーだよ。少しだけ進めよう！',evening:'今日の学習を振り返って、あと少し頑張ろう！'})[slot]).catch(()=>{});}});}
  apply();update();
  enableNotifications.addEventListener('click',async()=>{const permission=await Notification.requestPermission();update();if(permission==='granted')status.textContent='通知を許可しました。朝・昼・夜の設定を保存してね。';});
  saveButton.addEventListener('click',()=>{settings=read();localStorage.setItem('knot-study-reminders',JSON.stringify(settings));status.textContent='朝・昼・夜の設定を保存しました。ページを開いている間、設定時刻に通知します。';scheduleCheck();});
  testNotification.addEventListener('click',async()=>{try{await notify('KNOT Study テスト','テスト通知が届いたよ！');status.textContent='テスト通知を表示しました。';}catch{status.textContent='通知を表示できませんでした。ブラウザの設定を確認してください。';}});
  scheduleCheck();setInterval(scheduleCheck,15000);document.addEventListener('visibilitychange',()=>{if(!document.hidden)scheduleCheck();});
})();
</script>
<script define:vars={{ quotes }}>
  const quote = quotes[Math.floor(Math.random() * quotes.length)];
  document.getElementById('daily-quote-text').textContent = `「${quote.text}」`;
  document.getElementById('daily-quote-author').textContent = `— ${quote.name} / ${quote.era}`;
  document.getElementById('daily-quote-note').textContent = quote.note;
</script>
</Layout>