---
import Layout from '../layouts/Layout.astro';
import foundation from '../data/study-foundation.json';
import quotes from '../data/study-quotes.json';
const science = foundation.filter(q => q.subject === 'science').length;
const social = foundation.filter(q => q.subject === 'social').length;
---
<Layout title="Study｜KNOT" description="教科書の基礎を網羅し、学びを積み上げるKNOTの学習スペース。">
<main class="study-home">
  <header class="intro">
    <p class="eyebrow">KNOT / LEARNING SPACE</p>
    <h1>理科と社会、<span>ここで練習</span>しよう。</h1>
    <p>理科と社会の大事なところを、ここで一緒に確認しよう。</p>
    <div class="stats"><div><b>{foundation.length}</b><small>基礎問題</small></div><div><b>{science}</b><small>理科</small></div><div><b>{social}</b><small>社会</small></div><div><b>7</b><small>分野</small></div></div>
  </header>

  <section class="section">
    <div class="section-title"><div><p class="eyebrow">01 / FOUNDATION</p><h2>基礎網羅問題</h2><p>教科書に出てくる大事な語句や基本を、分野ごとにチェック。</p></div><span class="status active">公開中</span></div>
    <a class="main-card" href="foundation/"><span class="card-icon">基</span><div><small>FOUNDATION PRACTICE</small><h3>まずは基本から確認しよう。</h3><p>理科4分野・社会3分野を収録。間違えた問題はあとから復習できるよ。</p><b>学習を始める <span>→</span></b></div></a>
  </section>

  <section class="section">
    <div class="section-title"><div><p class="eyebrow">02 / KO SEN EXAM</p><h2>高専入試特化</h2><p>高専入試向けの問題は、ただいま準備中。</p></div><span class="status soon">COMING SOON</span></div>
    <div class="soon-card"><span class="card-icon">専</span><div><small>EXAM PREPARATION</small><h3>高専入試の対策問題を準備中！</h3><p>公開までもう少し待ってね。今は基礎網羅問題に取り組もう。</p><span class="soon-label">COMING SOON</span></div></div>
  </section>

  <section class="daily-quote" aria-live="polite">
    <p class="eyebrow">A LITTLE INSPIRATION</p>
    <p class="daily-quote-label">今日のひとこと</p>
    <blockquote id="daily-quote-text">「{quotes[0].text}」</blockquote>
    <p class="daily-quote-author" id="daily-quote-author">— {quotes[0].name} / {quotes[0].era}</p>
    <p class="daily-quote-note" id="daily-quote-note"></p>
    <a href="quotes/">ほかの名言も見る <span>↗</span></a>
  </section>
  <section class="notification-card">
    <div><p class="eyebrow">STUDY REMINDER</p><h2>KNOTからのお知らせ</h2><p id="notification-status">通知を許可すると、このブラウザで学習リマインダーを表示できるよ。</p></div>
    <div class="notification-actions"><button id="enable-notifications" type="button">通知を有効にする</button><button id="test-notification" type="button" hidden>テスト通知</button></div>
  </section>
  <p class="back"><a href="../">← KNOTトップへ戻る</a></p>
</main>
<style>
.notification-card{margin-top:20px;padding:21px;border:1px solid var(--line);border-radius:13px;background:var(--surface);display:flex;align-items:center;justify-content:space-between;gap:18px}
.notification-card .eyebrow{margin:0 0 7px}.notification-card h2{font-size:17px;margin:0 0 6px}.notification-card p:not(.eyebrow){font-size:11px;line-height:1.7;color:var(--muted);margin:0;max-width:500px}
.notification-actions{display:flex;gap:8px;flex-wrap:wrap}.notification-actions button{border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;cursor:pointer}.notification-actions button[hidden]{display:none}
@media(max-width:620px){.notification-card{align-items:flex-start;flex-direction:column}.notification-actions{width:100%}}
</style>

.study-home{max-width:900px;margin:0 auto;padding:40px 0 35px}.intro{padding:10px 0 35px}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800;margin:0 0 12px}.intro h1{font-size:clamp(34px,6vw,54px);font-weight:900;letter-spacing:-.065em;margin:0}.intro h1 span{color:var(--accent)}.intro>p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.8}.stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:25px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface)}.stats div{padding:13px 17px;border-right:1px solid var(--line);display:grid;gap:3px}.stats div:last-child{border:0}.stats b{font-size:23px}.stats small{font-size:10px;color:var(--muted)}.section{margin-top:34px}.section-title{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:13px}.section-title .eyebrow{margin:0 0 5px}.section-title h2{font-size:21px;margin:0}.section-title p:last-child{font-size:11px;color:var(--muted);margin:5px 0 0}.status{font-size:9px;font-weight:800;letter-spacing:.08em;padding:7px 9px;border-radius:5px;white-space:nowrap}.active{color:#25895e;background:color-mix(in srgb,#25895e 12%,var(--surface))}.soon{color:var(--muted);border:1px solid var(--line)}.main-card,.soon-card{display:flex;align-items:flex-start;gap:18px;padding:23px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.main-card{transition:border-color .15s,transform .15s}.main-card:hover{border-color:var(--accent);transform:translateY(-2px)}.card-icon{display:grid;place-items:center;flex:none;width:48px;height:48px;border-radius:11px;background:var(--surface-soft);color:var(--accent);font-size:21px;font-weight:900}.main-card small,.soon-card small{font:9px ui-monospace,monospace;color:var(--muted);letter-spacing:.1em}.main-card h3,.soon-card h3{font-size:20px;margin:6px 0}.main-card p,.soon-card p{font-size:12px;line-height:1.8;color:var(--muted);margin:0 0 13px}.main-card b{font-size:11px}.main-card b span,.quote-banner a span{color:var(--accent);margin-left:10px}.soon-card{background:var(--surface-soft);opacity:.85}.soon-label{display:inline-block;font:9px ui-monospace,monospace;letter-spacing:.1em;color:var(--muted);border:1px solid var(--line);padding:6px 8px;border-radius:4px}.daily-quote{margin-top:42px;padding:24px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.daily-quote .eyebrow{margin:0 0 12px}.daily-quote-label{font-size:11px;color:var(--muted);margin:0 0 8px}.daily-quote blockquote{font-size:clamp(19px,3.5vw,27px);font-weight:800;line-height:1.7;letter-spacing:-.03em;margin:0 0 12px}.daily-quote-author{font-size:12px;font-weight:750;margin:0 0 5px}.daily-quote-note{font-size:11px;line-height:1.7;color:var(--muted);margin:0 0 15px}.daily-quote>a{font-size:11px;font-weight:750}.daily-quote>a span{color:var(--accent);margin-left:8px}.back{margin-top:30px;font-size:11px;color:var(--muted)}@media(max-width:620px){.study-home{padding:25px 0}.stats div{padding:11px 8px}.stats b{font-size:19px}.section-title h2{font-size:18px}.main-card,.soon-card{padding:17px;gap:12px}.card-icon{width:40px;height:40px}.daily-quote{padding:19px}}
</style>
<script>
  const enableNotifications = document.getElementById('enable-notifications');
  const testNotification = document.getElementById('test-notification');
  const notificationStatus = document.getElementById('notification-status');
  const updateNotificationUi = () => {
    if (!('Notification' in window)) {
      notificationStatus.textContent = 'このブラウザは通知に対応していないよ。';
      enableNotifications.disabled = true;
      return;
    }
    if (Notification.permission === 'granted') {
      notificationStatus.textContent = 'このブラウザで通知を受け取れる設定になっているよ。';
      enableNotifications.hidden = true;
      testNotification.hidden = false;
    } else if (Notification.permission === 'denied') {
      notificationStatus.textContent = '通知はブロック中。ブラウザのサイト設定から許可してね。';
      enableNotifications.disabled = true;
    }
  };
  updateNotificationUi();
  enableNotifications?.addEventListener('click', async () => {
    if (!('Notification' in window)) return;
    const permission = await Notification.requestPermission();
    updateNotificationUi();
    if (permission === 'granted') notificationStatus.textContent = '通知を許可したよ。テスト通知で表示を確認できるよ。';
  });
  testNotification?.addEventListener('click', async () => {
    if (Notification.permission !== 'granted') return;
    try {
      const registration = await navigator.serviceWorker?.ready;
      if (registration) await registration.showNotification('KNOT Study', { body: '通知が届いたよ！学習を少しずつ進めよう。', icon: '/favicon.svg', badge: '/favicon.svg' });
      else new Notification('KNOT Study', { body: '通知が届いたよ！学習を少しずつ進めよう。' });
      notificationStatus.textContent = 'テスト通知を送ったよ。';
    } catch { notificationStatus.textContent = '通知を表示できなかったよ。ブラウザの設定を確認してね。'; }
  });
</script>
<script define:vars={{ quotes }}>
  const quote = quotes[Math.floor(Math.random() * quotes.length)];
  document.getElementById('daily-quote-text').textContent = `「${quote.text}」`;
  document.getElementById('daily-quote-author').textContent = `— ${quote.name} / ${quote.era}`;
  document.getElementById('daily-quote-note').textContent = quote.note;
</script>
</Layout>