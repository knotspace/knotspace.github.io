---
import Layout from '../layouts/Layout.astro';
import bank from '../data/study-questions.json';
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const science = bank.filter((q) => q.subject === 'science').length;
const social = bank.filter((q) => q.subject === 'social').length;
const topics = [...new Set(bank.map((q) => q.topic))];
const structuredData = {'@context':'https://schema.org','@type':'WebApplication',name:'KNOT Study',applicationCategory:'EducationalApplication',operatingSystem:'Any',inLanguage:'ja-JP',description:'中学理科・社会の問題演習アプリ'};
---
<Layout title="KNOT Study｜学習スペース" description="理科・社会を自分のペースで学べるKNOT Study。" structuredData={structuredData}>
<main class="study">
  <div class="study-kicker"><span>KNOT</span><i></i> LEARNING SPACE</div>
  <section class="study-hero">
    <div class="hero-copy"><p class="overline">LEARN · REVIEW · GROW</p><h1>Study<span>.</span></h1><p class="lead">わかった、を積み重ねる。<br />理科と社会のための、自分専用の学習スペース。</p><a class="primary-link" href={`${BASE}study/solve/`}>学習をはじめる <span>↗</span></a></div>
    <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit-core">K<span>.</span></div><b class="orbit-label label-a">THINK</b><b class="orbit-label label-b">REPEAT</b><b class="orbit-label label-c">MASTER</b></div>
  </section>
  <section class="overview" aria-label="収録内容"><div><strong>{bank.length.toLocaleString('ja-JP')}</strong><span>収録問題</span></div><div><strong>{science}</strong><span>理科</span></div><div><strong>{social}</strong><span>社会</span></div><div><strong>{topics.length}</strong><span>学習分野</span></div></section>
  <div class="section-heading"><div><p class="overline">CHOOSE YOUR SUBJECT</p><h2>今日の学習を選ぶ。</h2></div><span>01 / SUBJECTS</span></div>
  <section class="subject-grid">
    <a class="subject-card science" href={`${BASE}study/solve/?subject=science`}><div class="card-top"><span>01</span><span class="subject-icon">✳</span></div><div><p>SCIENCE</p><h3>理科</h3><span class="desc">しくみを理解して、考える力を育てる。</span></div><div class="card-bottom"><strong>{science}<small> QUESTIONS</small></strong><span class="arrow">↗</span></div></a>
    <a class="subject-card social" href={`${BASE}study/solve/?subject=social`}><div class="card-top"><span>02</span><span class="subject-icon">◎</span></div><div><p>SOCIAL STUDIES</p><h3>社会</h3><span class="desc">地理・歴史・公民をつなげて理解する。</span></div><div class="card-bottom"><strong>{social}<small> QUESTIONS</small></strong><span class="arrow">↗</span></div></a>
  </section>
  <section class="how"><div><p class="overline">YOUR STUDY FLOW</p><h2>学習の流れ</h2><p>分野と難易度を選んで演習。<br />間違えた問題は記録して、あとから復習できる。</p></div><ol><li><b>01</b><span><strong>選ぶ</strong><small>教科・分野・難易度を設定</small></span></li><li><b>02</b><span><strong>解く</strong><small>1問ずつ解答して解説を確認</small></span></li><li><b>03</b><span><strong>振り返る</strong><small>苦手な問題をもう一度解く</small></span></li></ol></section>
  <footer class="study-footer"><span>KNOT STUDY / KEEP LEARNING</span><a href={BASE}>KNOT HOME ↗</a></footer>
</main>
<style>
.study{--s-bg:var(--bg);--s-panel:var(--surface);max-width:1040px;margin:0 auto;padding:34px 28px 76px;color:var(--text)}.study-kicker,.overline{font-size:10px;font-weight:800;letter-spacing:.2em;color:var(--muted)}.study-kicker{display:flex;align-items:center;gap:10px}.study-kicker span{color:var(--accent)}.study-kicker i{width:22px;height:1px;background:var(--border)}.study-hero{min-height:360px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:30px;padding:38px 0 26px}.hero-copy .overline{margin:0 0 17px}.hero-copy h1{font-size:clamp(66px,10vw,112px);letter-spacing:-.095em;line-height:.92;margin:0 0 22px}.hero-copy h1 span{color:var(--accent)}.lead{font-size:15px;line-height:2;color:var(--muted);margin:0}.primary-link{display:inline-flex;align-items:center;gap:40px;margin-top:25px;padding:15px 19px;border-radius:9px;background:var(--text);color:var(--bg);font-size:13px;font-weight:800;text-decoration:none;transition:transform .2s}.primary-link:hover{transform:translateY(-3px)}.hero-art{height:280px;position:relative;display:grid;place-items:center;overflow:hidden}.orbit{position:absolute;border:1px solid var(--border);border-radius:50%;transform:rotate(-24deg)}.orbit-one{width:250px;height:150px}.orbit-two{width:190px;height:260px;transform:rotate(48deg)}.orbit-core{width:104px;height:104px;border-radius:28px;display:grid;place-items:center;background:var(--surface);border:1px solid var(--border);box-shadow:0 18px 50px #0002;font-size:52px;font-weight:900;letter-spacing:-.1em}.orbit-core span{color:var(--accent)}.orbit-label{position:absolute;font-size:9px;letter-spacing:.16em;color:var(--muted);background:var(--bg);padding:5px 8px}.label-a{top:23%;left:18%}.label-b{right:12%;top:48%}.label-c{bottom:18%;left:31%}.overview{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--border);border-radius:13px;overflow:hidden;background:var(--surface)}.overview div{padding:18px 20px;display:flex;flex-direction:column;gap:5px;border-right:1px solid var(--border)}.overview div:last-child{border:0}.overview strong{font-size:27px;letter-spacing:-.04em;font-variant-numeric:tabular-nums}.overview span{font-size:11px;color:var(--muted)}.section-heading{display:flex;justify-content:space-between;align-items:end;margin:58px 0 18px}.section-heading .overline,.how .overline{margin:0 0 8px}.section-heading h2,.how h2{font-size:24px;letter-spacing:-.06em;margin:0}.section-heading>span{font-size:10px;letter-spacing:.15em;color:var(--muted)}.subject-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.subject-card{min-height:245px;padding:22px;border:1px solid var(--border);border-radius:14px;background:var(--surface);color:var(--text);text-decoration:none;display:flex;flex-direction:column;justify-content:space-between;transition:transform .2s,border-color .2s}.subject-card:hover{transform:translateY(-4px);border-color:var(--accent)}.card-top,.card-bottom{display:flex;justify-content:space-between;align-items:center}.card-top>span:first-child{font-size:11px;letter-spacing:.16em;color:var(--muted)}.subject-icon{font-size:24px;color:var(--accent)}.subject-card>div:nth-child(2)>p{font-size:10px;font-weight:800;letter-spacing:.18em;color:var(--muted);margin:8px 0}.subject-card h3{font-size:32px;letter-spacing:-.06em;margin:0 0 5px}.desc{font-size:12px;color:var(--muted)}.card-bottom{margin-top:23px}.card-bottom strong{font-size:24px}.card-bottom small{font-size:9px;color:var(--muted);letter-spacing:.13em}.arrow{font-size:21px;color:var(--accent)}.how{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin:58px 0 45px;padding:28px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.how>div>p:last-child{font-size:12px;line-height:2;color:var(--muted);margin-top:13px}.how ol{list-style:none;padding:0;margin:0;display:grid;gap:14px}.how li{display:flex;align-items:center;gap:15px}.how li>b{font-size:12px;color:var(--accent);letter-spacing:.1em}.how li span{display:flex;flex-direction:column;gap:3px}.how li strong{font-size:13px}.how li small{font-size:11px;color:var(--muted)}.study-footer{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;font-size:10px;letter-spacing:.12em;color:var(--muted)}.study-footer a{color:var(--accent);text-decoration:none}@media(max-width:680px){.study{padding:25px 18px 55px}.study-hero{grid-template-columns:1fr;gap:0;padding:38px 0 20px}.hero-art{height:190px;margin-top:8px}.orbit-one{width:210px;height:125px}.orbit-two{height:205px;width:155px}.overview div{padding:13px 11px}.overview strong{font-size:22px}.overview span{font-size:10px}.section-heading{margin-top:42px}.section-heading h2,.how h2{font-size:21px}.subject-grid,.how{grid-template-columns:1fr}.subject-card{min-height:215px}.how{gap:22px;margin-top:42px}}@media(max-width:380px){.overview strong{font-size:19px}.overview div{padding:12px 8px}.hero-copy h1{font-size:66px}}
</style>
</Layout>