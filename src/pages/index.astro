
---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured] = posts;

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout
  title="KNOT | 日々の記録"
  description="中学3年生の日々感じたことを書いていく、備忘録的なブログです。"
>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">PERSONAL JOURNAL / SINCE 2026</span>

      <h1>日々のことを、<br /><span>少しずつ。</span></h1>

      <p>
        中学3年生の日々感じたことを書いていく、<br class="desktop-break" />
        備忘録的なブログです。
      </p>

      <a class="hero-link" href="#articles">
        記事を読む <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="logo-mark">
        <span class="logo-name">KNOT</span>
        <span class="logo-caption">A PERSONAL JOURNAL</span>
        <span class="logo-line"></span>
        <span class="logo-description">THOUGHTS & RECORDS</span>
      </div>
    </div>
  </section>

  {featured && (
    <section class="featured-section" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <span class="section-kicker">PICK UP</span>
          <h2 id="featured-title">最新の記事</h2>
        </div>
        <span class="section-count">01 / FEATURED</span>
      </div>

      <a class="featured-card" href={`${BASE}blog/${featured.slug}/`}>
        {featured.data.heroImage ? (
          <div class="featured-image">
            <img src={featured.data.heroImage} alt="" loading="eager" />
          </div>
        ) : (
          <div class="featured-image image-placeholder"><span>KNOT</span></div>
        )}

        <div class="featured-content">
          <div class="post-meta">
            <time datetime={featured.data.pubDate.toISOString()}>
              {dateFormat(featured.data.pubDate)}
            </time>
            <span class="meta-divider"></span>
            <span>{featured.data.category}</span>
          </div>

          <h3>{featured.data.title}</h3>
          <p>{featured.data.description}</p>
          <span class="read-more">記事を読む <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </section>
  )}

  <section class="articles-section" id="articles" aria-labelledby="articles-title">
    <div class="section-heading">
      <div>
        <span class="section-kicker">THE JOURNAL</span>
        <h2 id="articles-title">記事一覧</h2>
      </div>
      <span class="section-count">{String(posts.length).padStart(2, '0')} ARTICLES</span>
    </div>

    {posts.length === 0 ? (
      <div class="empty-state">
        <span>✳</span>
        <h3>記事はまだありません。</h3>
        <p>最初の記事を公開すると、ここに表示されます。</p>
      </div>
    ) : (
      <div class="article-grid">
        {posts.map((post, index) => (
          <a class="article-card" href={`${BASE}blog/${post.slug}/`}>
            <div class="card-topline">
              <span class="card-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="card-arrow">↗</span>
            </div>

            {post.data.heroImage ? (
              <img class="card-image" src={post.data.heroImage} alt="" loading="lazy" />
            ) : (
              <div class="card-image image-placeholder"><span>KNOT</span></div>
            )}

            <div class="card-body">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat(post.data.pubDate)}
                </time>
                <span class="meta-divider"></span>
                <span>{post.data.category}</span>
              </div>

              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .hero {
    min-height: 430px;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    gap: 35px;
    padding: 70px 0 76px;
  }

  .eyebrow, .section-kicker {
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .17em;
  }

  h1 {
    margin: 22px 0 17px;
    font-size: clamp(38px, 5.5vw, 62px);
    line-height: 1.22;
    letter-spacing: -.075em;
    font-weight: 900;
  }

  h1 span {
    color: #8db9ff;
  }

  .hero-copy > p {
    color: var(--muted);
    font-size: 14px;
    line-height: 2.1;
  }

  .hero-link {
    display: inline-flex;
    gap: 20px;
    align-items: center;
    margin-top: 20px;
    padding: 12px 18px;
    border: 1px solid rgba(141,185,255,.38);
    border-radius: 999px;
    color: #c5dcff;
    font-size: 12px;
    font-weight: 700;
    transition: .2s;
  }

  .hero-link:hover {
    background: rgba(114,167,255,.12);
    transform: translateY(-2px);
  }

  .hero-art {
    min-height: 280px;
    display: grid;
    place-items: center;
  }

  .logo-mark {
    width: min(330px, 90%);
    padding: 45px 35px;
    border-left: 1px solid rgba(141,185,255,.35);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .logo-name {
    font-size: clamp(65px, 9vw, 105px);
    font-weight: 900;
    letter-spacing: -.09em;
    line-height: 1;
    color: var(--text);
  }

  .logo-caption {
    margin-top: 13px;
    color: #8db9ff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .22em;
  }

  .logo-line {
    width: 35px;
    height: 2px;
    margin: 25px 0 13px;
    background: var(--accent);
  }

  .logo-description {
    color: #718198;
    font-size: 9px;
    letter-spacing: .18em;
  }

  .featured-section, .articles-section {
    padding-top: 28px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 7px 0 0;
    font-size: 25px;
    letter-spacing: -.06em;
  }

  .section-count {
    color: #718198;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    min-height: 260px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(17,28,46,.72);
    transition: border-color .2s, transform .2s;
  }

  .featured-card:hover, .article-card:hover {
    border-color: rgba(114,167,255,.55);
    transform: translateY(-3px);
  }

  .featured-image {
    min-height: 260px;
    overflow: hidden;
    background: #172740;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    transition: transform .5s;
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.04);
  }

  .featured-content {
    align-self: center;
    padding: 30px 34px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #8fa0b7;
    font-size: 10px;
    font-weight: 600;
  }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .featured-content h3 {
    margin: 18px 0 10px;
    font-size: 25px;
    line-height: 1.45;
    letter-spacing: -.05em;
  }

  .featured-content p, .card-body p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
  }

  .read-more {
    display: inline-flex;
    gap: 14px;
    margin-top: 23px;
    color: #a9caff;
    font-size: 11px;
    font-weight: 700;
  }

  .articles-section {
    padding-top: 78px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .article-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 17px;
    background: rgba(17,28,46,.65);
    transition: border-color .2s, transform .2s;
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    padding: 15px 17px 10px;
    color: #72839b;
    font-size: 10px;
  }

  .card-number {
    font-weight: 800;
    letter-spacing: .12em;
  }

  .card-arrow {
    color: var(--accent);
    font-size: 15px;
  }

  .card-image {
    display: block;
    width: calc(100% - 34px);
    height: 150px;
    margin: 0 17px;
    border-radius: 10px;
    object-fit: cover;
  }

  .card-body {
    padding: 17px 19px 22px;
  }

  .card-body h3 {
    margin: 11px 0 7px;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -.04em;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    background: #172740;
    color: #8db9ff;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .2em;
  }

  .empty-state {
    padding: 48px 20px;
    border: 1px dashed var(--line);
    border-radius: 18px;
    text-align: center;
    color: var(--muted);
  }

  .empty-state > span {
    color: var(--accent);
    font-size: 25px;
  }

  .empty-state h3 {
    color: var(--text);
    font-size: 16px;
  }

  .empty-state p {
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 58px 0 50px;
      gap: 10px;
    }

    .hero-art {
      min-height: 210px;
    }

    .logo-mark {
      padding: 30px;
    }

    .featured-card {
      grid-template-columns: 1fr;
    }

    .featured-image, .featured-image img {
      min-height: 190px;
      height: 190px;
    }

    .featured-content {
      padding: 24px;
    }

    .featured-content h3 {
      font-size: 21px;
    }

    .articles-section {
      padding-top: 60px;
    }
  }

  @media (max-width: 480px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 42px;
    }

    .section-heading h2 {
      font-size: 22px;
    }

    .section-count {
      font-size: 8px;
    }
  }
</style>
