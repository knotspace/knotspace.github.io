
---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = posts.slice(0, 4);

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout
  title="KNOT | 日々の記録"
  description="中学3年生の日々感じたことを書いていく、備忘録的なブログです。"
>
  <section class="welcome">
    <div class="welcome-main">
      <span class="eyebrow">PERSONAL BLOG / 2026</span>
      <h1>日々のことを、<br /><span>少しずつ。</span></h1>
      <p>
        中学3年生の日々感じたことを書いていく、<br class="desktop-break" />
        備忘録的なブログです。
      </p>
      <a class="welcome-link" href={`${BASE}blog/`}>
        記事一覧を見る <span aria-hidden="true">→</span>
      </a>
    </div>

    <aside class="about-card">
      <span class="side-label">ABOUT THIS BLOG</span>
      <h2>このブログについて</h2>
      <p>
        日常のこと、勉強のこと、そのとき考えたこと。
        忘れないように、少しずつ記録していきます。
      </p>
      <div class="about-divider"></div>
      <div class="about-detail">
        <span>ブログ名</span>
        <strong>KNOT</strong>
      </div>
      <div class="about-detail">
        <span>スタート</span>
        <strong>2026年</strong>
      </div>
    </aside>
  </section>

  <section class="recent-section" aria-labelledby="recent-title">
    <div class="section-heading">
      <div>
        <span class="section-kicker">RECENT POSTS</span>
        <h2 id="recent-title">最近の記事</h2>
      </div>
      <a class="view-all" href={`${BASE}blog/`}>
        すべて見る <span aria-hidden="true">→</span>
      </a>
    </div>

    {recentPosts.length === 0 ? (
      <div class="empty-state">
        <h3>記事はまだありません。</h3>
        <p>最初の記事を公開すると、ここに表示されます。</p>
      </div>
    ) : (
      <div class="post-list">
        {recentPosts.map((post) => (
          <a class="post-item" href={`${BASE}blog/${post.slug}/`}>
            <div class="post-thumbnail">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt="" loading="lazy" />
              ) : (
                <span>KNOT</span>
              )}
            </div>

            <div class="post-info">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat(post.data.pubDate)}
                </time>
                <span class="meta-divider"></span>
                <span>{post.data.category}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>

            <span class="post-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    )}

    <div class="bottom-link">
      <a href={`${BASE}blog/`}>記事をもっと見る →</a>
    </div>
  </section>
</Layout>

<style>
  .welcome {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 65px;
    align-items: center;
    padding: 85px 0 75px;
  }

  .welcome-main {
    padding: 10px 0;
  }

  .eyebrow,
  .section-kicker,
  .side-label {
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .16em;
  }

  h1 {
    margin: 24px 0 18px;
    font-size: clamp(43px, 5.5vw, 62px);
    line-height: 1.3;
    letter-spacing: -.075em;
    font-weight: 900;
  }

  h1 span {
    color: #8db9ff;
  }

  .welcome-main > p {
    color: var(--muted);
    font-size: 14px;
    line-height: 2.1;
  }

  .welcome-link {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    margin-top: 21px;
    padding: 12px 18px;
    border: 1px solid rgba(141,185,255,.38);
    border-radius: 999px;
    color: #c5dcff;
    font-size: 12px;
    font-weight: 700;
    transition: .2s;
  }

  .welcome-link:hover {
    background: rgba(114,167,255,.12);
    transform: translateY(-2px);
  }

  .about-card {
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: rgba(17,28,46,.58);
  }

  .about-card h2 {
    margin: 15px 0 12px;
    font-size: 19px;
    letter-spacing: -.04em;
  }

  .about-card > p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 2;
  }

  .about-divider {
    height: 1px;
    margin: 23px 0 17px;
    background: var(--line);
  }

  .about-detail {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    font-size: 11px;
  }

  .about-detail span {
    color: #718198;
  }

  .about-detail strong {
    color: #d8e4f5;
    font-weight: 600;
  }

  .recent-section {
    padding-top: 34px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 20px;
  }

  .section-heading h2 {
    margin: 7px 0 0;
    font-size: 25px;
    letter-spacing: -.055em;
  }

  .view-all {
    color: #a9caff;
    font-size: 11px;
    font-weight: 700;
  }

  .post-list {
    border-top: 1px solid var(--line);
  }

  .post-item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 22px;
    padding: 19px 8px;
    border-bottom: 1px solid var(--line);
    transition: background .2s;
  }

  .post-item:hover {
    background: rgba(255,255,255,.025);
  }

  .post-thumbnail {
    display: grid;
    place-items: center;
    width: 150px;
    height: 95px;
    overflow: hidden;
    border-radius: 9px;
    background: #172740;
    color: #8db9ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .post-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: #8fa0b7;
    font-size: 10px;
    font-weight: 600;
  }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .post-info h3 {
    margin: 9px 0 5px;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -.035em;
  }

  .post-info p {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
  }

  .post-arrow {
    color: var(--accent);
    font-size: 17px;
  }

  .bottom-link {
    padding-top: 25px;
    text-align: center;
  }

  .bottom-link a {
    display: inline-block;
    padding: 11px 25px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: #c5dcff;
    font-size: 11px;
    font-weight: 700;
    transition: .2s;
  }

  .bottom-link a:hover {
    border-color: var(--accent);
  }

  .empty-state {
    padding: 45px 20px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    text-align: center;
    color: var(--muted);
  }

  .empty-state h3 {
    color: var(--text);
    font-size: 16px;
  }

  .empty-state p {
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .welcome {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 65px 0 55px;
    }

    .about-card {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: 42px;
    }

    .post-item {
      grid-template-columns: 105px minmax(0, 1fr);
      gap: 13px;
      padding: 15px 3px;
    }

    .post-thumbnail {
      width: 105px;
      height: 82px;
    }

    .post-info h3 {
      font-size: 14px;
    }

    .post-info p {
      display: none;
    }

    .post-arrow {
      display: none;
    }

    .section-heading h2 {
      font-size: 22px;
    }
  }
</style>
