---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title="KNOT | 好きと学びをつなぐ場所" description="中学生が運営する個人ブログ。読書、勉強、Web制作など日々の興味を記録しています。">
  <main class="home">
    <div class="topline"><span>PERSONAL WEBSITE</span><span>EST. 2026　/　JAPAN</span></div>
    <section class="intro">
      <div class="intro-main">
        <p class="eyebrow">HELLO, I'M KNOT.</p>
        <h1>好きなことを、<br>自分の手で形にする。</h1>
        <p class="summary">読んだ本のこと。勉強のこと。コードを書いて試したこと。<br>中学生の日常と、興味の記録を置いている場所です。</p>
        <div class="quick-links"><a href={`${BASE}blog/`}>ブログを読む <span>→</span></a><a href={`${BASE}study/`}>Studyを開く <span>↗</span></a></div>
      </div>
      <aside class="operator">
        <div class="operator-head"><span>OPERATOR / 001</span><span class="status"><i></i> ONLINE</span></div>
        <div class="operator-name">運営者について<span>。</span></div>
        <p>中学3年生。小学生の頃に触れたHTML/CSSをきっかけに、最近またWeb制作にハマっています。</p>
        <dl><div><dt>INTEREST</dt><dd>Web / 読書 / 勉強</dd></div><div><dt>STACK</dt><dd>Astro · HTML · CSS · JS</dd></div></dl>
        <a href={`${BASE}about/`}>プロフィールを読む <span>↗</span></a>
      </aside>
    </section>

    <section class="directory">
      <div class="section-label"><span>CONTENTS</span><small>WHAT'S HERE?</small></div>
      <a class="directory-row" href={`${BASE}blog/`}><span class="number">01</span><div><h2>Blog</h2><p>読書、日常、勉強。考えたことを文章に残す。</p></div><span class="row-arrow">↗</span></a>
      <a class="directory-row" href={`${BASE}study/`}><span class="number">02</span><div><h2>Study</h2><p>理科・社会の問題演習。少しずつ理解を積み上げる。</p></div><span class="row-arrow">↗</span></a>
    </section>

    <section class="latest">
      <div class="section-label"><span>RECENT POSTS</span><a href={`${BASE}blog/`}>ALL POSTS ↗</a></div>
      {posts.length ? <div class="post-list">
        {posts.map((post, i) => <a class="post" href={`${BASE}blog/${post.slug}/`}>
          <span class="post-no">{String(i + 1).padStart(2, '0')}</span>
          <span class="post-info"><small>{dateFormat(post.data.pubDate)}　/　{post.data.category}</small><strong>{post.data.title}</strong><em>{post.data.description}</em></span>
          <span class="post-arrow">→</span>
        </a>)}
      </div> : <p class="empty">記事は準備中です。</p>}
    </section>
    <footer class="home-footer"><span>KNOT / BUILT WHILE LEARNING.</span><a href={`${BASE}about/`}>ABOUT THE OPERATOR ↗</a></footer>
  </main>
</Layout>
<style>
.home{max-width:900px;margin:0 auto;padding:25px 0 35px;color:var(--text)}
.topline,.section-label{display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--muted);font:10px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.12em}
.topline{padding:0 0 13px;border-bottom:1px solid var(--line)}
.intro{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(240px,.75fr);gap:48px;align-items:center;padding:62px 0 65px}
.eyebrow{font:11px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.14em;color:var(--accent)}
.intro h1{margin:17px 0 18px;font-size:clamp(33px,5vw,52px);line-height:1.45;letter-spacing:-.075em;font-weight:850}
.summary{color:var(--muted);font-size:13px;line-height:2.1}
.quick-links{display:flex;gap:23px;margin-top:27px;flex-wrap:wrap}.quick-links a{font-size:12px;font-weight:750;border-bottom:1px solid var(--line);padding-bottom:7px}.quick-links span{color:var(--accent);margin-left:12px}
.operator{padding:18px 0 17px 22px;border-left:1px solid var(--line)}
.operator-head{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font:9px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.08em}
.status{color:var(--accent)}.status i{display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:#62c58b}
.operator-name{margin:30px 0 12px;font-size:20px;font-weight:800;letter-spacing:-.05em}.operator-name span{color:var(--accent)}
.operator p{font-size:12px;line-height:2;color:var(--muted);margin:0}
.operator dl{margin:19px 0;display:grid;gap:9px}.operator dl div{display:grid;grid-template-columns:80px 1fr;gap:10px;font-size:10px}.operator dt{font:9px ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted);letter-spacing:.08em}.operator dd{margin:0;color:var(--text)}
.operator>a{font-size:11px;color:var(--accent);font-weight:750}.operator>a span{margin-left:7px}
.directory{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:17px 0 5px}
.section-label{margin-bottom:8px}.section-label a{color:var(--accent)}
.directory-row{display:grid;grid-template-columns:55px 1fr 25px;gap:12px;align-items:center;padding:20px 4px;border-top:1px solid var(--line);transition:padding .18s,color .18s}
.directory-row:hover{padding-left:11px;color:var(--accent)}
.number,.post-no{font:11px ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted)}
.directory-row h2{margin:0;font-size:21px;letter-spacing:-.05em}.directory-row p{margin:4px 0 0;color:var(--muted);font-size:11px;line-height:1.7}.row-arrow{justify-self:end;color:var(--accent);font-size:18px}
.latest{margin-top:52px}.post-list{border-top:1px solid var(--line)}.post{display:grid;grid-template-columns:40px 1fr 22px;gap:12px;align-items:center;padding:17px 4px;border-bottom:1px solid var(--line);transition:background .15s}.post:hover{background:var(--surface-soft)}.post-info{display:grid;gap:5px}.post-info small{font-size:10px;color:var(--muted)}.post-info strong{font-size:13px;line-height:1.6}.post-info em{font-size:11px;line-height:1.6;color:var(--muted);font-style:normal}.post-arrow{justify-self:end;color:var(--accent)}.empty{font-size:12px;color:var(--muted)}
.home-footer{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:45px;padding-top:15px;border-top:1px solid var(--line);font:9px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.1em;color:var(--muted)}.home-footer a{color:var(--accent)}
@media(max-width:680px){.home{padding-top:18px}.intro{grid-template-columns:1fr;gap:32px;padding:43px 0}.intro h1{font-size:clamp(32px,8vw,44px)}.operator{margin-left:4px;padding:16px 0 15px 17px}.directory-row{grid-template-columns:35px 1fr 20px}.post{grid-template-columns:25px 1fr 15px}.post-info em{display:none}}
</style>
