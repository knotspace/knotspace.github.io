---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.publishAt || post.data.publishAt <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))];
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' });
const lead = posts[0];
const others = posts.slice(1, 4);
---

<Layout title="KNOT | 個人ブログ" description="Web制作、PC・アプリ、本・読書、勉強。気になったことを自分のペースで記録する個人ブログ。">
  <div class="personal-home">
    <section class="intro">
      <div class="intro-kicker"><span class="live-dot"></span> PERSONAL WEBLOG <span class="intro-year">EST. 2026</span></div>
      <h1>好きなことを、<br/><em>好きなように。</em></h1>
      <div class="intro-bottom">
        <p>Webをつくったり、本を読んだり、知らないことを調べたり。<br/>日々の興味を、気ままに残していく場所。</p>
        <span class="intro-mark">K.</span>
      </div>
    </section>

    <div class="home-rule"><span>RECENTLY ON KNOT</span><span>01 — 04</span></div>

    {lead && (
      <section class="lead-story">
        <a class="lead-image" href={`${BASE}blog/${lead.id}/`} aria-label={lead.data.title}>
          {lead.data.heroImage ? <img src={lead.data.heroImage} alt={lead.data.title} fetchpriority="high" /> : <div class="image-placeholder">KNOT.</div>}
          <span class="image-index">01 / FEATURED</span>
          <span class="image-open">↗</span>
        </a>
        <div class="lead-copy">
          <div class="story-meta"><span>{lead.data.category}</span><time>{dateFormat(lead.data.pubDate)}</time></div>
          <h2><a href={`${BASE}blog/${lead.id}/`}>{lead.data.title}</a></h2>
          <p>{lead.data.description}</p>
          <a class="text-link" href={`${BASE}blog/${lead.id}/`}>この記事を読む <span>⟶</span></a>
        </div>
      </section>
    )}

    {others.length > 0 && (
      <section class="other-stories" aria-label="ほかの新着記事">
        {others.map((post, index) => (
          <a class="story-row" href={`${BASE}blog/${post.id}/`}>
            <span class="row-number">0{index + 2}</span>
            <div class="row-thumb">
              {post.data.heroImage ? <img src={post.data.heroImage} alt="" loading="lazy" /> : <span>K.</span>}
            </div>
            <div class="row-copy">
              <div class="story-meta"><span>{post.data.category}</span><time>{dateFormat(post.data.pubDate)}</time></div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <span class="row-arrow">↗</span>
          </a>
        ))}
      </section>
    )}

    <section class="bottom-note">
      <div><span class="note-kicker">A LITTLE MORE</span><h2>このブログについて。</h2></div>
      <p>ここは、ひとりの書き手が興味を持ったことを自由に書いている個人ブログです。テーマは決めすぎず、そのとき面白いと思ったことを。</p>
      <a href={`${BASE}about/`}>プロフィールを読む <span>↗</span></a>
    </section>

    <footer class="home-foot">
      <div class="foot-categories">{categories.map((category) => <a href={`${BASE}blog/?category=${encodeURIComponent(category)}`}>{category}</a>)}</div>
      <span>MADE WITH CURIOSITY. © KNOT {new Date().getFullYear()}</span>
    </footer>
  </div>
</Layout>

<style>
.personal-home{--home-accent:#f07850;max-width:1060px;margin:0 auto;padding:38px 8px 12px}
.personal-home a{color:inherit;text-decoration:none}
.site-header{background:transparent!important;border:0!important;box-shadow:none!important;border-radius:0!important;border-bottom:1px solid var(--line)!important;margin-top:8px!important;padding:0 8px!important;backdrop-filter:none!important}
.intro{padding:56px 5.5% 44px;position:relative}
.intro-kicker,.note-kicker{display:flex;align-items:center;gap:10px;font-size:9px;font-weight:850;letter-spacing:.2em;color:var(--muted)}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--home-accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--home-accent) 14%,transparent)}
.intro-year{margin-left:5px;opacity:.6}
.intro h1{font-size:clamp(48px,8.3vw,94px);line-height:1.12;letter-spacing:-.085em;font-weight:900;margin:28px 0 24px}
.intro h1 em{font-family:Georgia,"Times New Roman",serif;font-weight:500;letter-spacing:-.075em;color:var(--home-accent)}
.intro-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:20px}
.intro-bottom p{margin:0;color:var(--muted);font-size:13px;line-height:2.05;letter-spacing:.025em}
.intro-mark{font-size:58px;line-height:.8;font-weight:950;letter-spacing:-.12em;color:var(--line);padding-right:8px}
.home-rule{display:flex;justify-content:space-between;align-items:center;padding:13px 5.5%;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:9px;letter-spacing:.18em;font-weight:850;color:var(--muted)}
.lead-story{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:6.5%;align-items:center;padding:38px 5.5% 45px}
.lead-image{display:block;position:relative;aspect-ratio:1.34;overflow:hidden;background:var(--surface-soft)}
.lead-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .5s}
.lead-image:hover img{transform:scale(1.035);filter:saturate(1.08)}
.image-placeholder{height:100%;display:grid;place-items:center;font-size:54px;font-weight:900;color:var(--muted)}
.image-index{position:absolute;left:16px;bottom:15px;padding:7px 10px;background:rgba(10,12,16,.72);color:#fff;font-size:9px;letter-spacing:.16em}
.image-open{position:absolute;right:14px;top:14px;display:grid;place-items:center;width:35px;height:35px;border-radius:50%;background:rgba(10,12,16,.68);color:#fff;font-size:16px;transition:transform .2s}
.lead-image:hover .image-open{transform:rotate(45deg)}
.lead-copy{padding:14px 0}
.story-meta{display:flex;align-items:center;gap:13px;font-size:10px;color:var(--muted)}
.story-meta>span{color:var(--home-accent);font-weight:850;letter-spacing:.04em}
.story-meta time{font-variant-numeric:tabular-nums}
.lead-copy h2{margin:19px 0 13px;font-size:clamp(24px,3vw,35px);line-height:1.48;letter-spacing:-.055em;font-weight:850}
.lead-copy h2 a{transition:color .2s}.lead-copy h2 a:hover{color:var(--home-accent)}
.lead-copy>p{margin:0;color:var(--muted);font-size:12px;line-height:2.05}
.text-link{display:inline-flex;align-items:center;gap:20px;margin-top:26px;padding-bottom:7px;border-bottom:1px solid var(--home-accent);font-size:11px;font-weight:850}
.text-link span{color:var(--home-accent);font-size:16px;transition:transform .2s}.text-link:hover span{transform:translateX(4px)}
.other-stories{margin:0 5.5%;border-top:1px solid var(--line)}
.story-row{display:grid;grid-template-columns:38px 116px minmax(0,1fr) 25px;align-items:center;gap:19px;padding:19px 0;border-bottom:1px solid var(--line);transition:padding .25s}
.story-row:hover{padding-left:7px;padding-right:7px}
.row-number{font-size:11px;font-weight:850;color:var(--home-accent);font-variant-numeric:tabular-nums}
.row-thumb{width:116px;height:82px;overflow:hidden;background:var(--surface-soft)}
.row-thumb img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .45s}.story-row:hover .row-thumb img{transform:scale(1.06)}
.row-thumb>span{display:grid;place-items:center;height:100%;font-weight:900;color:var(--muted)}
.row-copy{min-width:0}.row-copy h3{font-size:16px;line-height:1.55;letter-spacing:-.025em;margin:7px 0 4px;font-weight:800;transition:color .2s}.story-row:hover h3{color:var(--home-accent)}
.row-copy p{margin:0;color:var(--muted);font-size:10px;line-height:1.7;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row-arrow{font-size:17px;color:var(--muted);transition:color .2s,transform .2s}.story-row:hover .row-arrow{color:var(--home-accent);transform:translate(2px,-2px)}
.bottom-note{display:grid;grid-template-columns:.8fr 1.2fr;column-gap:8%;row-gap:14px;margin:62px 5.5% 0;padding:25px 0 30px;border-top:1px solid var(--line)}
.bottom-note h2{font-size:20px;letter-spacing:-.04em;margin:9px 0 0}
.bottom-note>p{margin:0;color:var(--muted);font-size:11px;line-height:2}
.bottom-note>a{grid-column:2;justify-self:start;font-size:10px;font-weight:850;color:var(--home-accent)}
.bottom-note>a span{margin-left:8px}
.home-foot{display:flex;justify-content:space-between;align-items:center;gap:18px;margin:18px 5.5% 0;padding:17px 0 5px;border-top:1px solid var(--line);font-size:9px;letter-spacing:.1em;color:var(--muted)}
.foot-categories{display:flex;gap:13px;flex-wrap:wrap}.foot-categories a:hover{color:var(--home-accent)}
@media(max-width:700px){
 .personal-home{padding-top:14px}.intro{padding:43px 3% 30px}.intro h1{font-size:clamp(48px,12vw,72px);margin:24px 0 18px}
 .intro-bottom p{font-size:11px}.intro-mark{font-size:43px}
 .home-rule{padding:11px 3%}.lead-story{grid-template-columns:1fr;gap:22px;padding:23px 3% 31px}
 .lead-image{aspect-ratio:1.45}.lead-copy{padding:0 2px}.lead-copy h2{font-size:26px;margin:13px 0 9px}
 .other-stories{margin:0 3%}.story-row{grid-template-columns:25px 88px minmax(0,1fr) 15px;gap:11px;padding:14px 0}
 .row-thumb{width:88px;height:72px}.row-copy h3{font-size:13px;margin:5px 0}.row-copy p{font-size:9px}
 .story-meta{font-size:9px;gap:8px}.bottom-note{grid-template-columns:1fr;gap:12px;margin:43px 3% 0;padding-top:20px}
 .bottom-note>a{grid-column:1}.home-foot{margin:14px 3% 0;align-items:flex-start;flex-direction:column;gap:12px}
}
@media(prefers-reduced-motion:reduce){.lead-image img,.image-open,.text-link span,.story-row,.row-thumb img,.row-arrow{transition:none!important}}
</style>
