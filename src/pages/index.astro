---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import siteSettings from '../data/site-settings.json';
import { getAge } from '../utils/profile-age';
const age = getAge(new Date());

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.publishAt || post.data.publishAt <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id));
const categories = [...new Set(posts.map((post) => post.data.category))];
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isDateOnly = (date: Date) => date.getUTCHours() === 0 && date.getUTCMinutes() === 0 && date.getUTCSeconds() === 0;
const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric', timeZone: isDateOnly(date) ? 'UTC' : 'Asia/Tokyo' });
const dateTimeFormat = (date: Date) => isDateOnly(date) ? '00:00' : date.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Tokyo' });
---

<Layout title="KNOT｜Web制作・PCソフト・Androidアプリ・読書の個人ブログ" description={siteSettings.siteDescription}>
  <div class="personal-home">
    <section class="intro">
      <div class="intro-topline"><span class="intro-kicker"><span class="live-dot"></span> {siteSettings.introKicker}</span><span class="intro-year">NO. 001 / 2026—</span></div>
      <div class="intro-main"><h1>KNOT<span class="intro-period">.</span></h1><div class="intro-description"><p>{siteSettings.introLine1}<br/>{siteSettings.introLine2}</p><span class="school-grade">{age}歳</span></div></div>
      <div class="intro-bottom"><span>PERSONAL NOTES &amp; JOURNAL</span><span>SCROLL TO EXPLORE ↓</span></div>
    </section>

    <div class="home-rule"><span>人気の記事</span><span>注目の4記事</span></div>

    <section class="popular-section" aria-label="人気記事">
      <div class="popular-list" id="popular-list">
        {posts.map((post, index) => (
          <a class="popular-card" href={`${BASE}blog/${post.id}/`} data-slug={post.id} data-pubdate={post.data.pubDate.toISOString()} data-fallback-rank={index}>
            <div class="popular-thumb">
              {post.data.heroImage ? <img src={post.data.heroImage} alt={post.data.title} loading={index < 2 ? 'eager' : 'lazy'} /> : <span>KNOT.</span>}
              <span class="popular-number">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="popular-copy">
              <div class="story-meta"><span>{post.data.category}</span><time datetime={post.data.pubDate.toISOString()}>{dateFormat(post.data.pubDate)} {dateTimeFormat(post.data.pubDate)}</time></div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="popular-stats" data-stats-for={post.id}>閲覧数を集計中…</span>
            </div>
            <span class="popular-arrow">↗</span>
          </a>
        ))}
      </div>
      <a class="all-articles-link" href={`${BASE}blog/`}>他の記事も読む <span>⟶</span></a>
    </section>

    <section class="bottom-note">
      <div><span class="note-kicker">A LITTLE MORE</span><h2>このブログについて。</h2></div>
      <p>ここは、ひとりの書き手が興味を持ったことを自由に書いている個人ブログです。テーマは決めすぎず、そのとき面白いと思ったことを。</p>
      <a href={`${BASE}about/`}>プロフィールを読む <span>↗</span></a>
    </section>

    <footer class="home-foot">
      <div class="foot-categories">{categories.map((category) => <a href={`${BASE}blog/?category=${encodeURIComponent(category)}`}>{category}</a>)}</div>
      <span>MADE WITH CURIOSITY. © KNOT {new Date().getFullYear()}</span>
    </footer>
  </div>
<script is:inline>
(() => {
  const list = document.getElementById('popular-list');
  if (!list) return;
  const cards = Array.from(list.querySelectorAll('.popular-card'));
  const SUPABASE_URL = 'https://rtzorqaigpeechqywjie.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_-yhc0QqTEEZTBWi9jTcFRA_-AVi-iP6';
  const headers = { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` };
  const showTop = () => cards.forEach((card, index) => {
    card.hidden = index >= 4;
    const number = card.querySelector('.popular-number');
    if (number) number.textContent = String(index + 1).padStart(2, '0');
  });
  list.dataset.ready = "false";
  fetch(`${SUPABASE_URL}/rest/v1/article_stats?select=slug,views,likes`, { headers })
    .then(response => { if (!response.ok) throw new Error('stats unavailable'); return response.json(); })
    .then(rows => {
      const stats = new Map(rows.map(row => [row.slug, { views: Number(row.views) || 0, likes: Number(row.likes) || 0 }]));
      cards.sort((a, b) => {
        const sa = stats.get(a.dataset.slug) || { views: 0, likes: 0 };
        const sb = stats.get(b.dataset.slug) || { views: 0, likes: 0 };
        const scoreA = sa.views + sa.likes * 3;
        const scoreB = sb.views + sb.likes * 3;
        return scoreB - scoreA || new Date(b.dataset.pubdate).getTime() - new Date(a.dataset.pubdate).getTime() || a.dataset.slug.localeCompare(b.dataset.slug);
      });
      cards.forEach(card => {
        list.appendChild(card);
        const stat = stats.get(card.dataset.slug) || { views: 0, likes: 0 };
        const label = card.querySelector('.popular-stats');
        if (label) label.textContent = `いいね ${stat.likes.toLocaleString('ja-JP')}`;
      });
      showTop();
      list.dataset.ready = "true";
    })
    .catch(() => {
      cards.forEach(card => {
        const label = card.querySelector('.popular-stats');
        if (label) label.textContent = '';
      });
      showTop();
      list.dataset.ready = "true";
    });
})();
</script>
</Layout>

<style>

.popular-section{padding:28px 5.5% 0}
.popular-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px;min-height:360px}.popular-list:not([data-ready="true"]) .popular-card{visibility:hidden}.popular-card:nth-child(n+5){display:none}
.popular-card{position:relative;display:grid;grid-template-columns:112px minmax(0,1fr) 18px;gap:15px;align-items:center;padding:17px 0;border-bottom:1px solid var(--line);min-width:0}
.popular-card[hidden]{display:none!important}
.popular-thumb{position:relative;width:112px;height:82px;overflow:hidden;background:var(--surface-soft)}
.popular-thumb img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .4s}
.popular-card:hover .popular-thumb img{transform:scale(1.05)}
.popular-thumb>span:first-child:not(.popular-number){display:grid;place-items:center;height:100%;font-weight:900;color:var(--muted)}
.popular-number{position:absolute;left:6px;bottom:6px;padding:3px 6px;background:rgba(10,12,16,.75);color:white;font:9px ui-monospace,monospace}
.popular-copy{min-width:0}
.popular-copy h2{font-size:14px;line-height:1.55;letter-spacing:-.025em;margin:7px 0 4px;font-weight:800}
.popular-copy>p{margin:0;color:var(--muted);font-size:10px;line-height:1.7;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.popular-stats{display:block;margin-top:6px;color:var(--muted);font-size:9px}
.popular-arrow{color:var(--muted);font-size:16px;transition:transform .2s,color .2s}
.popular-card:hover .popular-arrow{color:var(--home-accent);transform:translate(2px,-2px)}
.all-articles-link{display:flex;justify-content:center;align-items:center;gap:18px;margin:23px auto 0;padding:13px 0;width:max-content;max-width:100%;border-bottom:1px solid var(--home-accent);font-size:12px;font-weight:850}
.all-articles-link span{color:var(--home-accent);font-size:17px;transition:transform .2s}
.all-articles-link:hover span{transform:translateX(4px)}

.personal-home{--home-accent:#f07850;max-width:1060px;margin:0 auto;padding:38px 8px 12px}
.personal-home a{color:inherit;text-decoration:none}
.site-footer{display:none!important}
.site-header{background:transparent!important;border:0!important;box-shadow:none!important;border-radius:0!important;border-bottom:1px solid var(--line)!important;margin-top:8px!important;padding:0 8px!important;backdrop-filter:none!important}
.intro{padding:34px 5.5% 23px;position:relative;border-bottom:1px solid var(--line)}
.intro-topline{display:flex;justify-content:space-between;align-items:center}
.intro-kicker,.note-kicker{display:flex;align-items:center;gap:10px;font-size:9px;font-weight:800;letter-spacing:.16em;color:var(--muted)}
.intro-year{font:9px ui-monospace,monospace;letter-spacing:.12em;color:var(--muted)}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--home-accent)}
.intro-main{display:flex;justify-content:space-between;align-items:flex-end;gap:25px;padding:40px 0 28px}
.intro h1{font-family:Arial,Helvetica,sans-serif;font-size:clamp(76px,13vw,150px);line-height:.78;letter-spacing:-.105em;font-weight:900;margin:0;color:var(--text)}
.intro-period{color:var(--home-accent)}
.intro-main p{margin:0 2px 4px 0;color:var(--muted);font-size:12px;line-height:2.05;letter-spacing:.02em}\n.intro-description{display:grid;gap:10px;justify-items:start}.school-grade{display:inline-flex;padding:5px 10px;border:1px solid var(--line);border-radius:999px;color:var(--home-accent);font-size:10px;font-weight:800}
.intro-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid var(--line);font:8px ui-monospace,monospace;letter-spacing:.14em;color:var(--muted)}
.home-rule{display:flex;justify-content:space-between;align-items:center;padding:13px 5.5%;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:9px;letter-spacing:.18em;font-weight:850;color:var(--muted)}
.lead-story{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:6.5%;align-items:center;padding:38px 5.5% 45px}
.lead-image{display:block;position:relative;aspect-ratio:1.34;overflow:hidden;background:var(--surface-soft)}
.lead-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .5s}
.lead-image:hover img{transform:scale(1.035);filter:saturate(1.08)}
.image-placeholder{height:100%;display:grid;place-items:center;font-size:54px;font-weight:900;color:var(--muted)}
.image-index{position:absolute;left:16px;bottom:15px;padding:7px 10px;background:rgba(10,12,16,.72);color:#fff;font-size:9px;letter-spacing:.16em}
.image-open{position:absolute;right:14px;top:14px;display:grid;place-items:center;width:35px;height:35px;border-radius:50%;background:rgba(10,12,16,.68);color:#fff;font-size:16px;transition:transform .2s}
.lead-image:hover .image-open{transform:rotate(45deg)}
.lead-copy{padding:14px 0}
.story-meta{display:flex;align-items:center;gap:13px;font-size:10px;color:var(--muted)}
.story-meta>span{color:var(--home-accent);font-weight:850;letter-spacing:.04em}
.story-meta time{font-variant-numeric:tabular-nums}
.lead-copy h2{margin:19px 0 13px;font-size:clamp(24px,3vw,35px);line-height:1.48;letter-spacing:-.055em;font-weight:850}
.lead-copy h2 a{transition:color .2s}.lead-copy h2 a:hover{color:var(--home-accent)}
.lead-copy>p{margin:0;color:var(--muted);font-size:12px;line-height:2.05}
.text-link{display:inline-flex;align-items:center;gap:20px;margin-top:26px;padding-bottom:7px;border-bottom:1px solid var(--home-accent);font-size:11px;font-weight:850}
.text-link span{color:var(--home-accent);font-size:16px;transition:transform .2s}.text-link:hover span{transform:translateX(4px)}
.other-stories{margin:0 5.5%;border-top:1px solid var(--line)}
.story-row{display:grid;grid-template-columns:38px 116px minmax(0,1fr) 25px;align-items:center;gap:19px;padding:19px 0;border-bottom:1px solid var(--line);transition:padding .25s}
.story-row:hover{padding-left:7px;padding-right:7px}
.row-number{font-size:11px;font-weight:850;color:var(--home-accent);font-variant-numeric:tabular-nums}
.row-thumb{width:116px;height:82px;overflow:hidden;background:var(--surface-soft)}
.row-thumb img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .45s}.story-row:hover .row-thumb img{transform:scale(1.06)}
.row-thumb>span{display:grid;place-items:center;height:100%;font-weight:900;color:var(--muted)}
.row-copy{min-width:0}.row-copy h3{font-size:16px;line-height:1.55;letter-spacing:-.025em;margin:7px 0 4px;font-weight:800;transition:color .2s}.story-row:hover h3{color:var(--home-accent)}
.row-copy p{margin:0;color:var(--muted);font-size:10px;line-height:1.7;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row-arrow{font-size:17px;color:var(--muted);transition:color .2s,transform .2s}.story-row:hover .row-arrow{color:var(--home-accent);transform:translate(2px,-2px)}
.bottom-note{display:grid;grid-template-columns:.8fr 1.2fr;column-gap:8%;row-gap:14px;margin:62px 5.5% 0;padding:25px 0 30px;border-top:1px solid var(--line)}
.bottom-note h2{font-size:20px;letter-spacing:-.04em;margin:9px 0 0}
.bottom-note>p{margin:0;color:var(--muted);font-size:11px;line-height:2}
.bottom-note>a{grid-column:2;justify-self:start;font-size:10px;font-weight:850;color:var(--home-accent)}
.bottom-note>a span{margin-left:8px}
.home-foot{display:flex;justify-content:space-between;align-items:center;gap:18px;margin:18px 5.5% 0;padding:17px 0 5px;border-top:1px solid var(--line);font-size:9px;letter-spacing:.1em;color:var(--muted)}
.foot-categories{display:flex;gap:13px;flex-wrap:wrap}.foot-categories a:hover{color:var(--home-accent)}
@media(max-width:700px){
 .personal-home{padding-top:14px}.intro{padding:25px 3% 16px}.intro-main{padding:37px 0 25px;align-items:flex-start;flex-direction:column;gap:17px}.intro h1{font-size:clamp(78px,20vw,120px)}.intro-main p{font-size:11px}.intro-bottom{font-size:7px}
 .home-rule{padding:11px 3%}.lead-story{grid-template-columns:1fr;gap:22px;padding:23px 3% 31px}
 .lead-image{aspect-ratio:1.45}.lead-copy{padding:0 2px}.lead-copy h2{font-size:26px;margin:13px 0 9px}
 .popular-section{padding:20px 3% 0}.popular-list{grid-template-columns:1fr}.popular-card{grid-template-columns:88px minmax(0,1fr) 15px;gap:11px;padding:14px 0}.popular-thumb{width:88px;height:72px}.popular-copy h2{font-size:13px;margin:5px 0}.popular-copy>p{font-size:9px}.story-meta{font-size:9px;gap:8px}.bottom-note{grid-template-columns:1fr;gap:12px;margin:43px 3% 0;padding-top:20px}
 .bottom-note>a{grid-column:1}.home-foot{margin:14px 3% 0;align-items:flex-start;flex-direction:column;gap:12px}
}
@media(prefers-reduced-motion:reduce){.lead-image img,.image-open,.text-link span,.story-row,.row-thumb img,.row-arrow{transition:none!important}}
</style>
