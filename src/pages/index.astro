---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.publishAt || post.data.publishAt <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))];
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const readingTime = (body = '') => Math.max(1, Math.ceil(body.replace(/\s/g, '').length / 500));
const featured = posts[0];
const popular = [...posts].sort((a, b) => (b.data.popularity ?? 0) - (a.data.popularity ?? 0) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 8);
const recent = posts.slice(1, 9);
---
<Layout title="KNOT | 個人ブログ" description="Web制作、PC・アプリ、本・読書、勉強や日々の興味を記録する個人ブログ。">
  <div class="home-blog">
    <div class="blog-masthead">
      <a class="blog-title" href={BASE}>KNOT<span>.</span></a>
      <p>Web・ガジェット・読書・勉強。気になったことを、自分の言葉で。</p>
    </div>
    <nav class="blog-category-nav" aria-label="カテゴリー">
      <a href={`${BASE}blog/`}>トップ</a>
      <a href={`${BASE}blog/`}>記事一覧</a>
      {categories.map((category) => <a href={`${BASE}blog/?category=${encodeURIComponent(category)}`}>{category}</a>)}
      <a href={`${BASE}about/`}>運営者について</a>
    </nav>
    <div class="home-columns">
      <main class="home-main">
        <div class="home-section-heading"><h1>記事</h1><span>ARTICLES</span></div>
        <section class="featured-slider" aria-label="おすすめ記事">
          <div class="slider-heading"><div><span class="slider-eyebrow">PICK UP</span><h2>おすすめの記事</h2></div><div class="slider-controls"><button type="button" class="slider-arrow" id="slider-prev" aria-label="前の記事">‹</button><button type="button" class="slider-arrow" id="slider-next" aria-label="次の記事">›</button></div></div>
          <div class="slider-viewport" id="slider-viewport">
            <div class="slider-track" id="slider-track">
              {posts.slice(0, 4).map((post, index) => <a class="slider-card" href={`${BASE}blog/${post.id}/`} aria-label={post.data.title}>
                <div class="slider-image">{post.data.heroImage ? <img src={post.data.heroImage} alt={post.data.title} loading={index === 0 ? 'eager' : 'lazy'} /> : <span>KNOT.</span>}<span class="slider-number">0{index + 1}</span></div>
                <div class="slider-card-copy"><div class="article-meta"><span>{post.data.category}</span><time>{dateFormat(post.data.pubDate)}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="slider-read">記事を読む <b>↗</b></span></div>
              </a>)}
            </div>
          </div>
          <div class="slider-footer"><div class="slider-dots" id="slider-dots" aria-label="スライド選択">{posts.slice(0,4).map((post,index)=><button type="button" class:list={['slider-dot',{'is-active':index===0}]} data-slide={index} aria-label={`${index+1}番目の記事`} aria-current={index===0?'true':undefined}></button>)}</div><span class="slider-count"><strong id="slider-current">01</strong> / {String(Math.min(posts.length,4)).padStart(2,'0')}</span></div>
        </section>
        <div class="home-latest-heading"><h2>新着記事</h2><span>最新の記事をピックアップ</span></div>
        <div class="home-mini-grid">
          {posts.slice(0, 4).map((post) => <a class="home-mini-card" href={`${BASE}blog/${post.id}/`}>
            {post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" />}
            <span class="mini-card-category">{post.data.category}</span><strong>{post.data.title}</strong><time>{dateFormat(post.data.pubDate)}</time>
          </a>)}
        </div>
        <script>
          const viewport = document.querySelector<HTMLElement>('#slider-viewport');
          const track = document.querySelector<HTMLElement>('#slider-track');
          const cards = Array.from(document.querySelectorAll<HTMLElement>('.slider-card'));
          const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.slider-dot'));
          const current = document.querySelector<HTMLElement>('#slider-current');
          let active = 0;
          const goTo = (index: number) => {
            if (!viewport || !cards.length) return;
            active = (index + cards.length) % cards.length;
            viewport.scrollTo({ left: cards[active].offsetLeft - cards[0].offsetLeft, behavior: 'smooth' });
            dots.forEach((dot, i) => { dot.classList.toggle('is-active', i === active); dot.setAttribute('aria-current', i === active ? 'true' : 'false'); });
            if (current) current.textContent = String(active + 1).padStart(2, '0');
          };
          document.querySelector('#slider-prev')?.addEventListener('click', () => goTo(active - 1));
          document.querySelector('#slider-next')?.addEventListener('click', () => goTo(active + 1));
          dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));
          let scrollTimer: ReturnType<typeof setTimeout>;
          viewport?.addEventListener('scroll', () => {
            clearTimeout(scrollTimer);
            scrollTimer = setTimeout(() => {
              if (!viewport || !cards.length) return;
              const center = viewport.scrollLeft;
              const nearest = cards.reduce((best, card, i) => Math.abs(card.offsetLeft - cards[0].offsetLeft - center) < Math.abs(cards[best].offsetLeft - cards[0].offsetLeft - center) ? i : best, 0);
              if (nearest !== active) { active = nearest; dots.forEach((dot,i)=>{dot.classList.toggle('is-active',i===active);dot.setAttribute('aria-current',i===active?'true':'false');}); if(current) current.textContent=String(active+1).padStart(2,'0'); }
            }, 70);
          }, { passive: true });
        </script>
      </main>
      <aside class="home-sidebar">
        <section class="side-widget"><h2>このブログについて</h2><div class="side-profile"><strong>KNOT<span>.</span></strong><p>中学3年生が運営する個人ブログ。Web制作や読書、勉強など、興味のあることを記録しています。</p><a href={`${BASE}about/`}>プロフィール »</a></div></section>
        <section class="side-widget"><h2>カテゴリー</h2><ul>{categories.map((category) => <li><a href={`${BASE}blog/?category=${encodeURIComponent(category)}`}>{category}<span>›</span></a></li>)}</ul></section>
        <section class="side-widget"><h2>KNOT Study</h2><p>勉強に使える問題・まとめを公開中。</p><a href={`${BASE}study/`}>Studyを開く »</a></section>
      </aside>
    </div>
  </div>
</Layout>
<style>
.home-blog{width:100%;max-width:1160px;margin:0 auto;padding:22px 0 42px}
.blog-masthead{padding:30px 34px 27px;border:1px solid var(--line);border-radius:26px 26px 0 0;background:linear-gradient(135deg,var(--surface),color-mix(in srgb,var(--surface) 76%,var(--accent) 24%));border-bottom:0}
.blog-title{font-size:clamp(36px,5vw,48px);font-weight:900;letter-spacing:-.08em;line-height:1}.blog-title span,.side-profile strong span{color:var(--accent)}
.blog-masthead p{margin:10px 0 0;color:var(--muted);font-size:13px}
.blog-category-nav{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding:11px 16px;border:1px solid var(--line);border-top:0;border-radius:0 0 22px 22px;background:var(--surface);box-shadow:0 10px 28px rgba(0,0,0,.05)}
.blog-category-nav a{display:block;padding:9px 15px;border:0;border-radius:999px;font-size:12px;font-weight:700;transition:background .2s,color .2s}.blog-category-nav a:hover{background:var(--surface-soft);color:var(--accent)}
.home-columns{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:30px;align-items:start;padding-top:30px}
.home-section-heading{display:flex;align-items:baseline;gap:12px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.home-section-heading h1{font-size:22px;margin:0}.home-section-heading span{font-size:10px;color:var(--muted);letter-spacing:.14em}
.featured-slider{min-width:0;padding:22px;border:1px solid var(--line);border-radius:25px;background:var(--surface);box-shadow:0 12px 34px rgba(0,0,0,.06);overflow:hidden}
.slider-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:17px}
.slider-eyebrow{font-size:9px;font-weight:900;letter-spacing:.2em;color:var(--accent)}
.slider-heading h2{margin:4px 0 0;font-size:20px;letter-spacing:-.04em}
.slider-controls{display:flex;gap:7px}
.slider-arrow{display:grid;place-items:center;width:37px;height:37px;border:1px solid var(--line);border-radius:50%;background:var(--bg);color:var(--text);font-size:24px;line-height:1;cursor:pointer;transition:background .2s,border-color .2s,color .2s}
.slider-arrow:hover{background:var(--accent);border-color:var(--accent);color:white}
.slider-viewport{overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;overscroll-behavior-x:contain}
.slider-viewport::-webkit-scrollbar{display:none}
.slider-track{display:flex;gap:15px}
.slider-card{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:0;flex:0 0 100%;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:19px;background:var(--bg);scroll-snap-align:start;transition:border-color .2s}
.slider-card:hover{border-color:var(--accent)}
.slider-image{position:relative;min-height:270px;overflow:hidden;background:var(--surface-soft)}
.slider-image img{display:block;width:100%;height:100%;min-height:270px;object-fit:cover;transition:transform .55s cubic-bezier(.2,.8,.2,1)}
.slider-card:hover .slider-image img{transform:scale(1.045)}
.slider-image>span:first-child:not(.slider-number){display:grid;place-items:center;height:100%;color:var(--muted);font-weight:900;font-size:30px}
.slider-number{position:absolute;left:14px;top:14px;display:grid;place-items:center;width:37px;height:37px;border:1px solid rgba(255,255,255,.45);border-radius:50%;background:rgba(10,15,25,.48);color:white;font-size:11px;font-weight:800;backdrop-filter:blur(10px)}
.slider-card-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:25px}
.article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:10px}
.article-meta>span{padding:5px 10px;border-radius:999px;background:color-mix(in srgb,var(--accent) 13%,var(--surface));color:var(--accent);font-weight:800}
.slider-card-copy h3{font-size:clamp(17px,2vw,23px);line-height:1.6;letter-spacing:-.035em;margin:14px 0 9px}
.slider-card-copy p{margin:0;color:var(--muted);font-size:11px;line-height:1.9}
.slider-read{display:inline-flex;gap:12px;align-items:center;margin-top:18px;padding:9px 14px;border-radius:999px;background:var(--surface-soft);color:var(--accent);font-size:11px;font-weight:800}
.slider-footer{display:flex;align-items:center;justify-content:space-between;padding:16px 3px 0}
.slider-dots{display:flex;align-items:center;gap:7px}
.slider-dot{width:7px;height:7px;padding:0;border:0;border-radius:99px;background:var(--line);cursor:pointer;transition:width .2s,background .2s}
.slider-dot.is-active{width:23px;background:var(--accent)}
.slider-count{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums}.slider-count strong{color:var(--text);font-size:13px}
.home-latest-heading{display:flex;align-items:baseline;gap:11px;margin:30px 0 13px}
.home-latest-heading h2{margin:0;font-size:17px}.home-latest-heading span{font-size:10px;color:var(--muted)}
.home-mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.home-mini-card{display:grid;grid-template-columns:92px minmax(0,1fr);grid-template-rows:auto 1fr auto;column-gap:12px;min-width:0;padding:10px;border:1px solid var(--line);border-radius:15px;background:var(--surface);transition:transform .2s,border-color .2s}
.home-mini-card:hover{transform:translateY(-2px);border-color:var(--accent)}
.home-mini-card img{grid-row:1/4;width:92px;height:78px;object-fit:cover;border-radius:10px}
.mini-card-category{font-size:9px;color:var(--accent);font-weight:800}
.home-mini-card strong{align-self:center;font-size:11px;line-height:1.6}
.home-mini-card time{font-size:9px;color:var(--muted)}
.home-sidebar{display:grid;gap:16px}
.side-widget{overflow:hidden;border:1px solid var(--line);border-radius:19px;background:var(--surface);box-shadow:0 5px 18px rgba(0,0,0,.04)}
.side-widget>h2{font-size:13px;margin:0;padding:14px 17px;border-bottom:1px solid var(--line)}
.side-profile{padding:18px}.side-profile strong{font-size:29px;letter-spacing:-.08em}
.side-profile p,.side-widget>p{font-size:11px;line-height:2;color:var(--muted);margin:8px 0}
.side-profile>a,.side-widget> a{display:inline-flex;margin-top:5px;padding:7px 12px;border-radius:999px;background:var(--surface-soft);font-size:11px;color:var(--accent);font-weight:700}
.side-widget ul{margin:0;padding:8px 17px 12px;list-style:none}.side-widget li{border-bottom:1px solid var(--line)}.side-widget li:last-child{border:0}
.side-widget li a{display:flex;justify-content:space-between;gap:10px;padding:10px 2px;font-size:11px;line-height:1.6}.side-widget li a:hover{color:var(--accent)}
.side-widget>p{padding:0 17px}.side-widget> a{margin:0 17px 16px}
@media(max-width:850px){.home-columns{grid-template-columns:1fr}.home-sidebar{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){
 .home-blog{padding:13px 0 30px}.blog-masthead{padding:24px 20px 21px;border-radius:22px 22px 0 0}.blog-masthead p{font-size:11px;line-height:1.8}
 .blog-category-nav{gap:4px;padding:9px 10px;border-radius:0 0 18px 18px;flex-wrap:nowrap;overflow-x:auto}.blog-category-nav a{white-space:nowrap;padding:8px 11px;font-size:10px}
 .home-columns{padding-top:22px}.featured-slider{padding:15px;border-radius:21px}.slider-heading h2{font-size:18px}
 .slider-card{grid-template-columns:1fr}.slider-image{min-height:0;height:190px}.slider-image img{min-height:190px}
 .slider-card-copy{padding:17px}.slider-card-copy h3{font-size:18px;margin:10px 0 7px}.slider-card-copy p{font-size:10px}
 .slider-read{margin-top:12px}.home-latest-heading{margin-top:24px}.home-mini-grid{grid-template-columns:1fr;gap:9px}
 .home-mini-card{grid-template-columns:78px minmax(0,1fr);padding:9px}.home-mini-card img{width:78px;height:70px}
 .home-sidebar{grid-template-columns:1fr;gap:12px}
}
@media(prefers-reduced-motion:reduce){.slider-viewport{scroll-behavior:auto}.slider-card,.slider-image img,.home-mini-card,.slider-arrow,.slider-dot{transition:none!important}}
</style>