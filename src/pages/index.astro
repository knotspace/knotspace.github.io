
---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = posts.slice(0, 5);

const categories = [...new Set(posts.map((post) => post.data.category))];

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout
  title="KNOT | 日々の記録"
  description="中学3年生の日々感じたことを書いていく、備忘録的なブログです。"
>
  <section class="welcome">
    <div class="welcome-copy">
      <span class="eyebrow">PERSONAL BLOG</span>
      <h1>日々のことを、<br /><span>少しずつ。</span></h1>
      <p>
        中学3年生の日々感じたことを書いていく、<br class="desktop-break" />
        備忘録的なブログです。
      </p>
    </div>
  </section>

  <div class="content-layout">
    <section class="main-column">
      <div class="section-heading">
        <div>
          <span class="section-kicker">LATEST ARTICLES</span>
          <h2>新着記事</h2>
        </div>
        <a class="more-link" href={`${BASE}blog/`}>記事一覧 →</a>
      </div>

      {recentPosts.length === 0 ? (
        <div class="empty-state">
          <h3>記事はまだありません。</h3>
          <p>最初の記事を公開すると、ここに表示されます。</p>
        </div>
      ) : (
        <div class="post-list">
          {recentPosts.map((post) => (
            <a class="post-card" href={`${BASE}blog/${post.slug}/`}>
              <div class="post-thumbnail">
                {post.data.heroImage ? (
                  <img src={post.data.heroImage} alt="" loading="lazy" />
                ) : (
                  <span>KNOT</span>
                )}
              </div>

              <div class="post-info">
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFormat(post.data.pubDate)}
                  </time>
                  <span class="category-label">{post.data.category}</span>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="read-more">続きを読む →</span>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="all-posts">
        <a href={`${BASE}blog/`}>すべての記事を見る →</a>
      </div>
    </section>

    <aside class="sidebar">
      <section class="widget profile-widget">
        <h2 class="widget-title">このブログについて</h2>
        <div class="profile-logo">KNOT<span>.</span></div>
        <p>
          中学3年生の日々感じたことを書いていく、備忘録的なブログです。
          日常や勉強のことなどを、気ままに記録しています。
        </p>
        <div class="profile-info">
          <span>ブログ開設</span>
          <strong>2026年</strong>
        </div>
      </section>

      <section class="widget">
        <h2 class="widget-title">カテゴリー</h2>
        {categories.length > 0 ? (
          <ul class="category-list">
            {categories.map((category) => (
              <li>
                <a href={`${BASE}blog/`}>
                  <span>{category}</span>
                  <span>→</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="widget-note">カテゴリーはまだありません。</p>
        )}
      </section>

      <section class="widget">
        <h2 class="widget-title">最近の記事</h2>
        <ul class="recent-list">
          {recentPosts.slice(0, 3).map((post) => (
            <li>
              <a href={`${BASE}blog/${post.slug}/`}>
                <span>{post.data.title}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat(post.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Layout>

<style>
  .welcome {
    padding: 42px 0 35px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow,
  .section-kicker {
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .15em;
  }

  .welcome h1 {
    margin: 15px 0 12px;
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.35;
    font-weight: 900;
    letter-spacing: -.07em;
  }

  .welcome h1 span {
    color: var(--accent);
  }

  .welcome-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 2;
  }

  .content-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 285px;
    gap: 35px;
    align-items: start;
    padding-top: 35px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 18px;
  }

  .section-heading h2 {
    margin: 7px 0 0;
    color: var(--text);
    font-size: 23px;
    letter-spacing: -.05em;
  }

  .more-link {
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
  }

  .post-list {
    border-top: 1px solid var(--line);
  }

  .post-card {
    display: grid;
    grid-template-columns: 165px minmax(0, 1fr);
    gap: 19px;
    padding: 18px 5px;
    border-bottom: 1px solid var(--line);
    transition: background .2s;
  }

  .post-card:hover {
    background: var(--surface-soft);
  }

  .post-thumbnail {
    display: grid;
    place-items: center;
    width: 165px;
    height: 110px;
    overflow: hidden;
    border-radius: 9px;
    background: var(--code-bg);
    color: var(--accent);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .15em;
  }

  .post-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-info {
    min-width: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    color: var(--muted);
    font-size: 10px;
  }

  .category-label {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--accent);
  }

  .post-info h3 {
    margin: 9px 0 7px;
    color: var(--text);
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: -.035em;
  }

  .post-info p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
  }

  .read-more {
    display: inline-block;
    margin-top: 9px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
  }

  .all-posts {
    padding: 24px 0;
    text-align: center;
  }

  .all-posts a {
    display: inline-block;
    padding: 11px 25px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 11px;
    font-weight: 700;
    transition: border-color .2s, background .2s;
  }

  .all-posts a:hover {
    border-color: var(--accent);
    background: var(--code-bg);
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .widget {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--surface);
    color: var(--text);
    transition: background .25s, border-color .25s;
  }

  .widget-title {
    margin: 0 0 16px;
    padding-bottom: 11px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 14px;
    letter-spacing: -.025em;
  }

  .profile-logo {
    color: var(--text);
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -.09em;
  }

  .profile-logo span {
    color: var(--accent);
  }

  .profile-widget > p {
    margin: 9px 0 17px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.9;
  }

  .profile-info {
    display: flex;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--text);
    font-size: 10px;
  }

  .profile-info span {
    color: var(--muted);
  }

  .profile-info strong {
    font-weight: 600;
  }

  .category-list,
  .recent-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-list li,
  .recent-list li {
    border-bottom: 1px solid var(--line);
  }

  .category-list li:last-child,
  .recent-list li:last-child {
    border-bottom: 0;
  }

  .category-list a {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    color: var(--muted);
    font-size: 11px;
    transition: color .2s;
  }

  .category-list a:hover,
  .recent-list a:hover span {
    color: var(--accent);
  }

  .recent-list a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 11px 0;
    color: var(--text);
    font-size: 11px;
    line-height: 1.6;
  }

  .recent-list time {
    color: var(--muted);
    font-size: 9px;
  }

  .widget-note {
    color: var(--muted);
    font-size: 11px;
  }

  .empty-state {
    padding: 40px 20px;
    border: 1px dashed var(--line);
    border-radius: 12px;
    background: var(--surface);
    text-align: center;
    color: var(--muted);
  }

  .empty-state h3 {
    color: var(--text);
    font-size: 15px;
  }

  .empty-state p {
    font-size: 11px;
  }

  @media (max-width: 780px) {
    .content-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .sidebar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile-widget {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .welcome {
      padding-top: 35px;
    }

    .post-card {
      grid-template-columns: 105px minmax(0, 1fr);
      gap: 12px;
      padding: 14px 2px;
    }

    .post-thumbnail {
      width: 105px;
      height: 85px;
    }

    .post-info h3 {
      margin: 7px 0;
      font-size: 13px;
    }

    .post-info p,
    .read-more {
      display: none;
    }

    .post-meta {
      gap: 6px;
      font-size: 9px;
    }

    .sidebar {
      display: flex;
    }
  }
</style>
