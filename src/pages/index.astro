---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.publishAt || post.data.publishAt <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))];
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const readingTime = (body = '') => Math.max(1, Math.ceil(body.replace(/\s/g, '').length / 500));
const featured = posts[0];
const recent = posts.slice(1, 9);
---
<Layout title="KNOT | 個人ブログ" description="Web制作、PC・アプリ、本・読書、勉強や日々の興味を記録する個人ブログ。">
  <div class="home-blog">
    <div class="blog-masthead">
      <a class="blog-title" href={BASE}>KNOT<span>.</span></a>
      <p>Web・ガジェット・読書・勉強。気になったことを、自分の言葉で。</p>
    </div>
    <nav class="blog-category-nav" aria-label="カテゴリー">
      <a href={`${BASE}blog/`}>トップ</a>
      <a href={`${BASE}blog/`}>記事一覧</a>
      {categories.map((category) => <a href={`${BASE}blog/?category=${encodeURIComponent(category)}`}>{category}</a>)}
      <a href={`${BASE}about/`}>運営者について</a>
    </nav>
    <div class="home-columns">
      <main class="home-main">
        <div class="home-section-heading"><h1>新着記事</h1><span>NEW ARTICLES</span></div>
        {featured && <a class="featured-article" href={`${BASE}blog/${featured.slug}/`}>
          {featured.data.heroImage && <img src={featured.data.heroImage} alt={featured.data.title} />}
          <div class="featured-copy"><div class="article-meta"><span>{featured.data.category}</span><time>{dateFormat(featured.data.pubDate)}</time></div><h2>{featured.data.title}</h2><p>{featured.data.description}</p><span class="continue-reading">続きを読む »</span></div>
        </a>}
        <div class="home-article-list">
          {recent.map((post) => <article class="home-article-row">
            <a class="row-thumb" href={`${BASE}blog/${post.slug}/`}>{post.data.heroImage ? <img src={post.data.heroImage} alt="" loading="lazy" /> : <span>KNOT</span>}</a>
            <div class="row-copy"><div class="article-meta"><span>{post.data.category}</span><time>{dateFormat(post.data.pubDate)}</time><small>約{readingTime(post.body)}分</small></div><h2><a href={`${BASE}blog/${post.slug}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="continue-reading" href={`${BASE}blog/${post.slug}/`}>続きを読む »</a></div>
          </article>)}
        </div>
        <a class="all-articles" href={`${BASE}blog/`}>記事一覧をもっと見る »</a>
      </main>
      <aside class="home-sidebar">
        <section class="side-widget"><h2>このブログについて</h2><div class="side-profile"><strong>KNOT<span>.</span></strong><p>中学3年生が運営する個人ブログ。Web制作や読書、勉強など、興味のあることを記録しています。</p><a href={`${BASE}about/`}>プロフィール »</a></div></section>
        <section class="side-widget"><h2>カテゴリー</h2><ul>{categories.map((category) => <li><a href={`${BASE}blog/?category=${encodeURIComponent(category)}`}>{category}<span>›</span></a></li>)}</ul></section>
        <section class="side-widget"><h2>最近の記事</h2><ol>{posts.slice(0, 5).map((post) => <li><a href={`${BASE}blog/${post.slug}/`}>{post.data.title}</a></li>)}</ol></section>
        <section class="side-widget"><h2>KNOT Study</h2><p>勉強に使える問題・まとめを公開中。</p><a href={`${BASE}study/`}>Studyを開く »</a></section>
      </aside>
    </div>
  </div>
</Layout>
<style>
.home-blog{width:100%;max-width:1100px;margin:0 auto;padding:12px 0 35px}
.blog-masthead{padding:27px 0 23px;border-bottom:1px solid var(--line)}
.blog-title{font-size:34px;font-weight:900;letter-spacing:-.08em}.blog-title span,.side-profile strong span{color:var(--accent)}
.blog-masthead p{margin:7px 0 0;color:var(--muted);font-size:12px}
.blog-category-nav{display:flex;align-items:center;gap:0;flex-wrap:wrap;border-bottom:3px solid var(--accent);background:var(--surface)}
.blog-category-nav a{display:block;padding:13px 17px;border-right:1px solid var(--line);font-size:12px;font-weight:700}
.blog-category-nav a:hover{background:var(--surface-soft);color:var(--accent)}
.home-columns{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:34px;align-items:start;padding-top:28px}
.home-section-heading{display:flex;align-items:baseline;gap:12px;margin-bottom:17px;padding-bottom:10px;border-bottom:2px solid var(--line)}
.home-section-heading h1{font-size:21px;margin:0}.home-section-heading span{font-size:9px;color:var(--muted);letter-spacing:.12em}
.featured-article{display:grid;grid-template-columns: minmax(0,1.1fr) minmax(0,1fr);gap:20px;padding-bottom:22px;border-bottom:1px solid var(--line)}
.featured-article>img{width:100%;height:220px;object-fit:cover}
.featured-copy{align-self:center}.article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:10px}
.article-meta>span{padding:3px 7px;background:var(--surface);border:1px solid var(--line);font-weight:700}
.featured-copy h2{font-size:20px;line-height:1.55;margin:12px 0 8px}.featured-copy p,.row-copy p{color:var(--muted);font-size:12px;line-height:1.9;margin:0 0 10px}
.continue-reading{color:var(--accent);font-size:11px;font-weight:700}
.home-article-row{display:grid;grid-template-columns:155px minmax(0,1fr);gap:17px;padding:19px 0;border-bottom:1px solid var(--line)}
.row-thumb{display:block;width:155px;height:105px;background:var(--surface);overflow:hidden}.row-thumb img{width:100%;height:100%;object-fit:cover}.row-thumb span{display:grid;place-items:center;height:100%;font-weight:900;color:var(--muted)}
.row-copy h2{font-size:16px;line-height:1.55;margin:7px 0}.row-copy p{margin-bottom:7px}
.all-articles{display:block;margin-top:22px;padding:13px;text-align:center;border:1px solid var(--line);font-size:12px;font-weight:700}
.home-sidebar{display:grid;gap:22px}.side-widget{border:1px solid var(--line);background:var(--surface)}
.side-widget>h2{font-size:14px;margin:0;padding:12px 14px;border-bottom:1px solid var(--line);border-left:4px solid var(--accent)}
.side-profile{padding:15px}.side-profile strong{font-size:26px;letter-spacing:-.08em}.side-profile p,.side-widget>p{font-size:11px;line-height:1.9;color:var(--muted);margin:8px 0}
.side-profile>a,.side-widget> a{font-size:11px;color:var(--accent);font-weight:700}
.side-widget ul,.side-widget ol{margin:0;padding:7px 14px 10px;list-style:none}.side-widget li{border-bottom:1px dotted var(--line)}.side-widget li:last-child{border:0}
.side-widget li a{display:flex;justify-content:space-between;gap:10px;padding:9px 0;font-size:11px;line-height:1.6}.side-widget li a:hover{color:var(--accent)}
.side-widget ol{counter-reset:recent}.side-widget ol li{counter-increment:recent}.side-widget ol li a:before{content:counter(recent);color:var(--accent);font-weight:800;margin-right:8px}
.side-widget>p{padding:0 14px}.side-widget> a{display:block;padding:0 14px 14px}
@media(max-width:760px){.home-columns{grid-template-columns:1fr;gap:30px}.home-sidebar{grid-template-columns:repeat(2,minmax(0,1fr))}.featured-article{grid-template-columns:1fr}.featured-article>img{height:230px}}
@media(max-width:520px){.home-blog{padding-top:0}.blog-masthead{padding:20px 0}.blog-title{font-size:29px}.blog-category-nav{overflow-x:auto;flex-wrap:nowrap}.blog-category-nav a{white-space:nowrap;padding:12px 13px;font-size:11px}.home-columns{padding-top:20px}.home-article-row{grid-template-columns:112px minmax(0,1fr);gap:12px}.row-thumb{width:112px;height:88px}.row-copy h2{font-size:13px}.row-copy p{font-size:10px;line-height:1.65}.home-sidebar{grid-template-columns:1fr}.featured-copy h2{font-size:18px}}
</style>