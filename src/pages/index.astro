
---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured] = posts;

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout
  title="KNOT | 日々の記録"
  description="中学3年生の日々感じたことを書いていく、備忘録的なブログです。"
>
  <section class="hero">
    <span class="eyebrow">PERSONAL JOURNAL / 2026</span>

    <h1>
      日々のことを、<br />
      <span>少しずつ。</span>
    </h1>

    <p>
      中学3年生の日々感じたことを書いていく、<br class="desktop-break" />
      備忘録的なブログです。
    </p>

    <a class="hero-link" href="#articles">
      記事一覧を見る <span aria-hidden="true">↓</span>
    </a>

    <div class="hero-note">
      <span>日常のこと、勉強のこと、考えたこと。</span>
      <span>気ままに書いています。</span>
    </div>
  </section>

  {featured && (
    <section class="featured-section" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <span class="section-kicker">NEW POST</span>
          <h2 id="featured-title">最近書いた記事</h2>
        </div>
        <span class="section-count">LATEST</span>
      </div>

      <a class="featured-card" href={`${BASE}blog/${featured.slug}/`}>
        {featured.data.heroImage ? (
          <div class="featured-image">
            <img src={featured.data.heroImage} alt="" loading="eager" />
          </div>
        ) : (
          <div class="featured-image image-placeholder">
            <span>NEW ARTICLE</span>
          </div>
        )}

        <div class="featured-content">
          <div class="post-meta">
            <time datetime={featured.data.pubDate.toISOString()}>
              {dateFormat(featured.data.pubDate)}
            </time>
            <span class="meta-divider"></span>
            <span>{featured.data.category}</span>
          </div>

          <h3>{featured.data.title}</h3>
          <p>{featured.data.description}</p>
          <span class="read-more">続きを読む <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </section>
  )}

  <section class="articles-section" id="articles" aria-labelledby="articles-title">
    <div class="section-heading">
      <div>
        <span class="section-kicker">ALL POSTS</span>
        <h2 id="articles-title">記事一覧</h2>
      </div>
      <span class="section-count">{posts.length} POSTS</span>
    </div>

    {posts.length === 0 ? (
      <div class="empty-state">
        <h3>記事はまだありません。</h3>
        <p>最初の記事を公開すると、ここに表示されます。</p>
      </div>
    ) : (
      <div class="article-grid">
        {posts.map((post) => (
          <a class="article-card" href={`${BASE}blog/${post.slug}/`}>
            {post.data.heroImage ? (
              <img class="card-image" src={post.data.heroImage} alt="" loading="lazy" />
            ) : (
              <div class="card-image image-placeholder">
                <span>KNOT</span>
              </div>
            )}

            <div class="card-body">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat(post.data.pubDate)}
                </time>
                <span class="meta-divider"></span>
                <span>{post.data.category}</span>
              </div>

              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="card-read">続きを読む ↗</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .hero {
    padding: 100px 0 85px;
    max-width: 760px;
  }

  .eyebrow,
  .section-kicker {
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .17em;
  }

  h1 {
    margin: 25px 0 20px;
    font-size: clamp(43px, 6vw, 62px);
    line-height: 1.3;
    letter-spacing: -.075em;
    font-weight: 900;
  }

  h1 span {
    color: #8db9ff;
  }

  .hero > p {
    color: var(--muted);
    font-size: 14px;
    line-height: 2.1;
  }

  .hero-link {
    display: inline-flex;
    gap: 20px;
    align-items: center;
    margin-top: 20px;
    padding: 12px 18px;
    border: 1px solid rgba(141,185,255,.38);
    border-radius: 999px;
    color: #c5dcff;
    font-size: 12px;
    font-weight: 700;
    transition: .2s;
  }

  .hero-link:hover {
    background: rgba(114,167,255,.12);
    transform: translateY(-2px);
  }

  .hero-note {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 55px;
    padding-left: 15px;
    border-left: 2px solid rgba(141,185,255,.45);
    color: #718198;
    font-size: 11px;
    line-height: 1.7;
  }

  .featured-section,
  .articles-section {
    padding-top: 28px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 7px 0 0;
    font-size: 25px;
    letter-spacing: -.06em;
  }

  .section-count {
    color: #718198;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 240px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(17,28,46,.55);
    transition: border-color .2s, transform .2s;
  }

  .featured-card:hover,
  .article-card:hover {
    border-color: rgba(114,167,255,.55);
    transform: translateY(-3px);
  }

  .featured-image {
    min-height: 240px;
    overflow: hidden;
    background: #172740;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
    transition: transform .5s;
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.04);
  }

  .featured-content {
    align-self: center;
    padding: 28px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: #8fa0b7;
    font-size: 10px;
    font-weight: 600;
  }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .featured-content h3 {
    margin: 17px 0 10px;
    font-size: 23px;
    line-height: 1.5;
    letter-spacing: -.05em;
  }

  .featured-content p,
  .card-body p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
  }

  .read-more {
    display: inline-flex;
    gap: 14px;
    margin-top: 22px;
    color: #a9caff;
    font-size: 11px;
    font-weight: 700;
  }

  .articles-section {
    padding-top: 75px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .article-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: rgba(17,28,46,.5);
    transition: border-color .2s, transform .2s;
  }

  .card-image {
    display: block;
    width: 100%;
    height: 175px;
    object-fit: cover;
    background: #172740;
  }

  .card-body {
    padding: 18px 19px 21px;
  }

  .card-body h3 {
    margin: 12px 0 8px;
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -.04em;
  }

  .card-read {
    display: inline-block;
    margin-top: 17px;
    color: #a9caff;
    font-size: 10px;
    font-weight: 700;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    color: #8db9ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .2em;
  }

  .empty-state {
    padding: 48px 20px;
    border: 1px dashed var(--line);
    border-radius: 16px;
    text-align: center;
    color: var(--muted);
  }

  .empty-state h3 {
    color: var(--text);
    font-size: 16px;
  }

  .empty-state p {
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .hero {
      padding: 75px 0 65px;
    }

    .featured-card {
      grid-template-columns: 1fr;
    }

    .featured-image,
    .featured-image img {
      min-height: 190px;
      height: 190px;
    }

    .featured-content {
      padding: 23px;
    }

    .featured-content h3 {
      font-size: 21px;
    }

    .articles-section {
      padding-top: 60px;
    }
  }

  @media (max-width: 480px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 42px;
    }

    .section-heading h2 {
      font-size: 22px;
    }
  }
</style>

