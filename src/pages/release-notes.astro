const entries = [
  { date: "2026-11-11", version: "KNOT Admin PWA", title: "ブログ管理画面をアプリとしてインストール可能に", description: "TinaCMS管理画面専用のWeb App Manifest・アイコン・Service Workerを追加。ホーム画面やデスクトップへKNOT Adminとしてインストールでき、スタンドアロン表示に対応。記事編集画面・認証情報・APIレスポンスはキャッシュせず、オフライン時は専用案内ページを表示する安全寄りのネットワーク優先構成。" },
  { date: "2026-11-11", version: "ブログ編集機能の拡張", title: "Markdown直接編集・書式ツール・記事プレビュー導線を追加", description: "本文エディターにMarkdownソース編集モード（Raw）を追加し、見出し・太字・斜体・リンク・画像・引用・リスト・コード・表の編集ツールを整理。記事ファイル名を編集画面の先頭に表示してURLスラッグの説明を追加し、記事プレビューへのルーティングも設定。既存のMarkdown本文形式と公開記事URLは維持。" },
  { date: "2026-11-11", version: "TinaCMS日本語化・編集画面改善", title: "ブログ管理画面の日本語表示と日付入力を改善", description: "TinaCMS管理画面によく使う操作ラベルの日本語表示を追加。公開日時・予約公開日時・更新日の表示形式を日本語の日付と24時間表記に統一し、各項目に入力ガイドを追加。既存記事と公開URLは変更せず、CMSビルド時に日本語補助スクリプトを自動配置する構成に変更。" },
  { date: "2026-11-11", version: "ブログ改善", title: "英単語帳の記事におすすめ参考書を追加・上部ナビを改善", description: "英単語の覚え方記事に、英検の級別パス単・システム英単語Basic・システム英単語の特徴と選び方、出版社公式ページへのリンクを追加。KNOT上部ナビゲーションをHOME・記事・NEWSの3タブに整理し、現在地が分かるアクティブ表示を追加。" },
  { date: "2026-11-11", version: "記事表示の整理", title: "AI生成の注意書き・ラベルを記事表示から削除", description: "ブログ記事本文のAI生成に関する定型注意書き、記事詳細の注意バナーとラベル、トップページ・記事一覧・NEWS一覧のAI生成表示を削除。出典や公式情報へのリンクは記事内に残し、記事の分類に必要な内部メタデータは維持。" },
  { date: "2026-11-11", version: "ブログ記事追加", title: "英単語帳の覚え方を解説する実践記事を公開", description: "英単語帳を何周しても覚えられない人向けに、知らない単語の洗い出し、10語ずつの学習、翌日・3日後・1週間後の復習、よくある質問をカジュアルな読みやすい構成で解説。武田塾津校の記事を学習法の参考資料として明記し、文章は独自に執筆。" },
  { date: "2026-11-11", version: "サイト導線の整理", title: "KNOT本体とStudyの入口を分離", description: "KNOT本体のヘッダーナビゲーションを「記事」「NEWS」の2項目に整理し、Studyへの直接タブを削除。Studyは独立リポジトリ knotspace/study の学習アプリとして扱い、MAPのStudyカードを独立した学習スペースであることが分かる説明へ更新。MAPからStudyへ移動する導線は維持。KNOT本体とStudyのソースコード・デプロイはそれぞれのリポジトリで管理する構成。" },
  { date: "2026-11-11", version: "ブログ記事追加", title: "英検準2級プラスの新設背景を解説する記事を公開", description: "準2級から2級までの合格期間に関する英検協会の公式データ（約18か月・約21か月の推計）を区別して紹介し、31年ぶりの新設背景、学力差、学習者の成功体験、名称の意図を解説する記事をブログに追加。英検協会の特設サイト・2025年4月18日発表・2023年9月29日発表を出典として掲載。" },
  { date: "2026-11-10", version: "昼の手動実行（トレンド記事・SEO・セキュリティ）", title: "若者トレンド解説記事を追加し、VOTE MATCHのSEOを整備", description: "SHIBUYA109 lab.トレンド大賞2026を、15〜24歳女性676人を対象とした調査であることを明記して解説するトレンド記事を追加。記事はcontentType: trend / aiGenerated: trueとして通常記事一覧から分離し、AIまとめ記事タブ向けに設定。VOTE MATCHにはトップ・概要ページのcanonical、回答・結果ページのnoindex、sitemap.xml、robots.txtを追加。KNOTの公開サイト監査ワークフローではGitHub Actionsの可変タグ参照2件を完全なSHAへ固定し、Semgrep成功を確認。VOTE MATCHのPagesデプロイとKNOTのビルド/デプロイ/Playwright監査は実行中で、公開URLでの最終反映は未確認。" },
  { date: "2026-11-10", version: "昼の手動実行（セキュリティ修正）", title: "公開サイト監査ワークフローの依存アクションをSHA固定", description: "Semgrepが公開サイト監査ワークフロー内のGitHub Actions参照2件（actions/checkout@v4、actions/setup-node@v4）を可変タグとして検出したため、公式リポジトリのv4タグが指す完全なコミットSHAへ固定。修正コミット ad5cb890bb1694db74a98a3768811ef7b636ad42 ではSemgrepが成功。KNOTのAstroビルド・Pagesデプロイ・Playwright/axe監査はこの実行時点で進行中のため、公開反映や全サイト監査の完了とは扱っていない。公開リポジトリ9件のmain構成を再確認し、Study共通問題1,171問・公立入試問題323問・TT用具カタログ107件のID重複が0件であることを構造確認。これらの新規追加は今回行っていない。青の分岐点のUIは変更せず、ソースコード使用クレジットが見つからない点を要確認として記録。ブログ記事、Study問題100問、用具50件・技術50件の新規追加、VOTE MATCH/TRACE LAB/ORBIT LABの機能改善、全ページの実機確認は未完了。" },
  { date: "2026-11-10", version: "昼の手動実行（16:40 JST）", title: "国際卓球大会の日程ステータスを更新・全リポジトリ構成を確認", description: "TT INSIGHTの国際大会データを更新。公式ITTFカレンダーで11月7〜9日のWTT Youth Star Contender Podgoricaを終了、11月9〜15日のITTF-Americas Masters Caracasと11月10〜15日のWTT Contender Istanbulを開催中へ変更し、world-data.jsonを更新（コミット 59bcf1d）。公開リポジトリ9件のmainと主要ファイル構成を棚卸し。青の分岐点の現行ソースにはrs-developing様のソースコード使用クレジットが見つからず、受験戦争は復旧作業中の案内ページで本体未復元。既存ゲームUIは変更していません。全公開サイトのPlaywright/axe実機監査、公開URLの操作確認、ブログ新規記事・Study問題100問・用具50件・技術50件の追加は今回未実施。監査スクリプトとGitHub Actionsワークフローの存在は確認したものの、今回の実行ログは取得できず、完了扱いにしていません。" },
  { date: "2026-11-09", version: "朝の実行 #2（08:43 JST）", title: "MAPのプロジェクト一覧を再同期し、重複導線を解消", description: "公開リポジトリ9件と直近のデプロイ履歴を再確認。MAPではORBIT LAB内に掲載済みのTRACE LABを重複カードとして別掲していたため整理し、GitHub Pagesのデプロイ成功を確認できたVOTE MATCHを追加。カード14件・ネットワーク図14ノード・リンク73本・ユニーク宛先64件・MAP PWAキャッシュv30・KNOT内Studyサブページ用SW v4を同期。MAPの余分な閉じタグ4件を修正し、TIMERのリンクを正規ルート `/timer/` に統一しました。TRACE LABでは訪問者フォームの任意項目・作成者への共有・データ保存期間の未確認事項を明示し、API送信先を固定Workerに限定。VOTE MATCHの公開URLと全サイトの実機表示は今回未確認です。KNOTブログの朝記事2本、NEWS 08:32 JST版、Study当日125問の追加はmainに既に存在するため重複作成を回避。さらに問題データ4ファイルの重複候補11問を別内容へ修正し、完全一致問題0件を確認。独立Study PWAのSWをv23へ更新。用具データは当日50件を追加し、カタログ56件・個別ページ56件のID重複0件。技術ガイドは当日50項目を追加して合計70項目へ拡張し、重複タイトルを整理して70項目すべてを固有化。knotspace.github.ioのGitHub Actionsは成功履歴を確認しましたが、Vercelチェックはビルドレート制限で失敗しています。" },
  { date: "2026-11-09", version: "朝の実行 #1", title: "NEWSの誤リンク修正・記事図版追加・TT INSIGHTの内容品質改善", description: "KNOT NEWSの主役記事とリンクの不一致を修正し、6項目と119番の日の情報を更新。ブログのAI生成記事2本にオリジナル図版を追加し、制度・予算の説明を正確化。TT INSIGHTではWTTフランクフルト結果、ITTFランキングの確認時点、技術解説12件を改善。AAAの空の著作表示リンクを公式URLへ修正。Studyは本日分の追加済みデータを確認し、重複登録を回避。古い演習リンクと公開分類語を中立化し、個人スペースの挨拶・学年表示も一般化。MAPは公開URL未確認のVOTE MATCHカードと転送ページへのリンクを除外して14件に整理。Release notesは最新6回分、PWAキャッシュはv18へ更新。GitHub更新は成功しましたが、Vercelの別チェックはビルドレート制限で失敗し、Actions全履歴とPages本番反映は未確認です。" },
  { date: "2026-11-09", version: "朝の更新", title: "KNOT NEWS・ブログ・Studyの朝更新と公開情報の整理", description: "NEWSを独立ページとして更新し、通常ブログ4本とオリジナル図版2点、Studyの問題125問、卓球技術30項目と公式確認済み用具50件を追加し、TT INSIGHTに68 URLのサイトマップとrobots.txtを追加。AI生成記事表示をトップ・一覧・詳細に統一し、MAPの導線とPWAキャッシュを更新。公開反映と全URLの実機確認はActionsで確認中です。" },
];
