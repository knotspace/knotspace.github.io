<!doctype html>
<html lang="ja">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#000000" /><meta name="description" content="KNOTSPACEが運営する各サイト・学習サービス・ゲームの更新履歴。機能追加、改善、不具合修正を掲載しています。" /><link rel="canonical" href="https://knotspace.github.io/release-notes/" /><meta property="og:type" content="website" /><meta property="og:site_name" content="KNOTSPACE" /><meta property="og:title" content="リリースノート｜KNOTSPACE" /><meta property="og:description" content="KNOTSPACE各サイトの更新履歴と改善内容。" /><meta property="og:url" content="https://knotspace.github.io/release-notes/" /><title>リリースノート｜KNOTSPACE</title></head>
<body>
<main>
