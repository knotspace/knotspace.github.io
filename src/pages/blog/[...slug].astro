
---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;
const { Content, headings } = await post.render();

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const toc = headings.filter((heading) =>
  heading.depth === 2 || heading.depth === 3
);

const date = dateFormat(post.data.pubDate);
---

<Layout
  title={`${post.data.title} | KNOT`}
  description={post.data.description}
  image={post.data.heroImage}
>
  <article class="post">
    <a class="back-link" href={`${BASE}blog/`}>
      ← 記事一覧に戻る
    </a>

    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {date}
        </time>

        <span class="meta-divider"></span>
        <span>{post.data.category}</span>

        {post.data.updatedDate && (
          <>
            <span class="meta-divider"></span>
            <span>更新：{dateFormat(post.data.updatedDate)}</span>
          </>
        )}
      </div>

      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
    </header>

    {post.data.heroImage && (
      <img class="hero-image" src={post.data.heroImage} alt="" />
    )}

    {toc.length > 0 && (
      <nav class="toc" aria-label="目次">
        <div class="toc-heading">
          <span class="toc-icon">☷</span>
          <span>目次</span>
          <span class="toc-count">{toc.length}項目</span>
        </div>

        <ol>
          {toc.map((heading) => (
            <li class:list={[`toc-level-${heading.depth}`]}>
              <a href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-content">
      <Content />
    </div>

    <div class="post-end">
      <span class="end-mark">✳</span>
      <p>最後まで読んでくれてありがとう。</p>
      <a href={`${BASE}blog/`}>
        ほかの記事も読んでみる
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- コメント欄 -->
    <section class="comments" aria-label="コメント">
      <div class="comments-heading">
        <span class="comments-label">DISCUSSION</span>
        <h2>コメント</h2>
        <p>この記事について、気軽にコメントしてね。</p>
      </div>

      <div class="giscus-container">
        <script
          src="https://giscus.app/client.js"
          data-repo="knotspace/knotspace.github.io"
          data-repo-id="R_kgDOVfFtzQ"
          data-category="General"
          data-category-id="DIC_kwDOVfFtzc4DKNL2"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang="ja"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </section>
  </article>
</Layout>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: 45px 0 20px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 34px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    transition: color .2s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    padding-bottom: 29px;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
  }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    margin: 21px 0 13px;
    font-size: clamp(30px, 5vw, 47px);
    line-height: 1.4;
    letter-spacing: -.065em;
    font-weight: 900;
    color: var(--text);
  }

  .description {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 2;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-height: 410px;
    margin: 30px 0 38px;
    border-radius: 17px;
    object-fit: cover;
  }

  /* 目次 */
  .toc {
    margin: 32px 0 42px;
    padding: 23px 26px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }

  .toc-heading {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 14px;
    font-weight: 800;
  }

  .toc-icon {
    color: var(--accent);
    font-size: 18px;
  }

  .toc-count {
    margin-left: auto;
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
  }

  .toc ol {
    margin: 13px 0 0;
    padding: 0;
    list-style: none;
  }

  .toc li {
    margin: 0;
    padding: 0;
  }

  .toc li a {
    display: block;
    padding: 7px 0;
    color: var(--article-text);
    font-size: 12px;
    line-height: 1.7;
    text-decoration: none;
    transition: color .2s, transform .2s;
  }

  .toc li a::before {
    content: "›";
    margin-right: 9px;
    color: var(--accent);
  }

  .toc li a:hover {
    color: var(--accent);
    transform: translateX(3px);
  }

  .toc .toc-level-3 {
    padding-left: 19px;
  }

  .toc .toc-level-3 a {
    color: var(--muted);
    font-size: 11px;
  }

  /* 記事本文 */
  .article-content {
    color: var(--text);
    font-size: 15px;
    line-height: 2.15;
    overflow-wrap: anywhere;
  }

  .article-content :global(h2) {
    scroll-margin-top: 24px;
    margin: 2.2em 0 .8em;
    padding-left: 15px;
    border-left: 3px solid var(--accent);
    color: var(--text);
    font-size: 23px;
    line-height: 1.5;
    letter-spacing: -.04em;
  }

  .article-content :global(h3) {
    scroll-margin-top: 24px;
    margin: 2em 0 .65em;
    color: var(--text);
    font-size: 18px;
  }

  .article-content :global(p) {
    margin: 1.15em 0;
    color: var(--article-text);
  }

  .article-content :global(strong) {
    color: var(--text);
    font-weight: 800;
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 1.5em;
    color: var(--article-text);
  }

  .article-content :global(li) {
    padding-left: .25em;
    margin: .35em 0;
  }

  .article-content :global(blockquote) {
    margin: 1.8em 0;
    padding: 5px 20px;
    border-left: 2px solid var(--accent);
    color: var(--article-text);
    background: var(--surface);
  }

  .article-content :global(blockquote p) {
    color: var(--article-text);
  }

  .article-content :global(code) {
    padding: .15em .4em;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--code-bg);
    color: var(--accent);
    font-size: .88em;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--code-bg);
    color: var(--text);
    line-height: 1.7;
  }

  .article-content :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .article-content :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  /* 記事の最後 */
  .post-end {
    margin-top: 65px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    text-align: center;
  }

  .end-mark {
    color: var(--accent);
    font-size: 23px;
  }

  .post-end p {
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
  }

  .post-end a {
    display: inline-block;
    margin-top: 8px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
  }

  /* コメント欄 */
  .comments {
    margin-top: 65px;
    padding-top: 35px;
    border-top: 1px solid var(--line);
  }

  .comments-heading {
    margin-bottom: 25px;
  }

  .comments-label {
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .comments-heading h2 {
    margin: 8px 0;
    color: var(--text);
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -.05em;
  }

  .comments-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .giscus-container {
    min-height: 150px;
    width: 100%;
  }

  @media (max-width: 600px) {
    .post {
      padding-top: 30px;
    }

    .article-content {
      font-size: 14px;
    }

    .article-content :global(h2) {
      font-size: 21px;
    }

    .hero-image {
      margin: 22px 0 28px;
    }

    .toc {
      padding: 19px;
      margin: 25px 0 34px;
    }

    .comments {
      margin-top: 50px;
      padding-top: 28px;
    }
  }
</style>
