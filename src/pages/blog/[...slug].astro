
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout
  title="記事一覧 | KNOT"
  description="KNOTで公開している記事の一覧です。"
>
  <section class="archive-header">
    <span class="eyebrow">THE JOURNAL</span>
    <h1>記事一覧</h1>
    <p>これまでに書いた記事をまとめています。</p>
    <span class="post-count">{posts.length} ARTICLES</span>
  </section>

  <section class="archive-content">
    {posts.length === 0 ? (
      <div class="empty-state">
        <h2>記事はまだありません。</h2>
        <p>最初の記事を公開すると、ここに表示されます。</p>
      </div>
    ) : (
      <div class="post-list">
        {posts.map((post, index) => (
          <a class="post-item" href={`${BASE}blog/${post.slug}/`}>
            <div class="post-thumbnail">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt="" loading="lazy" />
              ) : (
                <span>{String(index + 1).padStart(2, '0')}</span>
              )}
            </div>

            <div class="post-info">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat(post.data.pubDate)}
                </time>
                <span class="meta-divider"></span>
                <span>{post.data.category}</span>
              </div>

              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="read-more">続きを読む ↗</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <div class="back-home">
    <a href={BASE}>← トップページに戻る</a>
  </div>
</Layout>

<style>
  .archive-header {
    padding: 65px 0 35px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .17em;
  }

  .archive-header h1 {
    margin: 15px 0 10px;
    font-size: 38px;
    letter-spacing: -.06em;
  }

  .archive-header p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
  }

  .post-count {
    display: inline-block;
    margin-top: 21px;
    color: #718198;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .archive-content {
    padding-top: 15px;
  }

  .post-list {
    border-top: 1px solid var(--line);
  }

  .post-item {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 25px;
    align-items: center;
    padding: 23px 8px;
    border-bottom: 1px solid var(--line);
    transition: background .2s;
  }

  .post-item:hover {
    background: rgba(255,255,255,.025);
  }

  .post-thumbnail {
    display: grid;
    place-items: center;
    width: 180px;
    height: 115px;
    overflow: hidden;
    border-radius: 10px;
    background: #172740;
    color: #8db9ff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .15em;
  }

  .post-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: #8fa0b7;
    font-size: 10px;
    font-weight: 600;
  }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .post-info h2 {
    margin: 12px 0 8px;
    font-size: 19px;
    line-height: 1.5;
    letter-spacing: -.04em;
  }

  .post-info p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
  }

  .read-more {
    display: inline-block;
    margin-top: 13px;
    color: #a9caff;
    font-size: 10px;
    font-weight: 700;
  }

  .empty-state {
    margin-top: 20px;
    padding: 45px 20px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    text-align: center;
    color: var(--muted);
  }

  .empty-state h2 {
    color: var(--text);
    font-size: 17px;
  }

  .empty-state p {
    font-size: 12px;
  }

  .back-home {
    padding-top: 30px;
    text-align: center;
  }

  .back-home a {
    color: #a9caff;
    font-size: 12px;
  }

  @media (max-width: 580px) {
    .archive-header {
      padding-top: 48px;
    }

    .archive-header h1 {
      font-size: 32px;
    }

    .post-item {
      grid-template-columns: 105px minmax(0, 1fr);
      gap: 14px;
      padding: 16px 3px;
    }

    .post-thumbnail {
      width: 105px;
      height: 85px;
    }

    .post-info h2 {
      margin: 8px 0 5px;
      font-size: 14px;
    }

    .post-info p {
      display: none;
    }

    .read-more {
      margin-top: 9px;
    }
  }
</style>
