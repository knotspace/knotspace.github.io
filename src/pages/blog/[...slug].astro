
---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection('blog')).filter((post) => !post.data.publishAt || post.data.publishAt <= now);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;
const { Content, headings } = await render(post);

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const toc = headings.filter((heading) =>
  heading.depth === 2 || heading.depth === 3
);

const isDateOnly = post.data.pubDate.getUTCHours() === 0 && post.data.pubDate.getUTCMinutes() === 0 && post.data.pubDate.getUTCSeconds() === 0;
const date = post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: isDateOnly ? 'UTC' : 'Asia/Tokyo' });
const time = isDateOnly ? '00:00' : post.data.pubDate.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Tokyo' });
const articleText = (post.body ?? '').replace(/\!\[[^\]]*\]\([^)]*\)/g, ' ').replace(/<[^>]+>/g, ' ').replace(/[#>*_\x60~|\[\](){}]/g, ' ');
const readingMinutes = Math.max(1, Math.ceil(articleText.replace(/\s/g, '').length / 500));
const allPosts = (await getCollection('blog')).filter((item) => item.id !== post.id && (!item.data.publishAt || item.data.publishAt <= new Date()));
const relatedPosts = allPosts.filter((item) => item.data.category === post.data.category).slice(0, 3);
const recommendations = relatedPosts.length ? relatedPosts : allPosts.slice(0, 3);
const articleUrl = new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url).href;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  url: articleUrl,
  author: { '@type': 'Person', name: 'KNOT Editor' },
  publisher: { '@type': 'Organization', name: 'KNOT', url: 'https://knotspace.github.io/' },
  inLanguage: 'ja-JP',
  articleSection: post.data.category,
  ...(post.data.heroImage ? { image: new URL(post.data.heroImage, Astro.url).href } : {}),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://knotspace.github.io/' },
    { '@type': 'ListItem', position: 2, name: '記事一覧', item: 'https://knotspace.github.io/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};
---

<Layout
  title={`${post.data.title} | KNOT`}
  description={post.data.description}
  image={post.data.heroImage}
  structuredData={[articleJsonLd, breadcrumbJsonLd]}
>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <div class="article-layout">
  <article class="post" data-post-slug={post.id}>
    <div class="article-tools"><span>この記事を読む</span><div class="tool-actions"><button id="share-button" type="button">↗ リンクをコピー</button><button id="bookmark-button" type="button" aria-pressed="false">☆ あとで読む</button></div></div>
    <a class="back-link" href={`${BASE}blog/`}>
      ← 記事一覧に戻る
    </a>

    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {date} {time}
        </time>

        <span class="meta-divider"></span>
        <span class="category-chip">{post.data.category}</span>
        <span class="reading-time">約{readingMinutes}分で読めます</span>

        {post.data.updatedDate && (
          <>
            <span class="meta-divider"></span>
            <span>更新：{dateFormat(post.data.updatedDate)}</span>
          </>
        )}
      </div>

      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="article-byline"><span>✎ KNOT</span><span>読了目安 約{readingMinutes}分</span><span>本文をゆっくり読んでね。</span></div>
    </header>

    {post.data.heroImage && (
      <img class="hero-image" src={post.data.heroImage} alt={post.data.title} loading="eager" fetchpriority="high" decoding="async" />
    )}



    <div class="article-content">
      <Content />
    </div>

    <div class="article-reaction">
      <p>この記事がよかったら、リアクションしてね。</p>
      <button id="like-button" type="button" aria-pressed="false">♡ <span id="like-label">いいね</span></button>
      <small><span id="like-count">読み込み中...</span> ・ 閲覧 <span id="view-count">読み込み中...</span></small>
    </div>

    <section class="share-panel" aria-label="記事をシェア">
      <div><span class="comments-label">SHARE THIS ARTICLE</span><h2>この記事をシェアする</h2><p>気に入ったら、友だちにも教えてね。</p></div>
      <div class="share-actions">
        <a class="share-x" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noopener noreferrer">𝕏　Xでシェア</a>
        <a class="share-line" href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noopener noreferrer">LINEで送る</a>
        <button class="share-copy" type="button" data-share-copy>URLをコピー</button>
      </div>
    </section>

    <div class="post-end">
      <span class="end-mark">✳</span>
      <p>最後まで読んでくれてありがとう。</p>
      <a href={`${BASE}blog/`}>
        ほかの記事も読んでみる
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {recommendations.length > 0 && <section class="related"><span class="comments-label">KEEP READING</span><h2>関連記事</h2><div class="related-list">{recommendations.map((item) => <a href={`${BASE}blog/${item.id}/`}><span>{item.data.category}</span><strong>{item.data.title}</strong><small>記事を読む →</small></a>)}</div></section>}

    <!-- コメント欄 -->
    <section class="comments" aria-label="コメント">
      <div class="comments-heading">
        <span class="comments-label">DISCUSSION</span>
        <h2>コメント</h2>
        <p>この記事について、気軽にコメントしてね。</p>
      </div>

      <div class="giscus-container">
        <script is:inline
          src="https://giscus.app/client.js"
          data-repo="knotspace/knotspace.github.io"
          data-repo-id="R_kgDOVfFtzQ"
          data-category="General"
          data-category-id="DIC_kwDOVfFtzc4DKNL2"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang="ja"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </section>
  </article>
  <aside class="article-sidebar" aria-label="記事ナビゲーション">
    <section class="article-side-widget"><h2>お知らせ</h2><p>KNOTの記事を読んでくれてありがとう！新しい記事も随時更新中。</p><a href={`${BASE}blog/`}>記事一覧を見る »</a></section>
    {toc.length > 0 && <nav class="article-side-widget side-toc" aria-label="目次"><h2>目次</h2><ol>{toc.map((heading) => <li class:list={[`toc-level-${heading.depth}`]}><a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a></li>)}</ol></nav>}
  </aside>
  </div>
</Layout>

<script is:inline>
(() => {
  const links = Array.from(document.querySelectorAll('[data-toc-link]'));
  const headings = links.map(link => document.getElementById(link.dataset.tocLink)).filter(Boolean);
  if (!links.length || !headings.length) return;
  const activate = (id) => links.forEach(link => {
    const active = link.dataset.tocLink === id;
    link.classList.toggle('is-current', active);
    if (active) link.setAttribute('aria-current', 'location');
    else link.removeAttribute('aria-current');
  });
  const observer = new IntersectionObserver(entries => {
    const visible = entries.filter(entry => entry.isIntersecting).sort((a,b) => a.boundingClientRect.top - b.boundingClientRect.top);
    if (visible[0]) activate(visible[0].target.id);
  }, { rootMargin: '-12% 0px -72% 0px', threshold: 0 });
  headings.forEach(heading => observer.observe(heading));
  if (location.hash) activate(decodeURIComponent(location.hash.slice(1)));
  else activate(headings[0].id);
})();
</script>

<script is:inline>
(() => {
  const progress = document.getElementById('reading-progress');
  const button = document.getElementById('bookmark-button');
  const shareButton = document.getElementById('share-button');
  const likeButton = document.getElementById('like-button');
  const article = document.querySelector('[data-post-slug]');
  if (progress) {
    const update = () => { const max = document.documentElement.scrollHeight - window.innerHeight; progress.style.width = `${max > 0 ? Math.min(100, window.scrollY / max * 100) : 0}%`; };
    window.addEventListener('scroll', update, { passive: true }); window.addEventListener('resize', update); update();
  }
  const copyArticleUrl = async (target) => {
    try {
      await navigator.clipboard.writeText(location.href);
      target.textContent = '✓ コピーしました';
      window.setTimeout(() => { target.textContent = target.dataset.shareCopy !== undefined ? 'URLをコピー' : '↗ リンクをコピー'; }, 1800);
    } catch {
      target.textContent = 'コピーできませんでした';
    }
  };
  if (shareButton) shareButton.addEventListener('click', () => copyArticleUrl(shareButton));
  document.querySelectorAll('[data-share-copy]').forEach((target) => {
    target.addEventListener('click', () => copyArticleUrl(target));
  });
  if (likeButton && article) {
    const SUPABASE_URL = 'https://rtzorqaigpeechqywjie.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_-yhc0QqTEEZTBWi9jTcFRA_-AVi-iP6';
    const slug = article.dataset.postSlug;
    const likedKey = `knot-liked:${slug}`;
    const visitorKey = 'knot-visitor-id';
    const label = document.getElementById('like-label');
    const likeCount = document.getElementById('like-count');
    const viewCount = document.getElementById('view-count');

    const getVisitorId = () => {
      let id = localStorage.getItem(visitorKey);
      if (!id) {
        id = crypto.randomUUID();
        localStorage.setItem(visitorKey, id);
      }
      return id;
    };

    const headers = {
      apikey: SUPABASE_KEY,
      Authorization: `Bearer ${SUPABASE_KEY}`,
      'Content-Type': 'application/json',
    };

    const paintLike = () => {
      const liked = localStorage.getItem(likedKey) === '1';
      likeButton.setAttribute('aria-pressed', String(liked));
      likeButton.classList.toggle('liked', liked);
      likeButton.disabled = liked;
      if (label) label.textContent = liked ? 'ありがとう！' : 'いいね';
      likeButton.firstChild.textContent = liked ? '♥ ' : '♡ ';
    };

    const loadStats = async () => {
      try {
        const response = await fetch(
          `${SUPABASE_URL}/rest/v1/article_stats?slug=eq.${encodeURIComponent(slug)}&select=views,likes`,
          { headers }
        );
        if (!response.ok) throw new Error('stats request failed');
        const rows = await response.json();
        const stats = rows[0] || { views: 0, likes: 0 };
        if (likeCount) likeCount.textContent = `${Number(stats.likes).toLocaleString('ja-JP')} いいね`;
        if (viewCount) viewCount.textContent = `${Number(stats.views).toLocaleString('ja-JP')} 回`;
      } catch {
        if (likeCount) likeCount.textContent = 'いいね数を取得できません';
        if (viewCount) viewCount.textContent = '閲覧数を取得できません';
      }
    };

    const countView = async () => {
      const viewedKey = `knot-viewed:${slug}:${new Date().toISOString().slice(0, 10)}`;
      if (sessionStorage.getItem(viewedKey)) return;
      sessionStorage.setItem(viewedKey, '1');
      try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/rpc/increment_article_view`, {
          method: 'POST',
          headers,
          body: JSON.stringify({ article_slug: slug }),
        });
        if (!response.ok) throw new Error('view count failed');
      } catch {}
      await loadStats();
    };

    paintLike();
    loadStats();
    countView();

    likeButton.addEventListener('click', async () => {
      if (localStorage.getItem(likedKey) === '1') return;
      likeButton.disabled = true;
      try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/rpc/like_article`, {
          method: 'POST',
          headers,
          body: JSON.stringify({
            article_slug: slug,
            p_visitor_id: getVisitorId(),
          }),
        });
        if (!response.ok) throw new Error('like request failed');
        localStorage.setItem(likedKey, '1');
        paintLike();
        await loadStats();
      } catch {
        likeButton.disabled = false;
        if (label) label.textContent = '通信エラー・再試行';
      }
    });
  }
  if (button && article) {
    const key = 'knot-bookmarks'; const slug = article.dataset.postSlug;
    const read = () => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
    const paint = () => { const saved = read().includes(slug); button.textContent = saved ? '★ 保存済み' : '☆ あとで読む'; button.setAttribute('aria-pressed', String(saved)); };
    paint(); button.addEventListener('click', () => { const items = read(); const next = items.includes(slug) ? items.filter(x => x !== slug) : [...items, slug]; localStorage.setItem(key, JSON.stringify(next)); paint(); });
  }
})();
</script>

<style>
  .article-layout{display:grid;grid-template-columns:minmax(0,760px) 270px;gap:38px;align-items:start;max-width:1100px;margin:0 auto}
  .article-layout .post{width:100%;max-width:none;min-width:0}
  .article-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:18px;padding-top:48px}
  .article-side-widget{border:1px solid var(--line);background:var(--surface);padding:0}
  .article-side-widget h2{margin:0;padding:12px 14px;border-bottom:1px solid var(--line);border-left:4px solid var(--accent);font-size:14px}
  .article-side-widget p{margin:12px 14px;color:var(--muted);font-size:11px;line-height:1.8}
  .article-side-widget>a{display:block;margin:0 14px 14px;color:var(--accent);font-size:11px;font-weight:700}
  .side-toc{max-height:calc(100vh - 170px);overflow:auto}
  .side-toc ol{list-style:none;margin:0;padding:9px 12px 12px}
  .side-toc li{margin:0;padding:0}
  .side-toc li a{display:block;padding:8px 9px;border-left:2px solid transparent;color:var(--muted);font-size:11px;line-height:1.65;transition:color .15s,border-color .15s,background .15s}
  .side-toc li.toc-level-3{padding-left:12px}
  .side-toc li a:hover{color:var(--accent)}
  .side-toc li a.is-current{border-left-color:var(--accent);color:var(--accent);background:var(--surface-soft);font-weight:800}
  @media(max-width:1050px){.article-layout{grid-template-columns:minmax(0,1fr) 235px;gap:24px}}
  @media(max-width:760px){.article-layout{display:flex;flex-direction:column;gap:24px}.article-layout .post{padding-top:25px}.article-sidebar{position:static;width:100%;padding-top:0;display:grid;grid-template-columns:1fr}.side-toc{max-height:none}.side-toc ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}}
  .reading-progress{position:fixed;z-index:1000;top:0;left:0;width:0;height:3px;background:var(--accent);transition:width .08s linear}
  .article-tools{display:flex;justify-content:space-between;align-items:center;margin:0 0 20px;color:var(--muted);font-size:11px}
  .tool-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.article-tools button{border:1px solid var(--line);border-radius:999px;padding:8px 13px;background:var(--surface);color:var(--text);font-size:11px;font-weight:700;cursor:pointer}
  .article-reaction{display:flex;flex-direction:column;align-items:center;gap:9px;margin:38px 0 12px;padding:24px 16px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .share-panel{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:22px 0 12px;padding:22px;border:1px solid var(--line);border-radius:15px;background:var(--surface)}
  .share-panel h2{margin:6px 0;font-size:18px;color:var(--text)}.share-panel p{margin:0;color:var(--muted);font-size:11px}
  .share-actions{display:flex;gap:8px;flex-wrap:wrap}.share-actions a,.share-actions button{display:inline-flex;align-items:center;justify-content:center;padding:10px 13px;border:1px solid var(--line);border-radius:999px;background:var(--bg);color:var(--text);font:700 11px system-ui;text-decoration:none;cursor:pointer}.share-actions .share-x{background:#111;color:#fff;border-color:#111}.share-actions .share-line{color:#159b49;border-color:#159b49}
  .article-reaction p{margin:0;color:var(--muted);font-size:12px}
  .article-reaction button{border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:999px;padding:10px 22px;font-size:13px;font-weight:800;cursor:pointer}
  .article-reaction button.liked{color:#e66b8a;border-color:#e66b8a}
  .article-reaction small{color:var(--muted);font-size:10px}
  .related{margin-top:55px;padding-top:32px;border-top:1px solid var(--line)}.related h2{margin:8px 0 18px;color:var(--text);font-size:23px}.related-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.related-list a{display:flex;flex-direction:column;gap:9px;padding:18px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.related-list span,.related-list small{color:var(--muted);font-size:10px}.related-list strong{color:var(--text);font-size:13px;line-height:1.7}.related-list small{margin-top:auto;color:var(--accent)}
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: 45px 0 20px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 34px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    transition: color .2s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    padding-bottom: 29px;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
  }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    margin: 21px 0 13px;
    font-size: clamp(30px, 5vw, 47px);
    line-height: 1.4;
    letter-spacing: -.065em;
    font-weight: 900;
    color: var(--text);
  }

  .description {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 2;
  }
  .category-chip{padding:4px 9px;border-radius:3px;background:var(--accent);color:#fff;font-size:10px;font-weight:800}
  .reading-time{color:var(--muted);font-size:10px}
  .article-byline{display:flex;gap:16px;flex-wrap:wrap;margin-top:18px;padding-top:13px;border-top:1px solid var(--line);color:var(--muted);font-size:10px}
  .article-byline span:first-child{color:var(--accent);font-weight:800}


  .hero-image {
    display: block;
    width: 100%;
    max-height: 410px;
    margin: 30px 0 38px;
    border-radius: 17px;
    object-fit: cover;
  }

  /* 目次 */
  .toc {
    margin: 32px 0 42px;
    padding: 23px 26px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }

  .toc-heading {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 14px;
    font-weight: 800;
  }

  .toc-icon {
    color: var(--accent);
    font-size: 18px;
  }

  .toc-count {
    margin-left: auto;
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
  }

  .toc ol {
    margin: 13px 0 0;
    padding: 0;
    list-style: none;
  }

  .toc li {
    margin: 0;
    padding: 0;
  }

  .toc li a {
    display: block;
    padding: 7px 0;
    color: var(--article-text);
    font-size: 12px;
    line-height: 1.7;
    text-decoration: none;
    transition: color .2s, transform .2s;
  }

  .toc li a::before {
    content: "›";
    margin-right: 9px;
    color: var(--accent);
  }

  .toc li a:hover {
    color: var(--accent);
    transform: translateX(3px);
  }

  .toc .toc-level-3 {
    padding-left: 19px;
  }

  .toc .toc-level-3 a {
    color: var(--muted);
    font-size: 11px;
  }

  /* 記事本文 */
  .article-content {
    color: var(--text);
    font-size: 15px;
    line-height: 2.15;
    overflow-wrap: anywhere;
  }

  .article-content :global(h2) {
    scroll-margin-top: 24px;
    margin: 2.2em 0 .8em;
    padding-left: 15px;
    border-left: 3px solid var(--accent);
    color: var(--text);
    font-size: 23px;
    line-height: 1.5;
    letter-spacing: -.04em;
  }

  .article-content :global(h3) {
    scroll-margin-top: 24px;
    margin: 2em 0 .65em;
    color: var(--text);
    font-size: 18px;
  }

  .article-content :global(p) {
    margin: 1.15em 0;
    color: var(--article-text);
  }

  .article-content :global(strong) {
    color: var(--text);
    font-weight: 800;
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
