
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.publishAt || post.data.publishAt <= now)
  .sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id)
  );

const isAiPost = (post) => post.data.aiGenerated || (post.body ?? '').trimStart().startsWith('**AI生成記事**');
const regularPosts = posts.filter((post) => !isAiPost(post) && post.data.contentType !== 'trend');
const aiSummaryPosts = [];
const categories = [...new Set(regularPosts.map((post) => post.data.category))];
const readingTime = (body = '') => Math.max(1, Math.ceil(body.replace(/\s/g, '').length / 500));
const recommendationScore = (post) => {
  const body = post.body || '';
  const text = `${post.data.title} ${post.data.description} ${body}`;
  const specialistTerms = ['API','CLI','SDK','GitHub','Git','SQL','データベース','アルゴリズム','プログラミング','ソースコード','コマンドライン','サーバー構築','ネットワーク構成','機械学習','統計解析','微分積分','線形代数','暗号化','プロトコル','フレームワーク','ライブラリ','デプロイ','コンパイル','Docker','Linux','正規表現'];
  const termCount = specialistTerms.reduce((sum, term) => sum + (text.toLowerCase().split(term.toLowerCase()).length - 1), 0);
  const categoryPenalty = /プログラミング|技術解説|数学|情報技術|開発/.test(post.data.category) ? 18 : 0;
  const lengthPenalty = Math.max(0, Math.floor((body.length - 6500) / 3500)) * 3;
  return Math.max(0, 100 - Math.min(55, termCount * 4) - categoryPenalty - lengthPenalty);
};

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const isDateOnly = (date: Date) => date.getUTCHours() === 0 && date.getUTCMinutes() === 0 && date.getUTCSeconds() === 0;
const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: isDateOnly(date) ? 'UTC' : 'Asia/Tokyo' });
const timeFormat = (date: Date) => isDateOnly(date) ? '00:00' : date.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Tokyo' });
---

<Layout
  title="記事一覧 | KNOT"
  description="KNOTの記事一覧。Web制作、PC・フリーソフト、Androidアプリ、本・読書、英検や高校受験などの記事を掲載しています。"
>
  <section class="archive-header">
    <span class="eyebrow">THE JOURNAL</span>
    <h1>記事一覧</h1>
    <p>これまでに書いた記事をまとめています。</p>
    <div class="archive-actions">
      <span class="post-count">{regularPosts.length} ARTICLES</span>
      <button type="button" id="random-article" class="random-button">✦ ランダムに読む</button>
    </div>
  </section>

  <nav class="archive-tabs" role="tablist" aria-label="記事の種類">
    <button class="archive-tab active" type="button" role="tab" aria-selected="true" aria-controls="regular-panel" id="regular-tab" data-panel="regular-panel">記事一覧 <span>{regularPosts.length}</span></button>
    
  </nav>

  <div class="content-layout">
    <section class="main-column">
      <div id="regular-panel" class="archive-panel" role="tabpanel" aria-labelledby="regular-tab">
      <div class="filter-area">
        <input
          id="article-search"
          type="search"
          placeholder="記事を検索..."
          aria-label="記事を検索"
        />

        <div class="sort-controls" role="group" aria-label="記事の並び順">
          <span class="sort-label">並び順</span>
          <button class="sort-button active" type="button" data-sort="newest" aria-pressed="true">最新順</button>
          <button class="sort-button" type="button" data-sort="recommended" aria-pressed="false" title="専門用語が少なく、初めてでも読みやすい記事を上位に表示">おすすめ順</button>
          <button class="sort-button" type="button" data-sort="popular" aria-pressed="false">人気順</button>
        </div>
        <div class="category-filters">
          <button class="filter-button active" type="button" data-filter="all">
            すべて
          </button>
          {categories.map((category) => (
            <button
              class="filter-button"
              type="button"
              data-filter={category}
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="archive-list" id="archive-list">
        {regularPosts.map((post, index) => (
          <a
            class="post-card"
            href={`${BASE}blog/${post.id}/`}
            data-category={post.data.category}
            data-title={post.data.title}
            data-description={post.data.description}
            data-reading-time={readingTime(post.body)}
            data-readability={recommendationScore(post)}
            data-popularity={post.data.popularity}
          >
            <div class="post-thumbnail">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async" width="380" height="254" />
              ) : (
                <span>{String(index + 1).padStart(2, '0')}</span>
              )}
            </div>

            <div class="post-info">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat(post.data.pubDate)} {timeFormat(post.data.pubDate)}
                </time>
                <span class="category-label">{post.data.category}</span>
                {post.data.aiGenerated && <span class="category-label">AI生成記事</span>}
                <span class="reading-time">約{readingTime(post.body)}分</span>
              </div>

              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="read-more">続きを読む →</span>
            </div>
          </a>
        ))}
      </div>

      <p class="no-results" id="no-results" hidden>
        該当する記事はありません。
      </p>
      </div>

      <a class="news-page-link" href={`${BASE}news/`}><span class="section-kicker">NEWS / AI GENERATED ARTICLES</span><strong>今日の更新と、これまでに生成したAI記事を見る ↗</strong></a>
    </section>

    <aside class="sidebar">
      <section class="widget">
        <h2 class="widget-title">このブログについて</h2>
        <div class="profile-logo">KNOT<span>.</span></div>
        <p>
          日々感じたことや、興味を持ったことを書いていく備忘録的なブログです。
          日常や勉強のことなどを記録しています。
        </p>
      </section>

      <section class="widget">
        <h2 class="widget-title">カテゴリー</h2>
        <ul class="category-list">
          {categories.map((category) => (
            <li>
              <button type="button" data-sidebar-filter={category}>
                {category} <span>→</span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      <section class="widget">
        <h2 class="widget-title">記事数</h2>
        <p class="total-count">{regularPosts.length} 件の記事を公開中</p>
      </section>
    </aside>
  </div>

  <div class="back-home">
    <a href={BASE}>← トップページに戻る</a>
  </div>
</Layout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.archive-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.archive-panel'));
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const target = tab.dataset.panel;
    tabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle('active', active);
      item.setAttribute('aria-selected', String(active));
    });
    panels.forEach((panel) => { panel.hidden = panel.id !== target; });
  }));

  const searchInput = document.querySelector<HTMLInputElement>('#article-search');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#archive-list .post-card'));
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  );
  const sidebarButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-sidebar-filter]')
  );
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sort]'));
  let activeSort = 'newest';
  const popularity = new Map<string, number>();

  let activeCategory = new URLSearchParams(window.location.search).get('category') || 'all';

  function applySort() {
    const sorted = [...cards].sort((a, b) => {
      if (activeSort === 'recommended') {
        return Number(b.dataset.readability || 0) - Number(a.dataset.readability || 0)
          || new Date(b.querySelector('time')?.getAttribute('datetime') || 0).getTime() - new Date(a.querySelector('time')?.dateTime || 0).getTime();
      }
      if (activeSort === 'popular') {
        const scoreA = popularity.get(a.dataset.title || '') ?? Number(a.dataset.popularity || 0);
        const scoreB = popularity.get(b.dataset.title || '') ?? Number(b.dataset.popularity || 0);
        return scoreB - scoreA || new Date(b.querySelector('time')?.dateTime || 0).getTime() - new Date(a.querySelector('time')?.dateTime || 0).getTime();
      }
      return new Date(b.querySelector('time')?.dateTime || 0).getTime() - new Date(a.querySelector('time')?.dateTime || 0).getTime();
    });
    sorted.forEach((card) => document.querySelector('#archive-list')?.appendChild(card));
    sortButtons.forEach((button) => {
      const active = button.dataset.sort === activeSort;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
  }

  function filterPosts() {
    const keyword = searchInput?.value.trim().toLowerCase() ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const title = card.dataset.title ?? '';
      const description = card.dataset.description ?? '';

      const matchesCategory =
        activeCategory === 'all' || category === activeCategory;

      const matchesSearch =
        `${title} ${description} ${category}`.toLowerCase().includes(keyword);

      const visible = matchesCategory && matchesSearch;
      card.hidden = !visible;

      if (visible) visibleCount++;
    });

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.filter ?? 'all';

      filterButtons.forEach((item) => {
        item.classList.toggle('active', item === button);
      });

      filterPosts();
    });
  });

  sidebarButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.sidebarFilter ?? 'all';

      filterButtons.forEach((item) => {
        item.classList.toggle(
          'active',
          item.dataset.filter === activeCategory
        );
      });

      filterPosts();
      document.querySelector('#archive-list')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    });
  });

  sortButtons.forEach((button) => button.addEventListener('click', () => {
    activeSort = button.dataset.sort || 'newest';
    applySort();
    filterPosts();
  }));
  filterButtons.forEach((item) => item.classList.toggle('active', item.dataset.filter === activeCategory));
  applySort();
  filterPosts();
  fetch('https://rtzorqaigpeechqywjie.supabase.co/rest/v1/article_stats?select=slug,views,likes', {
    headers: { apikey: 'sb_publishable_-yhc0QqTEEZTBWi9jTcFRA_-AVi-iP6', Authorization: 'Bearer sb_publishable_-yhc0QqTEEZTBWi9jTcFRA_-AVi-iP6' }
  }).then((response) => { if (!response.ok) throw new Error('stats unavailable'); return response.json(); })
    .then((rows: Array<{slug:string;views:number;likes:number}>) => {
      const bySlug = new Map(rows.map((row) => [row.slug, (Number(row.views) || 0) + (Number(row.likes) || 0) * 3]));
      cards.forEach((card) => {
        const slug = (card as HTMLAnchorElement).pathname.split('/').filter(Boolean).at(-1) || '';
        popularity.set(card.dataset.title || '', bySlug.get(slug) || 0);
      });
      if (activeSort === 'popular') { applySort(); filterPosts(); }
    }).catch(() => {});
  searchInput?.addEventListener('input', filterPosts);
  const randomButton = document.querySelector<HTMLButtonElement>('#random-article');
  randomButton?.addEventListener('click', () => {
    const visibleCards = cards.filter((card) => !card.hidden);
    if (!visibleCards.length) return;
    const selected = visibleCards[Math.floor(Math.random() * visibleCards.length)];
    if (selected) window.location.href = (selected as HTMLAnchorElement).href;
  });
  const params = new URLSearchParams(window.location.search);
  if (params.get('focus') === 'search' && searchInput) { searchInput.focus(); searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

</script>

