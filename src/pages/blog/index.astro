
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.publishAt || post.data.publishAt <= now)
  .sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id)
  );

const categories = [...new Set(posts.map((post) => post.data.category))];
const readingTime = (body = '') => Math.max(1, Math.ceil(body.replace(/\s/g, '').length / 500));

const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const isDateOnly = (date: Date) => date.getUTCHours() === 0 && date.getUTCMinutes() === 0 && date.getUTCSeconds() === 0;
const dateFormat = (date: Date) => date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: isDateOnly(date) ? 'UTC' : 'Asia/Tokyo' });
const timeFormat = (date: Date) => isDateOnly(date) ? '00:00' : date.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Tokyo' });
---

<Layout
  title="記事一覧 | KNOT"
  description="KNOTの記事一覧。Web制作、PC・フリーソフト、Androidアプリ、本・読書、英検や高校受験などの記事を掲載しています。"
>
  <section class="archive-header">
    <span class="eyebrow">THE JOURNAL</span>
    <h1>記事一覧</h1>
    <p>これまでに書いた記事をまとめています。</p>
    <div class="archive-actions">
      <span class="post-count">{posts.length} ARTICLES</span>
      <button type="button" id="random-article" class="random-button">✦ ランダムに読む</button>
    </div>
  </section>

  <div class="content-layout">
    <section class="main-column">
      <div class="filter-area">
        <input
          id="article-search"
          type="search"
          placeholder="記事を検索..."
          aria-label="記事を検索"
        />

        <div class="category-filters">
          <button class="filter-button active" type="button" data-filter="all">
            すべて
          </button>
          {categories.map((category) => (
            <button
              class="filter-button"
              type="button"
              data-filter={category}
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="archive-list" id="archive-list">
        {posts.map((post, index) => (
          <a
            class="post-card"
            href={`${BASE}blog/${post.id}/`}
            data-category={post.data.category}
            data-title={post.data.title}
            data-description={post.data.description}
            data-reading-time={readingTime(post.body)}
          >
            <div class="post-thumbnail">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async" />
              ) : (
                <span>{String(index + 1).padStart(2, '0')}</span>
              )}
            </div>

            <div class="post-info">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat(post.data.pubDate)} {timeFormat(post.data.pubDate)}
                </time>
                <span class="category-label">{post.data.category}</span>
                <span class="reading-time">約{readingTime(post.body)}分</span>
              </div>

              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="read-more">続きを読む →</span>
            </div>
          </a>
        ))}
      </div>

      <p class="no-results" id="no-results" hidden>
        該当する記事はありません。
      </p>
    </section>

    <aside class="sidebar">
      <section class="widget">
        <h2 class="widget-title">このブログについて</h2>
        <div class="profile-logo">KNOT<span>.</span></div>
        <p>
          中学3年生の日々感じたことを書いていく、備忘録的なブログです。
          日常や勉強のことなどを記録しています。
        </p>
      </section>

      <section class="widget">
        <h2 class="widget-title">カテゴリー</h2>
        <ul class="category-list">
          {categories.map((category) => (
            <li>
              <button type="button" data-sidebar-filter={category}>
                {category} <span>→</span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      <section class="widget">
        <h2 class="widget-title">記事数</h2>
        <p class="total-count">{posts.length} 件の記事を公開中</p>
      </section>
    </aside>
  </div>

  <div class="back-home">
    <a href={BASE}>← トップページに戻る</a>
  </div>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#article-search');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  );
  const sidebarButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-sidebar-filter]')
  );
  const noResults = document.querySelector<HTMLElement>('#no-results');

  let activeCategory = new URLSearchParams(window.location.search).get('category') || 'all';

  function filterPosts() {
    const keyword = searchInput?.value.trim().toLowerCase() ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const title = card.dataset.title ?? '';
      const description = card.dataset.description ?? '';

      const matchesCategory =
        activeCategory === 'all' || category === activeCategory;

      const matchesSearch =
        `${title} ${description} ${category}`.toLowerCase().includes(keyword);

      const visible = matchesCategory && matchesSearch;
      card.hidden = !visible;

      if (visible) visibleCount++;
    });

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.filter ?? 'all';

      filterButtons.forEach((item) => {
        item.classList.toggle('active', item === button);
      });

      filterPosts();
    });
  });

  sidebarButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.sidebarFilter ?? 'all';

      filterButtons.forEach((item) => {
        item.classList.toggle(
          'active',
          item.dataset.filter === activeCategory
        );
      });

      filterPosts();
      document.querySelector('#archive-list')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    });
  });

  filterButtons.forEach((item) => item.classList.toggle('active', item.dataset.filter === activeCategory));
  filterPosts();
  searchInput?.addEventListener('input', filterPosts);
  const randomButton = document.querySelector<HTMLButtonElement>('#random-article');
  randomButton?.addEventListener('click', () => {
    const visibleCards = cards.filter((card) => !card.hidden);
    if (!visibleCards.length) return;
    const selected = visibleCards[Math.floor(Math.random() * visibleCards.length)];
    if (selected) window.location.href = (selected as HTMLAnchorElement).href;
  });
  const params = new URLSearchParams(window.location.search);
  if (params.get('focus') === 'search' && searchInput) { searchInput.focus(); searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

</script>

<style>
  .archive-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}
  .random-button{border:1px solid var(--line);background:var(--surface);color:var(--text);border-radius:999px;padding:9px 14px;font-size:11px;font-weight:700;cursor:pointer;transition:border-color .2s,transform .2s}
  .random-button:hover{border-color:var(--accent);transform:translateY(-1px)}
  .archive-header {
    padding: 44px 0 25px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .archive-header h1 {
    margin: 12px 0 8px;
    font-size: 34px;
    letter-spacing: -.06em;
  }

  .archive-header p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .post-count {
    display: inline-block;
    margin-top: 13px;
    color: #718198;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .content-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 285px;
    gap: 35px;
    align-items: start;
    padding-top: 30px;
  }

  .filter-area {
    margin-bottom: 20px;
  }

  #article-search {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--line);
    border-radius: 8px;
    outline: none;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 12px;
  }

  #article-search:focus {
    border-color: var(--accent);
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .filter-button {
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 10px;
    cursor: pointer;
  }

  .filter-button.active,
  .filter-button:hover {
    border-color: var(--accent);
    background: rgba(130,178,255,.1);
    color: #c5dcff;
  }

  .archive-list {
    border-top: 1px solid var(--line);
  }

  .post-card {
    display: grid;
    grid-template-columns: 165px minmax(0, 1fr);
    gap: 19px;
    padding: 18px 5px;
    border-bottom: 1px solid var(--line);
  }

  .post-card:hover {
    background: rgba(255,255,255,.025);
  }

  .post-card[hidden] {
    display: none;
  }

  .post-thumbnail {
    display: grid;
    place-items: center;
    width: 165px;
    height: 110px;
    overflow: hidden;
    border-radius: 9px;
    background: #172740;
    color: #8db9ff;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .15em;
  }

  .post-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-info h2 {
    margin: 9px 0 7px;
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: -.035em;
  }

  .post-info p {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    color: #8fa0b7;
    font-size: 10px;
  }

  .category-label {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: #a9caff;
  }

  .read-more {
    display: inline-block;
    margin-top: 9px;
    color: #a9caff;
    font-size: 10px;
    font-weight: 700;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .widget {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: rgba(17,28,46,.58);
  }

  .widget-title {
    margin: 0 0 16px;
    padding-bottom: 11px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }

  .profile-logo {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -.09em;
  }

  .profile-logo span {
    color: var(--accent);
  }

  .widget p {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.9;
  }

  .category-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-list li {
    border-bottom: 1px solid var(--line);
  }

  .category-list li:last-child {
    border-bottom: 0;
  }

  .category-list button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }

  .category-list button:hover {
    color: var(--accent);
  }

  .total-count {
    margin: 0;
  }

  .no-results {
    padding: 30px 10px;
    color: var(--muted);
    text-align: center;
    font-size: 12px;
  }

  .back-home {
    margin-top: 30px;
    text-align: center;
  }

  .back-home a {
    color: #a9caff;
    font-size: 11px;
  }

  @media (max-width: 780px) {
    .content-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .sidebar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sidebar .widget:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .post-card {
      grid-template-columns: 105px minmax(0, 1fr);
      gap: 12px;
      padding: 14px 2px;
    }

    .post-thumbnail {
      width: 105px;
      height: 85px;
    }

    .post-info h2 {
      margin: 7px 0;
      font-size: 13px;
    }

    .post-info p,
    .read-more {
      display: none;
    }

    .post-meta {
      gap: 6px;
      font-size: 9px;
    }

    .sidebar {
      display: flex;
    }
  }

  /* WordPress-inspired editorial archive */
  .archive-header{padding:38px 0 24px;border-bottom:0}
  .archive-header h1{font-size:clamp(32px,5vw,42px);letter-spacing:-.055em}
  .archive-header>p{font-size:13px}
  .content-layout{gap:42px;padding-top:20px}
  .filter-area{padding:17px;background:var(--surface);border:1px solid var(--line);border-radius:8px}
  #article-search{border-radius:4px;background:var(--bg)}
  .category-filters{gap:7px}
  .filter-button{border-radius:4px;padding:7px 11px}
  .filter-button.active,.filter-button:hover{background:var(--accent);color:#fff}
  .archive-list{border-top:0}
  .post-card{grid-template-columns:190px minmax(0,1fr);gap:20px;padding:20px 0;border-bottom:1px solid var(--line)}
  .post-thumbnail{width:190px;height:128px;border-radius:5px;background:linear-gradient(135deg,var(--surface),var(--code-bg))}
  .post-info h2{font-size:17px;line-height:1.6;margin:9px 0}
  .post-info p{font-size:12px;line-height:1.9}
  .post-meta{gap:9px;font-size:10px}
  .category-label{border:0;border-radius:3px;background:var(--accent);color:#fff;padding:4px 8px;font-weight:700}
  .reading-time{font-size:10px;color:var(--muted)}
  .read-more{color:var(--accent)}
  .widget{border:0;border-top:2px solid var(--accent);border-radius:0;background:var(--surface);padding:18px}
  .widget-title{font-size:15px;border-bottom:1px solid var(--line)}
  .profile-logo{font-size:30px}
  .total-count{font-weight:700}
  @media(max-width:520px){.post-card{grid-template-columns:112px minmax(0,1fr);gap:12px}.post-thumbnail{width:112px;height:88px}.post-info h2{font-size:13px}.post-info p{display:block;font-size:10px;line-height:1.6}.read-more{display:inline-block;font-size:10px}.archive-header{padding-top:28px}}

  /* WordPress-style archive refinements */
  .archive-header{padding:25px 0 18px;border-bottom:2px solid var(--line)}
  .archive-header .eyebrow{display:none}
  .archive-header h1{font-size:27px;letter-spacing:-.03em;margin:0 0 7px}
  .archive-header p{font-size:12px}
  .content-layout{grid-template-columns:minmax(0,1fr) 280px;gap:34px;padding-top:24px}
  .filter-area{padding:0 0 17px;background:none;border:0;border-bottom:1px solid var(--line);border-radius:0}
  #article-search{border-radius:3px}
  .category-filters{gap:0;margin-top:10px;border:1px solid var(--line);width:max-content;max-width:100%}
  .filter-button{border:0;border-right:1px solid var(--line);border-radius:0;padding:8px 12px}
  .post-card{grid-template-columns:180px minmax(0,1fr);gap:18px;padding:19px 0}
  .post-thumbnail{width:180px;height:120px;border-radius:2px}
  .post-info h2{font-size:16px;letter-spacing:0;margin:7px 0}
  .post-info p{font-size:11px;line-height:1.8}
  .widget{border:1px solid var(--line);border-radius:0;background:var(--surface);padding:0}
  .widget-title{padding:11px 13px;border-bottom:1px solid var(--line);border-left:4px solid var(--accent);margin:0 0 12px}
  .widget>p,.widget .profile-logo{margin-left:14px;margin-right:14px}
  .category-list{padding:0 14px 10px}
  .total-count{padding-bottom:12px}
  .random-button{border-radius:3px}
  @media(max-width:780px){.content-layout{grid-template-columns:1fr}.sidebar{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:520px){.post-card{grid-template-columns:112px minmax(0,1fr);gap:12px}.post-thumbnail{width:112px;height:88px}.post-info p{display:block}.sidebar{display:flex}.category-filters{width:100%;overflow-x:auto}.filter-button{white-space:nowrap}}

</style>
