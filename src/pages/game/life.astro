  L.faD=deathFrom(L.fa,"M")-L.fa;L.moD=deathFrom(L.mo,"F")-L.mo;
  L.gp=[["父方の祖父","M",L.fa+30],["父方の祖母","F",L.fa+28],["母方の祖父","M",L.mo+31],["母方の祖母","F",L.mo+29]]
    .map(([n,sx,ag])=>({n,age:ag,d:deathFrom(ag,sx)-ag})).filter(g=>g.d>=0);
  L.parentMoney=[0,40,80,150,220,320,450,600,900,1500][L.dec-1];
  {const w=R();if(w<0.0022){L.wealth="ultra";L.dec=10;L.parentMoney=40000;L.family=pick(["老舗企業の創業家","資産家","地方の名家"])}else if(w<0.03){L.wealth="rich";L.dec=10;L.parentMoney=6000;L.family=pick(["開業医の家","会社経営者の家","地主の家"])}}
  L.athl=R()<0.12;L.rare=[];
  {const sp=R();if(!L.wealth&&sp<0.09)L.single="母";else if(!L.wealth&&sp<0.10)L.single="父";if(L.single){L.dec=Math.max(1,L.dec-3);L.parentMoney=[0,40,80,150,220,320,450,600,900,1500][L.dec-1]}
   else if(R()<0.045)L.divAt=3+Math.floor(R()*11);
