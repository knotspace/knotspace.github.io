    if(L.idle>=2&&!L.used.has("jobHunt"+Math.floor(a/3))){L.used.add("jobHunt"+Math.floor(a/3));L.idle=0;
      ask({title:"仕事をしていない時期が続いている。どうする？",opts:[
        {t:YEAR0+a>=1992?"ハローワークや求人で仕事を探す":"職業安定所や求人広告で仕事を探す",sub:"もう一度働き始める",w:3,go(){jobAsk()}},
        {t:"もう少し休む",w:1,go(){L.hp+=1;say("もう少しだけ、ゆっくり過ごすことにする。")}}]})}}
  else if(L.job)L.idle=0;
  // 文系か理系か
  if(a===16&&L.school==="高校生"&&!L.track&&y>=1950){ask({title:"文系と理系、どちらに進む？",text:"高校生の約3割が理系に進む。選んだ道で、目指せる大学や仕事が変わってくる。",opts:[
    {t:"文系に進む",sub:"法律・経済・文学・教育など",w:2+(L.gift==="音楽と絵"?1:0),go(){L.track="文系";say("文系のクラスに進む。")}},
    {t:"理系に進む",sub:"工学・医療・研究など",w:1+Math.max(0,(L.know-50)/20),go(){L.track="理系";say("理系のクラスに進む。数学の問題集が分厚くなる。")}}]})}
  // 同棲
  if(L.partner&&!L.married&&a>=22&&a<=38&&y>=1975&&L.pSince<=a-1&&!L.cohab&&!L.used.has("cohabAsk"+L.partner)&&ch(0.3)){L.used.add("cohabAsk"+L.partner);const n=L.partner;
    ask({valid:()=>L.partner===n&&!L.married,title:`恋人の${n}と一緒に暮らす？`,text:"結婚前に同棲したことがある人は、20〜30代の約3割。",opts:[
      {t:"一緒に暮らし始める",sub:"お互いのことがよくわかる",w:2,go(){L.cohab=true;if(L.home==="実家"||L.home==="ひとり暮らし")L.home="賃貸";L.hp+=4;say(`${n}と2人で部屋を借りて、一緒に暮らし始める。`,"big")}},
      {t:"今はまだ別々に暮らす",w:2,go(){say(`${n}とは、今はまだ別々に暮らす。`)}}]})}
  if(!L.partner&&L.cohab&&!L.married)L.cohab=false;
  // 職人の道
  if(a>=18&&a<=24&&(L.edu==="高校"||L.edu==="中卒")&&(L.job==="中小企業"||!L.job)&&!L.pro&&!L.craft&&!L.used.has("craftAsk")&&ch(0.04)){L.used.add("craftAsk");
    const c=pick(y>=1970?["寿司職人","大工","和菓子職人","美容師","家具職人","庭師"]:["大工","寿司職人","和菓子職人","左官","鍛冶職人"]);
    ask({title:`${c}の親方から「うちで修業しないか」と誘われる`,text:"職人の世界では、一人前になるまで10年かかると言われる。",opts:[
      {t:"弟子入りする",sub:"最初は給料が少ないが、腕が身につく",w:1,go(){startJob("中小企業");L.occ=c;L.income*=0.7;L.craft=a;say(`${c}の親方に弟子入りする。最初は掃除と下働きばかりの毎日。`,"big")}},
      {t:"今の道を続ける",w:2,go(){say("誘いはありがたいが、今の道を続けることにする。")}}]})}
  if(L.craft&&a===L.craft+5)say(`${L.occ}の修業を続け、ようやく親方から仕事を任されるようになる。`);
  if(L.craft&&a>=L.craft+12&&a<=55&&L.job==="中小企業"&&!L.used.has("craftOwn")&&ch(0.2)){L.used.add("craftOwn");
    ask({title:"独立して、自分の店（工房）をもつ？",text:"開業には数百万円かかる。お客さんがつくまでが勝負。",opts:[
      {t:"独立する",sub:"成功すれば収入が大きく増える",w:2,go(){L.savings-=300;L.job="自営";L.title="";if(R()<0.55+L.rel/300){L.income*=1.4;L.hp+=10;say(`独立して、自分の${/職人|師/.test(L.occ)?"店":"工房"}を構える。腕を頼りに常連さんが増えていく。`,"big")}else{L.income*=0.75;L.hp-=6;say("独立するが、お客さんがなかなかつかず苦しい日々が続く。","big")}}},
      {t:"親方のもとで働き続ける",w:1,go(){say("親方のもとで、腕をみがき続ける。")}}]})}
  // 公務員の昇任試験
  if(L.job==="公務員"&&a>=38&&a<=50&&!L.title&&!L.used.has("koumuExam")&&ch(0.12)){L.used.add("koumuExam");
    ask({valid:()=>L.job==="公務員",title:"管理職の昇任試験を受ける？",text:"自治体では、管理職をめざす人が減っていると言われる。",opts:[
      {t:"受ける",sub:`合格の見込み 約${Math.round(SUCC(25+L.know/2.5))}%`,w:1,go(){if(R()*100<SUCC(25+L.know/2.5)){L.title="係長";L.income*=1.08;say("昇任試験に合格し、係長になる。","big");L.hp+=5}else say("昇任試験に落ちる。来年また考えることにする。")}},
      {t:"今の仕事を続ける",sub:"責任は増えないが、昇給はゆるやか",w:2,go(){say("昇任試験は受けず、今の仕事を続ける。")}}]})}
  // 心身の不調と休職
  if(corp(L)&&a>=25&&a<=58&&!L.illness&&!L.used.has("kyushoku"+Math.floor(a/10))&&ch(L.hb<-8?0.06:0.008)){L.used.add("kyushoku"+Math.floor(a/10));
    ask({title:"仕事の疲れがたまり、心と体の調子を崩す。どうする？",text:"仕事で強い不安やストレスを感じている人は、働く人の約8割。",opts:[
      {t:"休職して休む",sub:"収入は減るが、立て直せる",w:2,go(){L.hb+=8;L.hp+=4;L.income*=0.85;say("医師と相談して、しばらく休職する。ゆっくり眠れるようになる。","big")}},
      {t:"仕事を変える",sub:"環境を変えて、出直す",w:1,go(){startJob(weighted(["中小企業","公務員","好きな仕事"],[5,1,1]));L.hb+=5;say(`思い切って仕事を変え、${jobName()}で働き始める。`,"big")}},
      {t:"がんばって働き続ける",sub:"健康がさらに悪くなるおそれ",w:1,go(){L.hb-=6;say("無理をして、働き続ける。")}}]})}
  // 財産の残し方
  if(a>=70&&L.kids.length&&(L.savings+(L.invest||0))>=1000&&!L.used.has("isan")&&ch(0.08)){L.used.add("isan");
    ask({title:"子どもたちに、財産をどう残す？",text:"遺言書があると、相続のもめごとを減らしやすい。",opts:[
      {t:"遺言書を書いておく",w:2,go(){L.used.add("will");say("遺言書を書き、子どもたちに伝えておく。")}},
      {t:"生きているうちに少しずつ贈る",sub:L.grand?"子どもや孫の役に立つ":"子どもたちの役に立つ",w:1,go(){L.savings-=300;L.rel+=4;say("子どもたちに、生きているうちに少しずつお金を贈る。")}},
      {t:"特に何もしない",w:1,go(){say("財産のことは、特に何もしないでおく。")}}]})}
  // 孫の世話
  if(L.grand>0&&a>=58&&a<=76&&!L.used.has("magoCare")&&ch(0.1)){L.used.add("magoCare");
    ask({title:"共働きの子どもから、孫の世話を頼まれる",opts:[
      {t:"よろこんで引き受ける",sub:"にぎやかだが、体力を使う",w:2,go(){L.hp+=6;L.hb-=2;L.rel+=3;say("平日は孫を保育園に迎えに行き、夕方まで面倒を見る。")}},
      {t:"できる範囲で手伝う",w:2,go(){L.hp+=3;say("週に何日か、できる範囲で孫の世話を手伝う。")}}]})}
  // 人生後半の出会い
  if(!L.married&&!L.partner&&a>=60&&a<=80&&(L.spouse&&L.spouse.dead||!L.wasMarried)&&!L.used.has("lateLove")&&ch(0.02)){L.used.add("lateLove");const n=mate(L);
    ask({title:`${L.wasMarried?"趣味の集まり":"地域のサークル"}で、${n}さんと親しくなる`,text:"60代以上で再婚する人は、年に約2万人。",opts:[
      {t:"人生のパートナーとして一緒に過ごす",w:1,go(){L.partner=n;L.pSince=a;L.pLate=true;L.hp+=10;say(`${n}さんと、残りの人生をともに過ごすことにする。`,"big")}},
      {t:"よい友人として付き合う",w:2,go(){L.rel+=4;L.hp+=3;say(`${n}さんとは、よい友人として付き合っていく。`)}}]})}
}
