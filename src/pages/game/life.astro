.eradex{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px}
.eradex .ed{border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:var(--paper);display:flex;flex-direction:column;gap:8px}
