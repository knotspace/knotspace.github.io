.badges{display:flex;flex-wrap:wrap;gap:6px}
.whatif{display:flex;flex-direction:column;gap:8px}.whatif .wi-go{margin-top:6px;font-size:12.5px;padding:5px 12px}.whatif details summary{cursor:pointer;font-size:13px;color:var(--teal)}
