function skipCurrentChoice(){if(!s||!s.waiting)return;log('選択を見送る','この年は特定の道を選ばず、自然の流れに任せた。');s.yearOptions=null;$('event').hidden=true;$('confirm').hidden=true;$('skipchoice').hidden=true;s.waiting=false;s.left=ylen();save();if(pauseMoment())s.waiting=true;else run()}
