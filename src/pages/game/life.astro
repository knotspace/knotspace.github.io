 taisho:[["school","上の学校へ進んだ",L=>/大学|高校|専門/.test(L.edu||"")||L.hs==="進学校"],["ms","終戦の日を迎えた",(L,a,y)=>y>=1945],["olympic","東京オリンピックを見た",(L,a,y)=>y>=1964],ED_HOUSE],
 senji:[["postwar","戦後の焼け跡を生き抜いた",(L,a,y)=>y>=1950],["shudan","金の卵として上京した",L=>L.used.has("shudan")],["ms","大阪万博の年を迎えた",(L,a,y)=>y>=1970],ED_HOUSE],
 showa:[ED_UNIV,["bubble","バブル景気を経験した",(L,a,y)=>y>=1987&&1987-YEAR0>=20],["kacho","課長になった",L=>L.title==="課長"||L.used.has("wasKacho")],["ms","令和を迎えた",(L,a,y)=>y>=2019]],
 heisei:[ED_UNIV,["tokyo","上京した",L=>L.city==="東京"&&L.pref!=="東京"],["nisa","コツコツ積み立て投資をした",L=>L.used.has("nisaDone")],["ms","2050年を迎えた",(L,a,y)=>y>=2050]],
 now:[ED_UNIV,["free","好きなことを仕事にした",L=>L.used.has("wasFree")],ED_HOUSE,["ms","2100年を迎えた",(L,a,y)=>y>=2100]],
 future:[ED_UNIV,["uturn","ふるさとに戻った",L=>L.used.has("uturned")],ED_HOUSE,["ms","22世紀を迎えた",(L,a,y)=>y>=2101]]};
function eraDexItems(k){return [...ED_COMMON,...(ED_SPEC[k]||[])]}
const ED_TOTAL=ERADEX_ORDER.reduce((n,k)=>n+eraDexItems(k).length,0);
function dexGet(){return store.get("oi.dex",{n:0,prefs:{},eras:{},sum:0,maxAge:0,minAge:999,f:{}})}
function dexAdd(L,a){const d=dexGet(),before=new Set(BADGES.filter(b=>b[2](d)).map(b=>b[0]));const newPref=!d.prefs[L.pref];
  d.n++;d.sum+=a;d.maxAge=Math.max(d.maxAge,a);d.minAge=Math.min(d.minAge,a);d.prefs[L.pref]=(d.prefs[L.pref]||0)+1;d.eras=d.eras||{};d.eras[ERA.key]=(d.eras[ERA.key]||0)+1;
  const f=d.f;if(/老衰/.test(L.cause))f.roosui=1;if(L.city==="東京"&&L.pref!=="東京")f.tokyo=1;if(L.used.has("uturned"))f.uturn=1;if(L.used.has("leftIsland"))f.island=1;
  if(L.title==="課長"||L.used.has("wasKacho"))f.kacho=1;if(L.used.has("wasFree"))f.free=1;if(L.kids.length>=3)f.bigfam=1;if(L.grand>=3)f.grand=1;if(L.used.has("boughtHouse"))f.house=1;
  if(!L.wasMarried&&a>=70)f.single=1;if(L.wealth==="ultra")f.rich=1;if(L.pro)f.pro=1;if(L.used.has("japan"))f.japan=1;if(L.used.has("doctor"))f.doctor=1;if(L.todai)f.todai=1;if(L.used.has("star"))f.star=1;if(L.used.has("survived"))f.survivor=1;
  d.maxGen=Math.max(d.maxGen||1,L.gen||1);if((L.rebirth||0)>=2)f.rebirth3=1;if(L.fromShare)f.shared=1;if(L.used.has("veteran"))f.veteran=1;
  if(YEAR0<=1945&&YEAR0+a>=1950)f.postwar=1;if(L.used.has("shudan"))f.shudan=1;if(YEAR0+a>=1987&&1991-YEAR0>=22)f.bubble=1;
  if(L.smoke===2)f.quit=1;if(L.smoke===0&&a>=90)f.clean=1;if(L.used.has("marathonDone"))f.marathon=1;if(L.used.has("volDone"))f.vol=1;if(L.used.has("shoboDone"))f.shobo=1;if(L.used.has("nisaDone"))f.nisa=1;
  if(L.dec<=3&&!L.gen&&(L.peakSav||0)>=5000)f.selfmade=1;if(L.used.has("worked75"))f.lifelong=1;if(L.arcDone&&L.arcDone.hatsukoi)f.hatsukoi=1;
  if(L.faD<a&&L.moD<a&&L.spouse&&L.spouse.dead)f.seeoff=1;if(L.used.has("licReturned"))f.licret=1;
  let eraGot=[],eraN=0,eraT=0;try{const k=ED_SPEC[ERA.key]?ERA.key:null;if(k){d.ef=d.ef||{};const cur=d.ef[k]=d.ef[k]||{};const its=eraDexItems(k);eraT=its.length;
    for(const [id,lab,fn] of its){let ok=false;try{ok=!!fn(L,a,YEAR0+a)}catch(e){}if(ok&&!cur[id]){cur[id]=1;eraGot.push(lab)}}eraN=its.filter(x=>cur[x[0]]).length}}catch(e){}
  store.set("oi.dex",d);const got=BADGES.filter(b=>b[2](d)&&!before.has(b[0])).map(b=>b[1]);return{newPref,got,eraGot,eraN,eraT}}
function renderDex(){const d=dexGet(),sec=$("#dexSec");if(!sec)return;sec.hidden=!d.n;if(!d.n)return;
  const max=Math.max(...Object.values(d.prefs));const u=10,g=1.2;let r="";
  for(const [n,t] of Object.entries(TILES)){const [x,y,w=1,h=1]=t;const c=d.prefs[n]||0;
    r+=`<rect x="${x*u+g/2}" y="${y*u+g/2}" width="${w*u-g}" height="${h*u-g}" fill="${c?"var(--teal)":"var(--line)"}" opacity="${c?0.35+0.65*c/max:1}"><title>${pf(n)}：${c}回</title></rect>`}
  $("#dexMap").innerHTML=`<svg viewBox="-2 -2 144 124" shape-rendering="crispEdges" role="img" aria-label="生まれた都道府県">${r}</svg>`;
  $("#dexNums").innerHTML=`<div>生まれた都道府県<b>${Object.keys(d.prefs).length}<small style="font-size:13px"> / 47</small></b></div><div>生きた人生<b>${d.n}回</b></div><div>平均の享年<b>${(d.sum/d.n).toFixed(1)}歳</b></div><div>最長 · 最短<b>${d.maxAge}歳 · ${d.minAge}歳</b></div>`;
  $("#badges").innerHTML=BADGES.map(b=>`<span class="badge${b[2](d)?" on":""}">${b[1]}</span>`).join("");
  try{const ef=d.ef||{};let tot=0;$("#eraDex").innerHTML=ERADEX_ORDER.map(k=>{const e=ERAS[k],cur=ef[k]||{},its=eraDexItems(k),T=its.length,n=its.filter(x=>cur[x[0]]).length;tot+=n;
