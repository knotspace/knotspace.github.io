const Music={on:false,ctx:null,timer:null,gain:null};
function toggleMusic(){
  if(Music.on){Music.on=false;clearTimeout(Music.timer);try{Music.gain.gain.setTargetAtTime(0,Music.ctx.currentTime,0.4)}catch(e){}return}
  try{if(!Music.ctx){Music.ctx=new (window.AudioContext||window.webkitAudioContext)();Music.gain=Music.ctx.createGain();Music.gain.connect(Music.ctx.destination)}
    Music.ctx.resume();Music.gain.gain.setTargetAtTime(0.16,Music.ctx.currentTime,0.5);Music.on=true;playNote()}catch(e){Music.on=false}}
function playNote(){if(!Music.on)return;const c=Music.ctx,t=c.currentTime;
  const scale=[261.6,293.7,329.6,392,440,523.3,587.3,659.3];
  const f=pick(scale)*(R()<0.25?0.5:1);
  [f,f*1.5].forEach((fr,i)=>{if(i&&R()<0.6)return;const o=c.createOscillator(),g=c.createGain();o.type="sine";o.frequency.value=fr;
    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(i?0.12:0.3,t+0.08);g.gain.exponentialRampToValueAtTime(0.001,t+3.2);
    o.connect(g);g.connect(Music.gain);o.start(t);o.stop(t+3.3)});
  Music.timer=setTimeout(playNote,700+R()*1400)}


