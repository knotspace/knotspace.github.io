function advance(){s.age++;if(s.education==='kosen'&&s.age===18)s.age=19;s.peers.forEach(peerYear);updatePeers();s.left=ylen();let k={学び:'knowledge',健康:'health','人とのつながり':'friends',仕事:'money','自分の時間':'happy'}[s.focus];s.stats[k]=clamp(s.stats[k]+1);const pathEffects={study:{knowledge:.45},sport:{health:.45},creative:{happy:.35,knowledge:.2},community:{friends:.45},tech:{knowledge:.35,money:.15},career:{money:.4},global:{knowledge:.2,friends:.2},family:{friends:.4,happy:.2},entrepreneur:{money:.3,knowledge:.2},balance:{health:.35,happy:.25},legacy:{friends:.2,knowledge:.2}};for(const [pathName,effects] of Object.entries(pathEffects)){const strength=Math.min(2,s.branch?.[pathName]||0);for(const [stat,delta] of Object.entries(effects))s.stats[stat]=clamp(s.stats[stat]+delta*strength)}if(s.age>35)s.stats.health=clamp(s.stats.health-.4);if(s.age>55)s.stats.health=clamp(s.stats.health-.5);rollUnchosenEvent();historicalEvent();achievementCheck();if(s.age>=60){let risk=Math.min(.18,.004+Math.pow(s.age-60,2)*.00012+(100-s.stats.health)*.00025);if(Math.random()<risk){s.cause=s.stats.health<25?'長く続いた体調の変化':'年齢を重ねたことによる自然な最期';finish();return}}if(s.age>=85){s.cause='長い人生を歩み、85歳を迎えた';finish();return}render();save();if(s.age<=35){if(E[s.age]){stop();s.waiting=true;openEvent();if(s.auto)setTimeout(()=>{if(s.waiting){chosen=E[s.age][4].findIndex(c=>!['exam','short'].includes(c[3]));if(chosen<0)chosen=0;choose()}},1800)}else{stop();s.waiting=true;openYearChoice()}}else{stop();s.waiting=false;$('event').hidden=true;run()}}
function frame(t){if(!s||s.paused||s.waiting)return;if(!last)last=t;s.left-=(t-last)/1000*s.speed;last=t;if(s.left<=0)advance();else{$('clock').textContent='00:'+String(Math.ceil(s.left)).padStart(2,'0');$('bar').style.width=(s.left/ylen()*100)+'%'}if(s&&!s.paused&&!s.waiting)raf=requestAnimationFrame(frame)}
function start(){$('peers').replaceChildren();s={era:cfg.era,pref:randomPref(),mode:cfg.mode,compare:$('compare').value,name:$('name').value.trim(),duration:cfg.duration,age:0,left:cfg.duration*60/85,speed:1,paused:false,waiting:true,auto:false,focus:'学び',yearOptions:null,branch:{},stats:{health:76,happy:62,knowledge:30,friends:42,money:35},logs:[],school:null,profile:familyRoll(),peers:[0,1,2].map(makePeer),achievements:[],eras:[],cause:null};if(s.profile.household==='相対的に厳しい'){s.stats.money-=12;s.stats.knowledge-=3}if(s.profile.singleParent)s.stats.money-=6;if(s.profile.parentEducation==='大学卒以上')s.stats.knowledge+=5;$('home').hidden=true;$('game').hidden=false;$('ending').hidden=true;$('peers').replaceChildren();$('familyprofile').textContent=s.profile.gender+' · '+s.profile.household+' · '+(s.profile.singleParent?'ひとり親家庭':'両親と暮らす')+' · きょうだい '+s.profile.siblings+'人 · 親の学歴 '+s.profile.parentEducation+' · '+s.profile.parentWork;$('birthcompare').textContent=s.compare?'今回の出生地：'+s.pref+' ／ あなたの出身地：'+s.compare+(s.pref===s.compare?' · 同じ都道府県！':' · 異なる都道府県の人生を比較中'):'出身地の比較は設定されていません。';updatePeers();log('誕生',s.era+'年、'+s.pref+'で新しい人生が始まった。');render();$('event').hidden=false;$('kind').textContent='BIRTH';$('date').textContent=s.era+' / AGE 0';$('scene').textContent='ひとりの人生が、静かに始まる。';$('eventtitle').textContent='生まれてきた。';$('copy').textContent='家族や地域、時代。自分では選べない環境の中で、ここから人生が形づくられていく。';$('schoolarea').hidden=true;$('choices').replaceChildren();$('skipchoice').hidden=true;let b=document.createElement('button');b.className='choice picked';b.innerHTML='<b>この人生を歩き始める</b><small>0歳から時間が流れます →</small>';b.onclick=()=>{$('event').hidden=true;s.waiting=false;run()};$('choices').append(b);save()}
