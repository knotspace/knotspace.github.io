      {t:"会社に出て働く",w:1,go(){say("できるだけ会社に出て働く。")}}]})}}
}
function once3C(){const L=G.L;const n=["c3a","c3b"].find(k=>!L.used.has(k));if(!n||R()>0.15)return false;L.used.add(n);return true}
/* 人生の決断（さらに追加） */
function moreChoices3(a){const L=G.L,y=YEAR0+a,say=line,ch=p=>R()<p;if(G.queue.length>1)return;
  // 仕事がない時期が続いたら、仕事を探す
