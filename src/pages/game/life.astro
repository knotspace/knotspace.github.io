/* 毎年の変化：重点・お金・加齢 */
function yearly(a){const L=G.L;
  if(G.auto&&a>=6&&(R()<0.2||!G.focus)){const o=focusOpts();if(o)G.focus=pick(o)[0]}
  const f=G.focus;
  L.hp*=0.7;
  if(L.invest>0){const r=0.045+gauss()*0.15;L.invest*=1+r;if(r<-0.15&&ONCE("crash"+Math.floor(a/10)))line(`株価が大きく下がり、投資が${Math.round(-r*100)}%目減りする。`)}
  if(a<22)L.know+=a<6?1.5:2.6+(f==="勉強"?2.6:0)+(L.dec-5.5)*0.15;else L.know+=f==="仕事"?0.6:0.15;
  L.rel+=(f==="友だち"||f==="人づきあい"?2.2:-0.25)+(f==="運動"?0.6:0);
  if(a>=70&&f!=="人づきあい")L.rel-=0.6;
  L.hb+=(f==="健康"?1.1:f==="運動"?0.7:f==="仕事"?-0.5:-0.05)+(L.illness?-1.5:0);
  L.hb=clamp(L.hb,-35,25);L.rel=clamp(L.rel,0,100);
  if(f==="遊び"||f==="ゆとり"||f==="趣味")L.hp+=3;
  if(L.illness){L.illness.y++;if(L.illness.y>=5&&L.illness.treat){L.used.add("survived");line(`治療から5年がたち、再発の心配がほぼなくなる。`,"big");L.illness=null;L.hb+=10;L.hp+=8}}
  if(L.job==="医師")L.income=Math.min(L.income,1800);
  if(L.income>0){
    if(a<50)L.income*=1+(L.sex==="M"?0.028:0.014)+(f==="仕事"?0.01:0)+(L.know-50)*0.0002;
    // 手取りは額面の約78%。結婚していれば配偶者の収入も家計に入る
    const net=L.income*0.78+(L.married?140:0);
    const rate=f==="お金"?0.82:f==="ゆとり"?0.98:0.91;
    let fixed=L.kids.filter(k=>a-k.b<22).length*30;
    if(L.loan>0){fixed+=70;L.loan--}
    L.savings+=(net-fixed)*(1-rate)-Math.max(0,fixed-net);
  }else if(L.pension>0){
    let spend=(L.married?290:190)*(f==="お金"?0.9:1);
    // 配偶者がいれば、その年金も家計に入る
    const hp=L.pension+(L.married?(L.sex==="M"?90:150):(L.spouse&&L.spouse.dead?60:0));
    // 貯金が少なくなったら、暮らしを切り詰める
