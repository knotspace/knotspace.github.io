  if(L.edu)s.push(L.edu==="大学"?"大学を出て":L.edu==="専門"?"専門学校を出て":L.edu==="中卒"?(L.hs==="中退"?(L.occ?"高校をやめ":"高校をやめて働き"):YEAR0+12<1947?"若くして働きに出て":"中学を出て働き"):(L.occ?"高校を出て":"高校を出て働き"));if(L.occ&&!L.pro&&L.job!=="医師")s.push(`${L.occ}として働き`);
  if(L.army)s.push(/戦死/.test(L.forceDie||"")?`兵士として${L.army.front}へ送られ`:L.army.siberia?"シベリア抑留から生きて帰り":"戦地から生きて帰り");
  if(L.used.has("shudan"))s.push("集団就職で都会に出て");
  if(L.wasMarried)s.push(L.spouse&&L.spouse.dead?"連れ合いに先立たれ":"結婚し");
  if(L.kids.length)s.push(`${L.kids.length}人の子を育て`);
  if(L.grand)s.push(`${L.grand}人の孫に恵まれ`);
  return s.join("、")}
function finish(a){const c=document.querySelector(".ctrl");if(c)c.hidden=true;
  const L=G.L,diff=a-Math.round(L.prefLE),v=statVals();
  const my=store.get("knot.life.myPref","");const myP=PREFS.find(p=>p[0]===my);
  const sum=lifeSummary();
  const story=`${pf(L.pref)}に生まれ${sum?"、"+sum:""}${a>=20?(L.city!==L.pref?`、${L.city}で暮らした。`:`、生まれた土地で暮らした。`):"た。"}`;
  const peersTxt=G.peers.map(P=>`${P.name}（${P.pref}）は${P.death}歳`).join("、");
  const share=`青の分岐点｜${L.name}\n${pf(L.pref)}生まれ、${a}歳で亡くなる（${L.cause}）。\n${story}\n同じ日に生まれた3人：${peersTxt}`;
  const cmp=myP?`<div class="cmp"><span class="h"></span><span class="h">${L.name}の${L.pref}</span><span class="h">あなたの${myP[0]}</span>
    <span class="h">平均寿命（${L.sex==="M"?"男":"女"}）</span><b>${L.prefLE.toFixed(1)}歳</b><b>${(L.sex==="M"?myP[2]:myP[4]).toFixed(1)}歳</b>
    <span class="h">大学進学率</span><b>${L.univ}%</b><b>${myP[3]}%</b>
    <span class="h">年間出生数</span><b>${(PREFS.find(p=>p[0]===L.pref)[1]*1000).toLocaleString()}人</b><b>${(myP[1]*1000).toLocaleString()}人</b>
    <span class="h">平均月給</span><b>${Math.round(pdat(L.pref)[0]/10)}万円</b><b>${Math.round(pdat(myP[0])[0]/10)}万円</b>
    <span class="h">持ち家率</span><b>${pdat(L.pref)[1]}%</b><b>${pdat(myP[0])[1]}%</b>
    <span class="h">初婚年齢（${L.sex==="M"?"夫":"妻"}）</span><b>${pdat(L.pref)[L.sex==="M"?2:3]}歳</b><b>${pdat(myP[0])[L.sex==="M"?2:3]}歳</b></div>`:"";
  $("#finalBox").innerHTML=`<div class="card final">
    <span class="label">${L.name} · ${pf(L.pref)}生まれ · ${L.cause}</span>
    <p class="big">${a}年の人生でした。</p>${L.cause==="自死"?`<div class="helpnote"><p>日本では年に約2万人が自ら命を絶っていて、10〜39歳では死因の1位です。この人生はシミュレーションですが、もしいま、あなた自身がつらい気持ちを抱えていたら、ひとりで抱えずに話してみてください。</p><p><b>よりそいホットライン</b> <a href="tel:0120279338">0120-279-338</a>（無料・24時間）<br><b>いのちの電話</b> <a href="tel:0120783556">0120-783-556</a>（無料・毎日16〜21時）<br><b>こころの健康相談統一ダイヤル</b> <a href="tel:0570064556">0570-064-556</a></p></div>`:""}${L.rare&&L.rare.length?`<p class="newbadge">めずらしい人生：${L.rare.map(r=>`${r[0]}（${r[1]}）`).join("、")}</p>`:""}
    <p>${story}${pf(L.pref)}の${L.sex==="M"?"男性":"女性"}の平均寿命より${Math.abs(diff)}年${diff>=0?"長く":"短く"}生きました。${a>=22?`最後の貯金は${Math.round(L.savings+L.invest).toLocaleString()}万円。`:""}</p>
    <p class="note">最期の状態：健康 ${Math.round(v.health)} · 幸福 ${Math.round(v.happy)} · 知識 ${Math.round(v.know)} · 人間関係 ${Math.round(v.rel)}</p>
    <p class="note">同じ日に生まれた3人：${peersTxt}。</p>
    ${(()=>{if(a<1||/戦死|抑留|空襲|原子爆弾|沖縄戦/.test(L.cause))return"";const row=CAUSE_T.find(r=>a<r[0]).slice(1);const w=row.map((v,i)=>[CAUSE_N[i],v*(L.sex==="F"&&(i===6||i===7)?0.5:1)]).filter(x=>x[0]!=="その他の病気").sort((x,y)=>y[1]-x[1]).slice(0,3);return `<p class="note">参考：${YEAR0+a<2000?"いまの":""}${a}歳前後の日本の${L.sex==="M"?"男性":"女性"}に多い死因は、${w.map(x=>x[0]).join("、")}（人口動態統計）。</p>`})()}
    <div id="crowdCmp">${crowdText(L,a)}</div>
    ${G.sharedRes?compareHTML(G.sharedRes,lifeSnap(G),"シェアした人の人生とくらべる","シェアした人","あなた"):""}
    ${G.prev?compareHTML(G.prev,lifeSnap(G),...(G.prevLab||[])):""}
    ${whatIfHTML(G)}
    ${reviewHTML(L)}
    ${cmp}
    ${L.stars.length?`<span class="label">☆をつけた瞬間</span><ul class="stars">${L.stars.map(t=>`<li>${esc(t)}</li>`).join("")}</ul>`:""}
    <span class="label">${L.name}に、ひとこと声をかける</span>
    <div class="btns" id="words">${["おつかれさまでした","よく生きたね","もっと生きてほしかった","ありがとう","また会おう"].map(w=>`<button class="ghost" aria-pressed="false">${w}</button>`).join("")}</div>
    <p class="note" id="nthLife" hidden></p>
    <span class="label">シェアする</span><div id="finalShare" style="display:flex;flex-direction:column;gap:10px"></div>

    ${L.kids.length?`<span class="label">次の世代を生きる</span><p class="note">子どもとして生まれ、家系を引き継ぐ。親の住んでいた県・暮らし向き・家業が受け継がれる。</p><div class="btns" id="kidsGo">${L.kids.map((k,i)=>`<button class="ghost" data-k="${i}">${esc(k.n)}として生きる（${YEAR0+k.b}年生まれ）</button>`).join("")}</div>`:""}
    ${L.gen>1?`<span class="label">家系図</span><ul class="tl">${[...L.ancestors,{name:L.name,born:YEAR0,death:YEAR0+a,cause:L.cause}].map((x,i)=>`<li><span>第${i+1}代</span><div>${esc(x.name)}<br><b>${x.born}〜${x.death}年 · ${esc(x.cause||"")}</b></div></li>`).join("")}</ul>`:""}
    <details class="report"><summary>おかしなところを報告する</summary>
      <p class="note">話のつじつまが合わない・ありえないできごとがあったら教えてください。この人生のログと状態がいっしょに送られます（名前などの個人情報は含まれません）。</p>
      <textarea id="repText" rows="3" maxlength="1000" placeholder="例：独身なのに孫が出てきた（45歳のあたり）"></textarea>
      <div class="btns"><button class="ghost" id="repSend">送信する</button></div><p class="note" id="repMsg"></p></details>
    <div class="btns"><button class="primary" id="again">もう一度生まれる</button><button class="ghost" id="rebirthBtn">同じ家に、もう一度生まれる</button><button class="ghost" id="toTop">はじめの画面へ</button></div></div>`;
  const dx=dexAdd(L,a);const dexMsg=(dx.newPref?`図鑑に${pf(L.pref)}が加わりました。`:"")+(dx.got.length?`実績「${dx.got.join("」「")}」を達成しました。`:"")+(dx.eraT?(dx.eraGot&&dx.eraGot.length?`時代の図鑑（${ERA.label}）に「${dx.eraGot.join("」「")}」が加わりました（${dx.eraN}/${dx.eraT}）。`:`時代の図鑑（${ERA.label}）は ${dx.eraN}/${dx.eraT}。今回は新しいしるしはありませんでした。`):"");
  if(dexMsg){$("#finalBox .final").insertAdjacentHTML("afterbegin",`<p class="newbadge">${dexMsg}</p>`);if(dx.got.length)setTimeout(()=>sfx("badge"),2600)}
  const rec={id:G.id,name:L.name,pref:pf(L.pref),death:a,summary:`${G.whatIfAt&&G.whatIfAt.done?"〔もしも〕":""}${a}歳、${L.cause}。${sum?sum+"た。":""}`.replace(/てた。$/,"た。").replace(/、([^、]*)た。$/,"、$1た。"),word:""};
  rec.summary=`${G.whatIfAt&&G.whatIfAt.done?"〔もしも〕":""}${a}歳、${L.cause}。`+(sum?`${sum}。`:"");
  const save=()=>{const lives=store.get("knot.life.lives",[]).filter(x=>x.id!==rec.id);lives.unshift(rec);store.set("knot.life.lives",lives.slice(0,10))};
  save();
  document.querySelectorAll("#words button").forEach(b=>b.onclick=()=>{if(rec.word)return;rec.word=b.textContent;save();
    document.querySelectorAll("#words button").forEach(x=>{x.setAttribute("aria-pressed",x===b);x.disabled=x!==b});line(`あなたから：「${esc(rec.word)}」`,"re")});
  shareUI("final",$("#finalShare"));

  bindGraph(L);if(!G.birth)$("#rebirthBtn").hidden=true;
  document.querySelectorAll("#kidsGo button").forEach(b=>b.onclick=()=>{clearTimeout(G.timer);childLife(G,L.kids[+b.dataset.k])});
  {const nth=()=>{const e=$("#nthLife");if(e&&GSTAT&&GSTAT.lives){e.hidden=false;e.textContent=`あなたの人生は、このサイトで最後まで生きられたおよそ${(GSTAT.mine||GSTAT.lives).toLocaleString()}人目の人生でした。`}};
    if(GSTAT&&GSTAT.lives){postLife(L,a);nth()}else{postLife(L,a);loadGlobal(()=>{if(GSTAT&&GSTAT.lives){GSTAT.lives++;GSTAT.mine=GSTAT.lives}nth()})}}
  if(!GSTAT&&API){const gL=L,gA=a;loadGlobal(()=>{const e=$("#crowdCmp");if(e&&!e.innerHTML)e.innerHTML=crowdText(gL,gA)})}
  document.querySelectorAll("#finalBox .wi-go").forEach(b=>b.onclick=()=>startWhatIf(+b.dataset.wi));
  {const b=$("#repSend");if(b)b.onclick=()=>sendReport($("#repText").value,b,$("#repMsg"))}$("#rebirthBtn").onclick=()=>{clearTimeout(G.timer);rebirth()};
  $("#again").onclick=()=>{prepare(Math.round(G.base*84/60000),G.mode==="pop"?"pop":"birth",L.gen>1?"now":G.era)};
  $("#toTop").onclick=()=>{G=null;renderResume();renderDex();try{showTotal(false)}catch(e){}$("#topbar").hidden=true;$("#life").innerHTML="";$("#life").hidden=true;$("#start").hidden=false;renderPast();window.scrollTo(0,0)};
  setTimeout(()=>$("#finalBox").scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth",block:"start"}),50);
}
/* すべての定義が終わってから開始画面を準備する（図鑑データがあるときの初期化エラー対策） */
try{initStart()}catch(e){console.error(e);const b=document.getElementById("bornBtn");if(b&&!b.onclick)b.onclick=()=>location.reload()}

</script>
