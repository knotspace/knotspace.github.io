   ['中卒で就職する',{experience:8},'中学校卒業後、社会に出て働き始めた。',{career:'work',education:'middle'}],
   ['職業訓練や専門技術を学ぶ',{study:4,experience:7},'仕事に役立つ技術を身につける道を選んだ。',{career:'vocational',education:'middle'}],
   ['小さく事業を始める',{experience:9,health:-3},'自分の力で仕事をつくる挑戦を始めた。',{career:'startup',education:'middle'}]
