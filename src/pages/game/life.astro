function drawPx(ctx,rows,pal,ox,oy,outline=true){const H=rows.length,W=Math.max(...rows.map(r=>r.length));
  const at=(x,y)=>(y>=0&&y<H&&x>=0&&x<W)?(rows[y][x]||"."):".";
  for(let y=-1;y<=H;y++)for(let x=-1;x<=W;x++){const c=at(x,y);let col=null;
    if(c!==".")col=pal[c]||"#f0f";
    else if(outline&&(at(x-1,y)!=="."||at(x+1,y)!=="."||at(x,y-1)!=="."||at(x,y+1)!=="."))col=OUT;
    if(col){ctx.fillStyle=col;ctx.fillRect(ox+x,oy+y,1,1)}}}
function rng(seed){let a=seed>>>0;return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
