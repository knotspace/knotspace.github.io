function occChoices(a){const L=G.L;if(!L.job||!L.occ||!corp(L)&&!/自営|好きな仕事/.test(L.job)||G.queue.length>1||L.illness)return;
  OCCDEC.forEach((d,i)=>{const key="occd"+i;if(L.used.has(key)||!d[0].test(L.occ)||a<d[1]||a>d[2]||R()>d[3])return;L.used.add(key);const q=d[4](L,a);if(q)ask(q)})}
/* きょうだい・配偶者・子どもの人生 */
function nameSibs(L){const used=[L.given,...L.kids.map(k=>k.n)];(L.sibList||[]).forEach(sb=>{if(!sb.n){let n;for(let j=0;j<20;j++){n=sb.sex==="M"?pick(MN):pick(FN);if(!used.includes(n)&&!(L.sibList||[]).some(x=>x.n===n))break}sb.n=n}})}
function mate(L){nameSibs(L);const ng=[L.given,L.partner,L.spouse&&L.spouse.n,L.crush,...(L.pHist||[]),...(L.sibList||[]).map(x=>x.n),...L.kids.map(k=>k.n)].filter(Boolean);const pool=(L.sex==="M"?FN:MN).filter(x=>!ng.includes(x));return pick(pool.length?pool:(L.sex==="M"?FN:MN))}
function kidUni(kd,y){if(kd.uni==null)kd.uni=R()<(y<1960?0.15:y<1975?0.3:y<1995?0.42:0.6);return kd.uni}
function sibLabel(s){return s.d===0?(s.sex==="M"?"双子の兄弟":"双子の姉妹"):s.d>0?(s.sex==="M"?"兄":"姉"):(s.sex==="M"?"弟":"妹")}
function family(a){const L=G.L,y=YEAR0+a,say=line,ch=p=>R()<p;
  nameSibs(L);
  (L.sibList||[]).forEach((sb,i)=>{
    const sa=a+sb.d;if(sa<0)return;const lab=sibLabel(sb);
    if(sa===sb.sd&&!sb.dead){sb.dead=true;if(a>=6)say(`${lab}の${sb.n}が${sa}歳で亡くなる。`,"big"),L.hp-=10;return}
    if(sb.dead)return;
    if(sa>=25&&sa<=36&&!sb.m&&ch(0.09)){sb.m=a;if(a>=8)say(`${lab}の${sb.n}が結婚する。${a>=18?pick(["式で家族そろって写真を撮る。","披露宴で、子どものころの話をされて照れる。","久しぶりに家族が全員そろう。"]):"結婚式で、はじめてのドレスや晴れ着に目をかがやかせる。"}`)}
    if(sb.m&&!sb.kid&&a-sb.m>=1&&a-sb.m<=8&&ch(0.2)){sb.kid=1;if(a>=10)say(`${lab}の${sb.n}に子どもが生まれ、${pick(["甥","姪"])}ができる。`)}
    if(sb.m&&a>=40&&a<=70&&ch(0.01)&&!L.used.has("sibTalk"+i)){L.used.add("sibTalk"+i);say(`${lab}の${sb.n}と、久しぶりに二人で飲みに行く。子どものころの話で盛り上がる。`)}});
  // 配偶者の人生
  const sp=L.spouse;
  if(L.married&&sp){if(!sp.job){sp.job=pick(["会社員","会社員","公務員","看護師","教員","自営業","パート"]);sp.trait=pick(["おだやかな","几帳面な","よく笑う","しっかり者の","おおらかな","心配性の"])}
    const yrs=a-sp.at;
    if(yrs===1&&!L.used.has("chores")&&y>=1965){L.used.add("chores");ask({valid:()=>L.married,title:`${sp.n}との暮らしが始まった。家事はどうする？`,text:"共働きの夫婦でも、家事の負担は片方にかたよりやすい。",opts:[
      {t:"きっちり分担する",sub:"ぶつかることもあるが、不満がたまりにくい",w:2,go(){L.divRisk=Math.max(0.6,(L.divRisk||1)*0.8);say("ゴミ出しは自分、料理は相手、と家事を分担する。")}},
      {t:"得意なほうがやる",w:2,go(){say("料理が得意なほうが料理、片づけが得意なほうが片づけ、と自然に決まっていく。")}},
      {t:"相手にまかせる",sub:"楽だが、不満がたまるかもしれない",w:1,go(){L.divRisk=(L.divRisk||1)*1.4;say("家事はほとんど相手にまかせる。")}}]})}
    if(yrs===25)say(`${sp.n}と結婚25年の銀婚式を迎える。`,"big");
    if(yrs>=2&&yrs<=25&&/会社員|公務員|教員/.test(sp.job)&&(L.sex==="F"||y>=1985)&&a<=55&&!L.used.has("spMove")&&ch(0.025)){L.used.add("spMove");const to=pick(["札幌","仙台","名古屋","大阪","広島","福岡"].filter(c=>c!==placeOf(L)));
      ask({valid:()=>L.married,title:`${sp.n}に${to}への転勤の話が出る。どうする？`,opts:[
        {t:"家族でついていく",sub:"自分の仕事は変わる",w:2,go(){L.city=to;if(L.job&&corp(L)){startJob("中小企業");say(`${sp.n}の転勤にあわせて${to}へ引っ越し、${jobName()}で働き始める。`,"big")}else say(`${sp.n}の転勤にあわせて、${to}へ引っ越す。`,"big");if(L.home==="持ち家")L.home="賃貸"}},
        {t:"単身赴任してもらう",sub:"今の暮らしは守れるが、さびしい",w:2,go(){L.divRisk=(L.divRisk||1)*1.2;say(`${sp.n}は${to}へ単身赴任する。週末に電話で話すのが習慣になる。`)}},
        {t:"転勤を断ってもらう",sub:"相手のキャリアに響くかも",w:1,go(){say(`${sp.n}は転勤を断る。家族で今の街に残る。`)}}]})}}
  // 子どもの成長
  for(const kd of L.kids){const ka=a-kd.b;if(!kd.trait)kd.trait=pick(["やんちゃな","人なつこい","泣き虫の","しっかり者の","マイペースな","本好きの"]);
    if(ka===3&&!kd.t3)kd.t3=1,say(`${kd.n}は${kd.trait}子に育っている。`);
    if(ka===14&&!kd.rebel&&ch(0.5)){kd.rebel=1;ask({title:`${kd.n}（14歳）が反抗期で、ほとんど口をきいてくれない`,text:"中学生の多くが、親との会話が減る時期を経験する。",opts:[
      {t:"そっと見守る",w:2,go(){kd.bond=(kd.bond||0)+1;say(`${kd.n}の反抗期を、そっと見守る。夕飯だけは一緒に食べるようにする。`)}},
      {t:"時間をとって向き合う",w:2,go(){if(R()<0.5){kd.bond=(kd.bond||0)+2;say(`${kd.n}と二人で出かけ、ぽつりぽつりと話を聞く。`)}else{kd.bond=(kd.bond||0)-1;say(`話をしようとするが、「うるさい」と部屋にこもられる。`)}}},
      {t:"厳しく叱る",w:1,go(){kd.bond=(kd.bond||0)-2;L.hp-=3;say(`${kd.n}を厳しく叱る。しばらく家の空気が重くなる。`)}}]})}
    if(kd.m&&!kd.greet&&ka>=24){kd.greet=1;ask({title:`${kd.n}が、結婚したい相手を連れて挨拶に来る`,opts:[
      {t:"温かく迎える",w:3,go(){L.hp+=6;kd.bond=(kd.bond||0)+1;say(`${kd.n}の結婚相手を、家族そろって温かく迎える。`,"big")}},
      {t:"少し心配なことを伝える",w:1,go(){kd.bond=(kd.bond||0)-1;say(`${kd.n}に、心配なことを正直に伝える。少し気まずい空気になる。`)}}]})}
    if(ka>=30&&ka<=50&&(kd.bond||0)>=2&&!kd.thank&&a>=55&&ch(0.08)){kd.thank=1;say(`${kd.n}から「育ててくれてありがとう」と手紙が届く。`,"big");L.hp+=10}
    if(ka>=25&&(kd.bond||0)<=-2&&!kd.dist&&ch(0.05)){kd.dist=1;say(`${kd.n}とは、なんとなく疎遠になっている。`);L.hp-=5}}
  // 人生をふりかえる
  if((a===45||a===65)&&!L.used.has("echo"+a)){const ds=(L.decs||[]).filter(d=>d[0]<a-10&&!/自分から何をする|自分から動いてみる|何に挑戦する|投票|習い事|部活|運動の習慣|お酒|人間ドック/.test(d[1]));
    if(ds.length){L.used.add("echo"+a);const d=pick(ds);say(`${d[0]}歳のとき、「${d[1].replace(/[。？]$/,"")}」で「${d[2]}」を選んだ日のことを、ふと思い出す。${pick(["あの選択があって、今の自分がいる。","別の道を選んでいたら、と考えることもある。","あのときの自分に、よくやったと言いたい。"])}`)}}
}
function initiative(a){const L=G.L;if(G.queue.length||L.illness||(L.army&&!L.army.end)||a<7)return;
  const p=a<13?0.18:a<23?0.35:a<65?0.26:0.2;if(R()>p)return;
  const el=INIT.filter(x=>!L.used.has("init:"+x.id)&&x.when(L,a)&&!anach(x.t));if(el.length<2)return;
  for(let i=el.length-1;i>0;i--){const j=Math.floor(R()*(i+1));[el[i],el[j]]=[el[j],el[i]]}
  const pick3=el.slice(0,3);
  ask({title:pick(["今年、自分から何をする？","自分から動いてみる？","この1年、何に挑戦する？"]),text:"動けば何かが変わる。動かないのも、ひとつの選択。",
    opts:[...pick3.map(x=>({t:x.t,sub:x.sub,w:2,go(){L.used.add("init:"+x.id);x.go(L,G.age)}})),
      {t:"いまの暮らしを大事にする",sub:"幸福が少し上がる",w:1.2,go(){say(pick(["特別なことはせず、いつもの毎日を大切にする。","今年は無理をせず、のんびり過ごすことにする。"]));L.hp+=2}}]})}

