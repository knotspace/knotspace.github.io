function choose(){let e=E[s.age],c=e[4][chosen];if(!c)return;$('skipchoice').hidden=true;Object.keys(c[1]).forEach(k=>s.stats[k]=clamp(s.stats[k]+c[1][k]));let text=c[2];if(c[3]==='exam'){let x=selectedSchool(),sc=scores.get(x.name.replace(/^(北海道|東京都|大阪府|京都府|.{2,3}県)立/,'')),dev=sc?sc.deviation:55,chance=clamp(65+(s.stats.knowledge-50)*1.3-(dev-55)*1.35,5,98),pass=Math.random()*100<chance;s.school=x.name;s.schoolPref=x.prefecture;s.schoolType=x.schoolType;s.lastExam={name:x.name,dev,knowledge:s.stats.knowledge,chance,pass};text+=' '+x.name+'（'+x.prefecture+'）に'+(pass?'合格した。合格可能性の目安は'+chance+'%。':'挑戦したが不合格。合格可能性の目安は'+chance+'%。別の道を探した。');s.stats.happy=clamp(s.stats.happy+(pass?7:-4));if(pass&&s.age===15){s.education=/高等専門学校/.test(x.schoolType)?'kosen':'high';if(s.education==='kosen')s.age+=4}else if(pass&&s.age===18){s.education='university';s.age+=3}}else if(c[3]==='short'){let x=selectedSchool();s.school=x.name;s.schoolPref=x.prefecture;s.education='short';s.age+=1}else if(c[3]==='work'){s.education='work'}log(e[1],text);$('event').hidden=true;s.waiting=false;s.left=ylen();s.doneEvent=true;if([5,15,30,50,70].includes(s.age)){pauseMoment();s.waiting=true}else run();save()}
