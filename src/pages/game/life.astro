  if(y===1970&&a>=5&&a<=70&&!L.used.has("expo70")&&ch(regionOf(place)==="kansai"||["大阪","京都","兵庫","奈良","滋賀","和歌山"].includes(place)?0.7:0.3)){L.used.add("expo70");
    ask({title:"大阪万博に行く？",text:"半年で約6,400万人が訪れた。",opts:[
      {t:"行く",sub:"「月の石」は数時間待ち",w:2,go(){L.hp+=6;say(pick(["万博に行き、アメリカ館の「月の石」を見るために4時間並ぶ。","万博で「太陽の塔」を見上げる。人の多さに圧倒される。"]),"big")}},
      {t:"テレビで見る",w:1,go(){say("万博の様子をテレビで見る。")}}]})}
  // バブルの財テク（1987〜89年）→ 崩壊（1991〜92年）
  if(y>=1987&&y<=1989&&a>=25&&L.savings>=300&&!L.used.has("zaiteku")&&ch(0.35)){L.used.add("zaiteku");
    ask({title:"まわりが株や土地で儲けている。財テクに手を出す？",text:"日経平均は1989年末に約3万9千円の最高値をつけ、その後大きく下がった。",opts:[
      {t:"株を買う",sub:"今は上がり続けているが…",w:2,go(){L.bubbleInv=Math.round(Math.min(L.savings*0.5,1000));L.savings-=L.bubbleInv;L.invest=(L.invest||0)+L.bubbleInv;say(`${L.bubbleInv.toLocaleString()}万円で株を買う。値上がりが毎日の楽しみになる。`)}},
      {t:"手を出さない",w:2,go(){say("財テクには手を出さず、預金のままにしておく。")}}]})}
  if(L.bubbleInv&&y===1992){const loss=Math.round(Math.min(L.invest||0,L.bubbleInv*0.55));L.invest-=loss;L.hp-=8;say(`バブルがはじけ、買った株が大きく値下がりする。${loss.toLocaleString()}万円ほどの損になる。`,"big");L.bubbleInv=0}
  if(y>=1988&&y<=1990&&a>=22&&a<=40&&corp(L)&&ch(0.3)&&!L.used.has("bubbleLife")){L.used.add("bubbleLife");say(pick(["会社の経費で毎晩のように飲み歩く。帰りのタクシーがなかなかつかまらない。","ボーナスが驚くほど出る。","社員旅行がハワイになる。"]))}
  // 就職氷河期のその後（1993〜2005年に就職）
  const gy=YEAR0+(L.edu==="大学"?22:L.edu==="専門"?20:18);
