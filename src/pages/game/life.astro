    L.savings+=hp-spend;
    if(L.savings<0&&hp>=110&&!L.seiho){L.savings=0;if(ONCE("tsutsumashi"))line("貯金はほとんど残っていないが、年金の範囲でつつましく暮らす。")}
    if(L.savings<-80&&a>=65&&!L.seiho){L.seiho=true;line(`貯金が底をつき、生活保護を受けて暮らすことになる（生活保護を受ける世帯の半分以上が高齢者世帯）。`,"big");L.hp-=6}
    if(L.seiho)L.savings=Math.max(L.savings,-80);
  }
  if(L.savings<-150&&a>25&&ONCE("debt")){line(`生活費が足りず、借金をするようになる。`,"big");L.hp-=8}
  if(L.savings<-150)L.hp-=1.5;
}
