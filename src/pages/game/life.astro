/* ================= 戦争の時代（大正・戦時中の生まれ） ================= */
function warYear(){const y=YEAR0+G.age;return y>=1941&&y<=1946}
const RAIDCITY=["東京","神奈川","大阪","愛知","兵庫","福岡","静岡","岡山","広島","鹿児島","宮城","富山","和歌山","青森","香川","高知","徳島","山口","熊本","岐阜","長崎"];
const FRONT={"中国大陸":["中国大陸の戦線で、何百キロもの道を歩きつづける。","中国の村に駐屯する。故郷の田んぼを思い出す。"],
  "南方の島々":["南方の島で、飢えとマラリアに苦しむ。","補給が途絶え、草や木の根を口にする。"],
  "満州":["満州の国境近くで、凍える冬を越す。","広い大地の地平線を見ながら、故郷を思う。"],
  "フィリピン":["フィリピンのジャングルを、食べ物を探してさまよう。"],
  "ビルマ":["ビルマの山の中を、雨にうたれながら撤退する。"],
  "海の上":["輸送船に乗る。魚雷を恐れて、夜も眠れない。","艦の上で、南の海の星空を見上げる。"],
  "本土の部隊":["本土決戦に備えて、海岸で穴を掘りつづける。","内地の部隊で、敵の上陸に備える。"]};
function war(a){const L=G.L,y=YEAR0+a,say=line,ch=p=>R()<p;if(y<1937||y>1952)return;
  const place=a<18?L.pref:(CITY2PREF[L.city]||L.city),urban=RAIDCITY.includes(place)&&(BIGCITY.includes(place)||ch(0.6));
  /* 父の出征 */
  const faAge=L.fa+a;
  if(y>=1941&&y<=1945&&L.faD>a&&!L.faWar&&!awayP("父",a)&&faAge>=21&&faAge<=43&&ch(y>=1944?0.35:0.12)){L.faWar={at:a};
    say(`父に召集令状（赤紙）が届き、戦地へ向かう。${L.moD>=a?`母と${L.sibs?"きょうだいで":"二人で"}`:"残された家族で"}留守を守る。`,"big");L.hp-=8}
  if(L.faWar&&!L.faWar.end&&a>L.faWar.at&&L.faD<a){L.faWar.end=true}
  if(L.faWar&&!L.faWar.end&&a>L.faWar.at){if(y<=1945&&ch(y>=1944?0.24:0.1)){L.faD=a;L.faWarDeath=true;L.faWar.end=true;L.dec=Math.max(1,L.dec-2)}
    else if(y>=1946||(y===1945&&ch(0.3))){L.faWar.end=true;say(`父が戦地から復員してくる。やせ細った姿に、すぐには父だとわからない。`,"big");L.hp+=8}}
  /* 夫の出征 */
  if(L.sex==="F"&&L.married&&L.spouse&&!L.spWar&&y>=1941&&y<=1945){const sa=L.spouse.age+a-L.spouse.at;
    if(sa>=20&&sa<=42&&L.spD>a&&ch(0.3)){L.spWar={at:a};say(`夫の${L.spouse.n}に召集令状が届く。駅で日の丸の小旗をふって見送る。`,"big");L.hp-=10}}
  if(L.spWar&&!L.spWar.end&&a>L.spWar.at){if(y<=1945&&ch(0.12)){L.spD=a;L.spWarDeath=true;L.spWar.end=true}
    else if(y>=1946){L.spWar.end=true;say(`夫の${L.spouse.n}が復員して帰ってくる。`,"big");L.hp+=10}}
  /* 本人の出征 */
  if(L.sex==="M"&&!L.army&&y>=1937&&y<=1945&&a>=(y>=1944?19:20)&&a<=40){
    const p=y<=1940?0.12:y<=1942?0.3:0.55;
