function finish(){stop();stopMusic();if(s.age>=70)unlock('longlife','長い時間を歩んだ');try{let a=JSON.parse(localStorage.getItem('ao-life-archive')||'[]');a.unshift({name:s.name||'名もない人生',pref:s.pref,era:s.era,age:s.age,stats:s.stats,logs:s.logs,achievements:s.achievements,eras:s.eras,cause:s.cause});localStorage.setItem('ao-life-archive',JSON.stringify(a.slice(0,10)));localStorage.removeItem('ao-life-current')}catch{}$('game').hidden=true;$('ending').hidden=false;$('endtitle').textContent=(s.name||'ひとつの人生')+'の物語。';const ordered=[...s.logs].sort((a,b)=>a.age-b.age);const before35=ordered.filter(x=>x.age<=35),after35=ordered.filter(x=>x.age>35);const first=before35.slice(0,5).map(x=>x.title).join('、')||'日々の小さな経験';const turning=before35.filter(x=>/進路|学校|受験|仕事|関係|家族|転居|暮らし|挑戦|選択/.test(x.title)).map(x=>x.title).slice(0,4).join('、');$('endcopy').textContent=s.era+'年、'+s.pref+'に生まれた'+(s.profile?.gender||'ひとり')+'。'+(s.profile?'家庭環境は「'+s.profile.household+'」、'+(s.profile.singleParent?'ひとり親家庭':'両親と暮らす家庭')+'。':'')+'35歳までに'+before35.length+'件の出来事を経験した。'+(turning?'人生の節目には'+turning+'があり、':'')+'その後は自分で選ぶことのできない時間を歩み、'+s.age+'歳で人生を終えた。最期は「'+(s.cause||'人生の終わり')+'」。'+(after35.length?'35歳以降にも'+after35.length+'件の出来事があり、':'')+'この人生は、'+(s.stats.happy>=70?'人とのつながりや喜びに恵まれた':s.stats.knowledge>=70?'学びや経験を積み重ねた':s.stats.friends>=65?'人との関係を大切にした':'さまざまな出来事を受け止めながら歩んだ')+'物語だった。'+(Object.keys(s.branch||{}).length?' 前半に大切にした道は「'+Object.entries(s.branch).sort((a,b)=>b[1]-a[1]).slice(0,3).map(([k])=>({study:'学び',sport:'スポーツ',creative:'創作',community:'人とのつながり',tech:'技術',career:'仕事',global:'新しい世界',family:'家族',entrepreneur:'独立心',balance:'自分のペース',legacy:'次の世代'}[k]||k)).join('・')+'」だった。':'');$('endstats').replaceChildren();[['健康','health'],['幸福','happy'],['知識','knowledge'],['人間関係','friends'],['暮らし','money']].forEach(x=>{let d=document.createElement('div');d.innerHTML='<b>'+s.stats[x[1]]+'</b><small>'+x[0]+'</small>'; $('endstats').append(d)});$('life-review-summary').textContent='0〜35歳は、自分の選択で道をつくった時間。36歳から最期ま