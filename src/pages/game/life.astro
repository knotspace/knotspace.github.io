  ],'EXAM');
 } else {
  add('中高一貫校','APRIL','中高一貫の新しい学び','中学受験を経て入った学校。高校受験がない分、学びや活動に時間を使える。','中学から高校へ、同じ環境で学びを深めていく。',[
