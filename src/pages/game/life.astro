    ask({title:"地元の消防団に誘われる",text:"消防団員は全国に約75万人。ふだんは別の仕事をしながら、火事や災害のときに出動する。",opts:[
      {t:"入団する",sub:"地域に知り合いが増える",w:2,go(){L.used.add("shoboDone");L.rel+=6;L.hb-=1;say("地元の消防団に入る。夜の訓練に通う。")}},
      {t:"断る",w:1,go(){say("消防団への誘いは断る。")}}]})}
