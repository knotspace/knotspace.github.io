function randomPref(mode=cfg.mode){let w=mode==='population'?populationWeights:weights;let n=Math.random()*w.reduce((a,b)=>a+b,0);for(let i=0;i<prefs.length;i++){n-=w[i];if(n<=0)return prefs[i];}return '東京都'}
function familyRoll(){let poor=Math.random()<.15;return {gender:Math.random()<.51?'男性':'女性',siblings:Math.floor(Math.random()*4),singleParent:Math.random()<.09,household:poor?'相対的に厳しい':'平均的〜ゆとりあり',parentEducation:['中学・高校卒','高校・専門卒','大学卒以上'][Math.floor(Math.random()*3)],parentWork:['会社員','自営業','公務・専門職','農林水産業','パート・非正規'][Math.floor(Math.random()*5)]}}
function makePeer(i){return {name:['ひかり','そう','なぎ'][i],pref:randomPref(),age:0,stats:{health:70+Math.random()*20,happy:45+Math.random()*30,knowledge:20+Math.random()*25,friends:35+Math.random()*30,money:25+Math.random()*30},path:Math.floor(Math.random()*3),alive:true,life:74+Math.floor(Math.random()*18),school:['学びを続ける','ものづくりが好き','人と関わる仕事'][i]}}
function peerYear(p){if(!p.alive)return;p.age++;p.stats.health=clamp(p.stats.health-(p.age>55?1.1:.25)+(Math.random()*1.2-.45));p.stats.happy=clamp(p.stats.happy+(Math.random()*5-2));p.stats.knowledge=clamp(p.stats.knowledge+(p.path===0?1.2:.35));p.stats.friends=clamp(p.stats.friends+(Math.random()*3-.6));p.stats.money=clamp(p.stats.money+(p.age>22?Math.random()*2-.3:0));if(p.age>=p.life||p.stats.health<=0)p.alive=false}
function updatePeers(){if(!s?.peers)return;$('peers').replaceChildren();s.peers.forEach(p=>{let d=document.createElement('div');d.className='peerline';d.innerHTML='<b>'+p.name+' · '+p.pref+'</b><small>'+p.age+'歳 / '+(p.alive?'人生が続いている':'人生を終えた')+' · '+p.school+'</small><i><u style="width:'+p.stats.health+'%"></u></i>';$('peers').append(d)})}
function unlock(id,label){if(!s.achievements.includes(id)){s.achievements.push(id);log('図鑑に登録',label+'を記録した。')}}
function recordEra(title){if(!s.eras.includes(title)){s.eras.push(title);$('era-book').textContent=s.eras.join(' · ')}}
function tone(freq=440,duration=.12){if(!$('sfx')?.checked)return;try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();let o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=freq;g.gain.setValueAtTime(.045,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+duration);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+duration)}catch{}}
function stopMusic(){if(musicTimer)clearInterval(musicTimer);musicTimer=null}
function startMusic(){stopMusic();if(!$('music')?.checked)return;const notes=[261.6,329.6,392,329.6,293.7,349.2,440,349.2];let n=0;musicTimer=setInterval(()=>{if(!$('music')?.checked){stopMusic();return}try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();let o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=notes[n++%notes.length];g.gain.setValueAtTime(.009,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.0001,audioCtx.currentTime+.9);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+1)}catch{stopMusic()}},1100)}

