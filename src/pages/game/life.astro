const CITY2PREF={札幌:"北海道",仙台:"宮城",名古屋:"愛知",広島:"広島",福岡:"福岡",東京:"東京",大阪:"大阪",京都:"京都"};
function jmapSvg(hi,now,my,label=true,big=false){const u=10,gap=1.2;let r="";
  for(const [n,t] of Object.entries(TILES)){const [x,y,w=1,h=1]=t;
    const fill=n===hi?"var(--lamp)":(now&&n===now&&now!==hi)?"var(--ai)":"var(--line)";
    r+=`<rect x="${x*u+gap/2}" y="${y*u+gap/2}" width="${w*u-gap}" height="${h*u-gap}" fill="${fill}"${n===my?` stroke="var(--ink)" stroke-width="1.2" stroke-dasharray="2 1.5"`:""}><title>${pf(n)}</title></rect>`}
  if(label&&hi){const [bx,by,bw=1]=TILES[hi];const lx=bx*u+bw*u/2,ly=by*u;const right=lx>90;
    r+=`<rect x="${right?lx-34:lx+2}" y="${Math.max(0,ly-11)}" width="32" height="10" fill="var(--ink)"/><text x="${right?lx-18:lx+18}" y="${Math.max(0,ly-11)+7.4}" font-size="6.6" text-anchor="middle" fill="var(--paper)" font-family="var(--body)" font-weight="700">${hi}</text>`}
  return `<svg viewBox="-2 -2 144 124" shape-rendering="crispEdges" role="img" aria-label="${hi?pf(hi)+"の位置":"日本地図"}">${r}</svg>`}
function renderJMap(){const L=G.L;const my=store.get("knot.life.myPref","");const now=CITY2PREF[L.city]||L.city;
  $("#jmap").innerHTML=jmapSvg(L.pref,now,my);
  const w=G.mode==="pop"?PREFS.map(x=>POP[x[0]]):PREFS.map(x=>x[1]);const tot=w.reduce((a,b)=>a+b,0),i=PREFS.findIndex(x=>x[0]===L.pref);
  $("#jmapNote").innerHTML=`${G.mode==="pop"?"日本に暮らす人の":"日本の赤ちゃんの"}<b>${(w[i]/tot*100).toFixed(1)}%</b>が${pf(L.pref)}${G.mode==="pop"?"にいる。":"で生まれる。"}`+(now!==L.pref?`<br><span style="color:var(--ai)">■</span> いまは${L.city}で暮らす。`:"")+(my?`<br>点線：あなたの${my}`:"")}
