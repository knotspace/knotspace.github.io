function log(title,text){const entry={age:s.age,year:yr(),title,text};s.logs.unshift(entry);$('count').textContent=s.logs.length+' EVENTS';let li=document.createElement('li');li.className='archive-entry';li.innerHTML='<div class="archive-marker"><i></i></div><div class="archive-content"><div class="archive-meta"><span>'+entry.year+'年</span><span>'+entry.age+'歳</span></div><h4>'+title+'</h4><p>'+text+'</p></div>';$('diary').prepend(li)}
function drawPixelScene(){const cv=$('pixel-canvas');if(!cv)return;const g=cv.getContext('2d');if(!g)return;const t=Math.floor(performance.now()/260)%2,age=s?.age||0;g.clearRect(0,0,240,120);g.fillStyle=age<12?'#dce9e8':age<22?'#dfe6ed':age<60?'#e8e4d8':'#e9e5dc';g.fillRect(0,0,240,120);g.fillStyle='#f1c978';g.fillRect(190,12,18,18);g.fillStyle='#c8d7c8';for(let x=0;x<240;x+=24)g.fillRect(x,91,24,29);g.fillStyle='#9aa88f';g.fillRect(0,102,240,18);g.fillStyle='#718b7c';g.fillRect(0,99,240,3);function b(x,y,w,h,color){g.fillStyle=color;g.fillRect(x*6,y*6,w*6,h*6)}function person(x,y,action,color){b(x+2,y,3,3,'#463d39');b(x+1,y+2,5,3,'#e9b58e');b(x,y+5,7,5,color);b(x-1,y+5,2,4,'#e9b58e');b(x+6,y+5,2,4,'#e9b58e');if(action==='read'){b(x+6,y+6,3,3,'#f3d77c');b(x+1,y+10,2,4,'#344c65');b(x+4,y+10,2,4,'#344c65')}else if(action==='run'){b(x+1,y+10,2,4,'#344c65');b(x+5,y+10+(t?1:0),2,3,'#344c65');b(x+7,y+6,3,1,'#e9b58e')}else if(action==='work'){b(x+7,y+7,4,3,'#526c80');b(x+1,y+10,2,4,'#344c65');b(x+4,y+10,2,4,'#344c65')}else{b(x+1,y+10,2,4,'#344c65');b(x+4,y+10,2,4,'#344c65')}if(t){b(x-1,y+7,2,2,'#e9b58e');b(x+7,y+6,2,2,'#e9b58e')}}b(3,11,9,4,'#9aafaa');b(4,7,7,4,'#b6c8c0');b(5,8,2,2,'#f6f0d8');b(9,8,1,2,'#f6f0d8');let action=age<6?'run':age<22?'read':age<60?'work':'rest';let color=age<15?'#668eac':age<22?'#4d718c':age<60?'#527c6b':'#8b8177';person(18,6,action,color);person(28,8,age<22?'run':'rest','#b77d64');g.fillStyle='#40534a';g.font='8px monospace';g.fillText(age<6?'PLAY':age<15?'SCHOOL':age<22?'STUDY':age<60?'WORK':'LIFE',8,16);$('pixel-caption').textContent=age<6?'PLAYING OUTSIDE':age<15?'SCHOOL DAYS':age<22?'LEARNING & GROWING':age<60?'WORKING LIFE':'A QUIETER CHAPTER'}
function render(){drawPixelScene();renderAcademicArena();$('focus').parentElement.hidden=s.age>35;$('title').textContent=s.name?s.name+'の人生':'ひとりの人生';$('subtitle').textContent=s.pref+' · '+s.age+'歳 · '+yr()+'年';$('age').textContent=s.age+'歳 / 85歳';$('clock').textContent='00:'+String(Math.ceil(s.left)).padStart(2,'0');$('bar').style.width=(s.left/ylen()*100)+'%';[['health','health'],['happy','happy'],['knowledge','knowledge'],['friends','friends'],['money','money']].forEach(x=>{$(x[0]).textContent=s.stats[x[1]];$(x[0]+'b').style.width=s.stats[x[1]]+'%'});$('mapage').textContent=s.age+' / 85';$('map').replaceChildren();for(let i=0;i<86;i++){let d=document.createElement('i');if(i<=s.age)d.className='past';if([5,15,18,30,50,70].includes(i))d.classList.add('dot');$('map').append(d)}let a=[];if(s.stats.knowledge>70)a.push('学びを深めた');if(s.stats.friends>70)a.push('つながりを育てた');if(s.stats.health>70)a.push('健康を大切にした');if(s.school)a.push(s.school+'を選んだ');$('badges').textContent=a.join(' · ')||'人生の中で特別な経験をすると、ここに記録されます。'}
function renderAcademicArena(){const root=$('academic-radar');if(!root||!s)return;const age=s.age;if(age<10||age>35){root.innerHTML='<p>10歳ごろから模試・進路・学校選びが人生に加わります。学力だけでなく、選択や努力の積み重ねも結果に影響します。</p>';return}const study=s.branch?.study||0,tech=s.branch?.tech||0;const score=Math.round(clamp(38+s.stats.knowledge*.43+study*1.7+tech*.6,30,78));const rivals=(s.peers||[]).map((p,i)=>({name:p.name,score:Math.round(clamp(39+p.stats.knowledge*.43+(p.path===0?4:0)+(i-1)*2,28,76))})).sort((a,b)=>b.score-a.score);const rank=1+rivals.filter(x=>x.score>score).length;root.innerHTML='<div class="arena-score"><span>今回の推定偏差値</span><strong>'+score+'</strong><small>GAME DATA</small></div><div class="arena-rank"><b>同世代 '+rank+'位 / 4人</b><span>自己ベスト '+(s.bestMock||'未受験')+'</span></div><div class="arena-rivals">'+rivals.map(p=>'<div><span>'+p.name+' <small>ライバル</small></span><b>'+p.score+'</b></div>').join('')+'<div class="you"><span>あなた <small>YOU</small></span><b>'+score+'</b></div></div><button type="button" id="mock-challenge" class="mock-button" '+((s.mockAges||[]).includes(age)?'disabled':'')+'>'+((s.mockAges||[]).includes(age)?'今年の模試は受験済み':'模試に挑戦する →')+'</button><p class="arena-foot">偏差値はゲーム内能力値による演出用推定値。実在校の偏差値とは異なります。</p>';const btn=$('mock-challenge');if(btn&&!btn.disabled)btn.onclick=()=>{s.mockAges=s.mockAges||[];s.mockAges.push(age);const result=Math.round(clamp(score+(Math.random()*8-4),25,80));s.bestMock=Math.max(s.bestMock||0,result);s.stats.knowledge=clamp(s.stats.knowledge+2);log('模擬試験に挑戦','模試の推定偏差値は'+result+'。この結果を次の学習につなげることにした。');tone(620,.15);render();save()}}
function loadSchools(){if(allSchools.length){schools=allSchools;fillSchools();return}if(schoolLoading){schoolLoading.then(()=>fillSchools());return}schoolLoading=Promise.all(prefs.map((_,i)=>fetch('/data/game/schools/'+String(i+1).padStart(2,'0')+'.json').then(r=>r.ok?r.json():{schools:[]}).then(d=>d.schools||[]).catch(()=>[]))).then(parts=>{allSchools=parts.flat();schools=allSchools;fillSchools()}).catch(()=>{$('schoolinfo').textContent='全国の学校データを読み込めませんでした。'});return schoolLoading}
function fillSchools(){let typ=s.age>=18?'uni':'high',pref=$('schoolpref').value||'全国',q=($('schoolsearch').value||'').trim().toLocaleLowerCase('ja');let list=allSchools.filter(x=>typ==='high'?/高等学校|高等専門学校|中等教育学校/.test(x.schoolType||''):/大学|短期大学|高等専門学校|専修学校/.test(x.schoolType||''));if(pref!=='全国')list=list.filter(x=>x.prefecture===pref);if(q)list=list.filter(x=>(x.name+' '+x.prefecture+' '+(x.department||'')).toLocaleLowerCase('ja').includes(q));list.sort((a,b)=>{let sa=scores.get(a.name.replace(/^(北海道|東京都|大阪府|京都府|.{2,3}県)立/,''))?.deviation||0,sb=scores.get(b.name.replace(/^(北海道|東京都|大阪府|京都府|.{2,3}県)立/,''))?.deviation||0;return sb-sa||a.name.localeCompare(b.name,'ja')});$('school').replaceChildren();let ph=document.createElement('option');ph.value='';ph.textContent=list.length?'学校を選択（'+list.length+'校）':'該当する学校がありません';$('school').append(ph);list.slice(0,350).forEach(x=>{let o=document.createElement('option');o.value=x.schoolCode||x.name;let sc=scores.get(x.name.replace(/^(北海道|東京都|大阪府|京都府|.{2,3}県)立/,''));o.textContent=(sc?'偏差値'+sc.deviation+' · ':'')+x.name+'（'+x.prefecture+'）';$('school').append(o)});schoolInfo()}
function selectedSchool(){return allSchools.find(x=>(x.schoolCode||x.name)===$('school').value)}
function schoolInfo(){let x=selectedSchool();if(!x){$('schoolinfo').textContent='全国の学校から選択できます。検索欄に学校名を入力してください。';return}let sc=scores.get(x.name.replace(/^(北海道|東京都|大阪府|京都府|.{2,3}県)立/,''));$('schoolinfo').textContent=x.name+' / '+x.prefecture+' / '+(x.ownership||'設置者不明')+' / '+(sc?'参考偏差値 '+sc.deviation:'偏差値データ未収録・挑戦可能')+' / 文部科学省学校コード '+(x.schoolCode||'—')}
