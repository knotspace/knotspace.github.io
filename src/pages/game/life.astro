 {id:"oOldFriend",t:"長年会っていない友人に手紙を書く",sub:"昔の縁がよみがえる",when:(L,a)=>a>=55&&L.friend&&L.friend.d>a,go(L,a){say(`長年会っていない${L.friend.n}に手紙を書く。すぐに返事が届き、${R2(10,40)}年ぶりに会う約束をする。`,"big");L.rel+=5;L.hp+=6}},
 {id:"oGrandTrip",t:"孫を連れて旅行に行く",sub:"孫との思い出をつくる",when:(L,a)=>a>=60&&L.grand>0&&L.savings>=20,go(L,a){L.savings-=15;say(`孫を連れて${pick(["動物園","水族館","温泉","遊園地"])}へ行く。帰りの電車で、孫が手を握ったまま眠る。`,"big");L.hp+=8}},
 {id:"oVolun",t:"ボランティアで子どもたちに教える",sub:"人の役に立つ",when:(L,a)=>a>=62&&a<=82,go(L,a){say(`ボランティアで、地域の子どもたちに${pick(["昔遊び","勉強","将棋","読み聞かせ"])}を教える。`);L.rel+=6;L.hp+=5}},
 {id:"oTabi",t:"ずっと行きたかった場所へ旅に出る",sub:"人生の楽しみ",when:(L,a)=>a>=60&&a<=82&&L.savings>=60,go(L,a){L.savings-=40;say(`ずっと行きたかった${pick(["屋久島","知床","オーロラの見える北欧","沖縄の離島","奥の細道の旅路"])}へ行く。`,"big");L.hp+=9}},
