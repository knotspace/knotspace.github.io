      {t:"電気冷蔵庫",sub:"食べ物が長持ちする",w:1.5,go(){L.savings-=20;L.hb+=1;say("電気冷蔵庫を買う。冷えた麦茶に家族が喜ぶ。","big")}}]})}
  if(y>=1966&&y<=1975&&a>=25&&L.income>0&&once3C()){const c=pick(["tv","cooler",...(L.license&&!L.car?["car"]:[])]);if(c==="car")L.car="新車";say(c==="tv"?"カラーテレビを買う。画面に色がついて、家族で歓声をあげる。":c==="cooler"?"クーラーを取りつける。夏の夜がぐっと過ごしやすくなる。":"マイカーを買い、週末にドライブに出かける。")}
  // 学生運動（1968〜70年、大学生）
