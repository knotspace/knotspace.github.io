/* Minimal editorial masthead: no decorative top bar */
.wrap{max-width:1040px;padding:0 30px}
#home{padding:clamp(34px,6vw,72px) 0 60px}
#home>.eyebrow{font-size:10px;letter-spacing:.22em;color:#83b8ed;margin:0 0 18px}
h1{font-size:clamp(42px,7vw,76px);line-height:1.22;letter-spacing:-.065em;margin:0 0 22px}
.lead{font-size:13px;line-height:2.15;max-width:620px}
.facts{gap:0;max-width:620px;margin:30px 0 34px;padding:17px 0;border-top:1px solid #263449;border-bottom:1px solid #263449}
.facts>div{min-width:125px;padding:0 22px;border-right:1px solid #263449}
.facts>div:first-child{padding-left:0}.facts>div:last-child{border:0}
.facts b{font:600 25px Georgia;color:#a8c9ff}
.facts small{font-size:9px;letter-spacing:.06em}
.setup{max-width:760px;background:rgba(15,25,39,.78)!important;border:1px solid #2a3b52!important;box-shadow:0 24px 80px #0003;padding:clamp(22px,4vw,40px)}
.st{padding-bottom:2px}.st i{color:#83b8ed}
.st b{font-size:13px;letter-spacing:.04em}
.grid{gap:7px}.grid button,.dur button,.birthmodes button{min-height:64px;border-radius:3px;transition:border-color .18s,background .18s}
.grid button:hover,.dur button:hover,.birthmodes button:hover{border-color:#709bd0!important;background:#14243a!important}
.primary{min-height:50px;letter-spacing:.04em}
@media(max-width:600px){.wrap{padding:0 18px}.facts>div{min-width:0;flex:1;padding:0 12px}.facts b{font-size:21px}}

/* AO NO BUNKITEN — unified dark visual system */
:root{color-scheme:dark;--paper:#0b1018;--ink:#e8eef8;--muted:#8f9db1;--line:#263449;--blue:#79aaff;--wash:#14243a;--warm:#82c7e8;background:#0b1018}
html,body{background:#0b1018!important;color:#e8eef8!important}
body{background:radial-gradient(ellipse at 50% -15%,#172943 0%,#0b1018 58%)!important}
header{border-color:#263449}header b{background:#79aaff;color:#07111f}header strong{color:#edf4ff}
header small,.eyebrow{color:#82c7e8}h1 em{color:#79aaff}
.lead,.facts small,.st small,.field small,.fine,.hint{color:#9aa9bd}.facts b{color:#8db8ff}
.setup,.event,.diary,.side,.life-review,.endstats div,.endbox{background:#111b29!important;border-color:#2a3b52!important;color:#e8eef8}
.setup{box-shadow:0 24px 70px #0006}
.grid button,.dur button,.birthmodes button,.field select,.field input,.schoolrow select,.schoolrow input,.choice,.focus button,.controls button{background:#0c1521!important;border-color:#30425b!important;color:#e5edf9!important}
.grid button small,.dur button small,.birthmodes small,.schoolhint{color:#91a2b8}
.on,.grid button.on,.dur button.on,.birthmodes button.on,.controls button.on,.choice.picked,.choice:hover,.focus button.on{background:#1a304c!important;border-color:#79aaff!important;color:#f2f7ff!important;box-shadow:inset 0 0 0 1px #79aaff}
.primary{background:#79aaff!important;color:#07111f!important;font-weight:800}.primary:hover{background:#9bc0ff!important}
.gentle,.birthdraw,.schoolarea{background:#142236!important;border-color:#30445f!important}
.gentle b,.schoolarea>b{color:#e6effc}
.clock{background:#111d2c!important;border-color:#2a3b52!important}.clock>div:first-child b{color:#edf4ff}
.bar,.meters i,.peerline i{background:#26364c!important}.bar i,.meters u{background:#79aaff!important}
.meters>div{background:#111b29!important;border-color:#2a3b52!important;color:#a9b7ca}.meters b{color:#f1f6ff}
.event{box-shadow:0 20px 55px #0005;border-radius:5px}.event>p:not(#scene),#scene{color:#a9b8cc}
.pixel-stage{background:#101d2c!important;border-color:#30445e!important}.pixel-stage span{color:#8eb6e8}
.choice{border-radius:4px}.choice small,.side>p,.side #familyprofile,.side #era-book,.diary li,.endbox p{color:#9aa9bd}
.map i{background:#253449}.map i.past{background:#79aaff}.map i.dot{outline-color:#82c7e8}
.review-summary{color:#a9b8cc}.life-path i{background:#26364a}.life-path i.choice-age{background:#79aaff}.life-path i.life-age{background:#43536a}.life-path i.has-event{outline-color:#82c7e8}
.review-legend,.review-card small,.life-timeline li p{color:#9aa9bd}.review-card{background:#142236!important;border-color:#2a3b52!important}
.life-timeline{border-color:#2a3b52}.life-timeline li,.diary li,.endbox li{border-color:#263449}
.skipchoice,.plain{color:#a9b8cc;border-color:#30425b}
footer.site-footer{max-width:1120px;margin:35px auto 0;padding:22px 28px 30px;border-top:1px solid #263449;display:flex;justify-content:center}
footer.site-footer a{color:#8192a9;text-decoration:none;font:10px ui-monospace,monospace;letter-spacing:.16em;transition:color .2s}
footer.site-footer a:hover{color:#9bc0ff}
.archive{color:#e8eef8}#archives{color:#9aa9bd;font-size:11px;margin-top:12px}.ending h2{color:#edf4ff}.endstats b{color:#8db8ff}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid #82c7e8;outline-offset:3px}
@media(max-width:600px){footer.site-footer{padding-bottom:24px}}
</style></body></html>