---
const pageTitle = "青の分岐点｜KNOT";
---
<!doctype html>
<html lang="ja" data-theme="dark">
<head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>青の分岐点｜KNOT</title>
<meta name="description" content="選択が、人生のかたちを変えていく。0歳から人生の最後までを体験するKNOTの人生シミュレーション。">
<meta name="theme-color" content="#07111f">
<link rel="icon" href="/game/life/favicon.svg?v=2" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">

<style is:global>

/* Layout: 本家に寄せた3カラムの人生ダッシュボード。左＝身元記録と状態、中央＝ドット絵の場面・重点・記録、右＝家族・同じ日の人・人生地図。スマホでは場面を先頭に1列に積む */
:root{
  --bg:#F1F2EE; --paper:#FFFFFF; --soft:#F6F7F3; --ink:#23262D; --muted:#7A7F88; --line:#DCDFD8;
  --teal:#2E7C77; --teal-soft:#E0EFEC; --crimson:#8E1F3F; --ochre:#A87B2C; --green:#3F7D58;
  --btn:#1F2330; --btn-ink:#FFFFFF; --lamp:#E3A83B; --lamp-soft:#FBF0D8; --warn:#B4472F; --gone:#A3A8B0;
  --ai:var(--teal); --ai-soft:var(--teal-soft);
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100;
  --display:"Shippori Mincho B1","Hiragino Mincho ProN","Yu Mincho",serif;
  --body:"Zen Kaku Gothic New","Hiragino Sans","Yu Gothic",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#14161B; --paper:#1C1F26; --soft:#22252D; --ink:#E9EAEE; --muted:#9AA0AA; --line:#30343E;
  --teal:#5FB3AC; --teal-soft:#1E3432; --crimson:#D2627F; --ochre:#D2A24F; --green:#6DB48A;
  --btn:#E9EAEE; --btn-ink:#14161B; --lamp:#E9C063; --lamp-soft:#3A3220; --warn:#E58A72; --gone:#626872; --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#14161B; --paper:#1C1F26; --soft:#22252D; --ink:#E9EAEE; --muted:#9AA0AA; --line:#30343E;
  --teal:#5FB3AC; --teal-soft:#1E3432; --crimson:#D2627F; --ochre:#D2A24F; --green:#6DB48A;
  --btn:#E9EAEE; --btn-ink:#14161B; --lamp:#E9C063; --lamp-soft:#3A3220; --warn:#E58A72; --gone:#626872; --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
#finalBox:empty{display:none}
.tl .pct{display:block;color:var(--muted);font-size:11.5px;font-weight:400}
.report{margin:8px 0;font-size:13px}.report summary{cursor:pointer;color:var(--muted)}.report textarea{width:100%;box-sizing:border-box;font:inherit;padding:8px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);margin-top:6px}
.cmpPrev{margin:12px 0}.cmpPrev h4{margin:0 0 6px}.cmp .chg{color:var(--crimson)}
.soumato{position:fixed;inset:0;z-index:50;background:rgba(10,10,18,.97);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .6s;color:#f2efe6}
.soumato.in{opacity:1}.soumato.out{opacity:0}
.soumato .sm-in{max-width:520px;padding:24px;text-align:center;opacity:0;transform:translateY(8px);transition:opacity .45s,transform .45s}
.soumato .sm-in.on{opacity:1;transform:none}
.soumato .sm-ic svg{width:72px;height:72px;image-rendering:pixelated;filter:drop-shadow(0 0 12px rgba(255,240,200,.35))}
.soumato .sm-age{font-size:13px;letter-spacing:.2em;opacity:.7;margin-top:10px}
.soumato .sm-t{font-family:var(--display);font-size:20px;line-height:1.6;margin:8px 0 0}
.soumato .sm-skip{position:absolute;right:16px;bottom:16px;background:transparent;color:#f2efe6;border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:6px 14px;font:inherit;font-size:13px;cursor:pointer}
.toast{position:fixed;left:0;right:0;margin:0 auto;width:fit-content;top:84px;transform:translateY(-10px);z-index:40;background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:14px;box-shadow:0 10px 30px rgba(0,0,0,.18);padding:10px 16px;font-size:14px;opacity:0;transition:opacity .35s,transform .35s;pointer-events:none;max-width:min(92vw,460px)}
.toast.on{opacity:1;transform:none}
.toast.cut{display:flex;align-items:center;gap:12px;border-left:4px solid var(--crimson)}
.toast .ct-ic svg{width:40px;height:40px;image-rendering:pixelated}.toast .ct-t{font-weight:700;line-height:1.5}.toast .ct-t small{display:block;font-weight:400;color:var(--muted);font-size:11.5px}
.toast.pct{top:auto;bottom:24px;font-size:13px}
.helpnote{border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:10px;padding:10px 12px;background:var(--paper);font-size:13px;line-height:1.7}
.helpnote a{color:var(--teal);font-weight:700}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:14.5px;line-height:1.7;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 140px}
button,select,textarea,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--lamp);outline-offset:2px}
h1,h2,h3,p{margin:0}
.wrap{max-width:1280px;margin:0 auto;display:flex;flex-direction:column;gap:18px}
.label{font-size:12px;letter-spacing:.1em;color:var(--muted)}
.note{font-size:12.5px;color:var(--muted)}
.card{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:16px;display:flex;flex-direction:column;gap:12px;min-width:0;position:relative}
.card>.hd{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.card>.hd h3{font-size:17px;font-weight:700;letter-spacing:.02em}
.card>.hd .cn{font-size:11.5px;color:var(--muted)}
section{display:flex;flex-direction:column;gap:10px}
h2{font-size:12.5px;letter-spacing:.14em;color:var(--muted);font-weight:500}
.primary{background:var(--btn);color:var(--btn-ink);border:0;border-radius:6px;padding:15px;font-size:17px;font-weight:700;letter-spacing:.2em}
.ghost{background:var(--paper);border:1px solid var(--line);border-radius:5px;padding:5px 10px;font-size:12.5px;line-height:1.5;white-space:nowrap}
.ghost[aria-pressed="true"]{background:var(--btn);border-color:var(--btn);color:var(--btn-ink);font-weight:700}
.ghost:disabled{opacity:.45;cursor:not-allowed}

/* ===== スタート ===== */
.start{max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:22px;padding-top:28px;width:100%;position:relative}
.start>*{position:relative;z-index:1}
.start>.jbg{position:fixed;inset:0;z-index:0;pointer-events:none;display:grid;place-items:center;overflow:hidden}
.jbg svg{height:min(94vh,860px);width:auto;max-width:118vw;transform:translateX(14%) rotate(-3deg)}
@media (max-width:760px){.jbg svg{height:auto;width:100vw;max-width:none;transform:translateY(-4%) rotate(-3deg)}}
.jbg rect{fill:var(--ink);opacity:.055;transition:opacity 2.4s ease,fill 2.4s ease}
.jbg rect.on{fill:var(--teal);opacity:.38;transition:none}
@media (prefers-reduced-motion:reduce){.jbg rect{transition:none}}
.start h1{font-family:var(--display);font-weight:800;font-size:clamp(46px,13vw,80px);line-height:1.05;letter-spacing:.01em}
.start h1 small{display:block;font-family:var(--body);font-size:12.5px;font-weight:500;color:var(--muted);letter-spacing:.14em;margin-bottom:12px}
.lead{max-width:36em;font-size:15px}
.counters{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.counters div{background:var(--paper);padding:14px 16px}
.counters b{display:block;font-family:var(--display);font-size:34px;font-variant-numeric:tabular-nums;line-height:1.2}
.counters .gone b{color:var(--gone)}
.counters .total{grid-column:1/-1;display:flex;align-items:baseline;justify-content:space-between;gap:6px 14px;flex-wrap:wrap}
.counters .total>div{padding:0;background:none}.counters .total b{color:var(--teal)}.counters .total b small{font-size:15px;margin-left:3px;color:var(--ink)}
.counters p{font-size:12px;color:var(--muted)}
fieldset{border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
legend{padding:0;margin-bottom:8px}
.seg{display:flex;flex-wrap:wrap;gap:8px}
.upnote{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:12px;padding:8px 12px;margin:0;text-align:left;cursor:pointer;width:100%}
.upnote:hover{border-color:var(--teal)}
.upnote .nw,.news .nw{font-size:10.5px;font-weight:700;letter-spacing:.06em;color:#fff;background:var(--crimson);border-radius:999px;padding:1px 7px}
.upnote .ud{color:var(--muted);font-size:12px}
.news{display:flex;flex-direction:column;gap:10px}
.news details{border:1px solid var(--line);border-radius:12px;padding:10px 14px;background:var(--paper)}
.news summary{font-weight:700;font-size:14px;cursor:pointer;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.news summary .ud{font-weight:400;color:var(--muted);font-size:12px}
.news h4{font-size:12.5px;margin:12px 0 4px;color:var(--teal)}
.news ul{margin:0;padding-left:1.2em;font-size:13.5px;line-height:1.7}
.eraOpt{border:1px dashed var(--line);border-radius:12px;padding:10px 12px;margin-bottom:14px;color:var(--ink);font-size:13.5px}
.eraOpt summary{font-weight:700}
.eraOpt .opt{font-size:11px;font-weight:400;border:1px solid var(--line);border-radius:999px;padding:1px 7px;margin-left:8px;color:var(--muted)}
#eraCur{white-space:nowrap;font-weight:400;color:var(--muted);margin-left:8px;font-size:12.5px}
.eraSeg{margin-top:10px}
.eraSeg label{flex:1 1 28%}
.eraOpt .note.warn{color:var(--ink);border-left:3px solid var(--lamp);padding-left:8px}
.seg label{flex:1 1 90px;border:1px solid var(--line);border-radius:999px;background:var(--paper);padding:8px 12px;text-align:center;cursor:pointer;font-size:13.5px;position:relative}
.seg input{position:absolute;opacity:0;inset:0}
.seg label:has(input:checked){border-color:var(--teal);background:var(--teal);color:#fff;font-weight:700}
.seg label:has(input:focus-visible){outline:2px solid var(--lamp);outline-offset:2px}
select{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:8px 10px;width:100%}
.chance{display:flex;flex-direction:column;gap:6px;font-size:13.5px}
.chance .r{display:grid;grid-template-columns:5.5em 1fr 3.6em;gap:8px;align-items:center}
.chance .bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden}
.chance .bar i{display:block;height:100%;background:var(--teal)}
.chance .r b{font-variant-numeric:tabular-nums;text-align:right;font-weight:500}
.linkbtn{background:none;border:0;padding:0;color:var(--teal);text-decoration:underline;text-underline-offset:3px;font-size:13px;align-self:flex-start}
.tbl-wrap{overflow:auto;max-height:360px;border:1px solid var(--line);border-radius:6px}
.tbl{border-collapse:collapse;font-size:12.5px;width:100%;min-width:440px;font-variant-numeric:tabular-nums}
.tbl th,.tbl td{padding:5px 8px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
.tbl th:first-child,.tbl td:first-child{text-align:left}
.tbl thead th{position:sticky;top:0;background:var(--paper);color:var(--muted);font-weight:500}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;font-size:13.5px}
.facts div{border-top:2px solid var(--ink);padding-top:8px}
.facts b{display:block;font-size:14px;margin-bottom:2px}
.past{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.past li{padding:10px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:2px 12px;font-size:13.5px}
.past li b{font-family:var(--display);font-size:16px}
.past li .d{font-variant-numeric:tabular-nums;color:var(--muted);align-self:center}
.past li p{grid-column:1/-1;color:var(--muted);font-size:12.5px}
.music{align-self:center}

/* ===== 上部バー ===== */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:8;background:var(--bg);border-bottom:1px solid var(--line);
  margin-left:calc(-1 * max(16px,env(safe-area-inset-left,0px)));margin-right:calc(-1 * max(16px,env(safe-area-inset-right,0px)));
  padding:10px max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px))}
.tb-in{max-width:1280px;margin:0 auto;display:flex;align-items:center;gap:8px 14px;flex-wrap:wrap}
.tb-l{display:flex;align-items:baseline;gap:12px;min-width:0;flex:1 1 280px}
.brand{font-family:var(--display);font-weight:700;font-size:16px;white-space:nowrap}
.age{font-family:var(--display);font-size:38px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}
.age span{font-size:16px;margin-left:2px}
.sub{font-size:12.5px;color:var(--muted);min-width:0;display:flex;flex-direction:column;gap:4px;flex:1}
.sub span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.prog{height:3px;background:var(--line);border-radius:2px;overflow:hidden;max-width:180px}
.prog i{display:block;height:100%;background:var(--crimson);transition:width .4s}
.ctrl{display:flex;gap:5px;overflow-x:auto;max-width:100%;padding-bottom:2px;scrollbar-width:thin}
.ctrl .sep{width:1px;background:var(--line);flex:0 0 1px;margin-inline:2px}

/* ===== グリッド ===== */
.grid{display:grid;grid-template-columns:300px minmax(0,1fr) 320px;gap:16px;align-items:start;padding-top:16px}
.col{display:flex;flex-direction:column;gap:16px;min-width:0}
@media (max-width:1180px){.grid{grid-template-columns:290px minmax(0,1fr)}.col.r{grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));align-items:start}}
@media (max-width:760px){.grid{display:flex;flex-direction:column;align-items:stretch}.col,.col.r{display:contents}
  #c_scene{order:1}#finalBox{order:2}#c_id{order:3}#c_focus{order:4}#c_log{order:5}#c_state{order:6}#c_fam{order:7}#c_money{order:8}#c_peers{order:9}#c_map{order:10}#c_jmap{order:11}#c_curve{order:12}.sources{order:13}}

/* ===== 身元記録 ===== */
.idc{padding:0;overflow:hidden;gap:0}
.idc .bar{background:var(--crimson);color:#fff;font-family:var(--mono);font-size:11.5px;letter-spacing:.12em;padding:7px 14px;display:flex;justify-content:space-between}
.idc .body{position:relative;padding:14px;display:grid;grid-template-columns:72px 1fr;gap:12px}
.idc .gl{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.55}
.idc canvas{width:72px;height:auto;image-rendering:pixelated;border:1px solid var(--line);position:relative;align-self:start}
.idc .nm{font-family:var(--display);font-size:22px;font-weight:700;line-height:1.2;grid-column:2;position:relative}
.idc .nm small{display:block;font-family:var(--mono);font-size:10.5px;color:var(--muted);letter-spacing:.12em;font-weight:400;margin-top:3px}
.idc dl{grid-column:1/-1;display:grid;grid-template-columns:6.2em 1fr;gap:3px 10px;margin:0;font-size:13px;position:relative}
.idc dt{color:var(--muted);font-size:12px}
.idc dd{margin:0;min-width:0}
.idc .dots{letter-spacing:.12em;color:var(--ink)}
.idc .mrz{font-family:var(--mono);font-size:11px;letter-spacing:.06em;border-top:1px dashed var(--line);padding:9px 14px 11px;line-height:1.6;color:var(--ink);overflow-x:auto;white-space:pre}

/* ===== 状態 ===== */
.bars{display:flex;flex-direction:column;gap:9px}
.bars .r{display:grid;grid-template-columns:4.6em 1fr 3.6em;align-items:center;gap:10px;font-size:13.5px}
.bars .t{height:10px;background:var(--soft);border:1px solid var(--line);border-radius:2px;overflow:hidden}
.bars .t i{display:block;height:100%;transition:width .4s}
.bars b{white-space:nowrap;text-align:right;font-variant-numeric:tabular-nums;font-weight:500}
.bars .d{font-size:10.5px;margin-left:3px}
.up{color:var(--green)}.down{color:var(--warn)}
.fin{display:grid;grid-template-columns:1fr 1fr;gap:10px;border-top:1px dashed var(--line);padding-top:10px;font-size:12.5px}
.fin b{display:block;font-size:16px;font-variant-numeric:tabular-nums;font-weight:700;color:var(--ink)}
details{font-size:12.5px;color:var(--muted)}
details summary{cursor:pointer}
details dl{display:grid;grid-template-columns:auto 1fr;gap:4px 10px;margin:8px 0 0}
details dt{color:var(--ink);font-weight:700}
details dd{margin:0}

/* ===== 場面 ===== */
.scene-c{padding:0;overflow:hidden;gap:0}
.scene-c canvas{display:block;width:100%;height:auto;image-rendering:pixelated;background:#BFE3F7}
.scene-c .cap{padding:10px 14px;font-size:13px;color:var(--muted);border-top:1px solid var(--line)}
.scene-c .cap b{color:var(--ink);font-weight:500}

/* ===== 重点 ===== */
.role{font-size:13.5px}
.role b{font-weight:700}
.pills{display:flex;flex-wrap:wrap;gap:8px}
.pill{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:6px 14px;text-align:left;line-height:1.35;font-size:13.5px}
.pill small{display:block;font-size:10.5px;color:var(--muted)}
.pill[aria-pressed="true"]{background:var(--teal);border-color:var(--teal);color:#fff}
.pill[aria-pressed="true"] small{color:rgb(255 255 255 / .85)}

/* ===== 記録 ===== */
.lognote{font-size:12px;color:var(--teal);line-height:1.6}
.log-box{max-height:560px;overflow-y:auto;overscroll-behavior:contain;margin-inline:-4px;padding-inline:4px}
.log{list-style:none;margin:0;padding:0}
.log li{display:grid;grid-template-columns:24px 3em 1fr;gap:8px;padding:10px 4px;border-bottom:1px solid var(--line);cursor:pointer;align-items:start}
.log li .ic svg{width:22px;height:22px;display:block;margin-top:1px}
.log li .y{font-variant-numeric:tabular-nums;color:var(--muted);font-size:12.5px;padding-top:1px}
.log li .t{min-width:0;display:flex;flex-direction:column;gap:3px}
.log li .t p.big{font-weight:700}
.log li .t p.ch{font-size:12px;color:var(--crimson)}
.log li .t p.re{font-family:var(--display);color:var(--muted);font-size:13.5px}
.log li .t p.src{font-size:11.5px;color:var(--teal);font-family:var(--body)}
.log li .t p.src::before{content:"資料";font-weight:700;margin-right:6px}
.log li:first-child{background:var(--lamp-soft)}
.lf{display:flex;gap:4px;flex-wrap:wrap}
.lf button{font-size:11.5px;padding:3px 9px;border-radius:999px;border:1px solid var(--line);background:var(--paper);color:var(--muted)}
.lf button[aria-pressed="true"]{background:var(--btn);color:var(--btn-ink);border-color:var(--btn)}
#logBox[data-f="big"] .log li:not(:has(p.big)),#logBox[data-f="ch"] .log li:not(:has(p.ch)),#logBox[data-f="star"] .log li:not(.star){display:none}
#logBox[data-f="big"] .log li .t p:not(.big),#logBox[data-f="ch"] .log li .t p:not(.ch){display:none}
.rev{display:flex;flex-direction:column;gap:10px;border-top:1px solid var(--line);padding-top:12px}
.rev h4{margin:0;font-size:14px}
.graph{position:relative}
.graph svg{width:100%;height:auto;display:block;overflow:visible}
.graph .tip{position:absolute;pointer-events:none;background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:6px 9px;font-size:12px;box-shadow:0 4px 14px rgb(0 0 0 / .12);white-space:nowrap}
.graph .tip i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:5px}
.glegend{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.glegend span::before{content:"";display:inline-block;width:12px;height:3px;border-radius:2px;margin-right:5px;vertical-align:3px;background:var(--c)}
.tl{list-style:none;margin:0;padding:0;font-size:13px;max-height:280px;overflow:auto;border-top:1px solid var(--line)}
.tl li{display:grid;grid-template-columns:3.2em 1fr;gap:8px;padding:5px 0;border-bottom:1px dotted var(--line)}
.tl li span{color:var(--muted);font-variant-numeric:tabular-nums}
.tl.dec li b{font-weight:500;color:var(--crimson)}
.log li.star .y::after{content:"★";color:var(--lamp);display:block;font-size:14px}
.log li.end .t p.big{font-family:var(--display);font-size:17px}

/* ===== 右カラム ===== */
.kv{display:flex;flex-direction:column;font-size:13.5px}
.kv div{display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-bottom:1px solid var(--line)}
.kv div:last-child{border-bottom:0}
.kv span:first-child{color:var(--muted);white-space:nowrap}
.kv span:last-child{text-align:right;min-width:0}
.kv span small{display:block;color:var(--muted);font-size:11.5px}
.kv .gone{color:var(--gone)}
.peers{display:flex;flex-direction:column}
.peer{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px}
.peer:last-child{border-bottom:0}
.peer b{display:block;font-size:14px}
.peer span{color:var(--muted);font-size:12px}
.peer .st{white-space:nowrap;color:var(--ink);font-size:12.5px}
.peer.dead,.peer.dead .st{color:var(--gone)}
.map{display:grid;grid-template-columns:repeat(10,1fr);gap:3px}
.map i{aspect-ratio:1;background:var(--soft);border:1px solid var(--line);border-radius:2px}
.map i.lived{background:var(--teal);border-color:var(--teal);opacity:.55}
.map i.ev{background:var(--teal);border-color:var(--teal);opacity:1}
.map i.ch{background:var(--lamp);border-color:var(--lamp);opacity:1}
.map i.ill{background:var(--crimson);border-color:var(--crimson);opacity:1}
.map i.avg{box-shadow:inset 0 0 0 2px var(--ink)}
.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:11.5px;color:var(--muted)}
.legend span::before{content:"";display:inline-block;width:10px;height:10px;margin-right:4px;vertical-align:-1px;background:var(--c);border-radius:2px}
.legend span.ring::before{background:transparent;box-shadow:inset 0 0 0 2px var(--ink)}
.jm svg,.curve svg{width:100%;height:auto;display:block}
.money .acts{display:flex;flex-direction:column;gap:6px}
.money .acts button{text-align:left;background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:8px 12px;font-size:13px}
.money .acts button small{display:block;color:var(--muted);font-size:11.5px}
.money .acts button:disabled{opacity:.45;cursor:not-allowed}
.sources{font-size:11.5px;color:var(--muted);grid-column:1/-1}

/* ===== 決断シート ===== */
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:10;background:var(--paper);border-top:3px solid var(--crimson);
  box-shadow:0 -12px 40px rgb(0 0 0 / .18);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-top:16px;padding-bottom:calc(18px + env(safe-area-inset-bottom,0px));max-height:80%;overflow-y:auto}
.sheet.re{border-top-color:var(--lamp)}
.sheet .in{max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.sheet .cd{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted)}
.sheet .cdbar{flex:1;height:4px;border-radius:2px;background:var(--line);overflow:hidden}
.sheet .cdbar i{display:block;height:100%;width:100%;background:var(--crimson);transform-origin:left;transition:transform .12s linear}
.sheet.re .cdbar i{background:var(--lamp)}
.sheet .cd button{font-size:12px;padding:3px 10px;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--ink);cursor:pointer}
.sheet .kbd{display:none}
@media (hover:hover) and (pointer:fine){.sheet .kbd{display:inline}}
.sheet h3{font-family:var(--display);font-size:22px;line-height:1.4;text-wrap:balance}
.opts{display:flex;flex-direction:column;gap:8px}
.opts button{text-align:left;background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:11px 14px;line-height:1.5}
.opts button:hover{border-color:var(--teal)}
.opts button small{display:block;color:var(--muted);font-size:12px}

/* ===== 出生 ===== */
.birth{position:fixed;inset:0;z-index:20;background:var(--bg);overflow-y:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-top:calc(24px + env(safe-area-inset-top,0px));padding-bottom:calc(24px + env(safe-area-inset-bottom,0px))}
.birth .in{max-width:440px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
