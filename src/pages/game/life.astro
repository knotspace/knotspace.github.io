function pxSvg(name){const S=PX.s[name]||PX.s.sakura;let r="";
  S.forEach((row,y)=>{let x=0;while(x<16){const c=row[x];if(c==="."){x++;continue}let e=x;while(e<16&&row[e]===c)e++;r+=`<rect x="${x}" y="${y}" width="${e-x}" height="1" fill="${PX.pal[c]}"/>`;x=e}});
  return `<svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">${r}</svg>`}
