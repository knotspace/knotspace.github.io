.birth h2{font-family:var(--display);font-size:22px;color:var(--ink);letter-spacing:.3em;text-align:center;font-weight:700}

/* ===== 最期 ===== */
.final{border:2px solid var(--ink)}
.final .big{font-family:var(--display);font-size:clamp(30px,8vw,42px);font-weight:800;line-height:1.2;text-wrap:balance}
.cmp{display:grid;grid-template-columns:auto 1fr 1fr;font-size:13px;border-top:1px solid var(--line)}
.cmp>*{padding:6px 8px;border-bottom:1px solid var(--line);min-width:0}
.cmp .h{color:var(--muted);font-size:12px}
.cmp b{font-variant-numeric:tabular-nums}
.share{font-size:13px;background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:10px;white-space:pre-wrap;user-select:all}
.btns{display:flex;gap:8px;flex-wrap:wrap}
.btns .primary{flex:1 1 200px;letter-spacing:.08em;font-size:16px}
.stars{margin:0;padding-left:1.2em;font-size:13px}
.help{display:flex;flex-direction:column;gap:8px;font-size:13px}
.help ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px}
.help li{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:9px 12px;line-height:1.5}
.help li b{display:block;font-size:13.5px}
.help li a{font-family:var(--mono);font-size:15px;color:var(--teal);text-decoration:none;font-weight:500;user-select:all}
.help li span{display:block;color:var(--muted);font-size:11.5px}
.credit{font-size:12px;color:var(--muted);line-height:1.7}
.credit a{color:var(--teal)}
.foot{order:14;grid-column:1/-1;display:flex;flex-direction:column;gap:14px;border-top:1px solid var(--line);padding-top:16px;margin-top:4px}
.resume{border:2px solid var(--teal)}
.dex{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:600px){.dex{grid-template-columns:1fr}}
.dex .jm svg{max-width:340px}
