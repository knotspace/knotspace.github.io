  if(d>=6)P.story.push([6,"小学校に入る"]);
  if(d>=12)P.story.push([12,"中学生になる"]);
  const hsR=YEAR0+15<1947?0.2:YEAR0+15<1960?0.52:YEAR0+15<1975?0.8:1;
  if(d>=15&&R()>hsR){P.story.push([YEAR0<1935?14:15,"学校を出て働き始める"])}else{
  if(d>=15)P.story.push([15,YEAR0+15<1947?"旧制中学で学ぶ":"高校に進む"]);
  if(d>=18)P.story.push([18,R()*100<pu?"大学に進む":"働き始める"]);}
  if(pwar)P.story.push([d,"戦地へ送られ、戦死する"]);
  for(let a=24;a<=45&&a<d;a++){if(R()<(sex==="M"?0.055:0.07)){P.story.push([a,"結婚する"]);if(a+2<d&&R()<.75)P.story.push([a+2,"子どもが生まれる"]);break}}
  if(d>=65)P.story.push([65,"仕事を退く"]);
  return P;
}

