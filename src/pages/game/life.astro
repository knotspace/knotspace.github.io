function pauseMoment(){let p={5:['5歳のひと息','この人生で、どんなことに心が動いた？'],15:['15歳のひと息','周りと比べず、自分が大切にしたいものは何だろう。'],30:['30歳のひと息','今の自分につながっている選択は何だろう。'],50:['50歳のひと息','これから先、どんな時間を増やしたい？'],70:['70歳のひと息','この人生で出会えてよかったものは何だろう。']}[s.age];if(!p)return false;stop();$('momenttitle').textContent=p[0];$('momentcopy').textContent=p[1];if(s.age===70){$('momentcopy').textContent+=' '+(s.peers.find(x=>x.alive)?.name||'同じ日に生まれた人')+'から「ここまで歩いてきたね。あなたの人生には、あなたにしかない景色があったと思う。」と声をかけられた。'}$('note').value='';$('pausemoment').hidden=false;return true}
