  if(atHome){if(L.faD>=a&&!awayP("父",a))m.push({sex:"M",age:L.fa+a,look:L.faLook});if(L.moD>=a&&!awayP("母",a))m.push({sex:"F",age:L.mo+a,look:L.moLook});if(L.sansedai&&a<15)L.gp.slice(0,2).forEach(g=>{if(g.d>=a)m.unshift({sex:/祖父/.test(g.n)?"M":"F",age:g.age+a,look:{hair:"#C9C9CE",skin:L.look.skin,cloth:"#8D7B68",pants:"#4A4A4A"}})})}
