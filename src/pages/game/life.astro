 /* 老後 */
 {id:"oJibunshi",t:"自分史を書きはじめる",sub:"人生をふり返る",when:(L,a)=>a>=62,go(L,a){say(`ノートに自分史を書きはじめる。書き上がったら、家族や知り合いに配るつもりだ。`);L.hp+=5;L.know+=2}},
