      {t:"転職して大企業をめざす",sub:`見込み 約${Math.round(SUCC(20+L.know/3))}%`,w:1,go(){if(R()*100<SUCC(20+L.know/3)){startJob("大企業");say("中途採用で、希望していた大企業に入る。","big");L.hp+=8}else{say("中途採用の壁は厚く、今の会社で続けることにする。");L.hp-=3}}},
      {t:"今の会社で力をつける",w:2,go(){L.know+=3;say("今の会社で、地道に力をつけていく。")}}]})}
