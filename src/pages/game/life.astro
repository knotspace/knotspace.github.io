<script>
import schoolData from '../../data/game/schools.json';
const $=id=>document.getElementById(id), clamp=n=>Math.max(0,Math.min(100,n));
const schoolRecords = schoolData.schools || [];
const prefectures = schoolData.prefectures || ['北海道','東京都','栃木県','大阪府','福岡県'];
const prefectureSelect=$('home-prefecture');
prefectures.forEach(pref=>{const o=document.createElement('option');o.value=pref;o.textContent=pref;if(pref==='栃木県')o.selected=true;prefectureSelect.append(o);});

let state=null, stages=[];
const choices=(items)=>items.map(([label,effect,log,decision])=>({label,effect,log,decision}));
function stage(year,season,title,scene,desc,opts,tag){return {year,season,title,scene,desc,opts:choices(opts),tag};}
function buildStages(){
 const s=[];
 const add=(...args)=>s.push(stage(...args));
 const school=[['毎日少しずつ宿題と復習をする',{study:7},'机に向かう習慣が少しずつ身についた。'],['友達と遊びながらいろいろなことを経験する',{friends:7,experience:6},'友達との時間や遊びから多くを学んだ。'],['スポーツや習い事に打ち込む',{health:7,experience:6},'続けることの楽しさと難しさを知った。']];
 for(let g=1;g<=6;g++) add('小学'+g+'年生','APRIL','小学校'+g+'年生の毎日',g===1?'ランドセルを背負って、初めての教室へ。':'少しずつできることが増え、学校にも慣れてきた。','授業、友達、休み時間。毎日の小さな経験が、これからの自分をつくっていく。',school,'ELEMENTARY');
 add('小学6年生','WINTER','中学受験をする？','周りでは中学受験の話も聞こえてきた。受験する道も、地元の中学校へ進む道もある。','ここで選んだ進路によって、その後の受験ルートが変わる。',[
 ['中学受験に挑戦する',{study:4,health:-3},'受験勉強を始めた。自分で決めた目標に挑戦する。',{middleExam:true}],
 ['地元の中学校へ進む',{friends:3,health:3},'地元の中学校へ進むことにした。高校受験は中学生活の先に待っている。',{middleExam:false}]
 ],'MIDDLE EXAM CHOICE');
 if(state.decisions.middleExam) add('中学受験','FEBRUARY','中学受験本番','準備してきた日々を思い出しながら、試験会場へ向かう。','結果は努力だけで決まるものではない。最後まで落ち着いて取り組もう。',[
 ['得意な問題から落ち着いて解く',{study:5,health:3},'最後まで自分の力を出し切った。',{examResult:'pass'}),
 ['難しい問題にも粘り強く向き合う',{study:7,health:-4},'考え抜く経験を積んだ。',{examResult:'pass'})
 ],'EXAM');
 if(!state.decisions.middleExam||state.decisions.examResult!=='pass'){
  for(let g=1;g<=3;g++) add('中学'+g+'年生','APRIL','中学校'+g+'年生',g===1?'新しい制服、新しい教室。中学校生活が始まる。':'勉強も部活も少しずつ本格的になってきた。','定期テスト、部活動、友達との時間。自分に合うペースを探そう。',[
   ['授業と復習を大切にする',{study:8,health:-2},'基礎を積み重ね、学ぶ力が伸びた。'],
