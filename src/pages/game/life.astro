      {t:"デモに参加する",sub:"仲間はできるが、目をつけられることも",w:1,go(){L.rel+=5;L.know+=2;L.hp+=2;say("ヘルメットをかぶってデモに参加する。夜通し仲間と議論する。","big")}},
      {t:"距離をおいて勉強を続ける",w:2,go(){L.know+=4;say("騒ぎから距離をおき、図書館で勉強を続ける。")}},
      {t:"アルバイトと遊びに打ち込む",w:2,go(){L.savings+=20;L.hp+=2;say("ノンポリを決めこみ、アルバイトとジャズ喫茶通いの毎日を送る。")}}]})}
