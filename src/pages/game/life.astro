function runArcs(a){const L=G.L;L.arcs=L.arcs||[];L.arcDone=L.arcDone||{};
  for(const ar of L.arcs){if(ar.end||a<ar.at||ar.at===a&&ar.fresh)continue;const d=ARCS.find(x=>x.id===ar.id);if(!d){ar.end=true;continue}
    let r;try{r=d.steps[ar.s](L,a,ar.v)}catch(e){r=0}ar.s++;if(!r||ar.s>=d.steps.length)ar.end=true;else ar.at=a+r}
  L.arcs.forEach(x=>x.fresh=false);
  if(L.arcs.filter(x=>!x.end).length>=3)return;
  const el=ARCS.filter(d=>!L.arcDone[d.id]&&d.when(L,a));
  for(let i=el.length-1;i>0;i--){const j=Math.floor(R()*(i+1));[el[i],el[j]]=[el[j],el[i]]}
  for(const d of el){if(R()<d.p){L.arcDone[d.id]=1;const ar={id:d.id,s:0,at:a,v:{}};L.arcs.push(ar);const n0=G.lineN||0,q0=G.queue.length+(G.cur?1:0);let r;try{r=d.steps[0](L,a,ar.v)}catch(e){r=0}if((G.lineN||0)===n0&&G.queue.length+(G.cur?1:0)===q0)r=0;ar.s=1;if(!r||ar.s>=d.steps.length)ar.end=true;else{ar.at=a+r}break}}
}
