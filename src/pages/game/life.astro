      {t:"もう少し家にいてほしいと伝える",w:1,go(){say(`${kd.n}と話し合い、もう少し家から通うことになる。`)}}]})}}
  // 夫婦の危機
  if(L.married&&a>=30&&a<=65&&!L.used.has("crisis"+Math.floor(a/10))&&ch(L.rel<45?0.05:0.015)){L.used.add("crisis"+Math.floor(a/10));
    ask({title:`${L.spouse.n}との会話が減っている。どうする？`,text:"離婚する夫婦は、結婚する夫婦の約3分の1。",opts:[
      {t:"時間をとって、ちゃんと話し合う",sub:"関係が立て直しやすい",w:3,go(){L.divRisk=0.5;L.rel+=3;say(`${L.spouse.n}とじっくり話し合う。少しずつ会話が戻ってくる。`)}},
      {t:"ふたりで旅行に出かける",sub:"費用はかかるが、気分が変わる",w:2,go(){L.savings-=20;L.divRisk=0.7;L.hp+=3;say(`${L.spouse.n}と${pick(["温泉","京都","海辺の町"])}へ旅行に出かける。`)}},
      {t:"そのままにしておく",sub:"離婚のリスクが上がる",w:1,go(){L.divRisk=2.5;say("忙しさを理由に、そのままにしておく。")}}]})}
  // 借金の保証人
  if(a>=30&&a<=60&&!L.used.has("hosho")&&ch(0.006)){L.used.add("hosho");const n=npc("古い友人");
    ask({title:`古い友人の${n}さんから、借金の保証人を頼まれる`,text:"保証人になると、本人が返せないとき代わりに返す義務を負う。",opts:[
      {t:"断る",sub:"関係は少しぎくしゃくする",w:3,go(){L.rel-=2;say(`${n}さんの頼みを断る。`)}},
      {t:"引き受ける",sub:"友情は守れるが、リスクがある",w:1,go(){L.guar=a;say(`${n}さんの保証人を引き受ける。`)}}]})}
  if(L.guar&&a===L.guar+2){if(ch(0.35)){L.savings-=300;L.hp-=12;say(`保証人になっていた${npc("古い友人")}さんの事業が失敗し、300万円を代わりに返すことになる。`,"big")}else say(`${npc("古い友人")}さんが借金を返し終え、お礼に来る。`);L.guar=null}
