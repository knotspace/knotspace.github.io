/* 昭和・平成の世代ならではのできごと */
const KIDPOP=[[1950,1962,["紙芝居屋さんの拍子木が聞こえると、駆け出していく。","ベーゴマやメンコで日が暮れるまで遊ぶ。","「巨人・大鵬・卵焼き」に夢中になる。"]],[1963,1975,["テレビの怪獣ものに夢中になる。","超合金のおもちゃをねだる。","スーパーカーの消しゴムを集める。"]],
 [1976,1988,["ファミコンを買ってもらい、友だちが毎日遊びに来る。","ビックリマンシールを集める。","ミニ四駆を走らせる。"]],[1989,2000,["たまごっちを学校に持っていって怒られる。","ポケモンのカードを交換する。","ミニ四駆ブームでコースのある店に通う。"]],
 [2001,2012,["携帯ゲーム機で友だちと通信して遊ぶ。","カードゲームの大会に出る。"]],[2013,2040,["タブレットで動画を見る。","オンラインで友だちとゲームをする。"]]];
const TEENPOP=[[1955,1967,["ラジオから流れるロカビリーに心をうばわれる。"]],[1968,1979,["フォークソングをギターで弾き語りする。","深夜ラジオを聴きながら勉強する。"]],[1980,1991,["アイドルの歌番組を毎週欠かさず見る。","ウォークマンで好きなテープを聴く。"]],[1992,2003,["ルーズソックスが流行る。","ポケベルの数字の暗号で友だちとやりとりする。","カラオケで流行りの歌を歌う。"]],[2004,2015,["携帯電話のメールを夜中まで打ち合う。"]]];
function eraPop(a){const y=YEAR0+a,P=a>=5&&a<=12?KIDPOP:a>=13&&a<=18?TEENPOP:null;if(!P)return null;const row=P.find(r=>y>=r[0]&&y<=r[1]);if(!row)return null;const pool=row[2].filter(x=>!G.L.used.has(x));if(!pool.length)return null;const t=pick(pool);G.L.used.add(t);return t}
function generation(a){const L=G.L,y=YEAR0+a,say=line,ch=p=>R()<p,place=placeOf(L);if(G.queue.length>1)return;
  // 三種の神器（1955〜64年）と3C（1966〜75年）
  if(y>=1955&&y<=1964&&a>=22&&(L.married||L.job)&&!L.used.has("jingi")&&ch(0.25)){L.used.add("jingi");
