function advance(){s.age++;if(s.education==='kosen'&&s.age===18)s.age=19;s.peers.forEach(peerYear);updatePeers();s.left=ylen();let k={学び:'knowledge',健康:'health','人とのつながり':'friends',仕事:'money','自分の時間':'happy'}[s.focus];s.stats[k]=clamp(s.stats[k]+1);if(s.age>35)s.stats.health=clamp(s.stats.health-.4);if(s.age>55)s.stats.health=clamp(s.stats.health-.5);rollUnchosenEvent();historicalEvent();achievementCheck();if(s.age>=60){let risk=Math.min(.18,.004+Math.pow(s.age-60,2)*.00012+(100-s.stats.health)*.00025);if(Math.random()<risk){s.cause=s.stats.health<25?'長く続いた体調の変化':'年齢を重ねたことによる自然な最期';finish();return}}if(s.age>=85){s.cause='長い人生を歩み、85歳を迎えた';finish();return}render();save();if(E[s.age]){stop();s.waiting=true;openEvent();if(s.auto)setTimeout(()=>{if(s.waiting){chosen=E[s.age][4].findIndex(c=>!['exam','short'].includes(c[3]));if(chosen<0)chosen=0;choose()}},1800)}else{stop();s.waiting=true;openYearChoice()}}
function frame(t){if(!s||s.paused||s.waiting)return;if(!last)last=t;s.left-=(t-last)/1000*s.speed;last=t;if(s.left<=0)advance();else{$('clock').textContent='00:'+String(Math.ceil(s.left)).padStart(2,'0');$('bar').style.width=(s.left/ylen()*100)+'%'}if(s&&!s.paused&&!s.waiting)raf=requestAnimationFrame(frame)}
function start(){$('peers').replaceChildren();s={era:cfg.era,pref:randomPref(),mode:cfg.mode,compare:$('compare').value,name:$('name').value.trim(),duration:cfg.duration,age:0,left:cfg.duration*60/85,speed:1,paused:false,waiting:true,auto:false,focus:'学び',yearOptions:null,stats:{health:76,happy:62,knowledge:30,friends:42,money:35},logs:[],school:null,profile:familyRoll(),peers:[0,1,2].map(makePeer),achievements:[],eras:[],cause:null};if(s.profile.household==='相対的に厳しい'){s.stats.money-=12;s.stats.knowledge-=3}if(s.profile.singleParent)s.stats.money-=6;if(s.profile.parentEducation==='大学卒以上')s.stats.knowledge+=5;$('home').hidden=true;$('game').hidden=false;$('ending').hidden=true;$('peers').replaceChildren();$('familyprofile').textContent=s.profile.gender+' · '+s.profile.household+' · '+(s.profile.singleParent?'ひとり親家庭':'両親と暮らす')+' · きょうだい '+s.profile.siblings+'人 · 親の学歴 '+s.profile.parentEducation+' · '+s.profile.parentWork;updatePeers();log('誕生',s.era+'年、'+s.pref+'で新しい人生が始まった。');render();$('event').hidden=false;$('kind').textContent='BIRTH';$('date').textContent=s.era+' / AGE 0';$('scene').textContent='ひとりの人生が、静かに始まる。';$('eventtitle').textContent='生まれてきた。';$('copy').textContent='家族や地域、時代。自分では選べない環境の中で、ここから人生が形づくられていく。';$('schoolarea').hidden=true;$('choices').replaceChildren();$('skipchoice').hidden=true;let b=document.createElement('button');b.className='choice picked';b.innerHTML='<b>この人生を歩き始める</b><small>0歳から時間が流れます →</small>';b.onclick=()=>{$('event').hidden=true;s.waiting=false;run()};$('choices').append(b);save()}
function save(){try{localStorage.setItem('ao-life-current',JSON.stringify(s))}catch{}}
function finish(){stop();stopMusic();if(s.age>=70)unlock('longlife','長い時間を歩んだ');try{let a=JSON.parse(localStorage.getItem('ao-life-archive')||'[]');a.unshift({name:s.name||'名もない人生',pref:s.pref,era:s.era,age:s.age,stats:s.stats,logs:s.logs,achievements:s.achievements,eras:s.eras});localStorage.setItem('ao-life-archive',JSON.stringify(a.slice(0,10)));localStorage.removeItem('ao-life-current')}catch{}$('game').hidden=true;$('ending').hidden=false;$('endtitle').textContent=(s.name||'ひとつの人生')+'の物語。';$('endcopy').textContent=s.era+'年に'+s.pref+'で生まれ、'+s.age+'歳までの時間を歩んだ。'+(s.cause||'')+'。学び、人と出会い、迷いながら選んだ道。そのすべてが、この人生だけの物語になった。';$('endstats').replaceChildren();[['健康','health'],['幸福','happy'],['知識','knowledge'],['人間関係','friends'],['暮らし','money']].forEach(x=>{let d=document.createElement('div');d.innerHTML='<b>'+s.stats[x[1]]+'</b><small>'+x[0]+'</small>';$('endstats').append(d)});$('endreflect').textContent='この人生で大切にした重点は「'+s.focus+'」。数値だけでは表せない出会いや思い出も、この人生をつくった一部です。';$('rarity').textContent='達成した図鑑 '+s.achievements.length+'個 · 出会った時代 '+s.eras.length+'個 · '+s.pref+'生まれ。あなたと同じ条件の人生は、もう一度始めても同じにはなりません。';$('peerword').textContent=(s.peers.find(x=>x.alive)?.name||s.peers[0].name)+'より。「同じ日に生まれたけれど、歩んだ道はそれぞれ違ったね。あなたの人生を見届けられてよかった。」';$('enddiary').replaceChildren();s.logs.forEach(x=>{let li=document.createElement('li');li.textContent=x.year+'年 · '+x.age+'歳 '+x.title+' — '+x.text;$('enddiary').append(li)});archive()}
function archive(){let a=[];try{a=JSON.parse(localStorage.getItem('ao-life-archive')||'[]')}catch{}$('archives').replaceChildren();if(!a.length){$('archives').textContent='まだ人生の記録はありません。';return}a.slice(0,5).forEach(x=>{let p=document.createElement('p');p.textContent=x.name+' · '+x.era+'年 · '+x.pref+' · '+x.age+'歳まで';$('archives').append(p)})}
$('start').onclick=start;$('music').onchange=()=>{if($('music').checked)startMusic();else stopMusic()};$('sfx').onchange=()=>tone(660,.15);$('birthmodes').onclick=e=>{let b=e.target.closest('[data-mode]');if(!b)return;cfg.mode=b.dataset.mode;document.querySelectorAll('#birthmodes button').forEach(x=>x.classList.toggle('on',x===b))};$('pause').onclick=()=>{s.paused=!s.paused;$('pause').textContent=s.paused?'再開':'一時停止';if(s.paused)stop();else run()};document.querySelectorAll('.speed').forEach(b=>b.onclick=()=>{s.speed=+b.dataset.speed;document.querySelectorAll('.speed').forEach(x=>x.classList.toggle('on',x===b))});$('auto').onchange=e=>s.auto=e.target.checked;$('focus').onclick=e=>{let b=e.target.closest('[data-f]');if(!b)return;s.focus=b.dataset.f;document.querySelectorAll('#focus button').forEach(x=>x.classList.toggle('on',x===b))};$('exit').onclick=()=>{stop();save();$('game').hidden=true;$('home').hidden=false};$('again').onclick=$('homebtn').onclick=()=>{$('ending').hidden=true;$('home').hidden=false;archive()};
$('eras').onclick=e=>{let b=e.target.closest('[data-era]');if(!b)return;cfg.era=+b.dataset.era;document.querySelectorAll('#eras button').forEach(x=>x.classList.toggle('on',x===b))};$('dur').onclick=e=>{let b=e.target.closest('[data-d]');if(!b)return;cfg.duration=+b.dataset.d;document.querySelectorAll('#dur button').forEach(x=>x.classList.toggle('on',x===b))};archive();

try{const saved=JSON.parse(localStorage.getItem('ao-life-current')||'null');if(saved&&saved.stats&&saved.logs){const r=document.createElement('button');r.className='resume';r.textContent='前回の人生を続きから再開する →';$('home').insertBefore(r,$('.setup'));r.onclick=()=>{s=saved;s.peers=s.peers||[0,1,2].map(makePeer);s.profile=s.profile||familyRoll();s.achievements=s.achievements||[];s.eras=s.eras||[];s.mode=s.mode||'birth';s.cause=s.cause||null;$('familyprofile').textContent=s.profile.gender+' · '+s.profile.household+' · '+(s.profile.singleParent?'ひとり親家庭':'両親と暮らす')+' · きょうだい '+s.profile.siblings+'人 · 親の学歴 '+s.profile.parentEducation+' · '+s.profile.parentWork;updatePeers();$('home').hidden=true;$('game').hidden=false;render();if(E[s.age]&&!s.doneEvent){s.waiting=true;openEvent()}else if([5,15,30,50,70].includes(s.age)&&s.doneEvent){pauseMoment();s.waiting=true}else if(s.age>0&&!s.doneEvent){s.waiting=true;openYearChoice()}else run()}}}catch{}
</script>
