  if(y>=2008&&y<=2009&&a>=20&&a<=55&&/工場|配達|販売/.test(L.occ||"")&&L.job==="中小企業"&&!L.used.has("hakengiri")&&ch(0.08)){L.used.add("hakengiri");L.hp-=10;say("リーマンショックのあおりで、働いていた工場の仕事を切られる。","big");startJob("中小企業");L.income*=0.85;say(`しばらくして、${jobName()}で働き始める。`)}
