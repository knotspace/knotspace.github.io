function rollUnchosenEvent(){const pool=s.age<6?[[.18,'小さな発見','身近なものに夢中になり、新しいことを覚えた。',{knowledge:2,happy:2}],[.16,'家族との時間','家族と過ごす時間が、安心できる思い出になった。',{friends:2,happy:2}],[.1,'体調を崩す','少し体調を崩したが、休んで元気を取り戻した。',{health:-2}]]:s.age<18?[[.18,'友人との出会い','気の合う友人ができ、何気ない会話が日々の楽しみになった。',{friends:3,happy:2}],[.15,'得意なこと','続けてきたことが少しずつ形になり、自信につながった。',{knowledge:2,happy:2}],[.1,'小さな失敗','思うようにいかないこともあったが、次に生かす経験になった。',{knowledge:2,happy:-1}],[.08,'部活動の経験','仲間と練習や活動に取り組み、忘れられない経験ができた。',{health:2,friends:2}]]:s.age<60?[[.15,'思いがけない縁','偶然の出会いから、新しいつながりが生まれた。',{friends:3,happy:2}],[.13,'仕事の手応え','仕事や活動で小さな成果があり、自信になった。',{money:3,knowledge:2}],[.09,'暮らしの出費','予定外の出費があった。暮らしを見直すきっかけになった。',{money:-3}],[.08,'新しい趣味','興味を持ったことを始め、日々に楽しみが増えた。',{happy:3,health:1}]]:[[.15,'懐かしい再会','久しぶりの再会があり、昔の思い出を語り合った。',{friends:3,happy:3}],[.12,'地域との関わり','地域の人と関わる機会が増え、居場所が広がった。',{friends:3}],[.1,'健康を意識する','日々の体調に気を配り、生活習慣を整えた。',{health:2}]];for(const [p,title,desc,effect] of pool){if(Math.random()<p){Object.keys(effect).forEach(k=>s.stats[k]=clamp(s.stats[k]+effect[k]));log(title,desc);return}}if(!$('gentle').checked&&s.age>=18&&Math.random()<.12){let hard=s.age<40?[['転職・失業','仕事の環境が変わり、収入や生活を見直すことになった。',{money:-9,happy:-3}],['大きな病気','治療や休養が必要になり、生活のペースが変わった。',{health:-12,money:-5}],['転居','仕事や家族の事情で住む場所が変わった。',{money:-5,friends:-3,happy:2}]]:[['家族の介護','家族を支える時間が増え、暮らし方を考え直した。',{health:-5,friends:3,money:-4}],['長期の治療','治療と向き合いながら、日々の過ごし方を工夫した。',{health:-10,money:-5}],['離別','大切な人との関係に変化があり、これからを考える時間ができた。',{friends:-8,happy:-9}]];let e=hard[Math.floor(Math.random()*hard.length)];Object.keys(e[2]).forEach(k=>s.stats[k]=clamp(s.stats[k]+e[2][k]));log(e[0],e[1])}}
function historicalEvent(){const y=yr();const events=[{y:1923,t:'関東大震災',d:'大きな地震が関東を襲い、暮らしや町の姿が変わった。'},{y:1945,t:'終戦',d:'戦争が終わり、社会は復興へ向かう。'},{y:1964,t:'東京オリンピック',d:'新幹線や高速道路が整い、日本の景色が変わっていく。'},{y:1973,t:'オイルショック',d:'物価やエネルギーをめぐり、暮らしに影響が広がった。'},{y:1989,t:'平成の始まり',d:'新しい時代が始まった。'},{y:1995,t:'阪神・淡路大震災',d:'大きな地震が発生し、防災や地域の支え合いが見直された。'},{y:2008,t:'世界金融危機',d:'世界的な景気後退が、日本の仕事や暮らしにも影響した。'},{y:2011,t:'東日本大震災',d:'東日本で大きな地震と津波が発生し、多くの地域が復興に向かった。'},{y:2020,t:'新型コロナウイルス',d:'感染症の広がりで、学校・仕事・人との距離が変化した。'},{y:2025,t:'新しい社会の変化',d:'技術や働き方が変わり、暮らしの選択肢も広がっていく。'}];let e=events.find(x=>x.y===y);if(e){recordEra(e.t);log('時代の出来事 · '+e.t,e.d);tone(560,.2)}}
function achievementCheck(){if(s.stats.knowledge>=80)unlock('knowledge','知識を深めた');if(s.stats.friends>=80)unlock('friends','人とのつながりを育てた');if(s.stats.health>=80)unlock('health','健康を大切にした');if(s.age>=22&&s.school)unlock('education','進学を経験した');if(s.age>=30&&s.stats.money>=70)unlock('stable','暮らしを安定させた');if(s.age>=70)unlock('longlife','長い時間を歩んだ')}
function openYearChoice(){const age=s.age,stage=age<6?'幼いころ':age<12?'小学生のころ':age<18?'中高生のころ':age<25?'若いころ':age<60?'働き盛りのころ':'これからの時間';const opts=age<6?[['遊びや好きなことを楽しむ',{happy:4,health:2},'夢中になれる遊びを見つけ、毎日を楽しんだ。'],['本や新しいことに触れる',{knowledge:5},'知らないことを知る楽しさを覚えた。'],['家族や友達との時間を大切にする',{friends:4,happy:2},'身近な人と過ごす時間が増えた。'],['外で体を動かす',{health:5,happy:2},'体を動かす習慣ができた。']]:age<18?[['勉強や興味のある分野に取り組む',{knowledge:5},'学びを積み重ね、少しずつできることが増えた。'],['友人や仲間との時間を大切にする',{friends:5,happy:2},'仲間との経験が、かけがえのない思い出になった。'],['部活・スポーツ・文化活動に打ち込む',{health:4,friends:3},'活動を続ける中で、粘り強さが身についた。'],['新しいことに挑戦する',{knowledge:2,health:2,happy:3},'初めての経験が、自分の世界を広げた。']]:age<25?[['進学や資格など学びを続ける',{knowledge:5,money:-1},'学び続けたことが、新しい可能性につながった。'],['仕事や実務の経験を積む',{money:4,knowledge:2},'経験を重ね、自分の得意分野が見えてきた。'],['人とのつながりを広げる',{friends:5,happy:2},'新しい出会いが、暮らしに変化をもたらした。'],['趣味や旅で視野を広げる',{happy:4,knowledge:2,money:-2},'新しい景色や体験が、考え方を豊かにした。']]:age<60?[['仕事や専門性を磨く',{money:5,knowledge:3},'仕事に向き合い、経験と自信を積み重ねた。'],['家族や友人との時間を大切にする',{friends:5,happy:3},'大切な人と過ごす時間を増やした。'],['健康や生活習慣を整える',{health:5,happy:1},'自分の体と向き合い、生活を整えた。'],['新しい挑戦や学びを続ける',{knowledge:4,happy:2,money:-1},'新しいことを学び、日々に刺激が生まれた。']]:[['健康を第一に考える',{health:5,happy:1},'無理をせず、健やかな暮らしを心がけた。'],['人との交流を楽しむ',{friends:5,happy:3},'人との交流が、毎日の楽しみになった。'],['趣味や好きなことを深める',{happy:5,knowledge:2},'好きなことに向き合う時間を大切にした。'],['経験を次の世代に伝える',{friends:4,knowledge:3},'経験を伝えることで、新しいつながりが生まれた。']];s.yearOptions=opts;$('skipchoice').hidden=false;$('event').hidden=false;recordEra(age<6?'幼少期':age<18?'学校時代':age<25?'青年期':age<60?'働く時代':'人生の後半');$('schoolarea').hidden=true;$('kind').textContent='A YEAR IN YOUR LIFE';$('date').textContent=yr()+' / AGE '+age;$('scene').textContent=stage+'。この一年にも、小さな出来事が積み重なっていく。';$('eventtitle').textContent=age+'歳の一年、何を大切にする？';$('copy').textContent='毎年の過ごし方を選ぼう。選択はステータスや、その後の人生に少しずつ影響する。';$('choices').replaceChildren();$('confirm').hidden=true;opts.forEach((o,i)=>{let b=document.createElement('button');b.className='choice';b.innerHTML='<b>'+o[0]+'</b><small>この一年の重点にする →