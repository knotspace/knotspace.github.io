 ["rich","資産家の家に生まれた",d=>d.f.rich],["pro","プロ選手になった",d=>d.f.pro],["japan","日本代表に選ばれた",d=>d.f.japan],["doctor","医師になった",d=>d.f.doctor],["todai","東大に合格した",d=>d.f.todai],["star","芸能界でブレイク",d=>d.f.star],
