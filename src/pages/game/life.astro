/* 時代の図鑑：時代ごとに10の「しるし」を集める */
const ERADEX_ORDER=["taisho","senji","showa","heisei","now","future"];
const ED_COMMON=[["born","この時代に生まれた",()=>1],["wed","結婚した",L=>L.wasMarried],["grand","孫を抱いた",L=>L.grand>0],["le","平均寿命を超えた",(L,a)=>a>=Math.round(L.prefLE||81)],["c90","90歳を迎えた",(L,a)=>a>=90],["roosui","老衰で大往生",L=>/老衰/.test(L.cause||"")]];
