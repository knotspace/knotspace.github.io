  if(G.dead){try{const S=lifeSnap(G);const r={a:S.age,c:S.cause,e:S.edu,o:S.occ,m:S.married,k:S.kids,y:S.money,n:G.L.given,d:S.decs.filter(d=>!/自分から何をする|自分から動いてみる|何に挑戦する/.test(d[1])).slice(0,14)};
    u+="&r="+btoa(unescape(encodeURIComponent(JSON.stringify(r)))).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"")}catch(e){}}return u}
function sharedResult(){try{const q=new URLSearchParams(location.search).get("r");if(!q)return null;const j=JSON.parse(decodeURIComponent(escape(atob(q.replace(/-/g,"+").replace(/_/g,"/")))));
  if(typeof j.a!=="number")return null;return {age:j.a,cause:String(j.c||""),edu:String(j.e||""),occ:String(j.o||""),married:String(j.m||""),kids:+j.k||0,money:+j.y||0,name:String(j.n||""),decs:Array.isArray(j.d)?j.d.filter(x=>Array.isArray(x)&&x.length===3).map(x=>[+x[0],String(x[1]),String(x[2])]):[]}}catch(e){return null}}
