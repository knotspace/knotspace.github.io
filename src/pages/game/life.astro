function archive(){let a=[];try{a=JSON.parse(localStorage.getItem('ao-life-archive')||'[]')}catch{}$('archives').replaceChildren();if(!a.length){$('archives').textContent='まだ人生の記録はありません。';return}a.slice(0,5).forEach(x=>{let p=document.createElement('p');p.textContent=x.name+' · '+x.era+'年 · '+x.pref+' · '+x.age+'歳まで';$('archives').append(p)})}
$('start').onclick=start;$('music').onchange=()=>{if($('music').checked)startMusic();else stopMusic()};$('sfx').onchange=()=>tone(660,.15);$('birthmodes').onclick=e=>{let b=e.target.closest('[data-mode]');if(!b)return;cfg.mode=b.dataset.mode;document.querySelectorAll('#birthmodes button').forEach(x=>x.classList.toggle('on',x===b))};$('pause').onclick=()=>{s.paused=!s.paused;$('pause').textContent=s.paused?'再開':'一時停止';if(s.paused)stop();else run()};document.querySelectorAll('.speed').forEach(b=>b.onclick=()=>{s.speed=+b.dataset.speed;document.querySelectorAll('.speed').forEach(x=>x.classList.toggle('on',x===b))});$('auto').onchange=e=>s.auto=e.target.checked;$('focus').onclick=e=>{if(!s||s.age>35)return;let b=e.target.closest('[data-f]');if(!b)return;s.focus=b.dataset.f;document.querySelectorAll('#focus button').forEach(x=>x.classList.toggle('on',x===b))};$('exit').onclick=()=>{stop();save();$('game').hidden=true;$('home').hidden=false};$('again').onclick=$('homebtn').onclick=()=>{$('ending').hidden=true;$('home').hidden=false;archive()};
$('eras').onclick=e=>{let b=e.target.closest('[data-era]');if(!b)return;cfg.era=+b.dataset.era;document.querySelectorAll('#eras button').forEach(x=>x.classList.toggle('on',x===b))};$('dur').onclick=e=>{let b=e.target.closest('[data-d]');if(!b)return;cfg.duration=+b.dataset.d;document.querySelectorAll('#dur button').forEach(x=>x.classList.toggle('on',x===b))};archive();

try{const saved=JSON.parse(localStorage.getItem('ao-life-current')||'null');if(saved&&saved.stats&&saved.logs){const r=document.createElement('button');r.className='resume';r.textContent='前回の人生を続きから再開する →';$('home').insertBefore(r,$('.setup'));r.onclick=()=>{s=saved;s.peers=s.peers||[0,1,2].map(makePeer);s.profile=s.profile||familyRoll();s.achievements=s.achievements||[];s.eras=s.eras||[];s.mode=s.mode||'birth';s.cause=s.cause||null;$('familyprofile').textContent=s.profile.gender+' · '+s.profile.household+' · '+(s.profile.singleParent?'ひとり親家庭':'両親と暮らす')+' · きょうだい '+s.profile.siblings+'人 · 親の学歴 '+s.profile.parentEducation+' · '+s.profile.parentWork;$('birthcompare').textContent=s.compare?'今回の出生地：'+s.pref+' ／ あなたの出身地：'+s.compare+(s.pref===s.compare?' · 同じ都道府県！':' · 異なる都道府県の人生を比較中'):'出身地の比較は設定されていません。';updatePeers();$('home').hidden=true;$('game').hidden=false;render();if(E[s.age]&&!s.doneEvent){s.waiting=true;openEvent()}else if([5,15,30,50,70].includes(s.age)&&s.doneEvent){pauseMoment();s.waiting=true}else if(s.age>0&&!s.doneEvent){s.waiting=true;openYearChoice()}else run()}}}catch{}
</script>
