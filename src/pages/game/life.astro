function sceneMembers(){const L=G.L,a=G.age,m=[];
  const me={sex:L.sex,age:a,look:L.look,me:true};
  if(L.army&&!L.army.end){const u=L.army.front==="海の上"?{cloth:"#3E4A66",pants:"#33405A"}:{cloth:"#6E6B3E",pants:"#5B5832"};
    return [{sex:"M",age:a+1,look:{...makeLook(),...u}},{...me,look:{...L.look,...u,hair:"#2B2B3A"}},{sex:"M",age:a+2,look:{...makeLook(),...u}}]}
  const atHome=L.home==="実家";
  if(atHome){if(L.faD>=a&&!awayP("父",a))m.push({sex:"M",age:L.fa+a,look:L.faLook});if(L.moD>=a&&!awayP("母",a))m.push({sex:"F",age:L.mo+a,look:L.moLook});if(L.sansedai&&a<15)L.gp.slice(0,2).forEach(g=>{if(g.d>=a)m.unshift({sex:/祖父/.test(g.n)?"M":"F",age:g.age+a,look:{hair:"#C9C9CE",skin:L.look.skin,cloth:"#8D7B68",pants:"#4A4A4A"}})})}
  if(L.married&&L.spouse)m.push({sex:L.sex==="M"?"F":"M",age:L.spouse.age+a-L.spouse.at,look:L.spLook||(L.spLook=makeLook())});
