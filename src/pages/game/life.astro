.eradex .ed-h{display:flex;align-items:baseline;gap:8px}.eradex .ed-h b{font-size:15px}.eradex .ed-h span{font-size:11.5px;color:var(--muted)}.eradex .ed-h em{margin-left:auto;font-style:normal;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}
.eradex .ed-bar{height:4px;border-radius:2px;background:var(--line);overflow:hidden}.eradex .ed-bar i{display:block;height:100%;background:var(--ochre)}
.eradex .eradex-note{grid-column:1/-1}
.badge{font-size:12px;border:1px solid var(--line);border-radius:999px;padding:3px 10px;color:var(--gone);background:var(--paper)}
.badge.on{border-color:var(--ochre);color:var(--ink);background:var(--lamp-soft);font-weight:700}
.badge.on::before{content:"★ ";color:var(--ochre)}
