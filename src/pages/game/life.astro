    dec:1+Math.floor(R()*10),sibs:weighted([0,1,2,3],[22,52,21,5]),
    weight:Math.round(clamp(3000+gauss()*420,1400,4400)/10)*10,
    edu:"",school:"",hs:"",job:"",title:"",income:0,savings:0,pension:0,home:"実家",city:p[0],loan:0,invest:0,
    partner:null,spouse:null,spD:null,married:false,wasMarried:false,wantKids:null,kids:[],grand:0,pet:null,
    illness:null,used:new Set(),reflect:{},hb:0,hp:0,know:5,rel:55,stars:[]};
  L.name=L.surname+" "+L.given;
