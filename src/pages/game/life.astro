function openEvent(){let e=E[s.age];if(!e)return;drawPixelScene();$('skipchoice').hidden=false;$('event').hidden=false;$('kind').textContent=e[0];$('date').textContent=yr()+' / AGE '+s.age;$('scene').textContent=e[2];$('eventtitle').textContent=e[1];$('copy').textContent=e[3];const branchEntries=Object.entries(s.branch||{}).sort((a,b)=>b[1]-a[1]);const leadBranch=branchEntries[0]?.[0];const branchNames={study:'学び',sport:'スポーツ',creative:'創作',community:'人とのつながり',tech:'技術',career:'仕事',global:'新しい世界',family:'家族',entrepreneur:'独立心',balance:'自分のペース',legacy:'次の世代'};if(leadBranch&&s.branch[leadBranch]>=2&&[13,16,17,21,26,28,32,34,35].includes(s.age)){$('scene').textContent+=' これまで'+branchNames[leadBranch]+'を大切にしてきた経験も、今回の選択に影響している。'}$('choices').replaceChildren();chosen=null;$('confirm').hidden=true;$('schoolarea').hidden=!e[5];if(e[5]){$('schoolpref').value='全国';$('schoolsearch').value='';$('schoollabel').textContent=s.age>=18?'全国の大学・専門学校などを選ぶ':'全国の高校・高専などを選ぶ';loadSchools()}e[4].forEach((c,i)=>{let b=document.createElement('button');b.className='choice';b.innerHTML='<b>'+c[0]+'</b><small>この道を選ぶ →</small>';b.onclick=()=>{if((c[3]==='exam'||c[3]==='short')&&!selectedSchool()){$('schoolinfo').textContent='先に学校を選んでください。';return}chosen=i;b.classList.add('picked');chooseYearChoice()};$('choices').append(b)})}
function choose(){let e=E[s.age],c=e[4][chosen];if(!c)return;$('skipchoice').hidden=true;Object.keys(c[1]).forEach(k=>s.stats[k]=clamp(s.stats[k]+c[1][k]));if(c[4]){s.branch=s.branch||{};s.branch[c[4]]=(s.branch[c[4]]||0)+1;}let text=c[2];if(c[3]==='exam'){let x=selectedSchool(),sc=scores.get(x.name.replace(/^(北海道|東京都|大阪府|京都府|.{2,3}県)立/,'')),dev=sc?sc.deviation:55,pathBoost=(s.branch?.study||0)*1.4+(s.branch?.tech||0)*1.1+(s.branch?.sport||0)*.35,chance=clamp(65+(s.stats.knowledge-50)*1.3-(dev-55)*1.35+pathBoost,5,98),pass=Math.random()*100<chance;s.school=x.name;s.schoolPref=x.prefecture;s.schoolType=x.schoolType;s.lastExam={name:x.name,dev,knowledge:s.stats.knowledge,chance,pass};text+=' '+x.name+'（'+x.prefecture+'）に'+(pass?'合格した。合格可能性の目安は'+chance+'%。':'挑戦したが不合格。合格可能性の目安は'+chance+'%。別の道を探した。');s.stats.happy=clamp(s.stats.happy+(pass?7:-4));if(pass&&s.age===15){s.education=/高等専門学校/.test(x.schoolType)?'kosen':'high';if(s.education==='kosen')s.age+=4}else if(pass&&s.age===18){s.education='university';s.age+=3}}else if(c[3]==='short'){let x=selectedSchool();s.school=x.name;s.schoolPref=x.prefecture;s.education='short';s.age+=1}else if(c[3]==='work'){s.education='work'}log(e[1],text);$('event').hidden=true;s.waiting=false;s.left=ylen();s.doneEvent=true;if([5,15,30,50,70].includes(s.age)){pauseMoment();s.waiting=true}else run();save()}
