---
import Layout from '../layouts/Layout.astro';
import aboutSettings from '../data/about-settings.json';
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="プロフィール | KNOT" description={aboutSettings.lead}>
  <main class="about-page">
    <a class="back-link" href={BASE}>← ホームに戻る</a>
    <header class="intro">
      <span class="eyebrow">{aboutSettings.eyebrow}</span>
      <div class="logo">KNOT<span>.</span></div>
      <h1>{aboutSettings.headingLine1}<br />{aboutSettings.headingLine2}</h1>
      <p class="lead">{aboutSettings.lead}</p>
    </header>
    <section class="about-card">
      <span class="eyebrow">{aboutSettings.storyEyebrow}</span>
      <h2>{aboutSettings.storyTitle}</h2>
      {aboutSettings.storyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>
    <section class="details">
      
      <div><span>INTERESTS</span><strong>{aboutSettings.interests}</strong></div>
      <div><span>TECH</span><strong>{aboutSettings.tech}</strong></div>
    </section>
    <a class="back-blog" href={`${BASE}blog/`}>記事を読んでみる →</a>
  </main>
</Layout>
<style>
.about-page{max-width:760px;margin:0 auto;padding:54px 0 90px}.back-link{color:var(--muted);font-size:12px;font-weight:700}.intro{padding:55px 0 42px;border-bottom:1px solid var(--line)}.eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.18em}.logo{margin:20px 0 16px;font-size:42px;font-weight:900;letter-spacing:-.09em}.logo span{color:var(--accent)}h1{margin:0;color:var(--text);font-size:clamp(30px,5vw,46px);line-height:1.45;letter-spacing:-.06em}.lead{color:var(--muted);font-size:14px;line-height:1.9}.about-card{margin-top:35px;padding:30px;border:1px solid var(--line);border-radius:18px;background:var(--surface)}h2{margin:10px 0 20px;color:var(--text);font-size:23px}.about-card p{color:var(--article-text);font-size:14px;line-height:2.2}.details{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}.details div{padding:20px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.details div:last-child{grid-column:1/-1}.details span{display:block;margin-bottom:9px;color:var(--muted);font-size:10px;font-weight:800;letter-spacing:.14em}.details strong{color:var(--text);font-size:13px}.back-blog{display:inline-block;margin-top:20px;color:var(--accent);font-size:13px;font-weight:800}@media(max-width:600px){.about-page{padding:35px 0 65px}.about-card{padding:22px}.details{grid-template-columns:1fr}.details div:last-child{grid-column:auto}}
</style>
