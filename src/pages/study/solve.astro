---
import bank from '../../data/study-questions.json';
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const scienceCount = bank.filter((q) => q.subject === 'science').length;
const socialCount = bank.filter((q) => q.subject === 'social').length;
---
<!doctype html>
<html lang="ja" data-theme="dark">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#101827" /><title>演習｜KNOT Study</title>
<style>
:root{font-family:Inter,"Noto Sans JP",system-ui,sans-serif;color-scheme:dark;--bg:#0b1220;--panel:#121d2d;--panel2:#19283d;--text:#edf3fb;--muted:#9aabc2;--line:#2b3d55;--accent:#91b8ff;--good:#52c995;--bad:#ff8585}
:root[data-theme="light"]{color-scheme:light;--bg:#f4f6fa;--panel:#fff;--panel2:#edf2fa;--text:#172235;--muted:#64748b;--line:#dce3ed;--accent:#315fc2;--good:#16865a;--bad:#c43e4d}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);transition:background .2s,color .2s}button,select{font:inherit}.wrap{width:min(980px,calc(100% - 48px));margin:auto;padding:28px 0 72px}.top,.row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.brand{font-size:14px;font-weight:900;letter-spacing:.14em;color:var(--text)}.brand span{color:var(--accent)}a{color:var(--accent);text-decoration:none}.theme{border:1px solid var(--line);border-radius:999px;background:var(--panel);color:var(--text);padding:9px 14px;cursor:pointer;font-size:12px}.tag,.small{font-size:11px;color:var(--muted)}.tag{letter-spacing:.17em;font-weight:800}.intro{padding:48px 0 27px}.intro h1{font-size:clamp(36px,7vw,60px);letter-spacing:-.075em;margin:13px 0 10px}.intro p{color:var(--muted);line-height:1.9;margin:0}.counts{display:flex;gap:8px;flex-wrap:wrap;margin-top:19px}.counts span,.chip{border:1px solid var(--line);border-radius:999px;padding:7px 11px;font-size:11px;color:var(--muted)}.panel{margin-top:15px;padding:25px;border:1px solid var(--line);border-radius:16px;background:var(--panel);box-shadow:0 10px 30px #0000000a}.panel h2{font-size:15px;letter-spacing:.02em;margin:0 0 17px}.subjects{display:grid;grid-template-columns:1fr 1fr;gap:12px}.subject{border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text);padding:19px;text-align:left;cursor:pointer;transition:border-color .2s,transform .2s}.subject:hover{transform:translateY(-2px)}.subject.active{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.subject b{display:block;font-size:17px}.subject small{display:block;color:var(--muted);margin-top:6px;font-size:11px}.fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.field label{display:block;color:var(--muted);font-size:11px;margin-bottom:8px}.field select{width:100%;min-width:0;background:var(--bg);border:1px solid var(--line);border-radius:9px;color:var(--text);padding:12px}.primary,.secondary{border:1px solid transparent;border-radius:9px;padding:13px 17px;font-weight:800;cursor:pointer;transition:transform .15s,opacity .15s}.primary:hover,.secondary:hover{transform:translateY(-1px)}.primary{background:var(--accent);color:#101827}.secondary{background:var(--panel2);border-color:var(--line);color:var(--text)}button:focus-visible,a:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:17px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:15px}.stat{padding:14px;background:var(--panel2);border-radius:10px}.stat small{display:block;color:var(--muted);font-size:10px}.stat strong{font-size:23px;font-variant-numeric:tabular-nums}.quiz[hidden],[hidden]{display:none!important}.quiz{scroll-margin-top:20px}.quiz-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}.question{font-size:clamp(18px,3vw,22px);line-height:1.9;margin:25px 0}.answers{display:grid;grid-template-columns:1fr 1fr;gap:11px}.answer{display:flex;align-items:center;gap:13px;min-height:72px;text-align:left;padding:15px;border:1px solid var(--line);border-radius:11px;background:var(--panel2);color:var(--text);cursor:pointer;line-height:1.6;transition:border-color .15s}.answer:hover:not(:disabled){border-color:var(--accent)}.answer:disabled{cursor:default;opacity:1}.answer .letter{display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:8px;background:var(--bg);font-weight:800;color:var(--muted)}.answer.correct{border-color:var(--good);background:color-mix(in srgb,var(--good) 12%,var(--panel))}.answer.incorrect{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 12%,var(--panel))}.feedback{margin-top:18px;padding:17px;border:1px solid var(--line);border-radius:11px;background:var(--panel2);line-height:1.9;white-space:pre-wrap}.quiz-actions{display:flex;justify-content:space-between;gap:10px;margin-top:20px}.progress{height:6px;background:var(--line);border-radius:9px;overflow:hidden;margin-top:17px}.progress span{display:block;height:100%;width:0;background:var(--accent);transition:width .2s}.footer{text-align:center;color:var(--muted);font-size:10px;letter-spacing:.08em;margin-top:40px}
@media(max-width:640px){.wrap{width:calc(100% - 32px);padding-top:18px}.intro{padding:36px 0 23px}.fields{grid-template-columns:1fr 1fr}.fields .field:last-child{grid-column:1/-1}.answers{grid-template-columns:1fr}.panel{padding:18px}.question{font-size:18px}.stats{gap:6px}.stat{padding:11px}.stat strong{font-size:20px}}@media(max-width:390px){.subjects{grid-template-columns:1fr}.actions>*{width:100%}.quiz-actions>*{flex:1}}
</style></head><body><div class="wrap">
<header class="top"><a class="brand" href={BASE}>KNOT <span>/ STUDY</span></a><div class="row"><a href={`${BASE}study/`}>← Studyトップ</a><button class="theme" id="theme" type="button">☀ ライトモード</button></div></header>
<section class="intro"><span class="tag">FOCUS / PRACTICE / GROW</span><h1>演習ルーム<span style="color:var(--accent)">.</span></h1><p>自分のペースで、1問ずつ。理科・社会の知識を確かな力に。</p><div class="counts"><span>理科 {scienceCount}問</span><span>社会 {socialCount}問</span><span>合計 {bank.length}問</span></div></section>
<section class="panel"><h2>01　教科を選ぶ</h2><div class="subjects"><button class="subject active" data-subject="science"><b>🔬 理科</b><small>{scienceCount}問 / 物理・化学・生物・地学</small></button><button class="subject" data-subject="social"><b>🌏 社会</b><small>{socialCount}問 / 地理・歴史・公民</small></button></div></section>
<section class="panel"><h2>02　学習方法を設定</h2><div class="fields"><div class="field"><label for="level">難易度</label><select id="level"><option value="all">すべて</option><option value="basic">基礎</option><option value="standard">標準</option><option value="advanced">発展</option></select></div><div class="field"><label for="topic">分野</label><select id="topic"><option value="all">すべての分野</option></select></div><div class="field"><label for="mode">出題数</label><select id="mode"><option value="10">10問</option><option value="20" selected>20問</option><option value="all">全問</option><option value="wrong">苦手問題のみ</option></select></div></div><div class="actions"><button class="primary" id="start">演習を開始 →</button><button class="secondary" id="clear">学習記録をリセット</button></div><div class="stats"><div class="stat"><small>解答数</small><strong id="answered">0</strong></div><div class="stat"><small>正解数</small><strong id="correct">0</strong></div><div class="stat"><small>苦手問題</small><strong id="wrong">0</strong></div></div></section>
<section class="panel quiz" id="quiz" hidden><div class="quiz-head"><span class="chip" id="meta">理科</span><span class="small" id="counter">1 / 20</span></div><div class="progress"><span id="bar"></span></div><p class="question" id="question"></p><div class="answers" id="answers"></div><div class="feedback" id="feedback" hidden></div><div class="quiz-actions"><button class="secondary" id="quit">終了</button><button class="primary" id="next" disabled>次の問題 →</button></div></section>
<footer class="footer">KNOT Study · 学習記録はこの端末に保存されます</footer></div>
<script>
import bank from '../../data/study-questions.json';
const $=id=>document.getElementById(id),root=document.documentElement,THEME_KEY='knot-theme',RECORD_KEY='knot-study-solve-record-v1';
let subject=new URLSearchParams(location.search).get('subject')==='social'?'social':'science',list=[],index=0,done=false,record={answered:0,correct:0,wrong:[]};
try {
  const stored = JSON.parse(localStorage.getItem(RECORD_KEY) || 'null');
  if (stored && typeof stored === 'object' && !Array.isArray(stored)) {
    record.answered = Number.isFinite(stored.answered) ? Math.max(0, stored.answered) : 0;
    record.correct = Number.isFinite(stored.correct) ? Math.max(0, stored.correct) : 0;
    record.wrong = Array.isArray(stored.wrong) ? stored.wrong.filter(id => typeof id === 'string') : [];
  }
} catch { record = { answered: 0, correct: 0, wrong: [] }; }
const setTheme=t=>{root.dataset.theme=t;try{localStorage.setItem(THEME_KEY,t);}catch{}$('theme').textContent=t==='dark'?'☀ ライトモード':'☾ ダークモード';};
let savedTheme='dark';try{savedTheme=localStorage.getItem(THEME_KEY)||'dark';}catch{}setTheme(savedTheme==='light'?'light':'dark');
$('theme').onclick=()=>setTheme(root.dataset.theme==='dark'?'light':'dark');
function save(){try{localStorage.setItem(RECORD_KEY,JSON.stringify(record));}catch{}}
function stats(){$('answered').textContent=record.answered;$('correct').textContent=record.correct;$('wrong').textContent=record.wrong.length;}
function topics(){const s=$('topic'),old=s.value;s.replaceChildren(new Option('すべての分野','all'));[...new Set(bank.filter(q=>q.subject===subject).map(q=>q.topic))].sort().forEach(t=>s.add(new Option(t,t)));if([...s.options].some(o=>o.value===old))s.value=old;}
document.querySelectorAll('[data-subject]').forEach(b=>b.onclick=()=>{subject=b.dataset.subject;document.querySelectorAll('[data-subject]').forEach(x=>x.classList.toggle('active',x===b));topics();});
function begin(){let pool=bank.filter(q=>q.subject===subject&&($('level').value==='all'||q.level===$('level').value)&&($('topic').value==='all'||q.topic===$('topic').value));if($('mode').value==='wrong')pool=pool.filter(q=>record.wrong.includes(q.id));if(!pool.length){alert('この条件に合う問題がないよ。難易度や分野を変えてみてね。');return;}pool.sort(()=>Math.random()-.5);if($('mode').value!=='all'&&$('mode').value!=='wrong')pool=pool.slice(0,Number($('mode').value));list=pool;index=0;$('quiz').hidden=false;$('quiz').scrollIntoView({behavior:'smooth',block:'start'});render();}
function render(){done=false;const q=list[index];$('meta').textContent=(subject==='science'?'理科':'社会')+' ・ '+q.topic+' ・ '+q.level;$('counter').textContent=(index+1)+' / '+list.length;$('bar').style.width=(index/list.length*100)+'%';$('question').textContent=q.q;$('feedback').hidden=true;$('next').disabled=true;$('next').textContent=index===list.length-1?'演習を終了':'次の問題 →';const area=$('answers');area.replaceChildren();q.a.forEach((a,i)=>{const b=document.createElement('button');b.className='answer';const letter=document.createElement('span');letter.className='letter';letter.textContent=String.fromCharCode(65+i);const label=document.createElement('span');label.textContent=a;b.append(letter,label);b.onclick=()=>choose(i);area.append(b);});}
function choose(n){if(done)return;done=true;const q=list[index],ok=n===q.c;record.answered++;if(ok){record.correct++;record.wrong=record.wrong.filter(id=>id!==q.id);}else if(!record.wrong.includes(q.id))record.wrong.push(q.id);save();stats();[...$('answers').children].forEach((b,i)=>{b.disabled=true;if(i===q.c)b.classList.add('correct');if(i===n&&!ok)b.classList.add('incorrect');});$('feedback').hidden=false;$('feedback').textContent=(ok?'正解！':'不正解。正解は「'+q.a[q.c]+'」。')+'\\n\\n'+q.e;$('next').disabled=false;$('bar').style.width=((index+1)/list.length*100)+'%';}
$('start').onclick=begin;$('quit').onclick=()=>{$('quiz').hidden=true;};$('next').onclick=()=>{if(index<list.length-1){index++;render();}else{$('quiz').hidden=true;alert('演習終了！お疲れさま！');}};$('clear').onclick=()=>{if(confirm('この演習画面の学習記録を削除する？')){record={answered:0,correct:0,wrong:[]};save();stats();}};topics();stats();
</script></body></html>