---
import Layout from '../../layouts/Layout.astro';
import bank from '../../data/study-questions.json';
const science = bank.filter(q => q.subject === 'science').length;
const social = bank.filter(q => q.subject === 'social').length;
---
<Layout title="問題演習｜KNOT Study" description="理科・社会の問題演習">
<main class="solve-page">
<header class="solve-head"><div><a href="../">← Studyに戻る</a><p class="eyebrow">KNOT STUDY</p><h1>問題演習</h1><p class="muted">条件を選んで、さっそく始めよう。</p></div><div class="counts"><span>理科 {science}問</span><span>社会 {social}問</span></div></header>
<section class="panel" id="settings">
<h2>演習の設定</h2>
<div class="form-grid">
<label>教科<select id="subject"><option value="science">理科</option><option value="social">社会</option></select></label>
<label>分野<select id="topic"><option value="all">すべて</option></select></label>
<label>難易度<select id="level"><option value="all">すべて</option><option value="basic">基礎</option><option value="standard">標準</option><option value="advanced">発展</option></select></label>
<label>問題数<select id="amount"><option value="10">10問</option><option value="20" selected>20問</option><option value="all">全問</option><option value="wrong">苦手だけ</option></select></label>
</div>
<div class="buttons"><button class="primary" id="start">演習を始める</button><button class="subtle" id="reset">学習記録をリセット</button></div>
<div class="stats"><div><small>これまでに解いた数</small><strong id="total">0</strong></div><div><small>正解数</small><strong id="correct">0</strong></div><div><small>苦手問題</small><strong id="weak">0</strong></div></div>
</section>
<section class="panel quiz" id="quiz" hidden>
<div class="quiz-top"><span id="qmeta"></span><strong id="progressText"></strong></div><div class="track"><i id="progress"></i></div>
<h2 id="question"></h2><figure class="question-figure" id="question-figure" hidden><img id="question-image" alt=""><figcaption id="question-caption"></figcaption></figure><div id="answers" class="answers"></div>
<div id="explanation" class="explanation" hidden aria-live="polite"></div>
<div class="buttons quiz-buttons"><button class="subtle" id="quit">設定に戻る</button><button class="primary" id="next" disabled>次の問題</button></div>
</section>
<section class="panel result" id="result" hidden><p class="eyebrow">RESULT</p><h2>おつかれさま！</h2><p class="score"><strong id="score">0</strong><span> / <span id="max">0</span> 問正解</span></p><p id="resultText" class="muted"></p><div class="buttons"><button class="primary" id="again">同じ条件でもう一度</button><a class="subtle link-button" href="../">Studyトップへ</a></div></section>
</main>
<script>
import bank from '../../data/study-questions.json';
const $=id=>document.getElementById(id);
const KEY='knot-study-v2';
let record={answered:0,correct:0,wrong:[]},questions=[],position=0,score=0,selected=false,lastConfig=null;
try{const x=JSON.parse(localStorage.getItem(KEY)||'null');if(x&&typeof x==='object'){record.answered=Number.isFinite(x.answered)?x.answered:0;record.correct=Number.isFinite(x.correct)?x.correct:0;record.wrong=Array.isArray(x.wrong)?x.wrong.filter(v=>typeof v==='string'):[];}}catch{}
function save(){try{localStorage.setItem(KEY,JSON.stringify(record));}catch{}}
function showStats(){$('total').textContent=record.answered;$('correct').textContent=record.correct;$('weak').textContent=record.wrong.length;}
function fillTopics(){const subject=$('subject').value,select=$('topic'),old=select.value;select.replaceChildren(new Option('すべて','all'));[...new Set(bank.filter(q=>q.subject===subject).map(q=>q.topic))].sort().forEach(t=>select.add(new Option(t,t)));if([...select.options].some(o=>o.value===old))select.value=old;}
$('subject').addEventListener('change',fillTopics);fillTopics();showStats();
const params=new URLSearchParams(location.search);if(['science','social'].includes(params.get('subject'))){$('subject').value=params.get('subject');fillTopics();}
function enterQuizMode(){document.documentElement.classList.add('solve-quiz-active');if(!document.fullscreenElement&&document.documentElement.requestFullscreen)document.documentElement.requestFullscreen().catch(()=>{});}
function leaveQuizMode(){document.documentElement.classList.remove('solve-quiz-active');if(document.fullscreenElement&&document.exitFullscreen)document.exitFullscreen().catch(()=>{});}
document.addEventListener('fullscreenchange',()=>{if(!document.fullscreenElement)document.documentElement.classList.remove('solve-quiz-active');});
function start(){const config={subject:$('subject').value,topic:$('topic').value,level:$('level').value,amount:$('amount').value};lastConfig=config;let pool=bank.filter(q=>q&&q.subject===config.subject&&Array.isArray(q.a)&&q.a.length===4&&Number.isInteger(q.c)&&q.c>=0&&q.c<4&&typeof q.q==='string'&&typeof q.e==='string'&&(config.topic==='all'||q.topic===config.topic)&&(config.level==='all'||q.level===config.level));if(config.amount==='wrong')pool=pool.filter(q=>record.wrong.includes(q.id));if(!pool.length){alert('条件に合う問題がありません。設定を変えてみてください。');return;}pool=[...pool].sort(()=>Math.random()-.5);if(config.amount!=='all'&&config.amount!=='wrong')pool=pool.slice(0,Number(config.amount));questions=pool;position=0;score=0;enterQuizMode();$('settings').hidden=true;$('result').hidden=true;$('quiz').hidden=false;render();}
function render(){selected=false;const q=questions[position];$('qmeta').textContent=(q.subject==='science'?'理科':'社会')+' / '+q.topic+' / '+({basic:'基礎',standard:'標準',advanced:'発展'}[q.level]||'');$('progressText').textContent=(position+1)+' / '+questions.length;$('progress').style.width=(position/questions.length*100)+'%';$('question').textContent=q.q;const figure=$('question-figure');if(q.figure){$('question-image').src=q.figure;$('question-image').alt=q.figureAlt||'問題資料';$('question-caption').textContent=q.figureAlt||'資料';figure.hidden=false;}else{figure.hidden=true;$('question-image').removeAttribute('src');}const box=$('answers');box.replaceChildren();$('explanation').hidden=true;$('next').disabled=true;$('next').textContent=position===questions.length-1?'結果を見る':'次の問題';q.a.forEach((answer,i)=>{const b=document.createElement('button');b.type='button';b.className='answer';const letter=document.createElement('span');letter.className='letter';letter.textContent=['A','B','C','D'][i];const text=document.createElement('span');text.textContent=answer;b.append(letter,text);b.addEventListener('click',()=>choose(i));box.append(b);});}
function choose(i){if(selected)return;selected=true;const q=questions[position],buttons=[...$('answers').children],ok=i===q.c;if(ok)score++;record.answered++;if(ok)record.correct++;else if(!record.wrong.includes(q.id))record.wrong.push(q.id);else{}if(ok)record.wrong=record.wrong.filter(id=>id!==q.id);save();showStats();buttons.forEach((b,n)=>{b.disabled=true;if(n===q.c)b.classList.add('correct');else if(n===i)b.classList.add('incorrect');});$('explanation').hidden=false;$('explanation').innerHTML='';const title=document.createElement('strong');title.textContent=ok?'正解！':'不正解';const body=document.createElement('p');body.textContent=q.e;$('explanation').append(title,body);if(q.link){const link=document.createElement('a');link.href=q.link;link.className='summary-link';link.textContent='関連する要点まとめを見る →';$('explanation').append(link);}$('next').disabled=false;}
function finish(){ leaveQuizMode();$('quiz').hidden=true;$('result').hidden=false;$('score').textContent=score;$('max').textContent=questions.length;$('resultText').textContent=score===questions.length?'全問正解！すばらしい！':score/questions.length>=.7?'いい調子！間違えた問題を復習しよう。':'解説を読み直して、もう一度挑戦してみよう。';}
$('start').addEventListener('click',start);$('again').addEventListener('click',()=>{Object.entries(lastConfig||{}).forEach(([k,v])=>$(k).value=v);fillTopics();start();});$('next').addEventListener('click',()=>{if(!selected)return;if(position===questions.length-1)finish();else{position++;render();}});$('quit').addEventListener('click',()=>{leaveQuizMode();$('quiz').hidden=true;$('settings').hidden=false;});$('reset').addEventListener('click',()=>{if(!confirm('これまでの学習記録と苦手問題を消しますか？'))return;record={answered:0,correct:0,wrong:[]};save();showStats();});
</script>
<style>
.solve-page{max-width:850px;margin:0 auto;padding:35px 0 60px}.solve-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:25px}.solve-head>a,.solve-head a{font-size:12px;color:var(--accent)}.eyebrow{font-size:12px;font-weight:850;color:var(--accent);margin:20px 0 8px}.solve-head h1{font-size:38px;font-weight:900;letter-spacing:-.05em;margin:0}.muted{color:var(--muted);font-size:13px;line-height:1.8}.counts{display:flex;gap:8px;flex-wrap:wrap}.counts span{font-size:11px;color:var(--muted);background:var(--surface);padding:8px 11px;border-radius:8px}.panel{background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:25px;margin-top:16px}.panel h2{font-size:18px;font-weight:850;margin:0 0 20px}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.form-grid label{display:grid;gap:7px;font-size:12px;color:var(--muted);font-weight:700}.form-grid select{width:100%;padding:12px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text);font:inherit}.buttons{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.primary,.subtle,.link-button{border:0;border-radius:9px;padding:12px 18px;font:700 13px inherit;cursor:pointer}.primary{background:var(--accent);color:white}.subtle,.link-button{background:var(--surface-soft);border:1px solid var(--line);color:var(--text)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:23px}.stats div{padding:14px;background:var(--surface-soft);border-radius:9px}.stats small{display:block;color:var(--muted);font-size:11px}.stats strong{font-size:24px;font-weight:900}.quiz-top{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--muted)}.track{height:7px;background:var(--line);border-radius:9px;margin:13px 0 28px;overflow:hidden}.track i{display:block;height:100%;background:var(--accent);width:0;transition:width .2s}.quiz h2{font-size:clamp(18px,3vw,23px);line-height:1.8;margin-bottom:22px}.question-figure{margin:14px 0 20px;padding:12px;border:1px solid var(--line);border-radius:12px;background:#f8fafc}.question-figure[hidden]{display:none}.question-figure img{display:block;width:100%;max-height:330px;object-fit:contain}.question-figure figcaption{margin-top:7px;text-align:center;font-size:10px;color:#64748b}.answers{display:grid;grid-template-columns:1fr 1fr;gap:11px}.answer{display:flex;align-items:center;gap:12px;text-align:left;min-height:65px;padding:14px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--text);font:inherit;line-height:1.65;cursor:pointer}.answer:hover:not(:disabled){border-color:var(--accent)}.answer:disabled{cursor:default}.letter{width:28px;height:28px;flex:none;display:grid;place-items:center;border-radius:7px;background:var(--surface-soft);font-weight:800;color:var(--muted)}.answer.correct{border-color:#24a36a;background:color-mix(in srgb,#24a36a 12%,var(--surface))}.answer.incorrect{border-color:#d94c59;background:color-mix(in srgb,#d94c59 12%,var(--surface))}.explanation{margin-top:18px;padding:17px;border-radius:10px;background:var(--surface-soft);border:1px solid var(--line);line-height:1.8}.explanation p{margin:7px 0 0;font-size:13px;white-space:pre-wrap}.summary-link{display:inline-flex;margin-top:12px;color:var(--accent);font-size:12px;font-weight:800;text-decoration:underline;text-underline-offset:3px}.quiz-buttons{justify-content:space-between}.result{text-align:center;padding:35px}.result h2{font-size:28px}.score strong{font-size:54px;font-weight:900}.score span{color:var(--muted)}.result .buttons{justify-content:center}.quiz[hidden],.result[hidden]{display:none!important}
@media(max-width:650px){.solve-page{padding:22px 0 40px}.solve-head{display:block}.counts{margin-top:15px}.panel{padding:18px}.answers{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr 1fr}.stats{gap:6px}.stats div{padding:11px}.stats strong{font-size:20px}.solve-head h1{font-size:32px}}
</style>
</Layout>
<style is="global">
html.solve-quiz-active,html.solve-quiz-active body{width:100%;height:100%;overflow:hidden}
html.solve-quiz-active .site-header,html.solve-quiz-active .site-footer{display:none!important}
html.solve-quiz-active body main{height:100vh;min-height:100vh}
html.solve-quiz-active .solve-page{height:100vh;max-width:900px;margin:auto;padding:clamp(12px,4vh,42px) clamp(12px,4vw,48px);display:flex;align-items:center;justify-content:center}
html.solve-quiz-active .solve-head,html.solve-quiz-active #settings,html.solve-quiz-active #result{display:none!important}
html.solve-quiz-active #quiz{width:100%;max-height:100%;overflow:auto;margin:0;padding:clamp(18px,4vw,44px);border-radius:22px}
html.solve-quiz-active #quiz[hidden]{display:none!important}
html.solve-quiz-active #question{font-size:clamp(22px,3vw,34px);line-height:1.65}
html.solve-quiz-active .answer{min-height:clamp(78px,12vh,120px);font-size:clamp(14px,1.5vw,18px)}
@media(max-width:620px){html.solve-quiz-active .solve-page{padding:10px}html.solve-quiz-active #quiz{padding:16px 12px}html.solve-quiz-active .answers{grid-template-columns:1fr 1fr;gap:8px}html.solve-quiz-active .answer{min-height:94px;padding:10px 8px;font-size:12px}}
</style>
