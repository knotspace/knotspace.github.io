<!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101827"><link rel="manifest" href="/study.webmanifest"><title>演習｜KNOT Study</title><style>
:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#0b1220;color:#edf3fb}*{box-sizing:border-box}body{margin:0}.wrap{width:min(780px,92vw);margin:auto;padding:22px 0 60px}.top,.row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}a{color:#9fc2ff;text-decoration:none}.tag,.small{font-size:12px;color:#9db2ce}.tag{letter-spacing:.12em}h1{font-size:30px;margin:28px 0 6px}.muted{color:#aab8cc;line-height:1.7}.panel{margin-top:22px;padding:22px;border:1px solid #30415a;border-radius:17px;background:#141f30}label{display:block;color:#bdcbe0;font-size:13px;margin:12px 0 6px}select,button{font:inherit;border-radius:10px;padding:11px 13px}select{width:100%;background:#0c1727;color:#fff;border:1px solid #40516b}button{border:0;background:#78aaff;color:#081323;font-weight:800;cursor:pointer}.answers{display:grid;gap:10px;margin-top:20px}.answer{background:#202f44;color:#edf3fb;text-align:left;border:1px solid #40516b}.answer.selected{outline:2px solid #82b4ff;background:#294365}.result{padding:14px;border-radius:12px;background:#0c1727;margin-top:18px;line-height:1.8}
</style></head><body><main class="wrap"><div class="top"><a href="/study/">← KNOT STUDY</a><span class="tag">INDEPENDENT PRACTICE SCREEN</span></div><h1 id="title">演習を準備中</h1><p class="muted">解答を選択して答え合わせ。模試モードでは最後にまとめて採点する。</p><section class="panel"><div class="row"><span class="tag" id="mode-label">PRACTICE</span><span class="small" id="progress">—</span></div><label for="subject">教科</label><select id="subject"><option value="science">理科</option><option value="social">社会</option></select><label for="level">難易度</label><select id="level"><option value="basic">基礎レベル</option><option value="standard" selected>入試標準レベル</option><option value="advanced">入試応用レベル</option></select><div class="row" style="margin-top:18px"><button id="start">演習を開始</button><button id="mock" style="background:#2b3b53;color:#fff">もしもーど</button></div></section><section class="panel" id="quiz" hidden><div class="row"><span class="tag" id="topic"></span><span class="small" id="number"></span></div><h2 id="question"></h2><div class="answers" id="answers"></div><div id="feedback" class="result" hidden></div><div class="row" style="margin-top:18px"><button id="check">答え合わせ</button><button id="next" hidden>次の問題 →</button></div></section><p class="small" id="record"></p></main>
<script type="module">
const p=new URLSearchParams(location.search),$=s=>document.querySelector(s),subject=$('#subject'),level=$('#level');if(p.get('subject'))subject.value=p.get('subject');
const bank=[
{id:'sci-001',subject:'science',level:'standard',topic:'物理・電流',q:'抵抗器に加える電圧を一定にしたまま、抵抗の大きさを2倍にすると、流れる電流はどうなるか。',a:['2倍になる','1/2になる','4倍になる','変わらない'],c:1,e:'オームの法則 I=V/R より、電圧が一定なら電流は抵抗に反比例する。'},
{id:'sci-002',subject:'science',level:'advanced',topic:'化学・質量保存',q:'密閉容器内で銅粉を十分に加熱した。反応前後で容器全体の質量はどうなるか。',a:['増加する','減少する','変化しない','条件によって必ず変わる'],c:2,e:'密閉容器では物質の出入りがない。銅と酸素が結びついても容器全体では質量保存の法則が成り立つ。'},
{id:'sci-003',subject:'science',level:'basic',topic:'生物・細胞',q:'植物細胞にあり、動物細胞には基本的に見られないつくりはどれか。',a:['核','細胞膜','細胞壁','細胞質'],c:2,e:'植物細胞には細胞壁があり、体を支える。核・細胞膜・細胞質は動物細胞にもある。'},
{id:'sci-004',subject:'science',level:'standard',topic:'地学・天気',q:'暖かい空気が冷やされて雲ができる主な理由はどれか。',a:['水蒸気が凝結する','酸素が液体になる','窒素が固体になる','気圧が必ず0になる'],c:0,e:'空気が冷えて露点に達すると水蒸気が凝結し、小さな水滴や氷晶となって雲をつくる。'},
{id:'soc-001',subject:'social',level:'basic',topic:'地理・気候',q:'日本の太平洋側で冬に晴れて乾燥した日が多くなる主な理由はどれか。',a:['季節風が日本海で水分を失うから','山地を越えた空気が乾燥するから','赤道低圧帯に覆われるから','偏西風がなくなるから'],c:1,e:'冬の北西季節風は日本海側で雪を降らせた後、山地を越えて太平洋側に吹き下りるため乾燥しやすい。'},
{id:'soc-002',subject:'social',level:'standard',topic:'歴史・近代',q:'明治政府が殖産興業を進めた目的として最も適切なものはどれか。',a:['農村の自治を廃止するため','近代産業を育成し国力を高めるため','鎖国体制を復活させるため','身分制度を維持するため'],c:1,e:'殖産興業は工場・鉄道など近代産業を育て、富国強兵を支える経済力を高める政策だった。'},
{id:'soc-003',subject:'social',level:'advanced',topic:'公民・政治',q:'衆議院で可決された法律案が参議院で否決された場合、再可決に必要な条件はどれか。',a:['出席議員の過半数','出席議員の3分の2以上','参議院議長の承認','内閣総理大臣の単独決定'],c:1,e:'衆議院は参議院が否決した法律案を、出席議員の3分の2以上で再可決できる。'}
,
{"id": "sci-005", "subject": "science", "level": "basic", "topic": "物理・光", "q": "空気中からガラスに光が斜めに入るとき、光の進み方として正しいものはどれか。", "a": ["境界面で必ず反射だけする", "境界面で屈折し、法線に近づく向きに進む", "境界面で屈折し、法線から遠ざかる向きに進む", "速さも進む向きも変化しない"], "c": 1, "e": "光は空気より屈折率の大きいガラスに入ると速さが小さくなり、入射角より屈折角が小さくなる。したがって法線に近づく。"},
