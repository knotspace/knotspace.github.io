{"id": "sci-008", "subject": "science", "level": "advanced", "topic": "化学・濃度", "q": "食塩水100 gに食塩が8 g溶けている。この食塩水に水を加えて全体を200 gにしたとき、質量パーセント濃度は何％か。", "a": ["2％", "4％", "8％", "16％"], "c": 1, "e": "溶けている食塩の質量は8 gのまま。濃度は8÷200×100＝4％。水を加えても食塩の質量は変わらない。"},
{"id": "sci-009", "subject": "science", "level": "basic", "topic": "生物・消化", "q": "だ液に含まれ、デンプンを別の物質に分解する消化酵素はどれか。", "a": ["アミラーゼ", "ペプシン", "リパーゼ", "トリプシン"], "c": 0, "e": "だ液に含まれるアミラーゼは、デンプンを麦芽糖などに分解する。ペプシンやトリプシンは主にタンパク質、リパーゼは脂肪にはたらく。"},
{"id": "sci-010", "subject": "science", "level": "advanced", "topic": "地学・天体", "q": "日本で、ある日の正午ごろに太陽が南中した。翌日の南中時刻は、同じ場所ではおよそどうなるか。", "a": ["約4分早くなる", "約4分遅くなる", "約1時間早くなる", "ほぼ同じ時刻になる"], "c": 1, "e": "地球は公転しながら自転しているため、太陽が同じ位置に見えるまでの時間は平均約24時間4分。時計上の南中時刻は毎日およそ4分ずつ遅れる。"},
{"id": "soc-004", "subject": "social", "level": "basic", "topic": "地理・地形", "q": "日本の国土で、山地が多く平野が少ないことと関係が深い特徴はどれか。", "a": ["河川の流れが短く、勾配が急なものが多い", "河川の流れが長く、勾配が緩やかなものが多い", "大陸内部のような広大な砂漠が多い", "一年中、河川が凍結している"], "c": 0, "e": "日本は山地が国土の多くを占めるため、川は山から海まで短い距離を急に流れるものが多い。"},
{"id": "soc-005", "subject": "social", "level": "standard", "topic": "地理・農業", "q": "北海道で大規模な畑作や酪農が発達した理由として、最も適切なものはどれか。", "a": ["年間を通じて高温多雨だから", "広い土地を利用しやすく、冷涼な気候に適した農業が行われるから", "稲作以外が法律で禁止されているから", "人口密度が全国で最も高いから"], "c": 1, "e": "北海道には広い農地を確保しやすい地域があり、冷涼な気候を生かした畑作や酪農が盛ん。"},
{"id": "soc-006", "subject": "social", "level": "basic", "topic": "歴史・中世", "q": "鎌倉幕府で、将軍と御家人の間に結ばれた主従関係を表す組み合わせはどれか。", "a": ["御恩と奉公", "租・庸・調", "楽市・楽座", "版籍奉還"], "c": 0, "e": "将軍は御家人に領地の保護や新たな土地を与えるなどの御恩を行い、御家人は軍役などの奉公で応えた。"},
{"id": "soc-007", "subject": "social", "level": "standard", "topic": "歴史・近世", "q": "江戸幕府が大名を統制するために定めた法令はどれか。", "a": ["武家諸法度", "大日本帝国憲法", "御成敗式目", "五箇条の御誓文"], "c": 0, "e": "武家諸法度は大名の行動や城の修築などを統制するために江戸幕府が定めた法令。御成敗式目は鎌倉幕府の法である。"},
{"id": "soc-008", "subject": "social", "level": "advanced", "topic": "歴史・近代", "q": "日清戦争後に結ばれた下関条約の内容として正しいものはどれか。", "a": ["日本が台湾などを得た", "日本が朝鮮の独立を認めた", "日本が樺太の南半分を得た", "日本が満州の権益をすべて放棄した"], "c": 0, "e": "下関条約で清は朝鮮の独立を認め、台湾・澎湖諸島などを日本に割譲した。樺太南部は日露戦争後のポーツマス条約で得た。"},
{"id": "soc-009", "subject": "social", "level": "basic", "topic": "公民・経済", "q": "商品を買いたい人の数が増え、供給量が変わらない場合、一般に価格はどうなりやすいか。", "a": ["上がりやすい", "下がりやすい", "必ず0円になる", "需要と無関係に決まる"], "c": 0, "e": "供給量が同じで需要が増えると、商品を求める人が増えるため、一般に価格は上がりやすくなる。"},
{"id": "soc-010", "subject": "social", "level": "advanced", "topic": "公民・憲法", "q": "日本国憲法の改正案が国会で発議されるために必要な条件はどれか。", "a": ["各議院の総議員の過半数の賛成", "各議院の総議員の3分の2以上の賛成", "衆議院だけで総議員の3分の2以上の賛成", "内閣の全員一致"], "c": 1, "e": "憲法改正の発議には、衆議院・参議院それぞれで総議員の3分の2以上の賛成が必要。その後、国民投票で過半数の賛成を得る必要がある。"}
];
let list=[],idx=0,selected=-1,score=0;
function begin(mock=false){const sub=subject.value,lv=level.value;list=bank.filter(x=>x.subject===sub&&(mock||x.level===lv));if(!list.length)list=bank.filter(x=>x.subject===sub);list.sort(()=>Math.random()-0.5);if(!mock)list=list.slice(0,20);idx=0;score=0;$('#quiz').hidden=false;$('#mode-label').textContent=mock?'MOCK EXAM':'PRACTICE';$('#title').textContent=mock?'もしもーど':'通常演習';render()}
function render(){let q=list[idx];selected=-1;$('#topic').textContent=q.topic;$('#number').textContent=(idx+1)+' / '+list.length;$('#progress').textContent='正解 '+score+' 問';$('#question').textContent=q.q;$('#answers').innerHTML='';q.a.forEach((a,i)=>{let b=document.createElement('button');b.className='answer';b.textContent=(i+1)+'．'+a;b.onclick=()=>{selected=i;document.querySelectorAll('.answer').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')};$('#answers').append(b)});$('#feedback').hidden=true;$('#check').hidden=false;$('#next').hidden=true}
$('#start').onclick=()=>begin(false);$('#mock').onclick=()=>begin(true);
$('#check').onclick=()=>{if(selected<0){alert('選択肢を選んでね');return}let q=list[idx],ok=selected===q.c;if(ok)score++;$('#feedback').hidden=false;$('#feedback').textContent=(ok?'正解！':'不正解。正解：'+q.a[q.c]+'。')+' 解説：'+q.e;$('#check').hidden=true;$('#next').hidden=false;let r=JSON.parse(localStorage.getItem('knot-study-record')||'{"answered":0,"correct":0,"wrong":[]}');r.answered++;if(ok)r.correct++;else if(!r.wrong.includes(q.id))r.wrong.push(q.id);localStorage.setItem('knot-study-record',JSON.stringify(r));$('#record').textContent='累計 '+r.answered+'問 / 正答率 '+Math.round(r.correct/r.answered*100)+'% / 苦手 '+r.wrong.length+'問'};
$('#next').onclick=()=>{idx++;if(idx>=list.length){$('#quiz').innerHTML='<h2>演習終了！</h2><p>今回の正解：'+score+' / '+list.length+'問</p><a href="/study/">Studyトップへ戻る</a>';return}render()};
</script></body></html>