---
import StudyLayout from '../../layouts/StudyLayout.astro';
const records = [
{year:'令和8年度（2026）',subjects:['理科','社会','数学','英語','国語'],source:'https://www.pref.tochigi.lg.jp/m04/r08/r08_kennritukoutougakkounyuugakushasennbatunikannsuruosirase.html',label:'栃木県教育委員会・入試情報',status:'問題・正答の公開先を確認中'},
{year:'令和7年度（2025）',subjects:['理科','社会','数学','英語','国語'],source:'https://sakusemi.jp/entrance-exam-questions/',label:'サクセスセミナー・過去問題一覧',status:'問題・解答リンクあり'},
{year:'令和6年度（2024）',subjects:['理科','社会','数学','英語','国語'],source:'https://sakusemi.jp/entrance-exam-questions/',label:'サクセスセミナー・過去問題一覧',status:'問題・解答リンクあり'},
{year:'令和5年度（2023）',subjects:['理科','社会','数学','英語','国語'],source:'https://sakusemi.jp/entrance-exam-questions/',label:'サクセスセミナー・過去問題一覧',status:'問題・解答リンクあり'},
{year:'令和4年度（2022）',subjects:['理科','社会','数学','英語','国語'],source:'https://s.resemom.jp/pages/public-highschool-exam/09tochigi/index.html',label:'リセマム・栃木県過去問アーカイブ',status:'年度別の問題・正答を掲載'},
{year:'令和3年度（2021）',subjects:['理科','社会','数学','英語','国語'],source:'https://s.resemom.jp/pages/public-highschool-exam/09tochigi/index.html',label:'リセマム・栃木県過去問アーカイブ',status:'年度別の問題・正答を掲載'},
{year:'令和元年度（2019）',subjects:['理科','社会','数学','英語','国語'],source:'https://s.resemom.jp/pages/public-highschool-exam/09tochigi/index.html',label:'リセマム・栃木県過去問アーカイブ',status:'年度別の問題・正答を掲載'}
];
---
<StudyLayout title="栃木県公立高校入試・過去問データベース｜KNOT Study" description="年度・教科別に栃木県公立高校入試の過去問資料を整理。">
<main class="db-page"><a href="../public-exam/" class="back">← 公立高校入試問題精講</a>
<header class="hero"><p>ARCHIVE / TOCHIGI PREFECTURAL EXAM</p><h1>過去問データベース</h1><span>年度・教科・出典をまとめて確認。</span></header>
<div class="toolbar"><label>年度で絞り込む<select id="year"><option value="all">すべての年度</option>{records.map(r=><option value={r.year}>{r.year}</option>)}</select></label><label>教科で絞り込む<select id="subject"><option value="all">すべての教科</option>{['理科','社会','数学','英語','国語'].map(s=><option>{s}</option>)}</select></label></div>
<div class="summary"><b>{records.length}</b><span>年度を登録</span><small>資料リンクの索引。問題本文の無断転載は行いません。</small></div>
<section class="records">{records.map(r=><article class="record" data-year={r.year} data-subjects={r.subjects.join(',')}><div class="record-head"><b>{r.year}</b><span>{r.status}</span></div><div class="subjects">{r.subjects.map(s=><span>{s}</span>)}</div><a href={r.source} target="_blank" rel="noopener">{r.label} ↗</a><p>大問番号・設問単位の分類は、原本と照合して確認できたデータから順次追加。</p></article>)}</section>
<section class="note"><h2>データの精度について</h2><p>このページは過去問そのものを複製する場所ではなく、公開資料へのリンクと出題情報を整理する索引です。年度・教科の掲載情報と、設問ごとの大問番号・単元・出典確認状況を分けて管理します。確認できていない大問番号や設問番号は推測で登録しません。</p><h3>参考資料</h3><ul><li><a href="https://www.pref.tochigi.lg.jp/m04/r08/r08_kennritukoutougakkounyuugakushasennbatunikannsuruosirase.html" target="_blank" rel="noopener">栃木県教育委員会・令和8年度入試情報</a></li><li><a href="https://sakusemi.jp/entrance-exam-questions/" target="_blank" rel="noopener">サクセスセミナー・令和5〜7年度の過去問題</a></li><li><a href="https://s.resemom.jp/pages/public-highschool-exam/09tochigi/index.html" target="_blank" rel="noopener">リセマム・栃木県の過去問アーカイブ</a></li><li><a href="https://www.sing.co.jp/assets/pdf/exam/totigi04.pdf" target="_blank" rel="noopener">栃木県・過去4年間の出題傾向分析（理科）</a></li></ul></section>
<footer><a href="../public-exam/">問題精講へ戻る</a><span>KNOT STUDY / EXAM ARCHIVE</span></footer></main>
<script is:inline>
(()=>{const y=document.getElementById('year'),s=document.getElementById('subject'),cards=[...document.querySelectorAll('.record')];function filter(){cards.forEach(c=>{c.hidden=(y.value!=='all'&&c.dataset.year!==y.value)||(s.value!=='all'&&!c.dataset.subjects.split(',').includes(s.value));});}y.addEventListener('change',filter);s.addEventListener('change',filter);})();
</script>
<style>
.db-page{max-width:940px;margin:auto;padding:20px 0 48px;color:var(--text)}.back{font-size:11px;color:var(--muted)}.hero{margin:18px 0;padding:clamp(26px,5vw,48px);border-radius:20px;background:linear-gradient(130deg,#101827,#1b3557);color:#fff}.hero>p{font:9px ui-monospace,monospace;letter-spacing:.16em;color:#a9ceff}.hero h1{font-size:clamp(32px,6vw,52px);margin:8px 0;letter-spacing:-.06em}.hero span{font-size:12px;color:#d5e0ef}.toolbar{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0}.toolbar label{display:grid;gap:7px;flex:1;min-width:180px;font-size:11px;color:var(--muted)}.toolbar select{padding:12px;border:1px solid var(--line);border-radius:9px;background:var(--surface);color:var(--text)}.summary{display:flex;align-items:baseline;gap:9px;padding:16px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.summary b{font-size:28px}.summary span{font-weight:800}.summary small{margin-left:auto;color:var(--muted);font-size:10px}.records{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:15px 0}.record{padding:17px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.record[hidden]{display:none}.record-head{display:flex;justify-content:space-between;gap:8px;align-items:start}.record-head>b{font-size:17px}.record-head>span{font-size:9px;color:var(--muted);text-align:right}.subjects{display:flex;flex-wrap:wrap;gap:6px;margin:13px 0}.subjects span{padding:5px 8px;border-radius:6px;background:var(--surface-soft);font-size:10px}.record>a{font-size:11px;color:var(--accent);font-weight:850}.record p,.note p,.note li{font-size:10px;line-height:1.8;color:var(--muted)}.note{margin-top:20px;padding:18px;border:1px solid var(--line);border-radius:13px;background:var(--surface-soft)}.note h2{font-size:18px;color:var(--text)}.note h3{font-size:13px;color:var(--text)}.note a{color:var(--accent)}footer{display:flex;justify-content:space-between;gap:10px;margin-top:22px;padding-top:14px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}footer a{color:var(--accent)}@media(max-width:620px){.records{grid-template-columns:1fr}.summary{flex-wrap:wrap}.summary small{width:100%;margin:0}footer{flex-direction:column}}
</style>
</StudyLayout>