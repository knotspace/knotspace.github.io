---
import StudyLayout from '../../layouts/StudyLayout.astro';
---
<StudyLayout title="合格祈願の絵馬｜KNOT Study" description="目標や願いを絵馬に書いて、合格への決意を残そう。">
<main class="ema-page">
  <a class="back" href="../">← Studyトップへ</a>
  <header class="hero">
    <p class="eyebrow">KNOT STUDY / EMA BOARD</p>
    <h1>願いを、<span>言葉に。</span></h1>
    <p>目標を絵馬に書いて、今日からの一歩につなげよう。</p>
  </header>

  <section class="write-panel">
    <div class="section-head"><div><p class="eyebrow">WRITE YOUR WISH</p><h2>絵馬を書く</h2></div><span class="wood-mark">絵馬</span></div>
    <form id="ema-form">
      <label for="ema-category">願いの種類</label>
      <select id="ema-category"><option>志望校合格</option><option>定期テスト</option><option>資格・検定</option><option>部活動</option><option>その他</option></select>
      <label for="ema-title">目標・志望校</label>
      <input id="ema-title" maxlength="48" placeholder="例：第一志望に合格する" required>
      <label for="ema-message">願い・決意</label>
      <textarea id="ema-message" maxlength="140" rows="3" placeholder="例：毎日数学を30分勉強して、最後まであきらめない。" required></textarea>
      <div class="form-bottom"><span id="char-count">0 / 140</span><button class="submit" type="submit">絵馬を奉納する ↗</button></div>
      <p class="privacy">※絵馬はこのブラウザ内に保存されます。ほかの人には公開されません。</p>
      <p id="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <section class="board-section">
    <div class="section-head"><div><p class="eyebrow">MY EMA COLLECTION</p><h2>自分の絵馬</h2></div><span id="ema-count">0枚</span></div>
    <div id="ema-list" class="ema-grid" aria-live="polite"></div>
    <p id="empty-state" class="empty">まだ絵馬はありません。最初の一枚を書いてみよう。</p>
  </section>
  <footer><span>KNOT STUDY · ONE STEP CLOSER</span><a href="../">Studyホームへ戻る ↑</a></footer>
</main>
<script>
const KEY='knot-study-ema-v1';
const $=id=>document.getElementById(id);
const form=$('ema-form'),message=$('ema-message');
let entries=[];
try{const saved=JSON.parse(localStorage.getItem(KEY)||'[]');if(Array.isArray(saved))entries=saved.filter(x=>x&&typeof x.title==='string'&&typeof x.message==='string');}catch{}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(entries));return true;}catch{return false;}};
const dateText=value=>{const d=new Date(value);return Number.isNaN(d.getTime())?'':new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric'}).format(d);};
function render(){
 const list=$('ema-list');list.replaceChildren();
 $('ema-count').textContent=entries.length+'枚';
 $('empty-state').hidden=entries.length>0;
 entries.forEach(entry=>{
  const card=document.createElement('article');card.className='ema-card';
  const top=document.createElement('div');top.className='plaque-top';
  const category=document.createElement('span');category.className='category';category.textContent=entry.category;
  const date=document.createElement('time');date.textContent=dateText(entry.createdAt);
  top.append(category,date);
  const nail=document.createElement('span');nail.className='plaque-nail';nail.setAttribute('aria-hidden','true');nail.textContent='✦';
  const title=document.createElement('h3');title.textContent=entry.title;
  const body=document.createElement('p');body.textContent=entry.message;
  const bottom=document.createElement('div');bottom.className='plaque-bottom';
  const seal=document.createElement('span');seal.className='seal';seal.textContent='KNOT';
  const remove=document.createElement('button');remove.type='button';remove.className='remove';remove.textContent='この絵馬を外す';
  remove.addEventListener('click',()=>{entries=entries.filter(x=>x.id!==entry.id);save();render();});
  bottom.append(seal,remove);card.append(top,nail,title,body,bottom);list.append(card);
 });
}
message.addEventListener('input',()=>$('char-count').textContent=message.value.length+' / 140');
form.addEventListener('submit',event=>{
 event.preventDefault();
 const title=$('ema-title').value.trim(),body=message.value.trim();
 if(!title||!body){$('form-status').textContent='目標と願いの両方を入力してね。';return;}
 const entry={id:Date.now().toString(36)+Math.random().toString(36).slice(2,8),category:$('ema-category').value,title,message:body,createdAt:new Date().toISOString()};
 entries.unshift(entry);
 if(!save()){entries.shift();$('form-status').textContent='保存できなかったよ。ブラウザの空き容量を確認してね。';return;}
 form.reset();$('char-count').textContent='0 / 140';$('form-status').textContent='絵馬を奉納したよ。目標に向かって一歩ずつ！';render();
});
render();
</script>
<style>
.ema-page{max-width:920px;margin:0 auto;padding:26px 0 52px}.back{font-size:12px;color:var(--muted)}.hero{padding:34px 0 25px}.eyebrow{font:9px ui-monospace,monospace;letter-spacing:.16em;color:var(--accent);font-weight:850;margin:0 0 9px}.hero h1{font-size:clamp(36px,6vw,54px);letter-spacing:-.07em;margin:0}.hero h1 span{color:var(--accent)}.hero>p:last-child{font-size:12px;color:var(--muted);line-height:1.8}.write-panel,.board-section{padding:23px;border:1px solid var(--line);border-radius:16px;background:var(--surface);margin-bottom:18px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:17px}.section-head h2{font-size:21px;margin:0;letter-spacing:-.04em}.section-head>span:not(.wood-mark){font-size:10px;color:var(--muted)}.wood-mark{display:grid;place-items:center;width:42px;height:48px;background:linear-gradient(145deg,#d9b77d,#a9783e);clip-path:polygon(50% 0,100% 17%,90% 100%,10% 100%,0 17%);color:#51351e;font-size:11px;font-weight:900;padding-top:4px}form label{display:block;font-size:11px;font-weight:800;margin:13px 0 6px}form input,form textarea,form select{width:100%;box-sizing:border-box;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text);padding:12px;font:inherit;font-size:12px}form textarea{resize:vertical;line-height:1.8}form input:focus,form textarea:focus,form select:focus{outline:2px solid color-mix(in srgb,var(--accent) 40%,transparent);border-color:var(--accent)}.form-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:14px}.form-bottom>span{font-size:10px;color:var(--muted)}.submit{border:0;border-radius:9px;background:var(--accent);color:#081323;padding:12px 17px;font:inherit;font-size:11px;font-weight:900;cursor:pointer}.privacy,#form-status{font-size:10px;color:var(--muted);line-height:1.7;margin:10px 0 0}.ema-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.ema-card{position:relative;min-height:185px;padding:20px 20px 15px;background:linear-gradient(145deg,#d9b77d,#c89a5d 55%,#b98249);border:1px solid #8f6137;border-radius:5px 5px 13px 13px;color:#382719;box-shadow:0 7px 18px #0002;clip-path:polygon(0 0,100% 0,100% 90%,50% 100%,0 90%)}.ema-card:before{content:"";position:absolute;inset:6px;border:1px solid #6f492b66;pointer-events:none}.plaque-top,.plaque-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px}.category{font-size:9px;font-weight:900;letter-spacing:.06em;padding:4px 7px;border:1px solid #6f492b66;border-radius:4px}.plaque-top time{font-size:9px;color:#62452e}.plaque-nail{display:block;text-align:center;font-size:13px;margin:9px 0 4px;color:#754c2d}.ema-card h3{text-align:center;font-size:18px;line-height:1.5;margin:0 0 8px;overflow-wrap:anywhere}.ema-card>p{text-align:center;font-size:11px;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 15px}.plaque-bottom{padding-top:9px;border-top:1px solid #6f492b55}.seal{font:900 9px ui-monospace,monospace;letter-spacing:.15em;color:#783b30;border:1px solid #783b30;border-radius:50%;padding:6px}.remove{border:0;background:transparent;color:#62452e;text-decoration:underline;font:inherit;font-size:9px;cursor:pointer}.empty{text-align:center;padding:30px 10px;color:var(--muted);font-size:11px}.empty[hidden]{display:none}.ema-page footer{display:flex;justify-content:space-between;gap:10px;padding:17px 2px;border-top:1px solid var(--line);font:9px ui-monospace,monospace;letter-spacing:.08em;color:var(--muted)}.ema-page footer a{color:var(--accent);font-family:inherit;letter-spacing:0}@media(max-width:620px){.ema-page{padding:17px 0 38px}.write-panel,.board-section{padding:17px}.ema-grid{grid-template-columns:1fr}.ema-card{min-height:170px}.form-bottom{align-items:flex-end}.submit{padding:11px 13px}}
</style>
</StudyLayout>