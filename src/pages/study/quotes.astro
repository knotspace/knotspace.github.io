---
import Layout from '../../layouts/Layout.astro';
const quotes = [
  { name: 'ルネ・デカルト', era: '哲学者', text: '我思う、ゆえに我あり。', note: '考えることから、自分の確かな存在を見つめた言葉。' },
  { name: 'フランシス・ベーコン', era: '哲学者', text: '知は力なり。', note: '知識を身につけることが、世界を理解し行動する力になる。' },
  { name: '福沢諭吉', era: '思想家・教育者', text: '天は人の上に人を造らず、人の下に人を造らず。', note: '学ぶことによって、自分の可能性を広げていこうというメッセージ。' },
  { name: 'マリー・キュリー', era: '物理学者・化学者', text: '人生に恐れるものは何もありません。ただ理解すべきものがあるだけです。', note: '未知のものを、学び理解する姿勢を大切にした言葉。日本語訳は意訳。' },
  { name: 'アイザック・ニュートン', era: '物理学者', text: '私が遠くを見ることができたのは、巨人たちの肩の上に立っていたからです。', note: '先人の研究や知識の積み重ねが、新しい発見につながるという意味。日本語訳は意訳。' },
  { name: 'アルベルト・アインシュタイン', era: '物理学者', text: '大切なのは、問い続けることをやめないことです。', note: '好奇心を持ち、疑問を大切にする姿勢を表した言葉。趣旨をまとめた意訳。' }
];
---
<Layout title="偉人の名言集｜KNOT Study" description="学びや挑戦の背中を押してくれる偉人たちの言葉。">
<main class="quotes">
  <a class="back" href="../">← Studyトップへ</a>
  <header><p class="eyebrow">WORDS TO KEEP</p><h1>偉人の名言集</h1><p>勉強に疲れたとき、もう一歩だけ頑張りたいときに。</p></header>
  <div class="quote-list">
    {quotes.map((quote, index) => <article class="quote">
      <span class="number">{String(index + 1).padStart(2, '0')}</span>
      <div><blockquote>「{quote.text}」</blockquote><h2>{quote.name}</h2><small>{quote.era}</small><p>{quote.note}</p></div>
    </article>)}
  </div>
  <p class="footnote">※一部は原文の趣旨を伝えるための意訳・要約です。出典や訳文は今後も確認・整備していきます。</p>
</main>
<style>
.quotes{max-width:820px;margin:0 auto;padding:28px 0 55px}.back{font-size:12px;color:var(--muted)}header{padding:45px 0 30px}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800}header h1{font-size:clamp(32px,6vw,48px);letter-spacing:-.06em;margin:10px 0}header>p:last-child{font-size:13px;color:var(--muted)}.quote-list{border-top:1px solid var(--line)}.quote{display:grid;grid-template-columns:48px 1fr;gap:15px;padding:25px 5px;border-bottom:1px solid var(--line)}.number{font:11px ui-monospace,monospace;color:var(--accent);padding-top:7px}.quote blockquote{font-size:clamp(18px,3vw,23px);font-weight:750;line-height:1.8;letter-spacing:-.025em;margin:0 0 15px}.quote h2{display:inline;font-size:13px;margin:0 9px 0 0}.quote small{font-size:10px;color:var(--muted)}.quote p{font-size:12px;color:var(--muted);line-height:1.8;margin:9px 0 0}.footnote{font-size:10px;color:var(--muted);line-height:1.8;margin-top:20px}@media(max-width:600px){.quotes{padding:22px 0 40px}.quote{grid-template-columns:30px 1fr;gap:10px}}
</style>
</Layout>