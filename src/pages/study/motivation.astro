---
import StudyLayout from '../../layouts/StudyLayout.astro';
import quotesData from '../../data/study/study-quotes.json';
const quotes = quotesData.quotes;
---
<StudyLayout title="モチベーションセンター｜KNOT Study" description="目標、今日のミッション、継続記録、実績で学習のモチベーションを育てるKNOT Study。">
<main class="motivation-page">
  <a class="back" href="../">← Studyトップへ</a>
  <header class="hero">
    <p class="eyebrow">KNOT / YOUR GROWTH JOURNAL</p>
    <p class="date" id="today"></p>
    <h1>昨日の自分を、<span>少し超えよう。</span></h1>
    <p>完璧じゃなくていい。今日の小さな一歩を、ちゃんと積み重ねていこう。</p>
  </header>

  <section class="overview">
    <article class="level-card">
      <div class="level-top"><span class="eyebrow">YOUR LEVEL</span><span id="rank">STARTER</span></div>
      <div class="level-line"><strong id="level">Lv.1</strong><span id="xp">0 XP</span></div>
      <div class="progress"><span id="xp-bar"></span></div>
      <p id="level-caption">まずは今日の一歩から。</p>
    </article>
    <article class="streak-card">
      <span class="eyebrow">CURRENT STREAK</span>
      <div class="streak-number"><strong id="streak">0</strong><span>日</span><span class="flame">🔥</span></div>
      <p id="streak-caption">今日から記録を始めよう。</p>
    </article>
    <article class="done-card">
      <span class="eyebrow">TOTAL ACHIEVEMENTS</span>
      <div class="streak-number"><strong id="total-done">0</strong><span>回</span></div>
      <p>達成したミッションの合計</p>
    </article>
  </section>

  <section class="mission panel">
    <div class="section-top"><div><p class="eyebrow">TODAY'S MISSION</p><h2>今日のミッション</h2></div><span class="today-tag">DAILY CHALLENGE</span></div>
    <div class="mission-body"><div class="mission-symbol">✦</div><div><h3 id="mission-title">まずは1問、解いてみよう。</h3><p id="mission-desc">小さく始めることが、いちばんの近道。</p><span class="reward">達成すると +20 XP</span></div></div>
    <div class="mission-actions"><button id="complete-mission" class="primary">ミッション達成！</button><span id="mission-status" role="status">達成したらボタンを押そう。</span></div>
  </section>

  <div class="two-col">
    <section class="panel goal-panel">
      <p class="eyebrow">YOUR BIG GOAL</p><h2>目標を、言葉にしよう。</h2>
      <p class="sub">大きな目標も、毎日の行動に分ければ近づいていける。</p>
      <label for="goal-input">今の目標</label>
      <input id="goal-input" maxlength="90" placeholder="例：第一志望に合格する / 数学を得意にする">
      <label for="reason-input">その目標を叶えたい理由</label>
      <textarea id="reason-input" maxlength="220" rows="3" placeholder="例：自分の可能性を広げたいから"></textarea>
      <button id="save-goal" class="secondary">目標を保存する</button><p class="status" id="goal-status" aria-live="polite">目標はいつでも変更できるよ。</p>
      <div class="saved-goal"><small>MY WHY</small><strong id="saved-goal">まだ目標が設定されていません。</strong><p id="saved-reason">まずは、なりたい自分を想像してみよう。</p></div>
    </section>
    <section class="panel daily-panel">
      <p class="eyebrow">DAILY COMMITMENT</p><h2>今日はどれくらい進める？</h2>
      <p class="sub">最初から高く設定しなくてOK。今の自分に合う目標を選ぼう。</p>
      <div class="target-options" role="group" aria-label="今日の学習目標">
        <button data-minutes="15">15分</button><button data-minutes="30" class="selected">30分</button><button data-minutes="45">45分</button><button data-minutes="60">60分</button>
      </div>
      <div class="commitment-result"><strong id="target-minutes">30</strong><span>分の学習に挑戦</span></div>
      <button id="check-in" class="primary">今日の学習を記録する</button>
      <p class="status" id="checkin-status" aria-live="polite">学習を始めたら、ここから記録しよう。</p>
    </section>
  </div>

  <section class="panel mood-panel">
    <div><p class="eyebrow">HOW ARE YOU TODAY?</p><h2>今の気分は？</h2><p class="sub">調子に合わせて、今日のひとことを変えよう。</p></div>
    <div class="moods" role="group" aria-label="今日の気分">
      <button data-mood="最高" aria-pressed="false"><span>⚡</span>最高</button>
      <button data-mood="ふつう" aria-pressed="false"><span>🙂</span>ふつう</button>
      <button data-mood="少し疲れた" aria-pressed="false"><span>🌧</span>少し疲れた</button>
      <button data-mood="焦っている" aria-pressed="false"><span>💭</span>焦っている</button>
    </div>
    <blockquote id="mood-message">今日の調子を選ぶと、今の自分に合ったメッセージが届くよ。</blockquote>
  </section>

  <section class="panel achievements-panel">
    <div class="section-top"><div><p class="eyebrow">MILESTONES</p><h2>積み重ねの証</h2></div><span class="achievement-count" id="achievement-count">0 / 6 達成</span></div>
    <div class="badges" id="badges">
      <article data-achievement="first"><span>🌱</span><strong>はじめの一歩</strong><small>初めて記録する</small></article>
      <article data-achievement="three"><span>🔥</span><strong>三日坊主卒業</strong><small>3日連続で記録</small></article>
      <article data-achievement="seven"><span>🗓️</span><strong>1週間の習慣</strong><small>7日連続で記録</small></article>
      <article data-achievement="ten"><span>🏅</span><strong>チャレンジャー</strong><small>ミッション10回達成</small></article>
      <article data-achievement="twentyfive"><span>💎</span><strong>積み重ねの達人</strong><small>ミッション25回達成</small></article>
      <article data-achievement="goal"><span>🎯</span><strong>目標設定</strong><small>自分の目標を保存する</small></article>
    </div>
  </section>

  <section class="quote-panel">
    <p class="eyebrow">A LITTLE PUSH</p><blockquote id="quote-text">「小さな一歩を積み重ねよう。」</blockquote><div><span id="quote-author">KNOT Study</span><button id="new-quote" type="button">別の言葉を見る ↻</button></div>
  </section>
  <p class="privacy-note">※記録はこのブラウザ内に保存されます。別の端末やブラウザとは自動で同期されません。休む日があっても大丈夫。自分のペースで続けよう。</p>
</main>
<script type="application/json" id="quote-data" set:html={JSON.stringify(quotes)}></script>
<script>
const $=id=>document.getElementById(id);
const KEY='knot-motivation-v1';
const missions=[
 {title:'まずは1問、解いてみよう。',desc:'やる気が出るのを待たずに、1問だけ始めてみよう。'},
 {title:'苦手な問題に1つ向き合おう。',desc:'できない問題こそ、伸びしろ。解説を読むだけでも前進。'},
 {title:'昨日の間違いを3つ復習しよう。',desc:'解き直しは、できる問題を増やすいちばん確実な方法。'},
 {title:'25分だけ集中してみよう。',desc:'スマホを置いて、目の前の課題に集中。終わったら休憩しよう。'},
 {title:'新しいことを1つ覚えよう。',desc:'小さな「わかった」を、今日もひとつ増やそう。'},
 {title:'自分の成長を振り返ろう。',desc:'昨日よりできるようになったことを、ひとつ見つけてみよう。'},
 {title:'いつもより少し難しい問題に挑戦。',desc:'すぐに解けなくてもOK。考えた時間も力になる。'}
];
const messages={
 '最高':'その勢いを大切に。難しい問題にも一歩踏み込んでみよう。',
 'ふつう':'いつも通りで十分。淡々と続ける力が、あとから大きな差になる。',
 '少し疲れた':'今日は小さくていい。10分だけ、1問だけでも立派な前進。',
 '焦っている':'周りと比べなくていい。比べるなら、昨日の自分。今できることを一つずつ。'
};
const dayKey=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const dayIndex=()=>Math.floor(Date.parse(dayKey()+'T00:00:00Z')/86400000);
const blank=()=>({goal:'',reason:'',target:30,checkins:[],missionDays:[],xp:0,moodByDay:{},lastMood:'',quoteIndex:0});
let state=blank();
try{const parsed=JSON.parse(localStorage.getItem(KEY)||'null');if(parsed&&typeof parsed==='object')state={...state,...parsed};}catch{}
for(const k of ['checkins','missionDays'])if(!Array.isArray(state[k]))state[k]=[];
if(!state.moodByDay||typeof state.moodByDay!=='object')state.moodByDay={};
const today=dayKey(),idx=dayIndex(),mission=missions[((idx%missions.length)+missions.length)%missions.length];
const uniqueDays=a=>[...new Set(a)].sort();
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state));}catch{}};
const hasToday=()=>state.checkins.includes(today);
const missionDone=()=>state.missionDays.includes(today);
const streak=()=>{const set=new Set(state.checkins);let n=0,d=idx;if(!set.has(today))d--;while(set.has(new Date(d*86400000).toISOString().slice(0,10))){n++;d--;}return n;};
function levelInfo(){const xp=Math.max(0,Number(state.xp)||0);const level=Math.floor(xp/100)+1;return {xp,level,within:xp%100,rank:level>=10?'LEGEND':level>=6?'MASTER':level>=3?'CHALLENGER':'STARTER'};}
function render(){
 const l=levelInfo(),s=streak(),done=state.missionDays.length;
 $('today').textContent=new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',year:'numeric',month:'long',day:'numeric',weekday:'long'}).format(new Date());
 $('level').textContent='Lv.'+l.level;$('xp').textContent=l.xp+' XP';$('rank').textContent=l.rank;$('xp-bar').style.width=l.within+'%';$('level-caption').textContent=(100-l.within)+' XPで次のレベルへ';
 $('streak').textContent=s;$('streak-caption').textContent=s?('いい調子！'+s+'日続いているよ。'):'今日から新しい記録を始めよう。';
 $('total-done').textContent=done;$('mission-title').textContent=mission.title;$('mission-desc').textContent=mission.desc;
 $('complete-mission').disabled=missionDone();$('complete-mission').textContent=missionDone()?'今日のミッション達成済み':'ミッション達成！';$('mission-status').textContent=missionDone()?'今日のミッションをクリア！ +20 XP': '達成したらボタンを押そう。';
 $('goal-input').value=state.goal;$('reason-input').value=state.reason;$('saved-goal').textContent=state.goal||'まだ目標が設定されていません。';$('saved-reason').textContent=state.reason||'まずは、なりたい自分を想像してみよう。';
 $('target-minutes').textContent=state.target;$('check-in').disabled=hasToday();$('check-in').textContent=hasToday()?'今日の記録は完了！':'今日の学習を記録する';$('checkin-status').textContent=hasToday()?'今日の学習を記録したよ。おつかれさま！':'学習を始めたら、ここから記録しよう。';
 document.querySelectorAll('[data-minutes]').forEach(b=>b.classList.toggle('selected',Number(b.dataset.minutes)===Number(state.target)));
 const earned={first:state.checkins.length>0,three:s>=3,seven:s>=7,ten:done>=10,twentyfive:done>=25,goal:!!state.goal};
 let count=0;document.querySelectorAll('[data-achievement]').forEach(el=>{const yes=!!earned[el.dataset.achievement];el.classList.toggle('earned',yes);if(yes)count++;});
 $('achievement-count').textContent=count+' / 6 達成';
 const mood=state.moodByDay[today]||'';document.querySelectorAll('[data-mood]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mood===mood)));
 $('mood-message').textContent=mood?messages[mood]:'今日の調子を選ぶと、今の自分に合ったメッセージが届くよ。';
}
$('complete-mission').addEventListener('click',()=>{if(missionDone())return;state.missionDays.push(today);state.xp=(Number(state.xp)||0)+20;save();render();});
$('save-goal').addEventListener('click',()=>{state.goal=$('goal-input').value.trim();state.reason=$('reason-input').value.trim();save();$('goal-status').textContent=state.goal?'目標を保存したよ。迷ったときはここに戻ろう。':'目標を入力してみよう。';render();});
document.querySelectorAll('[data-minutes]').forEach(b=>b.addEventListener('click',()=>{state.target=Number(b.dataset.minutes);save();render();}));
$('check-in').addEventListener('click',()=>{if(hasToday())return;state.checkins.push(today);state.xp=(Number(state.xp)||0)+10;save();render();});
document.querySelectorAll('[data-mood]').forEach(b=>b.addEventListener('click',()=>{state.moodByDay[today]=b.dataset.mood;state.lastMood=b.dataset.mood;save();render();}));
let quotePool=[];try{quotePool=JSON.parse($('quote-data').textContent||'[]');}catch{}
function showQuote(){if(!quotePool.length)return;let n=Math.floor(Math.random()*quotePool.length);if(quotePool.length>1&&n===state.quoteIndex)n=(n+1)%quotePool.length;state.quoteIndex=n;const q=quotePool[n];$('quote-text').textContent='「'+q.text+'」';$('quote-author').textContent=q.name+' · '+q.era;}
$('new-quote').addEventListener('click',showQuote);
render();showQuote();
</script>
<style>
.motivation-page{max-width:920px;margin:0 auto;padding:28px 0 58px}.back{font-size:12px;color:var(--muted)}.hero{padding:36px 0 28px}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.15em;color:var(--accent);font-weight:850}.date{font-size:11px;color:var(--muted);margin:0 0 12px}.hero h1{font-size:clamp(34px,6vw,54px);letter-spacing:-.065em;line-height:1.2;margin:0 0 12px}.hero h1 span{color:var(--accent)}.hero>p:last-child,.sub{font-size:12px;line-height:1.9;color:var(--muted)}.overview{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:12px;margin-bottom:15px}.overview article,.panel{border:1px solid var(--line);border-radius:15px;background:var(--surface);padding:19px}.level-top,.section-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.level-top>span:last-child,.today-tag{font:9px ui-monospace,monospace;color:var(--accent);letter-spacing:.1em}.level-line{display:flex;justify-content:space-between;align-items:baseline;margin:14px 0 8px}.level-line strong,.streak-number strong{font-size:31px;letter-spacing:-.06em}.level-line>span{font-size:11px;color:var(--muted)}.progress{height:7px;background:var(--line);border-radius:9px;overflow:hidden}.progress span{display:block;height:100%;width:0;background:var(--accent);border-radius:9px;transition:width .3s}.overview article>p{font-size:10px;color:var(--muted);margin:9px 0 0}.streak-number{display:flex;align-items:baseline;gap:5px;margin:12px 0 0}.streak-number>span{font-size:12px;color:var(--muted)}.streak-number .flame{font-size:19px;margin-left:auto}.mission{margin-bottom:14px;padding:23px}.panel h2{font-size:19px;letter-spacing:-.035em;margin:6px 0}.mission-body{display:flex;align-items:center;gap:18px;padding:18px 0}.mission-symbol{width:58px;height:58px;flex:0 0 58px;display:grid;place-items:center;border-radius:16px;background:color-mix(in srgb,var(--accent) 14%,var(--surface));color:var(--accent);font-size:30px}.mission-body h3{font-size:19px;margin:0 0 5px}.mission-body p{font-size:12px;color:var(--muted);margin:0 0 9px}.reward{font-size:10px;color:var(--accent);font-weight:800}.mission-actions{display:flex;align-items:center;gap:13px;flex-wrap:wrap}.primary,.secondary{border:0;border-radius:9px;padding:12px 17px;font:inherit;font-size:11px;font-weight:800;cursor:pointer}.primary{background:var(--accent);color:white}.secondary{background:var(--surface-soft);color:var(--text);border:1px solid var(--line)}button:disabled{opacity:.55;cursor:not-allowed}.status{font-size:10px;color:var(--muted);margin:9px 0 0}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}.panel>h2{margin-top:7px}.sub{margin:0 0 17px}.goal-panel label{display:block;font-size:10px;font-weight:750;margin:12px 0 6px}.goal-panel input,.goal-panel textarea{width:100%;box-sizing:border-box;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text);padding:11px;font:inherit;font-size:12px;resize:vertical}.goal-panel input:focus,.goal-panel textarea:focus{outline:2px solid color-mix(in srgb,var(--accent) 40%,transparent);border-color:var(--accent)}.goal-panel>.secondary{margin-top:11px}.saved-goal{margin-top:17px;padding:14px;border-radius:10px;background:var(--surface-soft)}.saved-goal small{font:9px ui-monospace,monospace;color:var(--accent);letter-spacing:.12em}.saved-goal strong{display:block;font-size:13px;margin:7px 0}.saved-goal p{font-size:11px;line-height:1.8;color:var(--muted);margin:0}.target-options{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.target-options button,.moods button{border:1px solid var(--line);border-radius:9px;padding:11px 5px;background:var(--bg);color:var(--text);font:inherit;font-size:11px;cursor:pointer}.target-options button.selected,.moods button[aria-pressed=true]{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 13%,var(--surface));color:var(--accent);font-weight:800}.commitment-result{display:flex;align-items:baseline;gap:9px;margin:21px 0}.commitment-result strong{font-size:38px;letter-spacing:-.06em}.commitment-result span{font-size:11px;color:var(--muted)}.daily-panel>.primary{width:100%}.mood-panel{display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;gap:20px;margin-bottom:14px}.mood-panel h2{margin:6px 0}.mood-panel .sub{margin:0}.moods{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.moods button{display:grid;gap:7px;justify-items:center;padding:12px 3px}.moods button span{font-size:21px}.mood-panel blockquote{grid-column:1/-1;border-left:3px solid var(--accent);padding:8px 13px;margin:0;font-size:13px;line-height:1.8;color:var(--muted)}.achievements-panel{margin-bottom:14px;padding:23px}.achievement-count{font-size:10px;color:var(--muted)}.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:15px}.badges article{display:grid;grid-template-columns:38px 1fr;grid-template-rows:auto auto;align-items:center;column-gap:9px;padding:12px;border:1px solid var(--line);border-radius:10px;opacity:.45;filter:grayscale(1)}.badges article.earned{opacity:1;filter:none;border-color:color-mix(in srgb,var(--accent) 55%,var(--line))}.badges article>span{grid-row:1/3;font-size:23px}.badges strong{font-size:11px}.badges small{font-size:9px;color:var(--muted);margin-top:3px}.quote-panel{padding:22px;border-radius:15px;background:var(--surface-soft);border:1px solid var(--line)}.quote-panel blockquote{font-size:clamp(17px,3vw,22px);font-weight:800;line-height:1.7;margin:13px 0}.quote-panel>div{display:flex;justify-content:space-between;align-items:center;gap:12px}.quote-panel>div span{font-size:10px;color:var(--muted)}.quote-panel button{border:0;background:transparent;color:var(--accent);font:inherit;font-size:10px;cursor:pointer}.privacy-note{font-size:10px;color:var(--muted);line-height:1.8;margin-top:14px}@media(max-width:680px){.motivation-page{padding:22px 0 42px}.overview{grid-template-columns:1fr 1fr}.level-card{grid-column:1/-1}.two-col{grid-template-columns:1fr}.mood-panel{grid-template-columns:1fr;gap:13px}.badges{grid-template-columns:repeat(2,1fr)}.mission{padding:18px}.mission-body{gap:12px}.mission-body h3{font-size:16px}.mission-symbol{width:48px;height:48px;flex-basis:48px}.moods{grid-template-columns:repeat(4,1fr)}}
</style>
</StudyLayout>