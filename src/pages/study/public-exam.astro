---
import StudyLayout from '../../layouts/StudyLayout.astro';
import '../../styles/study/quiz-ui.css';
import examData from '../../data/study/public-exam.json';
import upgradeData from '../../data/study/public-exam-upgrade.json';
const bank = [...examData.questions, ...upgradeData.questions];
const science = bank.filter(q => q.subject === 'science').length;
const social = bank.filter(q => q.subject === 'social').length;
const qs = bank;
---
<StudyLayout title="公立高校入試問題精講｜KNOT Study" description="栃木県立高校入試の過去問分析と実戦演習。">
<main class="foundation exam-foundation">
  <div class="top-links"><a class="back" href="../">← Studyホームへ戻る</a><a class="back" href="../past-exams/">過去問データベース →</a></div>
  <header class="hero"><p class="eyebrow">KNOT STUDY / TOCHIGI EXAM</p><h1>公立高校入試問題精講</h1><p>基礎網羅問題と同じ解答エンジンで学習。4択・即時採点・解説・苦手復習・学習記録をひとつにまとめた。</p><div class="counts"><span><b>{bank.length}</b> 問収録</span><span><b>{science}</b> 理科</span><span><b>{social}</b> 社会</span><span><b>7</b> 分野</span></div></header>
  <section class="panel" id="settings">
    <div class="section-head"><div><p class="eyebrow">START LEARNING</p><h2>学習内容を選ぶ</h2></div><span class="tag">入試実戦</span></div>
    <div class="filters"><label>教科<select id="subject"><option value="all">理科・社会</option><option value="science">理科</option><option value="social">社会</option></select></label><label>分野<select id="topic"><option value="all">すべての分野</option></select></label><label>問題数<select id="amount"><option value="10">10問</option><option value="20">20問</option><option value="50">50問</option><option value="all">全問</option><option value="wrong">苦手だけ</option></select></label></div>
    <div class="record"><div><small>累計解答数</small><strong id="total">0</strong></div><div><small>累計正解数</small><strong id="correctTotal">0</strong></div><div><small>苦手な問題</small><strong id="weakTotal">0</strong></div></div>
    <div class="daily-record"><span>今日の学習</span><strong id="dailyTotal">0問</strong><span id="streak">連続学習 0日</span></div>
    <button class="primary" id="start">学習を始める <span>→</span></button><p class="note">間違えた問題は自動で苦手リストに登録。正解すると苦手リストから外れる。</p>
  </section>
  <section class="panel quiz" id="quiz" hidden><div class="shared-quiz-meta"><span id="foundationMeta"></span><b id="foundationProgress"></b></div><div class="shared-progress"><i id="foundationProgressBar"></i></div><div class="question-kicker" id="questionKicker">QUESTION</div><h2 id="prompt"></h2><div class="answers" id="answers"></div><div class="explanation" id="foundationExplanation" hidden aria-live="polite"></div><div class="quiz-actions"><button class="secondary" id="quit">中断して戻る</button><button class="primary" id="next" disabled>次の問題</button></div></section>
  <section class="panel result" id="result" hidden><p class="eyebrow">SESSION COMPLETE</p><h2>おつかれさま！</h2><p class="score"><strong id="score">0</strong><span> / <span id="max">0</span> 問正解</span></p><div class="result-rate"><div><b id="rate">0%</b><small>正答率</small></div><div><b id="resultWeak">0</b><small>今回の間違い</small></div></div><p id="resultMessage"></p><div class="quiz-actions"><button class="secondary" id="backSettings">条件を変える</button><button class="primary" id="retry">もう一度解く</button></div></section>
  <section class="coverage"><p class="eyebrow">LEARNING MAP</p><h2>収録分野</h2><div class="topic-grid"><div><span>理科</span><b>物理</b><small>{bank.filter(q=>q.topic==='物理').length}問</small></div><div><span>理科</span><b>化学</b><small>{bank.filter(q=>q.topic==='化学').length}問</small></div><div><span>理科</span><b>生物</b><small>{bank.filter(q=>q.topic==='生物').length}問</small></div><div><span>理科</span><b>地学</b><small>{bank.filter(q=>q.topic==='地学').length}問</small></div><div><span>社会</span><b>地理</b><small>{bank.filter(q=>q.topic==='地理').length}問</small></div><div><span>社会</span><b>歴史</b><small>{bank.filter(q=>q.topic==='歴史').length}問</small></div><div><span>社会</span><b>公民</b><small>{bank.filter(q=>q.topic==='公民').length}問</small></div></div></section>
  <aside class="source-note"><b>問題の出典について</b><p>「実戦改」はアップロードされた令和6・7年度の栃木県立入試を分析して作成したKNOTオリジナル類題。「基礎」は基礎確認問題。実際の過去問本文は、年度・大問・小問を明記して別区分で収録する。</p><a href="../past-exams/">過去問データベースを見る →</a></aside>
</main>
<script define:vars={{qs}}>
const $=id=>document.getElementById(id),KEY='knot-public-exam-v2';
let record={answered:0,correct:0,wrong:[]},questions=[],index=0,score=0,selected=false,lastConfig=null;
try{const s=JSON.parse(localStorage.getItem(KEY)||'null');if(s&&typeof s==='object'){record.answered=Number.isFinite(s.answered)?s.answered:0;record.correct=Number.isFinite(s.correct)?s.correct:0;record.wrong=Array.isArray(s.wrong)?s.wrong.filter(x=>typeof x==='string'):[];}}catch{}
function save(){try{localStorage.setItem(KEY,JSON.stringify(record));}catch{}}
function dateKey(d){return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');}
function daily(){try{const key='knot-study-daily-v1',d=new Date(),today=dateKey(d),s=JSON.parse(localStorage.getItem(key)||'{}');if(s.date===today)s.answered=(Number(s.answered)||0)+1;else{const y=new Date(d.getFullYear(),d.getMonth(),d.getDate()-1);s.streak=s.lastDate===dateKey(y)?(Number(s.streak)||0)+1:1;s.lastDate=today;s.date=today;s.answered=1;}localStorage.setItem(key,JSON.stringify(s));}catch{}}
function update(){ $('total').textContent=record.answered;$('correctTotal').textContent=record.correct;$('weakTotal').textContent=record.wrong.length;try{const d=JSON.parse(localStorage.getItem('knot-study-daily-v1')||'{}');$('dailyTotal').textContent=(d.date===dateKey(new Date())?Number(d.answered)||0:0)+'問';$('streak').textContent='連続学習 '+(Number(d.streak)||0)+'日';}catch{}}
function topics(){const v=$('subject').value,s=$('topic'),old=s.value;s.replaceChildren(new Option('すべての分野','all'));[...new Set(qs.filter(q=>v==='all'||q.subject===v).map(q=>q.topic))].forEach(t=>s.add(new Option(t,t)));if([...s.options].some(o=>o.value===old))s.value=old;}
$('subject').addEventListener('change',topics);topics();update();
function mode(id){$('settings').hidden=id!=='settings';$('quiz').hidden=id!=='quiz';$('result').hidden=id!=='result';document.documentElement.classList.toggle('quiz-active',id==='quiz');}
function start(){lastConfig={subject:$('subject').value,topic:$('topic').value,amount:$('amount').value};let p=qs.filter(q=>(lastConfig.subject==='all'||q.subject===lastConfig.subject)&&(lastConfig.topic==='all'||q.topic===lastConfig.topic));if(lastConfig.amount==='wrong')p=p.filter(q=>record.wrong.includes(q.id));if(!p.length){alert('この条件の問題はまだありません。別の条件を選んでね。');return;}p=[...p].sort(()=>Math.random()-.5);if(lastConfig.amount!=='all'&&lastConfig.amount!=='wrong')p=p.slice(0,Number(lastConfig.amount));questions=p;index=0;score=0;mode('quiz');render();}
function render(){selected=false;const q=questions[index];$('prompt').textContent=q.prompt;$('foundationMeta').textContent=(q.subject==='science'?'理科':'社会')+' / '+q.topic+' / '+(q.sourceType||'基礎問題');$('questionKicker').textContent='QUESTION '+String(index+1).padStart(2,'0');$('foundationProgress').textContent=(index+1)+' / '+questions.length;$('foundationProgressBar').style.width=(index/questions.length*100)+'%';$('foundationExplanation').hidden=true;$('foundationExplanation').replaceChildren();$('answers').replaceChildren();$('next').disabled=true;$('next').textContent=index===questions.length-1?'結果を見る':'次の問題';q.options.forEach((v,i)=>{const b=document.createElement('button');b.type='button';b.className='answer';b.setAttribute('aria-label','選択肢 '+['A','B','C','D'][i]+'：'+v);const letter=document.createElement('span');letter.className='letter';letter.textContent=['A','B','C','D'][i];const label=document.createElement('span');label.textContent=v;b.append(letter,label);b.addEventListener('click',()=>choose(i));b.addEventListener('pointerup',e=>{if(e.pointerType==='touch'&&!selected){e.preventDefault();choose(i);}});$('answers').append(b);});}
function choose(n){if(selected)return;selected=true;const q=questions[index],ok=n===q.correct;if(ok){score++;record.correct++;record.wrong=record.wrong.filter(x=>x!==q.id);}else if(!record.wrong.includes(q.id))record.wrong.push(q.id);record.answered++;save();daily();update();[...$('answers').children].forEach((b,i)=>{b.disabled=true;if(i===q.correct)b.classList.add('correct');else if(i===n)b.classList.add('incorrect');else b.classList.add('muted-answer');});const ex=$('foundationExplanation'),h=document.createElement('strong');h.className=ok?'feedback-correct':'feedback-wrong';h.textContent=ok?'正解！':'不正解';const a=document.createElement('p');a.className='correct-answer';a.textContent='正解：'+['A','B','C','D'][q.correct]+'　'+q.options[q.correct];const p=document.createElement('p');p.textContent=q.explanation||'解説は準備中です。';ex.append(h,a,p);if(q.sourceNote||q.sourceRef){const s=document.createElement('aside');s.className='question-source';s.textContent=(q.sourceRef?'出題参考：'+q.sourceRef+'　':'')+(q.sourceNote||'');ex.append(s);}if(q.link){const l=document.createElement('a');l.href=q.link;l.className='summary-link';l.textContent='関連する要点まとめを見る →';ex.append(l);}ex.hidden=false;$('next').disabled=false;}
function finish(){document.documentElement.classList.remove('quiz-active');$('foundationProgressBar').style.width='100%';$('quiz').hidden=true;$('result').hidden=false;$('score').textContent=score;$('max').textContent=questions.length;$('rate').textContent=Math.round(score/questions.length*100)+'%';$('resultWeak').textContent=questions.length-score;$('resultMessage').textContent=score===questions.length?'全問正解！その調子！':'間違えた問題は「苦手だけ」からもう一度復習しよう。';}
$('start').addEventListener('click',start);$('next').addEventListener('click',()=>{if(!selected)return;if(index===questions.length-1)finish();else{index++;render();}});$('quit').addEventListener('click',()=>mode('settings'));$('backSettings').addEventListener('click',()=>mode('settings'));$('retry').addEventListener('click',()=>{if(lastConfig){$('subject').value=lastConfig.subject;topics();$('topic').value=lastConfig.topic;$('amount').value=lastConfig.amount;}start();});
</script>
<style>
.exam-foundation .hero{padding:38px 0 28px}.exam-foundation .hero h1{max-width:780px;font-size:clamp(30px,5.5vw,46px);line-height:1.2}.exam-foundation .hero>p:not(.eyebrow){max-width:720px}.exam-foundation .filters{grid-template-columns:repeat(3,minmax(0,1fr))}.daily-record{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:11px 13px;margin:0 0 16px;border:1px solid var(--line);border-radius:9px;background:var(--surface-soft);font-size:10px;color:var(--muted)}.daily-record strong{font-size:14px;color:var(--text)}.daily-record span:last-child{margin-left:auto}.question-kicker{font:800 9px ui-monospace,monospace;letter-spacing:.15em;color:var(--accent)}.exam-foundation .answers{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:none}.exam-foundation .answer{min-height:78px}.exam-foundation .answer.muted-answer{opacity:.48}.exam-foundation .explanation{white-space:normal}.exam-foundation .explanation .correct-answer{font-weight:800;color:var(--text)}.feedback-correct{color:#16834e}.feedback-wrong{color:#c33d4c}.question-source{margin-top:10px;padding:10px 12px;border-left:3px solid var(--accent);background:var(--surface);font-size:11px;line-height:1.7;color:var(--muted)}.result-rate{display:flex;justify-content:center;gap:12px;margin:16px auto}.result-rate div{min-width:110px;padding:13px;border:1px solid var(--line);border-radius:10px;background:var(--surface-soft)}.result-rate b,.result-rate small{display:block}.result-rate b{font-size:23px}.result-rate small{font-size:10px;color:var(--muted)}.source-note{margin-top:28px;padding:16px;border:1px solid var(--line);border-radius:12px;background:var(--surface-soft);font-size:11px;line-height:1.8}.source-note p{color:var(--muted)}.source-note a{color:var(--accent);font-weight:800}
@media(max-width:620px){.exam-foundation .filters{grid-template-columns:1fr}.exam-foundation .answers{grid-template-columns:1fr}.exam-foundation .answer{min-height:72px}.daily-record span:last-child{margin-left:0}.exam-foundation .quiz-actions{flex-direction:column-reverse}.exam-foundation .quiz-actions button{width:100%}}
</style>
<style is:global>
html.quiz-active,html.quiz-active body{width:100%;height:100%;overflow:hidden}html.quiz-active body{background:var(--bg)!important}html.quiz-active .site-shell{width:100%;max-width:none;margin:0;padding:0}html.quiz-active .site-header,html.quiz-active .site-footer{display:none!important}html.quiz-active body main{min-height:100vh;height:100vh}
html.quiz-active .exam-foundation{width:100%;max-width:820px;height:100vh;margin:0 auto;padding:clamp(18px,4vh,48px) clamp(16px,4vw,52px);display:flex;align-items:center;justify-content:center}
html.quiz-active .exam-foundation>.top-links,html.quiz-active .exam-foundation>.hero,html.quiz-active .exam-foundation>#settings,html.quiz-active .exam-foundation>.coverage,html.quiz-active .exam-foundation>#result,html.quiz-active .exam-foundation>.source-note{display:none!important}
html.quiz-active .exam-foundation #quiz{width:100%;margin:0;padding:clamp(22px,4vw,48px);border-radius:24px;display:flex;flex-direction:column;justify-content:center;gap:clamp(16px,3vh,28px)}html.quiz-active .exam-foundation #quiz[hidden]{display:none!important}html.quiz-active .exam-foundation #prompt{font-size:clamp(22px,3.2vw,36px);line-height:1.65;margin:0}html.quiz-active .exam-foundation #answers{width:100%;gap:clamp(10px,1.5vw,16px)}html.quiz-active .exam-foundation #answers>.answer{min-height:clamp(78px,11vh,112px);padding:clamp(14px,2vw,22px);font-size:clamp(15px,1.5vw,19px);border-radius:20px}html.quiz-active .exam-foundation .quiz-actions{margin:0}html.quiz-active .exam-foundation #next,html.quiz-active .exam-foundation #quit{min-height:50px;padding:13px 22px;border-radius:13px;font-size:13px}
@media(max-width:620px){html.quiz-active,html.quiz-active body{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important}html.quiz-active body main{height:auto!important;min-height:100dvh!important}html.quiz-active .exam-foundation{height:auto!important;min-height:100dvh!important;display:block!important;padding:14px 12px calc(24px + env(safe-area-inset-bottom))!important}html.quiz-active .exam-foundation #quiz{width:100%;min-height:calc(100dvh - 28px);height:auto!important;max-height:none!important;overflow:visible!important;display:flex!important;justify-content:flex-start!important;gap:18px!important;padding:20px 15px!important;margin:0!important}html.quiz-active .exam-foundation #answers{display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:none!important;gap:11px!important}html.quiz-active .exam-foundation #answers>.answer{width:100%;min-height:76px!important;height:auto!important;padding:15px 14px!important;border-radius:18px!important;font-size:15px!important;line-height:1.55!important;gap:12px!important}html.quiz-active .exam-foundation #answers>.answer .letter{width:34px!important;height:34px!important;flex:0 0 34px!important}html.quiz-active .exam-foundation #prompt{font-size:clamp(19px,5vw,23px)!important;line-height:1.65!important;overflow-wrap:anywhere}html.quiz-active .exam-foundation .quiz-actions{position:sticky;bottom:0;background:var(--surface);padding:10px 0 max(8px,env(safe-area-inset-bottom));z-index:5}html.quiz-active .exam-foundation #next,html.quiz-active .exam-foundation #quit{min-height:48px!important}}
</style>
</StudyLayout>