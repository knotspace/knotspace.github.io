---
import StudyLayout from '../../layouts/StudyLayout.astro';
const qs=[
{subject:'理科',unit:'生物・植物の分類',title:'植物の分類',prompt:'種子をつくらず、根・茎・葉の区別がある植物はどれか。',options:['ゼニゴケ','イヌワラビ','アブラナ','マツ'],a:1,why:'イヌワラビはシダ植物。胞子でふえ、根・茎・葉の区別がある。ゼニゴケはコケ植物である。',point:'コケ植物とシダ植物の違いを整理する。'},
{subject:'理科',unit:'化学・気体の性質',title:'二酸化炭素の確認',prompt:'二酸化炭素を石灰水に通すとどうなるか。',options:['青色になる','白くにごる','赤色になる','気体が発生する'],a:1,why:'二酸化炭素を石灰水に通すと、炭酸カルシウムが生じて白くにごる。',point:'気体の性質と確認方法をセットで覚える。'},
{subject:'理科',unit:'化学・物質の溶解',title:'気体の溶解度',prompt:'一般に、水温が高くなるほど二酸化炭素が水に溶ける量はどうなるか。',options:['多くなる','少なくなる','変化しない','一度増えて一定'],a:1,why:'気体は一般に水温が低いほど水に多く溶ける。水温が上がると溶ける量は減少する。',point:'気体と固体では温度による溶解度の傾向が異なる。'},
{subject:'理科',unit:'物理・電流と熱量',title:'電力量の計算',prompt:'電力10Wの電熱線に2分間電流を流した。発生する熱量は何Jか。',options:['20J','120J','600J','1200J'],a:3,why:'熱量[J]＝電力[W]×時間[s]。2分＝120秒なので10×120＝1200J。',point:'時間を秒に直してから計算する。'},
{subject:'社会',unit:'地理・日本の地域',title:'関東地方の工業',prompt:'東京湾岸に石油化学工業が発達した理由として最も適切なものはどれか。',options:['森林資源が豊富だから','原料や製品を船で大量輸送しやすいから','積雪が少なく農業が盛んだから','大都市から遠く土地が安いから'],a:1,why:'石油化学工業は原料を大量に運ぶ必要があり、東京湾岸は港を利用した海上輸送に適している。',point:'工業立地は原料・製品の輸送と消費地との関係から考える。'},
{subject:'社会',unit:'地理・世界の地域',title:'地中海性気候',prompt:'地中海性気候の特徴はどれか。',options:['一年中高温多雨','夏に乾燥し冬に雨が多い','一年中低温で少雨','夏に雨が多く冬に乾燥'],a:1,why:'地中海性気候は夏に乾燥し、冬に偏西風や低気圧の影響で雨が多くなる。',point:'雨温図は降水量が夏と冬のどちらに多いかを見る。'},
{subject:'社会',unit:'歴史・中世の日本',title:'日宋貿易',prompt:'平清盛が日宋貿易の拠点として整備した港はどこか。',options:['博多','堺','大輪田泊','長崎'],a:2,why:'平清盛は現在の神戸付近にあたる大輪田泊を整備し、宋との貿易を進めた。',point:'人物・政策・場所を時代の流れと結びつける。'},
{subject:'社会',unit:'公民・日本国憲法',title:'国会の役割',prompt:'日本国憲法で、国会はどのような機関と定められているか。',options:['行政権の最高機関','司法権の最高機関','国権の最高機関で、国の唯一の立法機関','地方自治の最高機関'],a:2,why:'国会は国権の最高機関であり、国の唯一の立法機関。法律を制定する。',point:'国会・内閣・裁判所を立法・行政・司法と結びつけて区別する。'}
];
---
<StudyLayout title="公立高校入試問題精講｜KNOT Study" description="栃木県立高校入試の理科・社会の四択演習。">
<main class="exam-page">
<a class="back-link" href="../">← Studyホーム</a>
<header class="hero"><p class="eyebrow">TOCHIGI PREFECTURAL HIGH SCHOOL EXAM</p><h1>公立高校入試<br/><span>問題精講</span></h1><p>栃木県立高校入試の出題テーマを参考に、理科・社会を四択で演習。解答と詳しい解説まで確認しよう。</p><div class="tags"><span>栃木県立高校入試</span><span>理科・社会</span><span>四択演習</span></div></header>
<div class="stats"><div><b>8</b><small>収録問題</small></div><div><b>4</b><small>理科</small></div><div><b>4</b><small>社会</small></div><div><b id="score">0</b><small>正解数</small></div></div>
<section><div class="heading"><div><p class="eyebrow">PRACTICE</p><h2>入試問題に挑戦</h2></div><small id="progress">0 / 8 回答</small></div>
<nav class="filters"><button class="active" data-filter="すべて">すべて</button><button data-filter="理科">理科</button><button data-filter="社会">社会</button></nav>
<div class="questions">{qs.map((q,i)=><article class="q" data-subject={q.subject} data-answer={q.a}><div class="meta"><b>{q.subject}</b><span>{q.unit}</span><small>栃木県立入試の出題テーマを参考</small><i>Q{i+1}</i></div><h3>{q.title}</h3><p class="prompt">{q.prompt}</p><div class="choices">{q.options.map((o,j)=><button type="button" data-choice={j}><b>{['①','②','③','④'][j]}</b>{o}</button>)}</div><div class="actions"><button class="check" disabled>解答する</button><strong class="result" aria-live="polite"></strong></div><div class="explain" hidden><b class="answer"></b><p>{q.why}</p><aside><b>入試での着眼点</b><p>{q.point}</p></aside></div></article>)}</div></section>
<aside class="source"><b>教材について</b><p>栃木県教育委員会の出題方針・結果資料と公開された学力検査問題を参考に、KNOTが四択形式へ再構成したオリジナル演習です。実際の問題文・図表の転載ではありません。現在は導入版として理科4問・社会4問を収録しています。</p><a href="https://www.pref.tochigi.lg.jp/m04/r08/r08_kennritukoutougakkounyuugakushasennbatunikannsuruosirase.html" target="_blank" rel="noopener">栃木県教育委員会の入試情報 ↗</a></aside>
<footer><span>KNOT STUDY · TOCHIGI EXAM PRACTICE</span><a href="../">Studyホームへ戻る</a></footer>
</main>
<script>
const cards=[...document.querySelectorAll('.q')],filters=[...document.querySelectorAll('[data-filter]')];let answered=0,score=0;
function update(){document.getElementById('progress').textContent=answered+' / '+cards.length+' 回答';document.getElementById('score').textContent=score;}
cards.forEach(card=>{const choices=[...card.querySelectorAll('[data-choice]')],check=card.querySelector('.check'),result=card.querySelector('.result'),ex=card.querySelector('.explain');let selected=null,done=false;
choices.forEach(c=>c.addEventListener('click',()=>{if(done)return;selected=+c.dataset.choice;choices.forEach(x=>x.classList.toggle('selected',x===c));check.disabled=false;}));
check.addEventListener('click',()=>{if(selected===null||done)return;done=true;answered++;const a=+card.dataset.answer,ok=selected===a;if(ok)score++;choices.forEach((c,i)=>{c.disabled=true;if(i===a)c.classList.add('correct');else if(i===selected)c.classList.add('wrong');});result.textContent=ok?'正解！':'不正解';result.className='result '+(ok?'good':'bad');card.querySelector('.answer').textContent='正解：'+['①','②','③','④'][a]+' '+choices[a].textContent.trim();ex.hidden=false;check.hidden=true;update();});});
filters.forEach(b=>b.addEventListener('click',()=>{filters.forEach(x=>x.classList.toggle('active',x===b));cards.forEach(c=>c.hidden=b.dataset.filter!=='すべて'&&c.dataset.subject!==b.dataset.filter);}));
update();
</script>
<style>
.exam-page{max-width:940px;margin:auto;padding:18px 0 45px;color:var(--text)}.back-link{font-size:11px;color:var(--muted);text-decoration:none}.hero{margin:16px 0;padding:clamp(24px,5vw,44px);border-radius:20px;background:linear-gradient(130deg,#101827,#1b3557);color:#f5f8ff}.eyebrow{font:800 9px ui-monospace,monospace;letter-spacing:.15em;color:var(--accent);margin:0 0 9px}.hero .eyebrow{color:#a9ceff}.hero h1{font-size:clamp(34px,7vw,58px);line-height:1.12;letter-spacing:-.06em;margin:0}.hero h1 span{color:#a9ceff}.hero>p:not(.eyebrow){font-size:13px;line-height:1.9;color:#d5e0ef;max-width:650px}.tags{display:flex;gap:7px;flex-wrap:wrap}.tags span{border:1px solid #ffffff40;border-radius:99px;padding:6px 10px;font-size:10px}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface);margin-bottom:28px}.stats div{padding:12px 16px;display:grid;border-right:1px solid var(--line)}.stats div:last-child{border:0}.stats b{font-size:22px}.stats small{font-size:10px;color:var(--muted)}.heading{display:flex;justify-content:space-between;align-items:end}.heading h2{font-size:24px;margin:0}.heading>small{color:var(--muted)}.filters{display:flex;gap:7px;margin:13px 0}.filters button{border:1px solid var(--line);border-radius:99px;background:var(--surface);padding:8px 15px;color:var(--muted)}.filters button.active{background:var(--accent);color:#071426;border-color:var(--accent)}.questions{display:grid;gap:13px}.q{padding:clamp(16px,3vw,23px);border:1px solid var(--line);border-radius:15px;background:var(--surface)}.q[hidden]{display:none}.meta{display:flex;gap:9px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:10px}.meta>b{color:var(--accent)}.meta i{margin-left:auto;font-style:normal;font-family:monospace}.q h3{font-size:18px;margin:10px 0}.prompt{padding:13px;border-radius:9px;background:var(--surface-soft);font-size:13px;line-height:1.8}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.choices button{display:flex;gap:10px;text-align:left;align-items:start;padding:12px;border:1px solid var(--line);border-radius:9px;background:transparent;color:var(--text);font-size:12px;line-height:1.6;cursor:pointer}.choices button b{color:var(--accent)}.choices button.selected{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,var(--surface))}.choices button.correct{border-color:#24976c;background:color-mix(in srgb,#24976c 10%,var(--surface))}.choices button.wrong{border-color:#d15e68}.choices button:disabled{opacity:1}.actions{display:flex;align-items:center;gap:12px;margin-top:13px}.check{border:0;border-radius:8px;background:var(--accent);color:#071426;padding:10px 16px;font-weight:850}.check:disabled{opacity:.35}.result{font-size:12px}.good{color:#24976c}.bad{color:#d15e68}.explain{border-top:1px solid var(--line);margin-top:14px;padding-top:13px;font-size:12px;line-height:1.85}.explain>p{color:var(--muted)}.explain aside{padding:11px;border-left:3px solid var(--accent);background:var(--surface-soft)}.explain aside p{margin:4px 0 0}.source{margin-top:22px;padding:15px;border:1px solid var(--line);border-radius:12px;background:var(--surface-soft);font-size:11px;line-height:1.8}.source p{color:var(--muted)}.source a,footer a{color:var(--accent)}footer{display:flex;justify-content:space-between;gap:10px;margin-top:24px;padding-top:14px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}footer span{font-family:monospace;letter-spacing:.1em}@media(max-width:600px){.choices{grid-template-columns:1fr}.stats div{padding:10px 7px}.stats b{font-size:18px}footer{flex-direction:column}}
</style>
</StudyLayout>