---
import StudyLayout from '../../layouts/StudyLayout.astro';
import examData from '../../data/study/public-exam.json';
const qs = examData.questions.map(q => ({...q, subject:q.subject==='science'?'理科':'社会', unit:q.topic, title:q.term, a:q.correct, why:q.explanation, point:'関連する要点を確認し、用語だけでなく理由やしくみまで説明できるようにしよう。'}));
---
<StudyLayout title="公立高校入試問題精講｜KNOT Study" description="栃木県立高校入試のテーマを基にした理科・社会の段階式演習。">
<main class="exam-page">
<a class="back-link" href="../">← Studyホーム</a>
<header class="hero"><p class="eyebrow">TOCHIGI PREFECTURAL HIGH SCHOOL EXAM</p><h1>公立高校入試<br/><span>問題精講</span></h1><p>基礎網羅問題と同じ操作で、1問ずつ解答。選択肢をタップすると正誤と解説が表示されるよ。</p><div class="tags"><span>栃木県立高校入試</span><span>理科・社会</span><span>1問ずつ演習</span></div></header>
<section class="panel" id="settings">
<div class="heading"><div><p class="eyebrow">START LEARNING</p><h2>学習内容を選ぶ</h2></div><a class="db-link" href="../past-exams/">過去問データベース ↗</a></div>
<div class="filters"><label>教科<select id="subject"><option value="all">理科・社会</option><option value="理科">理科</option><option value="社会">社会</option></select></label><label>問題数<select id="amount"><option value="all">全問</option><option value="5">5問</option><option value="10">10問</option></select></label></div>
<div class="stats"><div><b>8</b><small>収録問題</small></div><div><b>4</b><small>理科</small></div><div><b>4</b><small>社会</small></div><div><b id="recordScore">0</b><small>今回の正解数</small></div></div>
<button class="primary" id="start">学習を始める <span>→</span></button>
<p class="note">間違えた問題も、解説を読んで次へ進もう。</p>
</section>
<section class="panel quiz" id="quiz" hidden>
<div class="shared-quiz-meta"><span id="meta"></span><b id="progress"></b></div><div class="shared-progress"><i id="progressBar"></i></div>
<h2 id="prompt"></h2><div class="answers" id="answers"></div>
<div class="explanation" id="explanation" hidden aria-live="polite"></div>
<div class="quiz-actions"><button class="secondary" id="quit">問題選択に戻る</button><button class="primary" id="next" disabled>次の問題</button></div>
</section>
<section class="panel result" id="result" hidden><p class="eyebrow">SESSION COMPLETE</p><h2>おつかれさま！</h2><p class="score"><strong id="score">0</strong> / <span id="max">0</span> 問正解</p><p id="resultMessage"></p><div class="quiz-actions"><button class="secondary" id="back">条件を変える</button><button class="primary" id="retry">もう一度解く</button></div></section>
<aside class="source"><b>出典・問題の扱い</b><p>今回の200問はKNOT制作の4択基礎・類題演習です。過去問本文の転載ではありません。アップロードされた過去問の各設問と個別に照合できた問題には、確認後に年度・大問・小問を記録します。出典番号を推測で付けることはしません。</p><a href="../past-exams/">過去問データベースを見る →</a></aside>
<footer><span>KNOT STUDY · TOCHIGI EXAM PRACTICE</span><a href="../">Studyホームへ戻る</a></footer>
</main>
<script define:vars={{qs}}>
const $=id=>document.getElementById(id);let pool=[],index=0,score=0,selected=false,last={subject:'all',amount:'all'};
function show(id){$('settings').hidden=id!=='settings';$('quiz').hidden=id!=='quiz';$('result').hidden=id!=='result';document.documentElement.classList.toggle('quiz-active',id==='quiz');}
function start(){last={subject:$('subject').value,amount:$('amount').value};pool=qs.filter(q=>last.subject==='all'||q.subject===last.subject).sort(()=>Math.random()-.5);if(last.amount!=='all')pool=pool.slice(0,Number(last.amount));index=0;score=0;show('quiz');render();}
function render(){selected=false;const q=pool[index];$('meta').textContent=q.subject+' / '+q.unit;$('progress').textContent=(index+1)+' / '+pool.length;$('progressBar').style.width=(index/pool.length*100)+'%';$('prompt').textContent=q.prompt;$('explanation').hidden=true;$('explanation').replaceChildren();$('answers').replaceChildren();$('next').disabled=true;$('next').textContent=index===pool.length-1?'結果を見る':'次の問題';q.options.forEach((option,i)=>{const b=document.createElement('button');b.type='button';b.className='answer';const letter=document.createElement('span');letter.className='letter';letter.textContent=['A','B','C','D'][i];const label=document.createElement('span');label.textContent=option;b.append(letter,label);b.addEventListener('click',()=>choose(i));$('answers').append(b);});}
function choose(choice){if(selected)return;selected=true;const q=pool[index],ok=choice===q.a;if(ok)score++;[...$('answers').children].forEach((b,i)=>{b.disabled=true;if(i===q.a)b.classList.add('correct');else if(i===choice)b.classList.add('incorrect');});const ex=$('explanation');const h=document.createElement('strong');h.textContent=ok?'正解！':'不正解';const p=document.createElement('p');p.textContent='正解：'+['A','B','C','D'][q.a]+'　'+q.options[q.a]+'\n'+q.why;const aside=document.createElement('aside');aside.textContent='入試での着眼点：'+q.point;ex.append(h,p,aside);ex.hidden=false;$('next').disabled=false;}
function finish(){show('result');$('score').textContent=score;$('max').textContent=pool.length;$('recordScore').textContent=score;$('resultMessage').textContent=score===pool.length?'全問正解！この調子！':'解説を確認して、苦手なところを基礎網羅問題でも復習しよう。';}
$('start').addEventListener('click',start);$('next').addEventListener('click',()=>{if(!selected)return;if(index===pool.length-1)finish();else{index++;render();}});$('quit').addEventListener('click',()=>show('settings'));$('back').addEventListener('click',()=>show('settings'));$('retry').addEventListener('click',()=>{ $('subject').value=last.subject;$('amount').value=last.amount;start();});
</script>
<style>
.exam-page{max-width:920px;margin:auto;padding:18px 0 45px;color:var(--text)}.back-link{font-size:11px;color:var(--muted)}.hero{margin:16px 0;padding:clamp(24px,5vw,44px);border-radius:20px;background:linear-gradient(130deg,#101827,#1b3557);color:#f5f8ff}.eyebrow{font:800 9px ui-monospace,monospace;letter-spacing:.15em;color:var(--accent);margin:0 0 9px}.hero .eyebrow{color:#a9ceff}.hero h1{font-size:clamp(34px,7vw,58px);line-height:1.12;letter-spacing:-.06em;margin:0}.hero h1 span{color:#a9ceff}.hero>p:not(.eyebrow){font-size:13px;line-height:1.9;color:#d5e0ef;max-width:650px}.tags{display:flex;gap:7px;flex-wrap:wrap}.tags span{border:1px solid #ffffff40;border-radius:99px;padding:6px 10px;font-size:10px}.panel{padding:clamp(16px,3vw,24px);border:1px solid var(--line);border-radius:16px;background:var(--surface);margin:14px 0}.heading{display:flex;justify-content:space-between;align-items:center;gap:10px}.heading h2{font-size:23px;margin:0}.db-link{font-size:11px;color:var(--accent);font-weight:800}.filters{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}.filters label{display:grid;gap:7px;font-size:11px;color:var(--muted);flex:1;min-width:140px}.filters select{padding:12px;border:1px solid var(--line);border-radius:9px;background:var(--surface-soft);color:var(--text)}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin:18px 0}.stats div{padding:11px;display:grid;border-right:1px solid var(--line)}.stats div:last-child{border:0}.stats b{font-size:20px}.stats small,.note{font-size:10px;color:var(--muted)}.primary,.secondary{border:0;border-radius:9px;padding:12px 17px;font-weight:850;cursor:pointer}.primary{background:var(--accent);color:#071426}.secondary{background:var(--surface-soft);border:1px solid var(--line);color:var(--text)}.primary:disabled{opacity:.35}.shared-quiz-meta{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px}.shared-progress{height:6px;background:var(--line);border-radius:20px;overflow:hidden;margin:10px 0 22px}.shared-progress i{display:block;height:100%;background:var(--accent);transition:width .2s}.quiz h2{font-size:clamp(18px,3vw,25px);line-height:1.65;margin:15px 0 22px}.answers{display:grid;gap:12px}.answers .answer{display:flex;align-items:center;gap:14px;width:100%;min-height:72px;padding:16px 19px;border:2px solid var(--quiz-answer-border,#9bb8ed);border-radius:17px;background:var(--quiz-answer-bg,#e8efff);color:var(--quiz-answer-ink,#243b61);box-shadow:0 4px 0 var(--quiz-answer-border,#9bb8ed);text-align:left;font-size:14px;line-height:1.6;font-weight:700;cursor:pointer}.answer .letter{display:grid;place-items:center;width:34px;height:34px;flex:0 0 34px;border-radius:12px;background:var(--quiz-answer-chip,#d1e0ff);font-weight:900}.answer.correct{background:#ddf7e7!important;border-color:#35a66a!important;color:#185b36!important;box-shadow:none!important}.answer.incorrect{background:#ffe5e7!important;border-color:#df5964!important;color:#842b35!important;box-shadow:none!important}.answer:disabled{opacity:1}.explanation{margin-top:18px;padding:16px;border-radius:12px;background:var(--surface-soft);font-size:13px;line-height:1.85;white-space:pre-line}.explanation p{color:var(--muted)}.explanation aside{padding:10px;border-left:3px solid var(--accent)}.summary-link{display:inline-block;margin-top:10px;color:var(--accent);font-weight:850;text-decoration:underline;text-underline-offset:3px}.quiz-actions{display:flex;justify-content:space-between;gap:10px;margin-top:20px}.score strong{font-size:40px}.source{margin-top:20px;padding:15px;border:1px solid var(--line);border-radius:12px;background:var(--surface-soft);font-size:11px;line-height:1.8}.source p{color:var(--muted)}.source a,footer a{color:var(--accent)}footer{display:flex;justify-content:space-between;gap:10px;margin-top:24px;padding-top:14px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}footer span{font-family:monospace;letter-spacing:.1em}@media(max-width:600px){.stats div{padding:9px 6px}.stats b{font-size:17px}.quiz-actions{flex-direction:column-reverse}.quiz-actions button{width:100%}footer{flex-direction:column}}
</style>
</StudyLayout>