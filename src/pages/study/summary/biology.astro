ng:10px;background:var(--surface-soft);display:grid;gap:5px}.volcanoes small,.circuits small,.particles small,.landforms small,.market span{font-size:10px;color:var(--muted)}.diagram table{width:100%;border-collapse:collapse;font-size:11px}.diagram th,.diagram td{border:1px solid var(--line);padding:8px;text-align:center}.diagram th{background:var(--surface-soft)}.wave{display:grid;gap:10px}.wave span{padding:12px;border-radius:8px;background:var(--surface-soft);font-size:12px}.wave span:first-child{border-left:5px solid #3686d6}.wave span:last-child{border-left:5px solid #d68a36}.equation{font-size:clamp(20px,4vw,30px);font-weight:800;text-align:center;padding:18px;background:var(--surface-soft);border-radius:10px}.flow{display:flex;align-items:center;justify-content:center;gap:9px;flex-wrap:wrap}.flow div{display:grid;gap:5px;text-align:center;border:1px solid var(--line);border-radius:9px;padding:12px;min-width:100px;background:var(--surface-soft)}.flow b{font-size:13px}.flow span,.market span{font-size:10px;color:var(--muted)}.flow i{font-style:normal;color:var(--accent);font-size:20px}.market strong{font-size:12px;color:var(--accent)}.source{margin-top:28px;padding:20px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.source h2{font-size:17px}.source p,.source li{font-size:11px;line-height:1.9;color:var(--muted)}.source a{color:var(--accent)}.disclaimer{margin-top:12px}.back-bottom{display:inline-block;margin-top:22px}@media(max-width:620px){.summary-page{padding:20px 0 42px}.unit-nav{grid-template-columns:1fr}.unit-nav b{grid-column:auto}.unit{padding:20px 0}.unit h2{font-size:19px}}
