900}.math-summary footer{display:flex;justify-content:space-between;margin-top:32px;padding-top:17px;border-top:1px solid var(--line)}@media(max-width:760px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.math-summary{padding-top:14px}.cards{grid-template-columns:1fr}.math-summary h2{font-size:21px}.stats{gap:10px}}
</style>
