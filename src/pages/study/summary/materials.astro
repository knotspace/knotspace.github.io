---
import StudyLayout from '../../../layouts/StudyLayout.astro';
import CommonsGallery from '../../../components/CommonsGallery.astro';
const categories = [
  "human heart anatomy diagram","human digestive system diagram","plant cell microscope","photosynthesis experiment leaf iodine",
  "plant vascular bundle xylem phloem diagram","blood circulation diagram","human lung alveoli microscope","genetics punnett square diagram",
  "food web ecosystem diagram","mitosis meiosis chromosome diagram","volcano types eruption diagram","igneous rocks granite basalt samples",
  "earthquake seismograph P wave S wave","sedimentary rock fossils strata","weather fronts synoptic weather map","cloud formation water cycle diagram",
  "weather station rain gauge barometer","moon phases astronomy diagram","solar system planets diagram","star trails north celestial pole",
  "electric circuit series parallel diagram","ammeter voltmeter circuit experiment","ohms law graph resistor","convex lens ray diagram",
  "force vectors inclined plane physics","pressure experiment surface area","energy conservation roller coaster diagram","sound wave frequency amplitude graph",
  "chemical reaction experiment gas collection","electrolysis of water apparatus","acid alkali neutralization titration graph","solubility curve crystallization graph",
  "periodic table chemical elements","atomic molecular model chemistry","density measurement laboratory experiment","distillation apparatus chemistry",
  "topographic map contour lines Japan","world climate zones map","climograph temperature precipitation graph","population pyramid statistics",
  "Japanese agriculture rice terrace farming","industrial regions Japan map","world trade exports imports graph","renewable energy power generation chart",
  "Japanese historical Jomon pottery","Yayoi rice paddy archaeological site","Kofun keyhole tomb aerial","Horyuji temple architecture",
  "Heian period Japanese painting","Kamakura samurai armor","Muromachi Kinkakuji Ginkakuji","Edo period ukiyo-e print",
  "Meiji restoration historical photograph","World War II historical map","Japanese constitution document","United Nations assembly hall",
  "separation of powers government diagram","Japanese parliament building","election system proportional representation chart","supply demand curve economics",
  "social security system diagram","international cooperation SDGs infographic"
];
---
<StudyLayout title="入試頻出資料・写真200｜KNOT Study" description="高校入試・高専入試で頻出の理科・社会の図表、写真、地図、実験資料をまとめて確認。">
<main class="materials-page">
  <a class="back" href="/study/summary/">← 要点まとめ一覧</a>
  <a class="diagram-library-link" href="/study/diagrams/">KNOTオリジナル図解400個を見る →</a>
<header>
    <p class="eyebrow">KNOT STUDY / EXAM MATERIALS</p>
    <h1>入試頻出資料・写真200</h1>
    <p>暗記だけでなく、図・写真・地図・グラフから読み取る練習に使おう。理科と社会の頻出テーマを中心に、関連資料を200点まで表示する。</p>
    <div class="counts"><span>理科：実験・模式図・観察写真</span><span>社会：地図・年表・統計グラフ</span><span>出典・ライセンス確認つき</span></div>
  </header>
  <section class="guide">
    <h2>資料を見るときの順番</h2>
    <ol><li>タイトル・対象・年代を確認する</li><li>単位・目盛り・凡例を確認する</li><li>変化・共通点・違いを読み取る</li><li>知識と資料の事実を分けて答える</li></ol>
  </section>
  <CommonsGallery categories={categories} limit={200} />
  <p class="note">画像はWikimedia Commonsから取得。表示された資料の作者・ライセンス・利用条件は、各原資料ページで確認してね。検索結果には入試頻出テーマに関連する補助資料も含まれる。</p>
</main>
<style>
.materials-page{max-width:920px;margin:0 auto;padding:28px 0 60px}.back{font-size:12px;color:var(--accent)}header{padding:32px 0 24px;border-bottom:1px solid var(--line)}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800}h1{font-size:clamp(30px,5vw,46px);letter-spacing:-.05em;margin:10px 0}header>p:last-of-type{font-size:13px;line-height:1.9;color:var(--muted);max-width:700px}.counts{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.counts span{font-size:10px;padding:7px 10px;border:1px solid var(--line);border-radius:8px;color:var(--muted)}.guide{margin:22px 0;padding:18px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.guide h2{font-size:16px;margin:0 0 10px}.guide ol{margin:0;padding-left:22px;font-size:12px;line-height:2;color:var(--muted)}.note{font-size:11px;line-height:1.8;color:var(--muted);margin-top:18px}
 .diagram-library-link{display:inline-block;margin:14px 0;padding:12px 15px;border:1px solid var(--line);border-radius:9px;color:var(--accent);font-size:12px;font-weight:800;background:var(--surface)}
</style>
</StudyLayout>