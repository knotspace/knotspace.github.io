---
import StudyLayout from '../../../layouts/StudyLayout.astro';
import assetsData from '../../../data/study/knot-summary-assets.json';
import foundationData from '../../../data/study/study-foundation.json';
const subjects = [
 {key:'physics',title:'物理',label:'PHYSICS',desc:'力・運動・電気・エネルギー・光と音',count:foundationData.questions.filter(q=>q.topic==='物理').length},
 {key:'chemistry',title:'化学',label:'CHEMISTRY',desc:'物質・水溶液・化学変化・イオン',count:foundationData.questions.filter(q=>q.topic==='化学').length},
 {key:'biology',title:'生物',label:'BIOLOGY',desc:'細胞・植物・人体・遺伝・生態系',count:foundationData.questions.filter(q=>q.topic==='生物').length},
 {key:'earth',title:'地学',label:'EARTH SCIENCE',desc:'火山・地震・地層・気象・天体',count:foundationData.questions.filter(q=>q.topic==='地学').length},
 {key:'geography',title:'地理',label:'GEOGRAPHY',desc:'世界と日本の自然・産業・人口・地域',count:foundationData.questions.filter(q=>q.topic==='地理').length},
 {key:'history',title:'歴史',label:'HISTORY',desc:'古代から現代まで、時代の流れと因果関係',count:foundationData.questions.filter(q=>q.topic==='歴史').length},
 {key:'civics',title:'公民',label:'CIVICS',desc:'憲法・政治・経済・国際社会',count:foundationData.questions.filter(q=>q.topic==='公民').length},
 {key:'materials',title:'図解・資料ライブラリ',label:'VISUAL LIBRARY',desc:'理科・社会の図解、比較表、資料をまとめて確認',count:assetsData.resources.length}
];
---
<StudyLayout title="要点まとめ｜KNOT Study" description="理科・社会の重要事項を、単元別の解説・図解・比較表・重要語句で体系的に学べる要点まとめ。">
<main class="summary-index">
  <a class="summary-back" href="../">← Studyホーム</a>
  <header class="summary-index-hero"><p class="eyebrow">KNOT STUDY / TEXTBOOK LIBRARY</p><h1>要点まとめ</h1><p>ただ暗記するだけでなく、しくみ・理由・つながりまで理解する。<br>図解、比較表、重要語句を使って、知識を整理しよう。</p><div class="summary-index-stats"><div><strong>7</strong><span>教科・分野</span></div><div><strong>{assetsData.counts.total}</strong><span>図解・表・資料</span></div><div><strong>{foundationData.questions.length}</strong><span>重要語句・確認問題</span></div></div></header>
  <div class="index-section-head"><div><p>CHOOSE YOUR SUBJECT</p><h2>学習する分野を選ぶ</h2></div><span>読みたい単元から始められる</span></div>
  <section class="subject-grid">{subjects.map((s,i)=><a class="subject-card" href={s.key==='materials'?'./materials/':'./'+s.key+'/'}><span class="subject-no">{String(i+1).padStart(2,'0')}</span><span class="subject-label">{s.label}</span><h3>{s.title}</h3><p>{s.desc}</p><div class="subject-bottom"><span>{s.count} <small>項目</small></span><b>学習する →</b></div></a>)}</section>
  <section class="index-guide"><div><p class="eyebrow">HOW TO STUDY</p><h2>おすすめの使い方</h2></div><ol><li><b>まず読む</b><span>単元の図解・整理表で全体像をつかむ。</span></li><li><b>自分で説明する</b><span>重要語句を見て、意味や理由を声に出して説明する。</span></li><li><b>問題で確認する</b><span>基礎網羅問題に挑戦し、間違えた箇所を読み直す。</span></li></ol><a href="../foundation/">基礎網羅問題へ進む →</a></section>
  <footer class="summary-index-footer"><span>KNOT STUDY · LEARN WITH UNDERSTANDING</span><a href="../">Studyホームへ</a></footer>
</main>
<style>
.summary-index{max-width:1080px;margin:0 auto;padding:22px 0 55px}.summary-back{display:inline-flex;margin-bottom:18px;color:var(--muted);font-size:12px}.summary-index-hero{padding:clamp(28px,5vw,52px);border:1px solid var(--line);border-radius:23px;background:linear-gradient(125deg,color-mix(in srgb,var(--accent) 15%,var(--surface)),var(--surface))}.eyebrow,.index-section-head>div>p{font:9px ui-monospace,monospace;letter-spacing:.16em;color:var(--accent);font-weight:900}.summary-index-hero h1{font-size:clamp(38px,7vw,64px);letter-spacing:-.07em;margin:16px 0 10px}.summary-index-hero>p:not(.eyebrow){font-size:13px;line-height:2;color:var(--muted)}.summary-index-stats{display:flex;gap:10px;margin-top:25px}.summary-index-stats div{display:grid;gap:3px;padding:10px 15px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.summary-index-stats strong{font-size:22px}.summary-index-stats span{font-size:9px;color:var(--muted)}.index-section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin:35px 0 16px}.index-section-head>div>p{margin:0 0 6px}.index-section-head h2{font-size:23px;margin:0}.index-section-head>span{font-size:10px;color:var(--muted)}.subject-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.subject-card{position:relative;display:flex;flex-direction:column;min-height:210px;padding:18px;border:1px solid var(--line);border-radius:14px;background:var(--surface);transition:transform .18s,border-color .18s}.subject-card:hover{transform:translateY(-3px);border-color:var(--accent)}.subject-no{position:absolute;right:15px;top:13px;font:9px ui-monospace,monospace;color:var(--muted)}.subject-label{font:8px ui-monospace,monospace;letter-spacing:.12em;color:var(--accent)}.subject-card h3{font-size:23px;letter-spacing:-.04em;margin:19px 0 5px}.subject-card p{font-size:10px;line-height:1.7;color:var(--muted);margin:0}.subject-bottom{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:auto;padding-top:20px}.subject-bottom>span{font-size:13px;font-weight:850}.subject-bottom small{font-size:9px;color:var(--muted);font-weight:500}.subject-bottom b{font-size:9px;color:var(--accent)}.index-guide{display:grid;grid-template-columns:1fr 2fr auto;align-items:center;gap:22px;margin-top:28px;padding:22px;border:1px solid var(--line);border-radius:15px;background:var(--surface)}.index-guide h2{font-size:18px;margin:0}.index-guide .eyebrow{margin:0 0 6px}.index-guide ol{display:grid;gap:9px;margin:0;padding-left:20px}.index-guide li{padding-left:3px;font-size:10px}.index-guide li b{display:block;font-size:11px}.index-guide li span{color:var(--muted)}.index-guide>a{padding:12px 14px;border-radius:9px;background:var(--accent);color:#071426;font-size:10px;font-weight:900;white-space:nowrap}.summary-index-footer{display:flex;justify-content:space-between;margin-top:22px;padding-top:16px;border-top:1px solid var(--line);font:8px ui-monospace,monospace;color:var(--muted)}.summary-index-footer a{color:var(--accent)}
@media(max-width:850px){.subject-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.index-guide{grid-template-columns:1fr 2fr}.index-guide>a{grid-column:1/-1;justify-self:start}}@media(max-width:560px){.summary-index{padding-top:15px}.summary-index-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.summary-index-stats div{padding:9px}.summary-index-stats strong{font-size:18px}.subject-grid{gap:8px}.subject-card{min-height:190px;padding:13px}.subject-card h3{font-size:20px}.subject-card p{font-size:9px}.index-section-head{align-items:flex-start;flex-direction:column}.index-guide{grid-template-columns:1fr;gap:15px}.summary-index-footer{font-size:7px}}
</style>
</StudyLayout>