---
<Layout studyMode title="高専過去問 模試モード｜KNOT Study" description="国立高専機構が公開する入試過去問で模試に挑戦。">
<main class="mock-page">
<a class="back" href="../">← Studyに戻る</a>
<header><p class="eyebrow">KNOT / MOCK EXAM</p><h1>過去問で模試</h1><p>公式公開の高専入試問題を使って、本番を想定した演習に挑戦しよう。</p><span class="beta">STUDY β版</span></header>
<section class="setup" id="setup">
<h2>模試を設定</h2>
<div class="fields">
<label>年度<select id="year">{years.map(y=><option value={y.year}>{y.label}</option>)}</select></label>
<label>受験形式<select id="subject"><option value="all">5教科通し</option>{years[0].subjects.map(s=><option value={s.name}>{s.name}</option>)}</select></label>
<label>制限時間<select id="duration"><option value="250">5教科（250分）</option><option value="50">1教科（50分）</option><option value="none">時間制限なし</option></select></label>
</div>
<p class="hint">※時間は演習用の目安。実際の試験時間・休憩・実施要項は年度の公式案内を確認してください。</p>
<button id="begin">模試を開始する →</button>
</section>
<section class="exam" id="exam" hidden>
<div class="exam-head"><div><p class="eyebrow">EXAM IN PROGRESS</p><h2 id="exam-title">令和8年度 / 5教科</h2></div><div class="clock" id="clock">04:10:00</div></div>
<div class="timer-actions"><button id="pause" class="secondary">一時停止</button><button id="finish" class="finish">模試を終了する</button></div>
<div id="papers" class="papers"></div>
<p class="hint">問題はこの画面内のビューアで表示します。PDF単体のページには移動しません。</p><section class="ai-panel"><h3>わからない問題をAIに質問</h3><p>問題番号や疑問点を入力すると、問題の出典と一緒にChatGPTで質問できます。</p><textarea id="ai-question" rows="3" placeholder="例：数学の大問2（3）の解き方がわからない。途中式も含めて中学生向けに説明して。"></textarea><button id="ask-ai" type="button">この問題をAIに聞く ↗</button><p class="hint">質問内容はChatGPTに引き継がれます。PDFの内容そのものは自動送信されないため、問題文や必要な部分を入力してください。</p></section>
<div id="answers" hidden class="answers"><h3>解答・正解</h3><div id="answer-links"></div></div>
</section>
<section class="source"><strong>出典・著作権について</strong><p>問題・正解の掲載元は、独立行政法人 国立高等専門学校機構「入試過去問」です。KNOTは問題PDFを転載・再配布せず、公式公開ページへのリンクを提供しています。出典を記載するだけで著作物の複製・転載が自由になるわけではないため、問題本文は公式PDFで閲覧してください。</p><a href="https://www.kosen-k.go.jp/kosen_navi" target="_blank" rel="noopener noreferrer">国立高専機構・入試過去問（公式） ↗</a></section>
<p class="back"><a href="../kosen/">← 高専対策に戻る</a></p>
</main>
<script type="application/json" id="exam-data">{JSON.stringify(years)}</script>
<script>
const years=JSON.parse(document.getElementById('exam-data').textContent);
let pdfjsPromise;
async function getPdfjs(){
  if(!pdfjsPromise){
    pdfjsPromise=import('pdfjs-dist').then((lib)=>{
      lib.GlobalWorkerOptions.workerSrc = new URL('pdfjs-dist/build/pdf.worker.min.mjs', import.meta.url).href;
      return lib;
    });
  }
  return pdfjsPromise;
}
const $=id=>document.getElementById(id);let chosen=[],remaining=0,interval=null,paused=false,currentYear=null;
function fmt(n){const h=Math.floor(n/3600),m=Math.floor(n%3600/60),s=n%60;return [h,m,s].map(v=>String(v).padStart(2,'0')).join(':')}
function drawClock(){ $('clock').textContent=remaining===null?'∞':fmt(remaining);}
function stopTimer(){if(interval){clearInterval(interval);interval=null;}}
async function renderPdf(container,src,title){container.replaceChildren();const status=document.createElement('p');status.className='pdf-status';status.textContent='PDFを読み込んでいます…';container.append(status);const fallback=document.createElement('a');fallback.className='pdf-fallback';fallback.href=src;fallback.target='_blank';fallback.rel='noopener noreferrer';fallback.textContent='公式PDFを別タブで開く ↗';try{const pdfjsLib=await getPdfjs();let pdf;const candidates=[src,'https://corsproxy.io/?url='+encodeURIComponent(src),'https://api.allorigins.win/raw?url='+encodeURIComponent(src)];let lastError;for(const candidate of candidates){try{pdf=await pdfjsLib.getDocument({url:candidate,withCredentials:false}).promise;break;}catch(error){lastError=error;}}if(!pdf)throw lastError||new Error('PDFを取得できません');status.textContent=title+' · '+pdf.numPages+'ページ';for(let pageNo=1;pageNo<=pdf.numPages;pageNo++){const page=await pdf.getPage(pageNo);const viewport=page.getViewport({scale:1.35});const canvas=document.createElement('canvas');canvas.className='pdf-page';const context=canvas.getContext('2d');canvas.width=viewport.width;canvas.height=viewport.height;canvas.setAttribute('aria-label',title+' '+pageNo+'ページ');container.append(canvas);await page.render({canvasContext:context,viewport}).promise;} }catch(error){status.textContent='このPDFはブラウザ内で読み込めませんでした。公式PDFを開いてください。';container.append(fallback);console.warn('PDF.js load failed:',src,error);}}
function finish(){stopTimer();$('answers').hidden=false;$('answer-links').replaceChildren();chosen.forEach(s=>{const card=document.createElement('article');card.className='answer-paper';const h=document.createElement('h3');h.textContent=s.name+' 解答・正解';card.append(h);renderPdf(card,s.answer,s.name+' 解答');$('answer-links').append(card);});$('finish').disabled=true;$('pause').disabled=true;}
$('begin').addEventListener('click',()=>{
currentYear=years.find(y=>y.year===$('year').value);const subject=$('subject').value;
chosen=subject==='all'?currentYear.subjects:currentYear.subjects.filter(s=>s.name===subject);
if(!chosen.length)return;
$('exam-title').textContent=currentYear.label+' / '+(subject==='all'?'5教科':subject);
$('papers').replaceChildren();
chosen.forEach(s=>{const card=document.createElement('article');card.className='paper';const h=document.createElement('h3');h.textContent=s.name;const viewer=document.createElement('div');viewer.className='pdf-wrap';renderPdf(viewer,s.problem,s.name);card.append(h,viewer);$('papers').append(card);});
$('setup').hidden=true;$('exam').hidden=false;$('answers').hidden=true;$('finish').disabled=false;$('pause').disabled=false;
const duration=$('duration').value;remaining=duration==='none'?null:Number(duration)*60;paused=false;drawClock();stopTimer();
if(remaining!==null){interval=setInterval(()=>{if(paused)return;if(remaining>0){remaining--;drawClock();}else finish();},1000);}
});
$('pause').addEventListener('click',()=>{paused=!paused;$('pause').textContent=paused?'再開する':'一時停止';});
$('finish').addEventListener('click',finish);
$('ask-ai').addEventListener('click',()=>{const question=$('ai-question').value.trim();if(!question){$('ai-question').focus();return;}const context=chosen.map(s=>s.name+'：'+s.problem).join('\n');const prompt='次の高専入試過去問について、中学生にもわかるように段階的に解説してください。\n'+question+'\n\n出典PDF（公式）：\n'+context+'\n\n問題文はユーザーが必要に応じて追加します。';window.open('https://chatgpt.com/?q='+encodeURIComponent(prompt),'_blank','noopener,noreferrer');});
</script>
<style>
.mock-page{max-width:850px;margin:0 auto;padding:30px 0 55px}.back{font-size:12px;color:var(--accent)}header{position:relative;padding:30px 0 25px;border-bottom:1px solid var(--line)}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800;margin:0 0 10px}h1{font-size:clamp(32px,6vw,46px);letter-spacing:-.06em;margin:0;font-weight:900}header>p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.8}.beta{display:inline-block;font:10px ui-monospace,monospace;color:var(--accent);border:1px solid var(--line);border-radius:5px;padding:6px 8px}.setup,.exam,.source{margin-top:20px;padding:22px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}h2{font-size:19px;margin:0 0 17px}.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.fields label{display:grid;gap:6px;font-size:11px;color:var(--muted)}select{width:100%;padding:11px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text)}button{cursor:pointer;border:0;border-radius:9px;padding:12px 16px;background:var(--accent);color:white;font-size:12px;font-weight:800}.setup>button{margin-top:17px}.hint{font-size:10px;line-height:1.7;color:var(--muted);margin:13px 0 0}.exam[hidden],.answers[hidden]{display:none}.exam-head{display:flex;justify-content:space-between;align-items:center;gap:15px}.exam-head h2{margin:0}.clock{font:700 25px ui-monospace,monospace;font-variant-numeric:tabular-nums}.timer-actions{display:flex;gap:8px;margin:17px 0}.secondary{background:var(--surface-soft);color:var(--text);border:1px solid var(--line)}.finish{background:#b84c58}.papers{display:grid;grid-template-columns:1fr;gap:16px}.pdf-wrap{width:100%;height:min(78vh,900px);min-height:520px;background:#fff;border-radius:8px;overflow-y:auto;overflow-x:hidden}.pdf-page{display:block;width:100%;height:auto;margin:0 auto 12px;background:#fff;box-shadow:0 2px 12px #0002}.pdf-status{margin:8px;font-size:11px;color:var(--muted)}.pdf-fallback{display:inline-block;margin:10px;padding:10px;color:#1769aa;font-size:12px;font-weight:700;background:#fff;border-radius:7px}.ai-panel{margin-top:20px;padding:18px;border:1px solid var(--line);border-radius:10px;background:var(--surface-soft)}.ai-panel h3{margin:0 0 7px;font-size:15px}.ai-panel p{font-size:11px;color:var(--muted);line-height:1.7}.ai-panel textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text);font:inherit;resize:vertical}.ai-panel button{margin-top:10px}.answer-paper{width:100%;margin:12px 0}.answer-paper h3{font-size:14px}.answer-paper .pdf-wrap{height:70vh}.paper{padding:15px;border:1px solid var(--line);border-radius:9px;background:var(--bg)}.paper h3{font-size:14px;margin:0 0 8px}.paper a,.answers a,.source a{font-size:11px;color:var(--accent);font-weight:750}.answers{margin-top:20px;padding-top:18px;border-top:1px solid var(--line)}.answers h3{font-size:14px}.answers>div{display:flex;gap:12px;flex-wrap:wrap}.source strong{font-size:12px}.source p{font-size:11px;color:var(--muted);line-height:1.8}.source a{display:inline-block;margin-top:4px}@media(max-width:620px){.fields{grid-template-columns:1fr}.setup,.exam,.source{padding:17px}.papers{grid-template-columns:1fr}.pdf-wrap{min-height:420px;height:68vh}.clock{font-size:20px}}
</style>
</Layout>