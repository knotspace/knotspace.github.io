  {name:'社会',problem:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2025/02/02_2025_syakai_mondai.pdf',answer:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2025/02/02_2025_syakai_seikai.pdf'},
  {name:'数学',problem:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2025/02/03_2025_sugaku_mondai.pdf',answer:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2025/02/03_2025_sugaku_seikai.pdf'},
  {name:'理科',problem:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2025/02/04_2025_rika_mondai.pdf',answer:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2025/02/04_2025_rika_seikai.pdf'},
