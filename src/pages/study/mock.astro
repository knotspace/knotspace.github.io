  {name:'社会',problem:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/02_2026_syakai_mondai2.pdf',answer:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/02_2026_syakai_seikai.pdf'},
  {name:'数学',problem:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/03_2026_sugaku_mondai.pdf',answer:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/03_2026_sugaku_seikai.pdf'},
  {name:'理科',problem:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/04_2026_rika_mondai.pdf',answer:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/04_2026_rika_seikai.pdf'},
  {name:'英語',problem:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/05_2026_eigo_mondai.pdf',answer:'https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/05_2026_eigo_seikai.pdf'}
 ]},
