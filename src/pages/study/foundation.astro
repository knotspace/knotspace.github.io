---
import StudyLayout from '../../layouts/StudyLayout.astro';
import '../../styles/study/quiz-ui.css';
import bank from '../../data/study/study-foundation.json';
const science = bank.filter(q => q.subject === 'science').length;
const social = bank.filter(q => q.subject === 'social').length;
---
<StudyLayout title="基礎網羅問題｜KNOT Study" description="中学理科・社会の重要語句と基本事項を分野別に確認する基礎学習。">
<main class="foundation">
  <div class="top-links"><a class="back" href="../why/">学ぶ理由と大学生活を読む ↗</a><a class="back" href="../kosen/">高専入試対策 ↗</a><a class="back" href="../mock/">過去問模試 ↗</a></div>
  <header class="hero">
    <p class="eyebrow">KNOT STUDY / FOUNDATION</p>
    <h1>基礎網羅問題</h1>
    <p>理科と社会の大事な語句・基本知識を、分野ごとに確認しよう。</p>
    <div class="counts"><span><b>{bank.length}</b> 問収録</span><span><b>{science}</b> 理科</span><span><b>{social}</b> 社会</span><span><b>7</b> 分野</span></div>
  </header>
  <section class="panel" id="settings">
    <div class="section-head"><div><p class="eyebrow">START LEARNING</p><h2>学習内容を選ぶ</h2></div><span class="tag">基礎編 第1弾</span></div>
    <div class="filters">
      <label>教科<select id="subject"><option value="all">理科・社会</option><option value="science">理科</option><option value="social">社会</option></select></label>
      <label>分野<select id="topic"><option value="all">すべての分野</option></select></label>
      <label>問題数<select id="amount"><option value="10">10問</option><option value="20">20問</option><option value="all">全問</option><option value="wrong">苦手だけ</option><option value="review">今日の復習</option></select></label>
    </div>
    <div class="record"><div><small>解答数</small><strong id="total">0</strong></div><div><small>正解数</small><strong id="correctTotal">0</strong></div><div><small>苦手な語句</small><strong id="weakTotal">0</strong></div></div>
    <button class="primary" id="start">学習を始める <span>→</span></button>
    <p class="note">間違えた問題は「苦手だけ」からもう一度解けるよ。問題はこれからも追加していくね。</p>
  </section>
  <section class="panel quiz" id="quiz" hidden>
    
    <div class="shared-quiz-meta"><span id="foundationMeta"></span><b id="foundationProgress"></b></div><div class="shared-progress"><i id="foundationProgressBar"></i></div>
    <h2 id="prompt"></h2>
    <div class="answers" id="answers"></div>
    <div class="explanation" id="foundationExplanation" hidden aria-live="polite"></div>
    <div class="quiz-actions"><button class="secondary" id="quit">問題選択に戻る</button><button class="primary" id="next" disabled>次の問題</button></div>
  </section>
  <section class="panel result" id="result" hidden>
    <p class="eyebrow">SESSION COMPLETE</p><h2>おつかれさま！</h2>
    <p class="score"><strong id="score">0</strong><span> / <span id="max">0</span> 問正解</span></p><p id="resultMessage"></p>
    <div class="quiz-actions"><button class="secondary" id="backSettings">条件を変える</button><button class="primary" id="retry">もう一度解く</button></div>
  </section>
  <section class="coverage"><p class="eyebrow">LEARNING MAP</p><h2>収録分野</h2>
    <div class="topic-grid"><div><span>理科</span><b>物理</b><small>{bank.filter(q => q.topic === '物理').length}問</small></div><div><span>理科</span><b>化学</b><small>{bank.filter(q => q.topic === '化学').length}問</small></div><div><span>理科</span><b>生物</b><small>{bank.filter(q => q.topic === '生物').length}問</small></div><div><span>理科</span><b>地学</b><small>{bank.filter(q => q.topic === '地学').length}問</small></div><div><span>社会</span><b>地理</b><small>{bank.filter(q => q.topic === '地理').length}問</small></div><div><span>社会</span><b>歴史</b><small>{bank.filter(q => q.topic === '歴史').length}問</small></div><div><span>社会</span><b>公民</b><small>{bank.filter(q => q.topic === '公民').length}問</small></div></div>
  </section>
</main>
<script>
import bank from '../../data/study/study-foundation.json';
const $ = id => document.getElementById(id);
const KEY = 'knot-foundation-v1';
let record = { answered: 0, correct: 0, wrong: [], review: {} }, questions = [], index = 0, score = 0, selected = false, lastConfig = null;
try { const saved = JSON.parse(localStorage.getItem(KEY) || 'null'); if (saved && typeof saved === 'object') { record.answered = Number.isFinite(saved.answered) ? saved.answered : 0; record.correct = Number.isFinite(saved.correct) ? saved.correct : 0; record.wrong = Array.isArray(saved.wrong) ? saved.wrong.filter(x => typeof x === 'string') : []; record.review = saved.review && typeof saved.review === 'object' ? saved.review : {}; } } catch {}
function save() { try { localStorage.setItem(KEY, JSON.stringify(record)); } catch {} }
function updateRecord() { $('total').textContent = record.answered; $('correctTotal').textContent = record.correct; $('weakTotal').textContent = record.wrong.length; }
function fillTopics() { const subject = $('subject').value, select = $('topic'), previous = select.value; select.replaceChildren(new Option('すべての分野', 'all')); [...new Set(bank.filter(q => subject === 'all' || q.subject === subject).map(q => q.topic))].forEach(topic => select.add(new Option(topic, topic))); if ([...select.options].some(option => option.value === previous)) select.value = previous; }
$('subject').addEventListener('change', fillTopics); fillTopics(); updateRecord();
function enterQuizMode() { document.documentElement.classList.add('quiz-active'); }
function leaveQuizMode() { document.documentElement.classList.remove('quiz-active'); }
function start() { lastConfig = { subject: $('subject').value, topic: $('topic').value, amount: $('amount').value }; let pool = bank.filter(q => (lastConfig.subject === 'all' || q.subject === lastConfig.subject) && (lastConfig.topic === 'all' || q.topic === lastConfig.topic)); if (lastConfig.amount === 'wrong') pool = pool.filter(q => record.wrong.includes(q.id)); if (lastConfig.amount === 'review') pool = pool.filter(q => Number(record.review[q.id]?.due || 0) <= Date.now() && record.review[q.id]); if (!pool.length) { alert('この条件の問題はまだありません。別の分野を選んでね。'); return; } pool = [...pool].sort(() => Math.random() - .5); if (lastConfig.amount !== 'all' && lastConfig.amount !== 'wrong' && lastConfig.amount !== 'review') pool = pool.slice(0, Number(lastConfig.amount)); enterQuizMode(); questions = pool; index = 0; score = 0; $('settings').hidden = true; $('result').hidden = true; $('quiz').hidden = false; render(); }
function render() { selected = false; const q = questions[index]; $('prompt').textContent = q.prompt; $('foundationMeta').textContent = (q.subject === 'science' ? '理科' : '社会') + ' / ' + q.topic; $('foundationProgress').textContent = (index + 1) + ' / ' + questions.length; $('foundationProgressBar').style.width = (index / questions.length * 100) + '%'; $('foundationExplanation').hidden = true; $('answers').replaceChildren(); $('next').disabled = true; $('next').textContent = index === questions.length - 1 ? '結果を見る' : '次の問題'; q.options.forEach((option, i) => {
  const palette = {
    bg: getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-bg').trim() || '#e8efff',
    border: getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-border').trim() || '#9bb8ed',
    ink: getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-ink').trim() || '#243b61',
    chip: getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-chip').trim() || '#d1e0ff'
  };
  const button = document.createElement('button');
  button.type = 'button';
  button.className = 'answer';
  button.style.setProperty('background', palette.bg, 'important');
  button.style.setProperty('border', '2px solid ' + palette.border, 'important');
  button.style.setProperty('border-radius', '18px', 'important');
  button.style.setProperty('color', palette.ink, 'important');
  button.style.setProperty('box-shadow', '0 4px 0 ' + palette.border, 'important');
  button.style.setProperty('font-weight', '700');
  button.style.setProperty('justify-content', 'flex-start');
  button.style.setProperty('padding', '18px 20px');
  button.style.setProperty('transition', 'transform .15s, box-shadow .15s');
  const letter = document.createElement('span');
  letter.className = 'letter';
  letter.textContent = ['A','B','C','D'][i];
  letter.style.setProperty('width', '34px');
  letter.style.setProperty('height', '34px');
  letter.style.setProperty('display', 'grid');
  letter.style.setProperty('place-items', 'center');
  letter.style.setProperty('flex', '0 0 34px');
  letter.style.setProperty('border-radius', '12px');
  letter.style.setProperty('background', palette.chip, 'important');
  letter.style.setProperty('color', palette.ink, 'important');
  letter.style.setProperty('font-weight', '800');
  const label = document.createElement('span');
  label.textContent = option;
  label.style.setProperty('text-align', 'left');
  label.style.setProperty('line-height', '1.55');
  button.append(letter, label);
  button.addEventListener('mouseenter', () => { if (!button.disabled) { button.style.transform = 'translateY(-2px)'; button.style.boxShadow = '0 6px 0 ' + palette.border; } });
  button.addEventListener('mouseleave', () => { button.style.transform = ''; button.style.boxShadow = '0 4px 0 ' + palette.border; });
  button.addEventListener('click', () => choose(i));
  $('answers').append(button);
}); }
function celebrateCorrect() { const toast=document.createElement('div'); toast.className='correct-toast'; toast.innerHTML='<span class="sparkle">✦</span><strong>正解！</strong><small>その調子！</small>'; document.body.append(toast); const colors=['#ffd166','#6ee7b7','#93c5fd','#f9a8d4']; for(let i=0;i<18;i++){const bit=document.createElement('i');bit.className='confetti-bit';bit.style.setProperty('--x',(Math.random()*100-50)+'vw');bit.style.setProperty('--r',(Math.random()*720-360)+'deg');bit.style.setProperty('--delay',(Math.random()*.18)+'s');bit.style.setProperty('--color',colors[i%colors.length]);document.body.append(bit);setTimeout(()=>bit.remove(),1250);} setTimeout(()=>toast.remove(),1150); }
function choose(choice) { if (selected) return; selected = true; const q = questions[index], isCorrect = choice === q.correct; if (isCorrect) { score++; record.correct++; record.wrong = record.wrong.filter(id => id !== q.id); } else if (!record.wrong.includes(q.id)) record.wrong.push(q.id); const previous = record.review[q.id] || { stage: 0 }; const intervals = [1, 3, 7, 14, 30]; const stage = isCorrect ? Math.min(4, (previous.stage || 0) + 1) : 0; const days = isCorrect ? intervals[stage - 1] : 1; record.review[q.id] = { stage, due: Date.now() + days * 86400000, updated: Date.now() }; record.answered++; save(); updateRecord(); if (isCorrect) celebrateCorrect(); [...$('answers').children].forEach((button, i) => { button.disabled = true; if (i === q.correct) { button.classList.add('correct'); button.style.setProperty('background', '#DDF7E7', 'important'); button.style.setProperty('border', '2px solid #35A66A', 'important'); button.style.setProperty('color', '#185B36', 'important'); button.style.setProperty('box-shadow', 'none', 'important'); } else if (i === choice) { button.classList.add('incorrect'); button.style.setProperty('background', '#FFE5E7', 'important'); button.style.setProperty('border', '2px solid #DF5964', 'important'); button.style.setProperty('color', '#842B35', 'important'); button.style.setProperty('box-shadow', 'none', 'important'); } else { button.style.setProperty('opacity', '.58'); button.style.setProperty('box-shadow', 'none', 'important'); } }); const explanation = $('foundationExplanation'); explanation.replaceChildren(); const heading = document.createElement('strong'); heading.textContent = isCorrect ? '正解！' : '不正解'; const detail = document.createElement('p'); detail.textContent = q.explanation || '解説は準備中です。'; explanation.append(heading, detail); if (q.link) { const link = document.createElement('a'); link.href = q.link; link.className = 'summary-link'; link.textContent = '関連する要点まとめを見る →'; explanation.append(link); } explanation.hidden = false; $('next').disabled = false; }
function finish() { leaveQuizMode(); $('foundationProgressBar').style.width = '100%'; $('quiz').hidden = true; $('result').hidden = false; $('score').textContent = score; $('max').textContent = questions.length; $('resultMessage').textContent = score === questions.length ? '全問正解！この調子で次の分野も進めよう。' : '間違えた語句は「苦手だけ」から復習できるよ。'; }
$('start').addEventListener('click', start); $('next').addEventListener('click', () => { if (!selected) return; if (index === questions.length - 1) finish(); else { index++; render(); } }); $('quit').addEventListener('click', () => { leaveQuizMode(); $('quiz').hidden = true; $('settings').hidden = false; }); $('backSettings').addEventListener('click', () => { $('result').hidden = true; $('settings').hidden = false; }); $('retry').addEventListener('click', () => { $('result').hidden = true; $('settings').hidden = false; if (lastConfig) { $('subject').value = lastConfig.subject; fillTopics(); $('topic').value = lastConfig.topic; $('amount').value = lastConfig.amount; } start(); });
</script>
<style>
.correct-toast{position:fixed;z-index:3000;left:50%;top:18%;transform:translate(-50%,-12px) scale(.7);display:grid;justify-items:center;gap:2px;padding:15px 25px;border-radius:18px;background:#fff;color:#16834e;box-shadow:0 12px 45px #0003;animation:toast-pop .9s cubic-bezier(.2,1.5,.4,1) forwards;pointer-events:none}.correct-toast .sparkle{font-size:26px;animation:sparkle-spin .7s ease-out}.correct-toast strong{font-size:23px;font-weight:950}.correct-toast small{font-size:10px;color:#398b66}.confetti-bit{position:fixed;z-index:2999;left:50%;top:25%;width:9px;height:13px;border-radius:2px;background:var(--color);pointer-events:none;animation:confetti-fly 1.1s ease-out var(--delay) forwards}@keyframes toast-pop{0%{opacity:0;transform:translate(-50%,15px) scale(.55)}45%{opacity:1;transform:translate(-50%,-8px) scale(1.08)}100%{opacity:0;transform:translate(-50%,-42px) scale(.95)}}@keyframes sparkle-spin{to{transform:rotate(180deg) scale(1.35)}}@keyframes confetti-fly{to{opacity:0;transform:translate(var(--x),65vh) rotate(var(--r))}}
.foundation{max-width:880px;margin:0 auto;padding:28px 0 55px}.back{font-size:12px;color:var(--muted)}.hero{padding:42px 0 30px}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800}.hero h1{font-size:clamp(32px,6vw,48px);letter-spacing:-.06em;margin:12px 0}.hero>p:not(.eyebrow){color:var(--muted);font-size:13px;line-height:1.9}.counts{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.counts span,.tag{font-size:11px;padding:8px 11px;border:1px solid var(--line);border-radius:8px;color:var(--muted)}.counts b{color:var(--text)}.panel{background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:24px;margin-top:16px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.section-head h2,.coverage h2{font-size:19px;margin:5px 0 20px}.section-head .eyebrow{margin:0}.filters{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.filters label{display:grid;gap:7px;font-size:11px;color:var(--muted)}.filters select{width:100%;padding:11px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text);font:inherit}.record{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:20px 0}.record div{background:var(--surface-soft);border-radius:9px;padding:12px}.record small{display:block;font-size:10px;color:var(--muted)}.record strong{font-size:23px}.primary,.secondary{border:0;border-radius:8px;padding:12px 17px;font:700 12px system-ui;cursor:pointer}.primary{background:var(--accent);color:white}.primary span{margin-left:15px}.secondary{background:var(--surface-soft);border:1px solid var(--line);color:var(--text)}.note{font-size:10px;line-height:1.8;color:var(--muted);margin:13px 0 0}.quiz-meta,.quiz-actions{display:flex;align-items:center;justify-content:space-between;gap:12px}.quiz-meta{font-size:11px;color:var(--muted)}.progress{height:6px;border-radius:8px;background:var(--line);overflow:hidden;margin:14px 0 28px}.progress i{display:block;height:100%;width:0;background:var(--accent);transition:width .2s}.term-label{font-size:11px;color:var(--muted)}.quiz h2{font-size:clamp(18px,3vw,23px);line-height:1.8;margin:8px 0 22px}.answers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(2,minmax(76px,auto));gap:12px}.answer{display:flex;align-items:center;gap:12px;text-align:left;min-width:0;min-height:76px;padding:15px 16px;border:1px solid var(--line);border-radius:14px;background:var(--bg);color:var(--text);font:inherit;font-size:13px;line-height:1.6;cursor:pointer;transition:border-color .15s,background .15s,transform .15s}.answer:not(:disabled):hover{transform:translateY(-2px);filter:saturate(1.12)}.answer:disabled{cursor:default}:root{--quiz-answer-bg:#26364f;--quiz-answer-border:#526b91;--quiz-answer-ink:#f4f7ff;--quiz-answer-chip:#405779}
html[data-theme="light"]{--quiz-answer-bg:#e8efff;--quiz-answer-border:#a9c0ed;--quiz-answer-ink:#243b61;--quiz-answer-chip:#d1e0ff}
.answer{border-radius:18px;box-shadow:0 4px 0 var(--quiz-answer-border)}
.letter{background:var(--quiz-answer-chip);border-radius:12px;color:var(--quiz-answer-ink)}
.answer.correct,.answer.correct:disabled{background-color:#d9f7e5!important;border:2px solid #28a36a!important;color:#185b36!important}
.answer.incorrect,.answer.incorrect:disabled{background-color:#ffe1e3!important;border:2px solid #d94c59!important;color:#842b35!important}
.explanation{margin-top:17px;padding:15px;border-radius:9px;background:var(--surface-soft);line-height:1.8}.explanation p{font-size:12px;color:var(--muted);margin:6px 0 0}.quiz-actions{margin-top:20px}.score strong{font-size:48px}.score span{font-size:13px;color:var(--muted)}.result{text-align:center}.coverage{margin-top:42px}.coverage .eyebrow{margin-bottom:8px}.topic-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.topic-grid div{display:grid;gap:5px;padding:13px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.topic-grid span,.topic-grid small{font-size:10px;color:var(--muted)}.topic-grid b{font-size:13px}.quiz[hidden],.result[hidden]{display:none!important}
@media(max-width:620px){.foundation{padding:22px 0 40px}.panel{padding:17px}.filters{grid-template-columns:1fr}.answers{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(2,minmax(82px,auto));gap:9px}.answer{min-height:82px;padding:11px 10px;gap:8px;font-size:12px;border-radius:13px}.letter{width:24px;height:24px}.topic-grid{grid-template-columns:repeat(2,1fr)}.hero{padding:30px 0 20px}}
.top-links{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:12px}.top-links .back{font-size:11px}</style>
<style is:global>
:root{--quiz-answer-bg:#26364f;--quiz-answer-border:#526b91;--quiz-answer-ink:#f4f7ff;--quiz-answer-chip:#405779}
html[data-theme="light"]{--quiz-answer-bg:#e8efff;--quiz-answer-border:#a9c0ed;--quiz-answer-ink:#243b61;--quiz-answer-chip:#d1e0ff}
</style>

<style is:global>
html.quiz-active,html.quiz-active body{width:100%;height:100%;overflow:hidden}
html.quiz-active body{background:var(--bg)!important}
html.quiz-active .site-shell{width:100%;max-width:none;margin:0;padding:0}
html.quiz-active .site-header,html.quiz-active .site-footer{display:none!important}
html.quiz-active body main{min-height:100vh;height:100vh}
html.quiz-active .foundation{width:100%;max-width:820px;height:100vh;margin:0 auto;padding:clamp(18px,4vh,48px) clamp(16px,4vw,52px);display:flex;align-items:center;justify-content:center}
html.quiz-active .foundation>.back,html.quiz-active .foundation>.hero,html.quiz-active .foundation>#settings,html.quiz-active .foundation>.coverage,html.quiz-active .foundation>#result{display:none!important}
html.quiz-active #quiz{width:100%;margin:0;padding:clamp(22px,4vw,48px);border-radius:24px;display:flex;flex-direction:column;justify-content:center;gap:clamp(18px,3vh,30px)}
html.quiz-active #quiz[hidden]{display:none!important}
html.quiz-active #prompt{font-size:clamp(22px,3.2vw,36px);line-height:1.65;margin:0 0 4px}
html.quiz-active #answers{width:100%;gap:clamp(12px,1.8vw,20px)}
html.quiz-active #answers>.answer{min-height:clamp(86px,13vh,132px);padding:clamp(16px,2vw,25px);font-size:clamp(15px,1.5vw,19px);border-radius:22px!important}
html.quiz-active .quiz-actions{margin:0}
html.quiz-active #next,html.quiz-active #quit{min-height:52px;padding:14px 24px;border-radius:14px;font-size:14px}
@media(max-width:620px){html.quiz-active .foundation{padding:12px}html.quiz-active #quiz{padding:18px 14px;border-radius:18px;gap:18px}html.quiz-active #answers{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(2,minmax(100px,auto));gap:9px}html.quiz-active #answers>.answer{min-height:100px;padding:12px 10px;gap:8px;border-radius:16px!important;font-size:13px}html.quiz-active #prompt{font-size:21px;line-height:1.6}html.quiz-active #next,html.quiz-active #quit{padding:12px 13px;font-size:12px}}
</style>



</StudyLayout>
<style is="global">
@media(max-width:620px){
  html.quiz-active,html.quiz-active body{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important}
  html.quiz-active body main{height:auto!important;min-height:100dvh!important}
  html.quiz-active .foundation{height:auto!important;min-height:100dvh!important;display:block!important;padding:14px 12px calc(24px + env(safe-area-inset-bottom))!important}
  html.quiz-active #quiz{width:100%;min-height:calc(100dvh - 28px);height:auto!important;max-height:none!important;overflow:visible!important;display:flex!important;justify-content:flex-start!important;gap:18px!important;padding:20px 15px!important;margin:0!important}
  html.quiz-active #answers{display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:none!important;gap:11px!important}
  html.quiz-active #answers>.answer{width:100%;min-height:76px!important;height:auto!important;padding:15px 14px!important;border-radius:18px!important;font-size:15px!important;line-height:1.55!important;gap:12px!important}
  html.quiz-active #answers>.answer .letter{width:34px!important;height:34px!important;flex:0 0 34px!important;border-radius:11px!important;font-size:13px!important}
  html.quiz-active #prompt{font-size:clamp(19px,5vw,23px)!important;line-height:1.65!important;overflow-wrap:anywhere}
  html.quiz-active .quiz-actions{position:sticky;bottom:0;background:var(--surface);padding:10px 0 max(8px,env(safe-area-inset-bottom));z-index:5}
  html.quiz-active #next,html.quiz-active #quit{min-height:48px!important}
}
</style>
