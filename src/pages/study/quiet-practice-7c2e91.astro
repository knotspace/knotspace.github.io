---
import StudyLayout from '../../layouts/StudyLayout.astro';
import '../../styles/study/quiz-ui.css';
import questionsData from '../../data/study/private-practice-bank.json';
import pastQuestionsData from '../../data/study/private-past-bank.json';
import mathBetaData from '../../data/study/private-math-beta.json';
const questions = questionsData.questions;
const pastQuestions = [...pastQuestionsData.questions, ...mathBetaData.questions];
const regularQuestions = questions;
const topics = [...new Set(regularQuestions.map(q => q.topic))];
---
<StudyLayout title="高専絶対合格｜KNOT Study" description="高専入試に向けた個人用学習アプリ。基本対策・過去問演習・数学β版。" noindex={true} manifestUrl="/study/kosen-absolute.webmanifest">
<main class="private-practice-page is-locked">
  <section class="secret-gate" id="secret-gate">
    <a class="back" href="../">← Studyに戻る</a>
    <div class="secret-gate-card">
      <div class="secret-lock-icon">⌑</div>
      <p class="eyebrow">KNOT STUDY / PRIVATE</p>
      <h1>秘密モード</h1>
      <p>パスワードを入力して、特別な演習を始めよう。</p>
      <form id="secret-login">
        <label for="secret-password">パスワード</label>
        <input id="secret-password" type="password" autocomplete="current-password" placeholder="パスワードを入力" required>
        <button type="submit">ロックを解除する <span>→</span></button>
        <p id="secret-error" role="alert" aria-live="polite"></p>
      </form>
    </div>
  </section>
  <script is:inline>
    (() => {
      const root = document.querySelector('.private-practice-page');
      const gate = document.getElementById('secret-gate');
      const form = document.getElementById('secret-login');
      const input = document.getElementById('secret-password');
      const error = document.getElementById('secret-error');
      const PASSWORD = 'kosen';
      const KEY = 'knot-study-secret-unlocked';
      const unlock = () => { root.classList.remove('is-locked'); gate.remove(); window.dispatchEvent(new Event('knot-secret-unlocked')); };
      try { if (sessionStorage.getItem(KEY) === '1') unlock(); } catch {}
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (input.value === PASSWORD) {
          try { sessionStorage.setItem(KEY, '1'); } catch {}
          unlock();
        } else {
          error.textContent = 'パスワードが違うよ。もう一度入力してね。';
          input.value = '';
          input.focus();
        }
      });
    })();
  </script>
  <a class="back" href="../">← Studyに戻る</a>
  <header class="hero">
    <p class="eyebrow">KNOT / ADVANCED PRACTICE</p>
    <div class="hero-row"><div><h1>高専絶対合格</h1><p>今日の一問が、未来の実験・開発・ものづくりにつながる。</p></div><span class="live">PRACTICE 01</span></div>
    <div class="hero-stats"><div><strong>{regularQuestions.length}</strong><small>5教科の演習問題</small></div><div><strong>{topics.length}</strong><small>出題テーマ</small></div><div><strong>5教科</strong><small>国・数・英・理・社</small></div></div>
  </header>
  <section class="kosen-motivation" id="kosen-motivation">
    <div class="motivation-head"><div><p class="eyebrow">YOUR KOSEN JOURNEY</p><h2>高専で挑戦する未来へ。</h2><p>プログラミング、実験、ロボット、研究。学びたいことを、今日の積み重ねにつなげよう。</p></div><span class="motivation-mark">KOSEN<br>GOAL</span></div>
    <div class="motivation-stats"><div><small>累計解答</small><strong id="kosen-total">0</strong><span>問</span></div><div><small>正答率</small><strong id="kosen-rate">—</strong><span>%</span></div><div><small>連続学習</small><strong id="kosen-streak">0</strong><span>日</span></div></div>
    <div class="motivation-goal"><div><b>今日のミッション</b><span id="kosen-daily-label">0 / 10 問</span></div><div class="motivation-track"><i id="kosen-daily-progress"></i></div><small>まずは10問。終わったら、もう一段先へ。</small></div>
    <div class="motivation-milestones"><b>積み上げバッジ</b><div class="milestone-list"><span data-threshold="10">10問 / FIRST STEP</span><span data-threshold="50">50問 / CONTINUE</span><span data-threshold="100">100問 / BUILDER</span><span data-threshold="250">250問 / CHALLENGER</span><span data-threshold="500">500問 / KOSEN SPIRIT</span></div></div>
    <div class="motivation-vision"><strong>高専に入った自分を想像してみよう。</strong><p>授業で学んだ理論を実験で確かめる。自分のアイデアをプログラムや装置にする。仲間と試行錯誤しながら、まだ形のないものをつくっていく。その未来に近づくための一日を、ここから始めよう。</p></div>
  </section>
  <section class="kosen-pwa-card" id="kosen-pwa-card" hidden><div><p class="eyebrow">YOUR STUDY APP</p><strong>「高専絶対合格」をアプリに。</strong><p>ログイン済みのこのページから、ブラウザのインストール案内を使ってホーム画面に追加できるよ。</p></div><span>INSTALL AFTER LOGIN</span></section>
  <section class="mode-picker" id="mode-picker" aria-label="学習モード選択">
    <p class="eyebrow">CHOOSE YOUR MODE</p>
    <h2>学習モードを選択</h2>
    <div class="mode-cards">
      <button type="button" class="mode-card" data-mode="practice">
        <span class="mode-index">01 / FOUNDATION</span><strong>高専基本対策モード</strong>
        <span>4択中心。計算量が少ない知識・理解・資料読解問題で、入試頻出分野を効率よく固める。</span><b>基本対策を始める →</b>
      </button>
      <button type="button" class="mode-card" data-mode="exam">
        <span class="mode-index">02 / PAST EXAM</span><strong>過去問モード</strong>
        <span>本番を意識した大問単位の演習。令和7・8年度の数学は大問2〜4も含むβ版を収録。</span><b>過去問演習を始める →</b>
      </button>
    </div>
    <p class="mode-note">※過去問モードは現在、令和7・8年度の出題内容を参考にした再構成問題を収録。公式問題冊子の完全再現ではありません。</p>
  </section>
  <div class="beta-banner"><b>β版</b><div><strong>高専基本対策・過去問演習</strong><p>高専基本対策モードは計算量を抑えた4択問題中心。過去問モードは年度・教科を選び、過去問の出題内容を参考にした再構成問題を大問単位で解ける。</p></div></div>
  <section class="source-note" id="source-note" hidden><div><strong>問題の方針</strong><p>難度の高い入試で問われる、複数の情報を組み合わせる力・統計や地図を読み取る力を意識したオリジナル問題。過去問の文章や選択肢をそのまま転載せず、出題テーマを参考に作成している。</p><p>令和7・8年度の問題冊子を分析し、出題分野・問い方を参考にした再構成問題を収録。原本の問題文・図表とKNOTのオリジナル問題は区別して表示する。</p>
  <p class="data-sources"><strong>資料データの出典</strong><br><a href="/study-data/資料ダウンロード一覧.md" target="_blank" rel="noopener noreferrer">理科・社会の公的資料ダウンロード一覧 ↗</a><br><br><a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener noreferrer">国土地理院・地理院タイル（地形図・土地条件図） ↗</a><br><a href="https://www.data.jma.go.jp/risk/obsdl/" target="_blank" rel="noopener noreferrer">気象庁・過去の気象データ（CSVダウンロード） ↗</a></p>
  <small class="figure-credit">図版：KNOTオリジナル模式図。実際の地形図・観測値ではなく、地形や自然現象の読み取り練習用に作成。</small></div></section>
  <section class="workspace" id="workspace" hidden>
    <div class="toolbar"><div><p class="eyebrow">QUESTION SET</p><h2 id="workspace-title">演習を始める</h2></div><div class="filters"><label>教科<select id="subject"><option value="全教科">5教科すべて</option><option value="理科">理科のみ</option><option value="社会">社会のみ</option><option value="数学">数学のみ</option><option value="英語">英語のみ</option><option value="国語">国語のみ</option><option value="理社ミックス">理社ミックス</option></select></label><label id="exam-year-label" hidden>年度<select id="exam-year"><option value="all">すべての年度</option><option value="令和8年度">令和8年度</option><option value="令和7年度">令和7年度</option></select></label><label id="topic-label">分野<select id="topic"><option value="all">すべての分野</option></select></label><label id="amount-label">問題数<select id="amount"><option value="10">10問</option><option value="20">20問</option><option value="all">全問</option><option value="wrong">苦手だけ</option></select></label><label id="level-label">難易度<select id="level"><option value="all">すべて</option><option value="標準">標準</option><option value="発展">発展</option></select></label><label hidden>モード<select id="mode"><option value="practice">高専基本対策モード</option><option value="exam">過去問モード（大問単位）</option></select></label></div></div>
    <p class="math-beta-note" id="math-beta-note" hidden><b>MATHEMATICS β版</b> 令和7・8年度の数学・大問1〜4を読み込み、標準的な小問から四択化。図形・関数・規則性の問題を順次追加中。</p>
    <div class="history"><span>累計 <b id="total">0</b> 問</span><span>正解 <b id="correct">0</b> 問</span><span>正答率 <b id="rate">—</b></span></div>
    <button class="start" id="start">演習を開始する <span>→</span></button>
  </section>
  <section class="quiz" id="quiz" hidden>
    <div class="quiz-meta shared-quiz-meta"><span id="meta"></span><span id="timer" class="exam-timer" hidden></span><b id="progressText"></b></div><div class="progress shared-progress"><i id="progress"></i></div>
    <div class="paper-tools"><button type="button" id="read-paper" class="secondary">この大問の収録問題を見る ↗</button></div>
    <h2 id="question"></h2><figure class="question-figure" id="question-figure" hidden><img id="question-image" alt=""><figcaption id="question-caption"></figcaption></figure><div id="question-diagram" class="question-diagram" hidden></div><div class="choices answers" id="choices"></div>
    <div class="explanation" id="explanation" hidden aria-live="polite"></div>
    <div class="quiz-actions"><button id="quit" class="secondary">中断する</button><button id="prev" class="secondary" disabled>← 前へ</button><button id="next" class="start" disabled>次の問題 →</button></div>
  </section>
  <div class="paper-modal" id="paper-modal" hidden><div class="paper-backdrop" data-paper-close></div><section class="paper-dialog" role="dialog" aria-modal="true" aria-labelledby="paper-title"><header><div><p class="eyebrow">PAST QUESTION / READING</p><h2 id="paper-title">大問内の収録問題</h2></div><button type="button" id="close-paper" class="secondary">閉じる ×</button></header><p class="paper-instruction" id="paper-instruction"></p><div id="paper-content" class="paper-content"></div></section></div>
  <section class="result" id="result" hidden><p class="eyebrow">YOUR RESULT</p><h2>演習終了！</h2><div class="score"><strong id="score">0</strong><span> / <span id="max">0</span> 問正解</span></div><p id="resultMessage"></p><div id="review" class="review-list" hidden></div><button class="start" id="retry">もう一度解く →</button></section>
  <footer class="note">※過去問モードには、令和7・8年度の出題内容を参考にした再構成問題39問を収録。数学は大問1〜4を読み込んだβ版。原本の問題文・図表は公開リポジトリへ転載せず、出題意図を保った四択再構成問題として掲載。</footer>
</main>
<script>
import bank from '../../data/study/private-practice-bank.json';
import pastBankData from '../../data/study/private-past-bank.json';
import mathBeta from '../../data/study/private-math-beta.json';
const pastBank = [...pastBankData.questions, ...mathBeta.questions];
import diagramBank from '../../data/study/knot-diagrams.json';
const $=id=>document.getElementById(id), KEY='knot-private-practice-record-v1';
let record={answered:0,correct:0,wrong:[]},set=[],index=0,score=0,locked=false,lastConfig=null,mode='practice',answers=[],timerHandle=null,deadline=0;
try{const v=JSON.parse(localStorage.getItem(KEY)||'null');if(v&&Number.isFinite(v.answered)&&Number.isFinite(v.correct)){record={answered:v.answered,correct:v.correct,wrong:Array.isArray(v.wrong)?v.wrong.filter(x=>typeof x==='string'):[]};}}catch{}
function save(){try{localStorage.setItem(KEY,JSON.stringify(record));}catch{}}
function markDailyAnswer(){try{const key='knot-study-daily-v1',today=new Date(),date=[today.getFullYear(),String(today.getMonth()+1).padStart(2,'0'),String(today.getDate()).padStart(2,'0')].join('-'),saved=JSON.parse(localStorage.getItem(key)||'null')||{};if(saved.date===date){saved.answered=(Number(saved.answered)||0)+1;}else{const yesterday=new Date(today.getFullYear(),today.getMonth(),today.getDate()-1),yesterdayKey=[yesterday.getFullYear(),String(yesterday.getMonth()+1).padStart(2,'0'),String(yesterday.getDate()).padStart(2,'0')].join('-');saved.streak=saved.lastDate===yesterdayKey?(Number(saved.streak)||0)+1:1;saved.lastDate=date;saved.date=date;saved.answered=1;}localStorage.setItem(key,JSON.stringify(saved));const pkey='knot-private-daily-v1',privateDaily=JSON.parse(localStorage.getItem(pkey)||'null')||{};if(privateDaily.date===date){privateDaily.answered=(Number(privateDaily.answered)||0)+1;}else{const yesterday=new Date(today.getFullYear(),today.getMonth(),today.getDate()-1),yesterdayKey=[yesterday.getFullYear(),String(yesterday.getMonth()+1).padStart(2,'0'),String(yesterday.getDate()).padStart(2,'0')].join('-');privateDaily.streak=privateDaily.lastDate===yesterdayKey?(Number(privateDaily.streak)||0)+1:1;privateDaily.lastDate=date;privateDaily.date=date;privateDaily.answered=1;}localStorage.setItem(pkey,JSON.stringify(privateDaily));}catch{}}
function updateMathBetaNote(){const note=$('math-beta-note');if(note)note.hidden=$('subject').value!=='数学';}
function syncSubjects(){const select=$('subject'),previous=select.value;const subjects=$('mode').value==='exam'?['理科','社会','数学','理社ミックス']:['全教科','理科','社会','数学','英語','国語','理社ミックス'];select.replaceChildren(...subjects.map(s=>new Option(s==='数学'?'数学（β版）':s,s)));select.value=subjects.includes(previous)?previous:(subjects[0]);$('amount-label').hidden=$('mode').value==='exam';$('topic-label').hidden=$('mode').value==='exam';$('level-label').hidden=$('mode').value==='exam';$('exam-year-label').hidden=$('mode').value!=='exam';fillTopics();updateMathBetaNote();}
function isBasicEligible(q){
 const text=(String(q.topic||'')+' '+String(q.q||''));
 return !/(二次方程式|連立方程式|関数|確率|平方根|仕事率|電力量|オームの法則|濃度|中和の計算|地震の到着時刻|速さの計算|時差の計算|比例式)/.test(text);
}
function subjectMatches(q,subject){return subject==='全教科'||subject==='理社ミックス'&&['理科','社会'].includes(q.subject)||q.subject===subject;}
function fillTopics(){const subject=$('subject').value,select=$('topic'),previous=select.value,source=$('mode').value==='exam'?pastBank:bank;select.replaceChildren(new Option('すべての分野','all'));[...new Set(source.filter(q=>subjectMatches(q,subject)).map(q=>q.topic))].sort().forEach(t=>select.add(new Option(t,t)));if([...select.options].some(o=>o.value===previous))select.value=previous;}
$('subject').addEventListener('change',()=>{fillTopics();updateMathBetaNote();});$('mode').addEventListener('change',syncSubjects);syncSubjects();
$('mode-picker').querySelectorAll('[data-mode]').forEach(button=>button.addEventListener('click',()=>{
  $('mode').value=button.dataset.mode;
  syncSubjects();
  $('mode-picker').hidden=true;
  $('source-note').hidden=false;
  $('workspace').hidden=false;
  $('workspace-title').textContent=button.dataset.mode==='exam'?'過去問モード':'高専基本対策モード';
  $('start').textContent=button.dataset.mode==='exam'?'本番形式の演習を開始する →':'基本対策を開始する →';
  $('workspace').scrollIntoView({behavior:'smooth',block:'start'});
}));
const modeBack=document.createElement('button');
modeBack.type='button';modeBack.className='secondary';modeBack.textContent='← モード選択';
modeBack.addEventListener('click',()=>{stopTimer();leaveQuizMode();$('quiz').hidden=true;$('result').hidden=true;$('workspace').hidden=true;$('source-note').hidden=true;$('mode-picker').hidden=false;});
$('workspace').querySelector('.toolbar').append(modeBack);
function stats(){$('total').textContent=record.answered;$('correct').textContent=record.correct;$('rate').textContent=record.answered?Math.round(record.correct/record.answered*100)+'%':'—';}
function renderMotivation(){const daily=(()=>{try{return JSON.parse(localStorage.getItem('knot-private-daily-v1')||'null')||{};}catch{return {};}})();$('kosen-total').textContent=record.answered.toLocaleString('ja-JP');$('kosen-rate').textContent=record.answered?Math.round(record.correct/record.answered*100):'—';$('kosen-streak').textContent=Number(daily.streak)||0;const now=new Date(),today=[now.getFullYear(),String(now.getMonth()+1).padStart(2,'0'),String(now.getDate()).padStart(2,'0')].join('-'),count=daily.date===today?(Number(daily.answered)||0):0;$('kosen-daily-label').textContent=Math.min(count,10)+' / 10 問';$('kosen-daily-progress').style.width=Math.min(100,count*10)+'%';document.querySelectorAll('.milestone-list [data-threshold]').forEach(el=>el.classList.toggle('achieved',record.answered>=Number(el.dataset.threshold)));$('kosen-pwa-card').hidden=false;}
window.addEventListener('knot-secret-unlocked',renderMotivation);
function enterQuizMode(){document.documentElement.classList.add('private-quiz-active');}
function leaveQuizMode(){document.documentElement.classList.remove('private-quiz-active');}
function stopTimer(){if(timerHandle){clearInterval(timerHandle);timerHandle=null;}}
function updateTimer(){const left=Math.max(0,Math.ceil((deadline-Date.now())/1000)),m=Math.floor(left/60),s=left%60;$('timer').textContent='残り '+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');if(left<=0){stopTimer();finish(true);}}
function startTimer(minutes=50){stopTimer();deadline=Date.now()+minutes*60*1000;$('timer').hidden=false;updateTimer();timerHandle=setInterval(updateTimer,500);}
function start(){const workspace=$('workspace'),quiz=$('quiz'),result=$('result');if(!workspace||!quiz||!result)return;mode=$('mode').value;const subject=$('subject').value;lastConfig={subject,topic:mode==='exam'?'all':$('topic').value,amount:mode==='exam'?'10':$('amount').value,level:mode==='exam'?'all':$('level').value,mode};const source=mode==='exam'?pastBank:bank;let pool=source.filter(q=>q&&q.choices?.length===4&&Number.isInteger(q.answer)&&q.answer>=0&&q.answer<4&&subjectMatches(q,subject)&&(mode==='exam'?($('exam-year').value==='all'||String(q.sourceBig||'').startsWith($('exam-year').value)):isBasicEligible(q))&&(mode==='exam'||lastConfig.topic==='all'||q.topic===lastConfig.topic)&&(mode==='exam'||lastConfig.level==='all'||q.level===lastConfig.level));if(mode==='practice'&&lastConfig.amount==='wrong')pool=pool.filter(q=>record.wrong.includes(q.id));if(mode==='exam'){
 pool=pool.filter(q=>q.sourceType==='公式過去問を参考にした再構成問題');
 pool.sort((a,b)=>(a.subject||'').localeCompare(b.subject||'','ja')||(a.sourceBig||'').localeCompare(b.sourceBig||'','ja',{numeric:true})||Number((a.sourceSub||'').match(/\d+/)?.[0]||0)-Number((b.sourceSub||'').match(/\d+/)?.[0]||0));
 }else{for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}if(lastConfig.amount!=='all'&&lastConfig.amount!=='wrong')pool=pool.slice(0,Number(lastConfig.amount));}if(!pool.length){$('meta').textContent='この条件の問題はまだありません';return;}set=pool;answers=new Array(set.length).fill(null);index=0;score=0;result.hidden=true;workspace.hidden=true;quiz.hidden=false;$('review').hidden=true;enterQuizMode();if(mode==='exam')startTimer(subject==='理社ミックス'?100:50);else{$('timer').hidden=true;stopTimer();}render();}
function renderQuestionDiagram(q){
 const host=$('question-diagram');host.replaceChildren();
 if(!['理科','社会'].includes(q.subject)){host.hidden=true;return;}
 host.hidden=false;
 const aliases={
 '物理':['力','圧力','速さ','仕事','電流','電圧','電気','音','光','密度','運動'],
 '化学':['物質','溶解','原子','化学','酸','気体','濃度','中和','酸化'],
 '生物':['植物','消化','血液','遺伝','食物','細胞','腎臓','神経','呼吸'],
 '地学':['地震','火山','天体','気象','前線','星','地層'],
 '地理':['地形','気候','人口','農業','貿易','時差','地図','漁業','工業'],
 '歴史':['古代','縄文','弥生','江戸','明治','鎌倉','室町','歴史','戦国','平安'],
 '公民':['憲法','国会','経済','税','選挙','国際','人権','内閣','裁判','地方自治']
 };
 const root=(q.topic||'').split('・')[0],words=[...(aliases[root]||[]),root,(q.topic||'').split('・').slice(1).join(' '),...(q.q||'').match(/[一-龠ぁ-んァ-ヶー]{2,}/g)||[]];
 const candidates=diagramBank.diagrams.filter(d=>d.subject===q.subject&&words.some(w=>w&&w.length>=2&&(d.topic.includes(w)||w.includes(d.topic))));
 if(!candidates.length){host.hidden=true;return;}
 const hash=Array.from((q.topic||'')+' '+q.q).reduce((n,c)=>n+c.charCodeAt(0),0),d=candidates[hash%candidates.length];
 const card=document.createElement('section');card.className='question-diagram-card';
 const label=document.createElement('small');label.textContent='KNOT ORIGINAL DIAGRAM / '+d.id.toUpperCase();
 const title=document.createElement('h3');title.textContent=d.title;
 const visual=document.createElement('div');visual.className='question-diagram-visual kind-'+d.kind;
 d.nodes.forEach((node,i)=>{const item=document.createElement('div');item.className='question-diagram-node';const no=document.createElement('small');no.textContent=String(i+1).padStart(2,'0');const name=document.createElement('b');name.textContent=node.label;const hint=document.createElement('span');hint.textContent=node.hint;item.append(no,name,hint);visual.append(item);});
 const note=document.createElement('p');note.textContent=d.note;
 const explain=document.createElement('p');explain.className='diagram-explain';explain.textContent=d.explain;
 card.append(label,title,visual,note,explain);host.append(card);
}
function render(){locked=false;const q=set[index];$('read-paper').hidden=!q.sourceBig;$('meta').textContent=mode==='exam'?(q.sourceBig+' '+(q.sourceSub||'')+' / '+q.subject+' / '+(q.sourceType||'過去問')):q.subject+' / '+q.topic+' / '+q.level;$('progressText').textContent=(index+1)+' / '+set.length;$('progress').style.width=(index/set.length*100)+'%';$('question').textContent=q.q;const figure=$('question-figure');if(q.figure){$('question-image').src=q.figure;$('question-image').alt=q.figureAlt||'問題資料';$('question-caption').textContent=q.figureAlt||'資料';figure.hidden=false;}else{figure.hidden=true;$('question-image').removeAttribute('src');}renderQuestionDiagram(q);$('choices').replaceChildren();$('explanation').hidden=true;$('prev').disabled=mode!=='exam'||index===0;$('next').disabled=mode==='practice'&&answers[index]===null;$('next').textContent=index===set.length-1?(mode==='exam'?'採点して結果を見る →':'結果を見る →'):'次の問題 →';q.choices.forEach((choice,i)=>{const b=document.createElement('button');b.type='button';b.className='choice answer';if(mode==='exam'&&answers[index]===i)b.classList.add('selected');const palette={bg:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-bg').trim()||'#26364f',border:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-border').trim()||'#526b91',ink:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-ink').trim()||'#f4f7ff',chip:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-chip').trim()||'#405779'};b.style.setProperty('background',palette.bg,'important');b.style.setProperty('border','2px solid '+palette.border,'important');b.style.setProperty('border-radius','18px','important');b.style.setProperty('color',palette.ink,'important');b.style.setProperty('box-shadow','0 4px 0 '+palette.border,'important');b.style.setProperty('font-weight','700');b.style.setProperty('justify-content','flex-start');b.style.setProperty('padding','18px 20px');const letter=document.createElement('span');letter.className='letter';letter.textContent=['A','B','C','D'][i];letter.style.setProperty('width','34px');letter.style.setProperty('height','34px');letter.style.setProperty('display','grid');letter.style.setProperty('place-items','center');letter.style.setProperty('flex','0 0 34px');letter.style.setProperty('border-radius','12px');letter.style.setProperty('background',palette.chip,'important');letter.style.setProperty('color',palette.ink,'important');letter.style.setProperty('font-weight','800');const text=document.createElement('span');text.textContent=choice;text.style.setProperty('text-align','left');text.style.setProperty('line-height','1.55');b.append(letter,text);b.addEventListener('click',()=>answer(i));$('choices').append(b);});}
function celebrateCorrect(){const toast=document.createElement('div');toast.className='private-correct-toast';toast.innerHTML='<strong>正解！</strong><span>その調子。次の一問へ。</span>';document.body.append(toast);setTimeout(()=>toast.remove(),950);}
function answer(n){if(mode==='exam'){answers[index]=n;[...$('choices').children].forEach((b,i)=>{b.classList.toggle('selected',i===n);});$('next').disabled=false;return;}if(locked)return;locked=true;answers[index]=n;const q=set[index],ok=n===q.answer;if(ok){score++;record.correct++;record.wrong=record.wrong.filter(id=>id!==q.id);celebrateCorrect();}else if(!record.wrong.includes(q.id))record.wrong.push(q.id);record.answered++;save();markDailyAnswer();stats();showAnswer(q,n,ok);$('next').disabled=false;}
function showAnswer(q,n,ok){[...$('choices').children].forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===n)b.classList.add('wrong');});const box=$('explanation');box.replaceChildren();const result=document.createElement('strong');result.textContent=ok?'正解':'不正解';const detail=document.createElement('p');detail.textContent=q.explanation;box.append(result,detail);appendDetailedExplanation(box,q);appendSummaryLink(box,q);box.hidden=false;}
function summaryPath(q){if(q.subject==='数学')return '/study/summary/math/';if(q.subject==='理科'){const t=String(q.topic||'');if(t.startsWith('物理'))return '/study/summary/physics/';if(t.startsWith('化学'))return '/study/summary/chemistry/';if(t.startsWith('生物'))return '/study/summary/biology/';if(t.startsWith('地学'))return '/study/summary/earth/';}if(q.subject==='社会'){const t=String(q.topic||'');if(t.includes('地理'))return '/study/summary/geography/';if(t.includes('歴史'))return '/study/summary/history/';if(t.includes('公民'))return '/study/summary/civics/';}return q.link||'/study/summary/';}
function appendSummaryLink(host,q){const link=document.createElement('a');link.href=summaryPath(q);link.className='summary-link';link.textContent='関連する要点まとめを見る →';host.append(link);}
function appendDetailedExplanation(box,q){if(Array.isArray(q.solutionSteps)&&q.solutionSteps.length){const steps=document.createElement('section');steps.className='solution-detail';const heading=document.createElement('h3');heading.textContent='解き方を順番に確認';steps.append(heading);const list=document.createElement('ol');q.solutionSteps.forEach(line=>{const li=document.createElement('li');li.textContent=line;list.append(li);});steps.append(list);box.append(steps);}if(Array.isArray(q.choiceNotes)&&q.choiceNotes.length){const notes=document.createElement('details');notes.className='choice-detail';const summary=document.createElement('summary');summary.textContent='ほかの選択肢が違う理由';notes.append(summary);const list=document.createElement('ul');q.choiceNotes.forEach((line,i)=>{const li=document.createElement('li');li.textContent=['A','B','C','D'][i]+'：'+line;list.append(li);});notes.append(list);box.append(notes);}if(q.takeaway){const tip=document.createElement('p');tip.className='takeaway';tip.textContent='入試で覚えるポイント：'+q.takeaway;box.append(tip);}}
function finish(timeUp=false){stopTimer();if(mode==='exam'){score=0;set.forEach((q,i)=>{const chosen=answers[i];if(chosen===null)return;record.answered++;markDailyAnswer();if(chosen===q.answer){score++;record.correct++;record.wrong=record.wrong.filter(id=>id!==q.id);}else if(!record.wrong.includes(q.id))record.wrong.push(q.id);});save();stats();}leaveQuizMode();$('quiz').hidden=true;$('result').hidden=false;$('score').textContent=score;$('max').textContent=set.length;$('resultMessage').textContent=timeUp?'制限時間終了。回答済みの問題を自動採点したよ。':score===set.length?'全問正解！すばらしい。':score/set.length>=.7?'いい調子。解説を確認して弱点をつぶそう。':'解説を読み直して、もう一度挑戦しよう。';$('progress').style.width='100%';if(mode==='exam')renderReview();}
function openPaper(){const q=set[index];if(!q)return;const getNo=item=>Number((item.sourceSub||'').match(/\d+/)?.[0]||1),currentNo=getNo(q);const group=pastBank.filter(item=>item.sourceBig===q.sourceBig).sort((a,b)=>getNo(a)-getNo(b));const visible=group.filter(item=>getNo(item)<=currentNo);$('paper-title').textContent=q.sourceBig||'大問の問題文';$('paper-instruction').textContent='現在の小問 '+(q.sourceSub||'（1）')+' までを表示しています。前の小問も含めて、問題文と選択肢を確認できます。';const root=$('paper-content');root.replaceChildren();if(q.bigQuestionText||q.passage||q.sourceText){const passage=document.createElement('div');passage.className='paper-passage';passage.textContent=q.bigQuestionText||q.passage||q.sourceText;root.append(passage);}visible.forEach(item=>{const card=document.createElement('article');card.className='paper-question';const heading=document.createElement('h3');heading.textContent=(item.sourceSub||'（1）')+' '+item.topic;const prompt=document.createElement('p');prompt.textContent=item.q;card.append(heading,prompt);if(item.figure){const img=document.createElement('img');img.src=item.figure;img.alt=item.figureAlt||'問題資料';card.append(img);if(item.figureAlt){const cap=document.createElement('small');cap.textContent=item.figureAlt;card.append(cap);}}const list=document.createElement('ol');list.type='A';item.choices.forEach(choice=>{const li=document.createElement('li');li.textContent=choice;list.append(li);});card.append(list);root.append(card);});$('paper-modal').hidden=false;document.body.classList.add('paper-open');$('close-paper').focus();}
function closePaper(){$('paper-modal').hidden=true;document.body.classList.remove('paper-open');}
function renderReview(){const root=$('review');root.replaceChildren();root.hidden=false;const heading=document.createElement('h3');heading.textContent='全問題の解答・詳しい解説';root.append(heading);set.forEach((q,i)=>{const card=document.createElement('article');card.className='review-card';if(q.sourceBig){const source=document.createElement('small');source.className='review-source';source.textContent='参考：'+q.sourceBig+' '+(q.sourceSub||'');card.append(source);}const title=document.createElement('h4');title.textContent=(i+1)+'. '+q.q;const answerLine=document.createElement('p');answerLine.textContent='あなたの回答：'+(answers[i]===null?'未回答':q.choices[answers[i]])+' ／ 正解：'+q.choices[q.answer];answerLine.className=answers[i]===q.answer?'review-correct':'review-wrong';card.append(title,answerLine);const explanation=document.createElement('p');explanation.textContent=q.explanation;card.append(explanation);appendDetailedExplanation(card,q);appendSummaryLink(card,q);root.append(card);});}
$('read-paper').addEventListener('click',openPaper);$('close-paper').addEventListener('click',closePaper);$('paper-modal').querySelector('[data-paper-close]').addEventListener('click',closePaper);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('paper-modal').hidden)closePaper();});$('start').addEventListener('click',start);$('retry').addEventListener('click',()=>{$('result').hidden=true;$('workspace').hidden=false;if(lastConfig){$('mode').value=lastConfig.mode;syncSubjects();$('subject').value=lastConfig.subject;fillTopics();$('topic').value=lastConfig.topic;if(lastConfig.mode==='practice'){$('amount').value=lastConfig.amount;$('level').value=lastConfig.level;}}start();});
$('prev').addEventListener('click',()=>{if(index>0){index--;render();}});
$('next').addEventListener('click',()=>{if(mode==='practice'&&answers[index]===null)return;if(index===set.length-1)finish();else{index++;render();}});
$('quit').addEventListener('click',()=>{if(mode==='exam'){if(!confirm('テストを終了して、ここまでの回答を採点しますか？'))return;finish();return;}stopTimer();leaveQuizMode();$('quiz').hidden=true;$('workspace').hidden=false;});
document.addEventListener('keydown',e=>{if($('quiz').hidden||!$('paper-modal').hidden||e.altKey||e.ctrlKey||e.metaKey)return;const key=e.key.toLowerCase(),choice='abcd'.indexOf(key);if(choice>=0){if(mode==='exam'||!locked)answer(choice);return;}if(key==='enter'&&!$('next').disabled){e.preventDefault();$('next').click();}});
stats();try{if(sessionStorage.getItem('knot-study-secret-unlocked')==='1')renderMotivation();}catch{}
</script>
