---
import Layout from '../layouts/Layout.astro';
import '../styles/study.css';
const structuredData={"@context":"https://schema.org","@type":"WebApplication",name:'KNOT Study',applicationCategory:'EducationalApplication',operatingSystem:'Any'};
---
<Layout title="KNOT Study | 学習アプリ" description="中学生向け理科・社会の一問一答" structuredData={structuredData}>
<main class="study-app">
<header class="site-header"><div class="brand">KNOT<span> Study</span></div><div class="header-note">毎日の積み重ねを、確かな力に。</div></header>
<section class="hero"><h1>今日の学習を、ここから。</h1><p>理科・社会の問題に挑戦して、苦手を克服しよう。</p></section>
<section class="stats-grid"><div class="stat-card"><div class="stat-label">回答した問題</div><div class="stat-value" id="total-answered">0</div></div><div class="stat-card"><div class="stat-label">正解数</div><div class="stat-value" id="total-correct">0</div></div><div class="stat-card"><div class="stat-label">正答率</div><div class="stat-value" id="accuracy">—</div></div><div class="stat-card"><div class="stat-label">苦手問題</div><div class="stat-value" id="wrong-count">0</div></div></section>
<h2 class="section-title">科目を選択</h2><div class="subjects"><button class="subject active" data-subject="理科">🔬 理科</button><button class="subject" data-subject="社会">🌏 社会</button></div>
<section class="panel"><h2 class="section-title">学習設定</h2><div class="controls"><div class="field"><label for="grade">学年</label><select id="grade"><option value="all">全学年</option><option value="1">中学1年</option><option value="2">中学2年</option><option value="3">中学3年</option></select></div><div class="field"><label for="mode">モード</label><select id="mode"><option value="all">全問題</option><option value="topic">分野別</option><option value="mock">ランダム20問</option><option value="wrong">苦手問題</option></select></div><div class="field" id="topic-wrap" hidden><label for="topic">分野</label><select id="topic"><option value="all">すべて</option></select></div><button class="primary-btn" id="start-btn">学習スタート →</button></div><div class="controls"><button class="secondary-btn" id="review-btn">苦手問題を復習（<span id="review-total">0問</span>）</button><button class="danger-btn" id="reset-btn">記録をリセット</button></div></section>
<section class="panel" id="quiz-panel" hidden><div class="quiz-top"><span id="quiz-subtitle">理科</span><span id="question-counter">1 / 20</span></div><h2 id="quiz-title">理科の問題</h2><div class="quiz-meta"><span class="pill" id="question-grade">中1</span><span class="pill" id="question-topic">植物</span></div><p id="question-text"></p><div class="answer-list" id="answer-list"></div><div class="explanation" id="explanation" hidden></div><div class="quiz-actions"><button class="secondary-btn" id="quit-btn">終了</button><button class="primary-btn" id="next-btn" disabled>次の問題 →</button></div></section>
<footer class="footer">© KNOT Study</footer></main><script>import '../scripts/app.js';</script>
</Layout>
