---
import Layout from '../../layouts/Layout.astro';
import questions from '../../data/kosen-questions.json';
const topics = [...new Set(questions.map(q => q.topic))];
---
<Layout title="高専入試対策｜KNOT Study" description="高専入試を意識した思考力・資料読解型のオリジナル演習問題。">
<main class="kosen-page">
  <a class="back" href="../">← Studyに戻る</a>
  <header class="hero">
    <p class="eyebrow">KNOT / KO SEN EXAM</p>
    <div class="hero-row"><div><h1>高専入試対策</h1><p>知識を覚えるだけじゃない。資料を読み、考えて、答えを導く。</p></div><span class="live">PRACTICE 01</span></div>
    <div class="hero-stats"><div><strong>{questions.length}</strong><small>オリジナル問題</small></div><div><strong>{topics.length}</strong><small>出題テーマ</small></div><div><strong>社会</strong><small>公開中の教科</small></div></div>
  </header>
  <section class="source-note"><div><strong>問題の方針</strong><p>高専の学力検査で問われる、複数の情報を組み合わせる力・統計や地図を読み取る力を意識したオリジナル問題。過去問の文章や選択肢をそのまま転載せず、出題テーマを参考に作成している。</p><a href="https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/02_2026_syakai_mondai2.pdf" target="_blank" rel="noopener noreferrer">令和8年度 高専入試・社会の問題冊子（公式PDF） ↗</a></div></section>
  <section class="workspace">
    <div class="toolbar"><div><p class="eyebrow">QUESTION SET</p><h2>演習を始める</h2></div><div class="filters"><label>分野<select id="topic"><option value="all">すべて</option>{topics.map(t=><option value={t}>{t}</option>)}</select></label><label>問題数<select id="amount"><option value="5">5問</option><option value="10" selected>10問</option><option value="all">全問</option></select></label></div></div>
    <div class="history"><span>累計 <b id="total">0</b> 問</span><span>正解 <b id="correct">0</b> 問</span><span>正答率 <b id="rate">—</b></span></div>
    <button class="start" id="start">演習を開始する <span>→</span></button>
  </section>
  <section class="quiz" id="quiz" hidden>
    <div class="quiz-meta"><span id="meta"></span><b id="progressText"></b></div><div class="progress"><i id="progress"></i></div>
    <h2 id="question"></h2><div class="choices" id="choices"></div>
    <div class="explanation" id="explanation" hidden aria-live="polite"></div>
    <div class="quiz-actions"><button id="quit" class="secondary">中断する</button><button id="next" class="start" disabled>次の問題 →</button></div>
  </section>
  <section class="result" id="result" hidden><p class="eyebrow">YOUR RESULT</p><h2>演習終了！</h2><div class="score"><strong id="score">0</strong><span> / <span id="max">0</span> 問正解</span></div><p id="resultMessage"></p><button class="start" id="retry">もう一度解く →</button></section>
  <footer class="note">※この問題セットは学習用のオリジナル問題です。実際の入試問題・公式解答ではありません。</footer>
</main>
<script>
import bank from '../../data/kosen-questions.json';
const $=id=>document.getElementById(id), KEY='knot-kosen-record-v1';
let record={answered:0,correct:0},set=[],index=0,score=0,locked=false,lastTopic='all',lastAmount='10';
try{const v=JSON.parse(localStorage.getItem(KEY)||'null');if(v&&Number.isFinite(v.answered)&&Number.isFinite(v.correct)){record={answered:v.answered,correct:v.correct};}}catch{}
function save(){try{localStorage.setItem(KEY,JSON.stringify(record));}catch{}}
function stats(){$('total').textContent=record.answered;$('correct').textContent=record.correct;$('rate').textContent=record.answered?Math.round(record.correct/record.answered*100)+'%':'—';}
function start(){lastTopic=$('topic').value;lastAmount=$('amount').value;let pool=bank.filter(q=>lastTopic==='all'||q.topic===lastTopic);pool=pool.sort(()=>Math.random()-.5);set=lastAmount==='all'?pool:pool.slice(0,Number(lastAmount));if(!set.length)return;index=0;score=0;$('result').hidden=true;$('quiz').hidden=false;$('workspace').hidden=true;render();}
function render(){locked=false;const q=set[index];$('meta').textContent=q.subject+' / '+q.topic+' / '+q.level;$('progressText').textContent=(index+1)+' / '+set.length;$('progress').style.width=(index/set.length*100)+'%';$('question').textContent=q.q;$('choices').replaceChildren();$('explanation').hidden=true;$('next').disabled=true;$('next').textContent=index===set.length-1?'結果を見る →':'次の問題 →';q.choices.forEach((choice,i)=>{const b=document.createElement('button');b.type='button';b.className='choice';const letter=document.createElement('b');letter.textContent=['A','B','C','D'][i];const text=document.createElement('span');text.textContent=choice;b.append(letter,text);b.addEventListener('click',()=>answer(i));$('choices').append(b);});}
function answer(n){if(locked)return;locked=true;const q=set[index],ok=n===q.answer;if(ok)score++;record.answered++;if(ok)record.correct++;save();stats();[...$('choices').children].forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===n)b.classList.add('wrong');});const box=$('explanation');box.replaceChildren();const result=document.createElement('strong');result.textContent=ok?'正解':'不正解';const detail=document.createElement('p');detail.textContent=q.explanation;box.append(result,detail);box.hidden=false;$('next').disabled=false;}
function finish(){$('quiz').hidden=true;$('result').hidden=false;$('score').textContent=score;$('max').textContent=set.length;$('resultMessage').textContent=score===set.length?'全問正解！すばらしい。':score/set.length>=.7?'いい調子。解説を確認して弱点をつぶそう。':'解説を読み直して、もう一度挑戦しよう。';$('progress').style.width='100%';}
$('start').addEventListener('click',start);$('retry').addEventListener('click',()=>{$('topic').value=lastTopic;$('amount').value=lastAmount;$('result').hidden=true;$('workspace').hidden=false;start();});$('next').addEventListener('click',()=>{if(!locked)return;if(index===set.length-1)finish();else{index++;render();}});$('quit').addEventListener('click',()=>{$('quiz').hidden=true;$('workspace').hidden=false;});stats();
</script>
<style>
.kosen-page{max-width:880px;margin:0 auto;padding:28px 0 55px}.back{font-size:12px;color:var(--accent)}.hero{padding:34px 0 25px;border-bottom:1px solid var(--line)}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800;margin:0 0 10px}.hero-row{display:flex;justify-content:space-between;gap:18px;align-items:center}.hero h1{font-size:clamp(32px,6vw,48px);letter-spacing:-.06em;margin:0;font-weight:900}.hero p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.8;margin:9px 0 0}.live{font:10px ui-monospace,monospace;color:var(--accent);border:1px solid var(--line);border-radius:7px;padding:9px 11px;white-space:nowrap}.hero-stats{display:flex;gap:0;margin-top:24px}.hero-stats div{display:grid;gap:3px;padding:0 24px;border-left:1px solid var(--line)}.hero-stats div:first-child{padding-left:0;border:0}.hero-stats strong{font-size:22px}.hero-stats small{font-size:10px;color:var(--muted)}.source-note{margin:20px 0;padding:17px 19px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}.source-note strong{font-size:12px}.source-note p{font-size:11px;line-height:1.8;color:var(--muted);margin:7px 0}.source-note a{font-size:11px;color:var(--accent);font-weight:750}.workspace,.quiz,.result{margin-top:18px;padding:23px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.toolbar{display:flex;justify-content:space-between;gap:20px;align-items:center}.toolbar h2{font-size:20px;margin:0}.toolbar .eyebrow{margin-bottom:5px}.filters{display:flex;gap:10px}.filters label{display:grid;gap:5px;font-size:10px;color:var(--muted)}.filters select{min-width:110px;padding:9px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text)}.history{display:flex;gap:18px;flex-wrap:wrap;margin:20px 0;color:var(--muted);font-size:11px}.history b{color:var(--text);font-size:14px;margin-left:4px}.start{border:0;border-radius:9px;background:var(--accent);color:#fff;padding:13px 18px;font-size:12px;font-weight:800;cursor:pointer}.start span{margin-left:14px}.quiz[hidden],.result[hidden]{display:none}.quiz-meta{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px}.progress{height:6px;background:var(--line);border-radius:10px;margin:12px 0 25px;overflow:hidden}.progress i{display:block;height:100%;background:var(--accent);width:0;transition:width .2s}.quiz h2{font-size:clamp(18px,3vw,23px);line-height:1.8;margin:0 0 20px}.choices{display:grid;grid-template-columns:1fr 1fr;gap:10px}.choice{display:flex;align-items:center;gap:12px;text-align:left;padding:14px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text);font:inherit;line-height:1.7;cursor:pointer}.choice b{width:27px;height:27px;flex:none;display:grid;place-items:center;border-radius:7px;background:var(--surface-soft);font-size:11px}.choice.correct{border-color:#259b68;background:color-mix(in srgb,#259b68 12%,var(--surface))}.choice.wrong{border-color:#d94c59;background:color-mix(in srgb,#d94c59 12%,var(--surface))}.choice:disabled{cursor:default}.explanation{margin-top:17px;padding:16px;border-radius:9px;background:var(--surface-soft);font-size:12px;line-height:1.8}.explanation p{margin:6px 0 0}.quiz-actions{display:flex;justify-content:space-between;gap:10px;margin-top:20px}.secondary{padding:12px 16px;border:1px solid var(--line);border-radius:9px;background:var(--surface-soft);color:var(--text);font-size:12px}.start:disabled{opacity:.45;cursor:not-allowed}.result{text-align:center;padding:30px}.result h2{font-size:25px}.score strong{font-size:55px}.score span{color:var(--muted)}.result p:not(.eyebrow){font-size:12px;color:var(--muted)}.note{margin-top:22px;color:var(--muted);font-size:10px;line-height:1.7}@media(max-width:620px){.kosen-page{padding-top:20px}.hero-row{align-items:flex-start}.hero h1{font-size:34px}.hero-stats div{padding:0 14px}.toolbar{align-items:flex-start;flex-direction:column}.filters{width:100%}.filters label{flex:1}.filters select{width:100%;min-width:0}.workspace,.quiz,.result{padding:17px}.choices{grid-template-columns:1fr}}
</style>
</Layout>