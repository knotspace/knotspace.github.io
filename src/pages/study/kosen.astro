---
import StudyLayout from '../../layouts/StudyLayout.astro';
import '../../styles/study/quiz-ui.css';
import questionsData from '../../data/study/kosen-questions.json';
import pastQuestionsData from '../../data/study/kosen-past-questions.json';
const questions = questionsData.questions;
const pastQuestions = pastQuestionsData.questions;
const regularQuestions = questions.filter(q => ['理科','社会'].includes(q.subject));
const topics = [...new Set(regularQuestions.map(q => q.topic))];
---
<StudyLayout title="高専入試対策｜KNOT Study" description="高専入試を意識した思考力・資料読解型のオリジナル演習問題。">
<main class="kosen-page">
  <a class="back" href="../">← Studyに戻る</a>
  <header class="hero">
    <p class="eyebrow">KNOT / KO SEN EXAM</p>
    <div class="hero-row"><div><h1>高専入試対策</h1><p>知識を覚えるだけじゃない。資料を読み、考えて、答えを導く。</p></div><span class="live">PRACTICE 01</span></div>
    <div class="hero-stats"><div><strong>{regularQuestions.length}</strong><small>理科・社会の演習問題</small></div><div><strong>{topics.length}</strong><small>出題テーマ</small></div><div><strong>2教科</strong><small>理科・社会</small></div></div>
  </header>
  <div class="beta-banner"><b>β版</b><div><strong>理科・社会の重点対策</strong><p>通常演習・模試のどちらも理科のみ／社会のみ／理社ミックスを選択可能。過去問は大問ごとに（1）から順番に出題。全110問を収録。</p></div></div>
  <section class="source-note"><div><strong>問題の方針</strong><p>高専の学力検査で問われる、複数の情報を組み合わせる力・統計や地図を読み取る力を意識したオリジナル問題。過去問の文章や選択肢をそのまま転載せず、出題テーマを参考に作成している。</p><a href="https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/04_2026_rika_mondai.pdf" target="_blank" rel="noopener noreferrer">令和8年度 理科・問題冊子（公式PDF） ↗</a><br><a href="https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/04_2026_rika_seikai.pdf" target="_blank" rel="noopener noreferrer">理科・公式正解 ↗</a><br><a href="https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/02_2026_syakai_mondai2.pdf" target="_blank" rel="noopener noreferrer">令和8年度 社会・問題冊子（公式PDF） ↗</a><br><a href="https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/02_2026_syakai_seikai.pdf" target="_blank" rel="noopener noreferrer">社会・公式正解 ↗</a>
  <p class="data-sources"><strong>資料データの出典</strong><br><a href="/study-data/資料ダウンロード一覧.md" target="_blank" rel="noopener noreferrer">理科・社会の公的資料ダウンロード一覧 ↗</a><br><br><a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener noreferrer">国土地理院・地理院タイル（地形図・土地条件図） ↗</a><br><a href="https://www.data.jma.go.jp/risk/obsdl/" target="_blank" rel="noopener noreferrer">気象庁・過去の気象データ（CSVダウンロード） ↗</a></p>
  <small class="figure-credit">図版：KNOTオリジナル模式図。実際の地形図・観測値ではなく、地形や自然現象の読み取り練習用に作成。</small></div></section>
  <section class="workspace" id="workspace">
    <div class="toolbar"><div><p class="eyebrow">QUESTION SET</p><h2>演習を始める</h2></div><div class="filters"><label>教科<select id="subject"><option value="理科">理科のみ</option><option value="社会">社会のみ</option><option value="理社ミックス">理社ミックス</option></select></label><label id="topic-label">分野<select id="topic"><option value="all">すべての分野</option></select></label><label id="amount-label">問題数<select id="amount"><option value="10">10問</option><option value="20">20問</option><option value="all">全問</option><option value="wrong">苦手だけ</option></select></label><label>モード<select id="mode"><option value="practice">通常演習</option><option value="exam">模試モード（過去問・大問単位）</option></select></label></div></div>
    <div class="history"><span>累計 <b id="total">0</b> 問</span><span>正解 <b id="correct">0</b> 問</span><span>正答率 <b id="rate">—</b></span></div>
    <button class="start" id="start">演習を開始する <span>→</span></button>
  </section>
  <section class="quiz" id="quiz" hidden>
    <div class="quiz-meta"><span id="meta"></span><span id="timer" class="exam-timer" hidden></span><b id="progressText"></b></div><div class="progress"><i id="progress"></i></div>
    <div class="paper-tools"><button type="button" id="read-paper" class="secondary">この大問の問題文を読む ↗</button></div>
    <h2 id="question"></h2><figure class="question-figure" id="question-figure" hidden><img id="question-image" alt=""><figcaption id="question-caption"></figcaption></figure><div class="choices" id="choices"></div>
    <div class="explanation" id="explanation" hidden aria-live="polite"></div>
    <div class="quiz-actions"><button id="quit" class="secondary">中断する</button><button id="prev" class="secondary" disabled>← 前へ</button><button id="next" class="start" disabled>次の問題 →</button></div>
  </section>
  <div class="paper-modal" id="paper-modal" hidden><div class="paper-backdrop" data-paper-close></div><section class="paper-dialog" role="dialog" aria-modal="true" aria-labelledby="paper-title"><header><div><p class="eyebrow">PAST QUESTION / READING</p><h2 id="paper-title">大問の問題文</h2></div><button type="button" id="close-paper" class="secondary">閉じる ×</button></header><p class="paper-instruction" id="paper-instruction"></p><div id="paper-content" class="paper-content"></div></section></div>
  <section class="result" id="result" hidden><p class="eyebrow">YOUR RESULT</p><h2>演習終了！</h2><div class="score"><strong id="score">0</strong><span> / <span id="max">0</span> 問正解</span></div><p id="resultMessage"></p><div id="review" class="review-list" hidden></div><button class="start" id="retry">もう一度解く →</button></section>
  <footer class="note">※模試モードには令和8年度の公式過去問22問と、過去問を参考にしたKNOTオリジナル類題88問を収録（理科55問・社会55問）。公式問題は大問単位で（1）から最後までまとめて出題します。追加問題はKNOTオリジナル類題です。原文・図表は公式PDFで確認できます。</footer>
</main>
<script>
import bank from '../../data/study/kosen-questions.json';
import pastBank from '../../data/study/kosen-past-questions.json';
const $=id=>document.getElementById(id), KEY='knot-kosen-record-v1';
let record={answered:0,correct:0,wrong:[]},set=[],index=0,score=0,locked=false,lastConfig=null,mode='practice',answers=[],timerHandle=null,deadline=0;
try{const v=JSON.parse(localStorage.getItem(KEY)||'null');if(v&&Number.isFinite(v.answered)&&Number.isFinite(v.correct)){record={answered:v.answered,correct:v.correct,wrong:Array.isArray(v.wrong)?v.wrong.filter(x=>typeof x==='string'):[]};}}catch{}
function save(){try{localStorage.setItem(KEY,JSON.stringify(record));}catch{}}
function markDailyAnswer(){try{const key='knot-study-daily-v1',today=new Date(),date=[today.getFullYear(),String(today.getMonth()+1).padStart(2,'0'),String(today.getDate()).padStart(2,'0')].join('-'),saved=JSON.parse(localStorage.getItem(key)||'null')||{};if(saved.date===date){saved.answered=(Number(saved.answered)||0)+1;}else{const yesterday=new Date(today.getFullYear(),today.getMonth(),today.getDate()-1),yesterdayKey=[yesterday.getFullYear(),String(yesterday.getMonth()+1).padStart(2,'0'),String(yesterday.getDate()).padStart(2,'0')].join('-');saved.streak=saved.lastDate===yesterdayKey?(Number(saved.streak)||0)+1:1;saved.lastDate=date;saved.date=date;saved.answered=1;}localStorage.setItem(key,JSON.stringify(saved));}catch{}}
function syncSubjects(){const select=$('subject'),previous=select.value;const subjects=['理科','社会','理社ミックス'];select.replaceChildren(...subjects.map(s=>new Option(s,s)));select.value=subjects.includes(previous)?previous:'理科';$('amount-label').hidden=$('mode').value==='exam';$('topic-label').hidden=$('mode').value==='exam';fillTopics();}
function fillTopics(){const subject=$('subject').value,select=$('topic'),previous=select.value,source=$('mode').value==='exam'?pastBank:bank;select.replaceChildren(new Option('すべての分野','all'));[...new Set(source.filter(q=>subject==='理社ミックス'||q.subject===subject).map(q=>q.topic))].forEach(t=>select.add(new Option(t,t)));if([...select.options].some(o=>o.value===previous))select.value=previous;}
$('subject').addEventListener('change',fillTopics);$('mode').addEventListener('change',syncSubjects);syncSubjects();
function stats(){$('total').textContent=record.answered;$('correct').textContent=record.correct;$('rate').textContent=record.answered?Math.round(record.correct/record.answered*100)+'%':'—';}
function enterQuizMode(){document.documentElement.classList.add('kosen-quiz-active');}
function leaveQuizMode(){document.documentElement.classList.remove('kosen-quiz-active');}
function stopTimer(){if(timerHandle){clearInterval(timerHandle);timerHandle=null;}}
function updateTimer(){const left=Math.max(0,Math.ceil((deadline-Date.now())/1000)),m=Math.floor(left/60),s=left%60;$('timer').textContent='残り '+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');if(left<=0){stopTimer();finish(true);}}
function startTimer(){stopTimer();deadline=Date.now()+50*60*1000;$('timer').hidden=false;updateTimer();timerHandle=setInterval(updateTimer,500);}
function start(){const workspace=$('workspace'),quiz=$('quiz'),result=$('result');if(!workspace||!quiz||!result)return;mode=$('mode').value;const subject=$('subject').value;lastConfig={subject,topic:mode==='exam'?'all':$('topic').value,amount:mode==='exam'?'10':$('amount').value,mode};const source=mode==='exam'?pastBank:bank;let pool=source.filter(q=>q&&q.choices?.length===4&&Number.isInteger(q.answer)&&q.answer>=0&&q.answer<4&&(subject==='理社ミックス'||q.subject===subject)&&(mode==='exam'||lastConfig.topic==='all'||q.topic===lastConfig.topic));if(mode==='practice'&&lastConfig.amount==='wrong')pool=pool.filter(q=>record.wrong.includes(q.id));if(mode==='exam'){
 const groups=new Map();
 pool.forEach(q=>{const key=q.sourceBig||q.id;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(q);});
 groups.forEach(group=>group.sort((a,b)=>Number((a.sourceSub||'').match(/\d+/)?.[0]||0)-Number((b.sourceSub||'').match(/\d+/)?.[0]||0)));
 const shuffled=[...groups.values()].sort(()=>Math.random()-.5);
 pool=[];for(const group of shuffled){pool.push(...group);if(pool.length>=10)break;}
 }else{pool=pool.slice().sort(()=>Math.random()-.5);if(lastConfig.amount!=='all'&&lastConfig.amount!=='wrong')pool=pool.slice(0,Number(lastConfig.amount));}if(!pool.length){$('meta').textContent='この条件の問題はまだありません';return;}set=pool;answers=new Array(set.length).fill(null);index=0;score=0;result.hidden=true;workspace.hidden=true;quiz.hidden=false;$('review').hidden=true;enterQuizMode();if(mode==='exam')startTimer();else{$('timer').hidden=true;stopTimer();}render();}
function render(){locked=false;const q=set[index];$('read-paper').hidden=!q.sourceBig;$('meta').textContent=mode==='exam'?(q.sourceBig+' '+(q.sourceSub||'')+' / '+q.subject+' / '+(q.sourceType||'過去問')):q.subject+' / '+q.topic+' / '+q.level;$('progressText').textContent=(index+1)+' / '+set.length;$('progress').style.width=(index/set.length*100)+'%';$('question').textContent=q.q;const figure=$('question-figure');if(q.figure){$('question-image').src=q.figure;$('question-image').alt=q.figureAlt||'問題資料';$('question-caption').textContent=q.figureAlt||'資料';figure.hidden=false;}else{figure.hidden=true;$('question-image').removeAttribute('src');}$('choices').replaceChildren();$('explanation').hidden=true;$('prev').disabled=mode!=='exam'||index===0;$('next').disabled=mode==='practice'&&answers[index]===null;$('next').textContent=index===set.length-1?(mode==='exam'?'採点して結果を見る →':'結果を見る →'):'次の問題 →';q.choices.forEach((choice,i)=>{const b=document.createElement('button');b.type='button';b.className='choice answer';if(mode==='exam'&&answers[index]===i)b.classList.add('selected');const palette={bg:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-bg').trim()||'#26364f',border:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-border').trim()||'#526b91',ink:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-ink').trim()||'#f4f7ff',chip:getComputedStyle(document.documentElement).getPropertyValue('--quiz-answer-chip').trim()||'#405779'};b.style.setProperty('background',palette.bg,'important');b.style.setProperty('border','2px solid '+palette.border,'important');b.style.setProperty('border-radius','18px','important');b.style.setProperty('color',palette.ink,'important');b.style.setProperty('box-shadow','0 4px 0 '+palette.border,'important');b.style.setProperty('font-weight','700');b.style.setProperty('justify-content','flex-start');b.style.setProperty('padding','18px 20px');const letter=document.createElement('span');letter.className='letter';letter.textContent=['A','B','C','D'][i];letter.style.setProperty('width','34px');letter.style.setProperty('height','34px');letter.style.setProperty('display','grid');letter.style.setProperty('place-items','center');letter.style.setProperty('flex','0 0 34px');letter.style.setProperty('border-radius','12px');letter.style.setProperty('background',palette.chip,'important');letter.style.setProperty('color',palette.ink,'important');letter.style.setProperty('font-weight','800');const text=document.createElement('span');text.textContent=choice;text.style.setProperty('text-align','left');text.style.setProperty('line-height','1.55');b.append(letter,text);b.addEventListener('click',()=>answer(i));$('choices').append(b);});}
function answer(n){if(mode==='exam'){answers[index]=n;[...$('choices').children].forEach((b,i)=>{b.classList.toggle('selected',i===n);});$('next').disabled=false;return;}if(locked)return;locked=true;answers[index]=n;const q=set[index],ok=n===q.answer;if(ok){score++;record.correct++;record.wrong=record.wrong.filter(id=>id!==q.id);}else if(!record.wrong.includes(q.id))record.wrong.push(q.id);record.answered++;save();markDailyAnswer();stats();showAnswer(q,n,ok);$('next').disabled=false;}
function showAnswer(q,n,ok){[...$('choices').children].forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===n)b.classList.add('wrong');});const box=$('explanation');box.replaceChildren();const result=document.createElement('strong');result.textContent=ok?'正解':'不正解';const detail=document.createElement('p');detail.textContent=q.explanation;box.append(result,detail);appendDetailedExplanation(box,q);if(q.link){const link=document.createElement('a');link.href=q.link;link.className='summary-link';link.textContent='関連する要点まとめを見る →';box.append(link);}box.hidden=false;}
function appendDetailedExplanation(box,q){if(Array.isArray(q.solutionSteps)&&q.solutionSteps.length){const steps=document.createElement('section');steps.className='solution-detail';const heading=document.createElement('h3');heading.textContent='解き方を順番に確認';steps.append(heading);const list=document.createElement('ol');q.solutionSteps.forEach(line=>{const li=document.createElement('li');li.textContent=line;list.append(li);});steps.append(list);box.append(steps);}if(Array.isArray(q.choiceNotes)&&q.choiceNotes.length){const notes=document.createElement('details');notes.className='choice-detail';const summary=document.createElement('summary');summary.textContent='ほかの選択肢が違う理由';notes.append(summary);const list=document.createElement('ul');q.choiceNotes.forEach((line,i)=>{const li=document.createElement('li');li.textContent=['A','B','C','D'][i]+'：'+line;list.append(li);});notes.append(list);box.append(notes);}if(q.takeaway){const tip=document.createElement('p');tip.className='takeaway';tip.textContent='入試で覚えるポイント：'+q.takeaway;box.append(tip);}}
function finish(timeUp=false){stopTimer();if(mode==='exam'){score=0;set.forEach((q,i)=>{const chosen=answers[i];if(chosen===null)return;record.answered++;markDailyAnswer();if(chosen===q.answer){score++;record.correct++;record.wrong=record.wrong.filter(id=>id!==q.id);}else if(!record.wrong.includes(q.id))record.wrong.push(q.id);});save();stats();}leaveQuizMode();$('quiz').hidden=true;$('result').hidden=false;$('score').textContent=score;$('max').textContent=set.length;$('resultMessage').textContent=timeUp?'制限時間終了。回答済みの問題を自動採点したよ。':score===set.length?'全問正解！すばらしい。':score/set.length>=.7?'いい調子。解説を確認して弱点をつぶそう。':'解説を読み直して、もう一度挑戦しよう。';$('progress').style.width='100%';if(mode==='exam')renderReview();}
function openPaper(){const q=set[index];if(!q)return;const getNo=item=>Number((item.sourceSub||'').match(/\d+/)?.[0]||1),currentNo=getNo(q);const group=pastBank.filter(item=>item.sourceBig===q.sourceBig).sort((a,b)=>getNo(a)-getNo(b));const visible=group.filter(item=>getNo(item)<=currentNo);$('paper-title').textContent=q.sourceBig||'大問の問題文';$('paper-instruction').textContent='現在の小問 '+(q.sourceSub||'（1）')+' までを表示しています。前の小問も含めて、問題文と選択肢を確認できます。';const root=$('paper-content');root.replaceChildren();if(q.bigQuestionText||q.passage||q.sourceText){const passage=document.createElement('div');passage.className='paper-passage';passage.textContent=q.bigQuestionText||q.passage||q.sourceText;root.append(passage);}visible.forEach(item=>{const card=document.createElement('article');card.className='paper-question';const heading=document.createElement('h3');heading.textContent=(item.sourceSub||'（1）')+' '+item.topic;const prompt=document.createElement('p');prompt.textContent=item.q;card.append(heading,prompt);if(item.figure){const img=document.createElement('img');img.src=item.figure;img.alt=item.figureAlt||'問題資料';card.append(img);if(item.figureAlt){const cap=document.createElement('small');cap.textContent=item.figureAlt;card.append(cap);}}const list=document.createElement('ol');list.type='A';item.choices.forEach(choice=>{const li=document.createElement('li');li.textContent=choice;list.append(li);});card.append(list);root.append(card);});$('paper-modal').hidden=false;document.body.classList.add('paper-open');$('close-paper').focus();}
function closePaper(){$('paper-modal').hidden=true;document.body.classList.remove('paper-open');}
function renderReview(){const root=$('review');root.replaceChildren();root.hidden=false;const heading=document.createElement('h3');heading.textContent='全問題の解答・詳しい解説';root.append(heading);set.forEach((q,i)=>{const card=document.createElement('article');card.className='review-card';const title=document.createElement('h4');title.textContent=(i+1)+'. '+q.q;const answerLine=document.createElement('p');answerLine.textContent='あなたの回答：'+(answers[i]===null?'未回答':q.choices[answers[i]])+' ／ 正解：'+q.choices[q.answer];answerLine.className=answers[i]===q.answer?'review-correct':'review-wrong';card.append(title,answerLine);const explanation=document.createElement('p');explanation.textContent=q.explanation;card.append(explanation);appendDetailedExplanation(card,q);root.append(card);});}
$('read-paper').addEventListener('click',openPaper);$('close-paper').addEventListener('click',closePaper);$('paper-modal').querySelector('[data-paper-close]').addEventListener('click',closePaper);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('paper-modal').hidden)closePaper();});$('start').addEventListener('click',start);$('retry').addEventListener('click',()=>{$('result').hidden=true;$('workspace').hidden=false;if(lastConfig){$('mode').value=lastConfig.mode;syncSubjects();$('subject').value=lastConfig.subject;fillTopics();$('topic').value=lastConfig.topic;if(lastConfig.mode==='practice')$('amount').value=lastConfig.amount;}start();});
$('prev').addEventListener('click',()=>{if(index>0){index--;render();}});
$('next').addEventListener('click',()=>{if(mode==='practice'&&answers[index]===null)return;if(index===set.length-1)finish();else{index++;render();}});
$('quit').addEventListener('click',()=>{if(mode==='exam'){if(!confirm('テストを終了して、ここまでの回答を採点しますか？'))return;finish();return;}stopTimer();leaveQuizMode();$('quiz').hidden=true;$('workspace').hidden=false;});
stats();
</script>
<style>
.beta-banner{display:flex;align-items:center;gap:12px;margin-top:18px;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.beta-banner>b{padding:6px 8px;border-radius:6px;background:var(--accent);color:#fff;font-size:10px}.beta-banner strong{font-size:12px}.beta-banner p{font-size:10px;color:var(--muted);margin:3px 0 0}.kosen-page{max-width:880px;margin:0 auto;padding:28px 0 55px}.back{font-size:12px;color:var(--accent)}.hero{padding:34px 0 25px;border-bottom:1px solid var(--line)}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800;margin:0 0 10px}.hero-row{display:flex;justify-content:space-between;gap:18px;align-items:center}.hero h1{font-size:clamp(32px,6vw,48px);letter-spacing:-.06em;margin:0;font-weight:900}.hero p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.8;margin:9px 0 0}.live{font:10px ui-monospace,monospace;color:var(--accent);border:1px solid var(--line);border-radius:7px;padding:9px 11px;white-space:nowrap}.hero-stats{display:flex;gap:0;margin-top:24px}.hero-stats div{display:grid;gap:3px;padding:0 24px;border-left:1px solid var(--line)}.hero-stats div:first-child{padding-left:0;border:0}.hero-stats strong{font-size:22px}.hero-stats small{font-size:10px;color:var(--muted)}.source-note{margin:20px 0;padding:17px 19px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}.source-note strong{font-size:12px}.source-note p{font-size:11px;line-height:1.8;color:var(--muted);margin:7px 0}.source-note a{font-size:11px;color:var(--accent);font-weight:750}.data-sources{margin:12px 0 4px;font-size:11px;line-height:2;color:var(--muted)}.data-sources strong{color:var(--text)}.figure-credit{display:block;margin-top:8px;font-size:10px;color:var(--muted)}.workspace,.quiz,.result{margin-top:18px;padding:23px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.toolbar{display:flex;justify-content:space-between;gap:20px;align-i