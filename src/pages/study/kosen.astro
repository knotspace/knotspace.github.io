---
import StudyLayout from '../../layouts/StudyLayout.astro';
import questions from '../../data/study/kosen-questions.json';
const topics = [...new Set(questions.map(q => q.topic))];
---
<StudyLayout title="高専入試対策｜KNOT Study" description="高専入試を意識した思考力・資料読解型のオリジナル演習問題。">
<main class="kosen-page">
  <a class="back" href="../">← Studyに戻る</a>
  <header class="hero">
    <p class="eyebrow">KNOT / KO SEN EXAM</p>
    <div class="hero-row"><div><h1>高専入試対策</h1><p>知識を覚えるだけじゃない。資料を読み、考えて、答えを導く。</p></div><span class="live">PRACTICE 01</span></div>
    <div class="hero-stats"><div><strong>{questions.length}</strong><small>オリジナル問題</small></div><div><strong>{topics.length}</strong><small>出題テーマ</small></div><div><strong>理科・社会</strong><small>公開中の教科</small></div></div>
  </header>
  <div class="beta-banner"><b>β版</b><div><strong>高専対策は開発中です</strong><p>理科・社会の資料読解、計算、実験考察を追加。問題は今後も拡充します。</p></div></div>
  <section class="source-note"><div><strong>問題の方針</strong><p>高専の学力検査で問われる、複数の情報を組み合わせる力・統計や地図を読み取る力を意識したオリジナル問題。過去問の文章や選択肢をそのまま転載せず、出題テーマを参考に作成している。</p><a href="https://www.kosen-k.go.jp/wp/wp-content/uploads/2026/02/02_2026_syakai_mondai2.pdf" target="_blank" rel="noopener noreferrer">令和8年度 高専入試・社会の問題冊子（公式PDF） ↗</a>
  <p class="data-sources"><strong>資料データの出典</strong><br><a href="/study-data/資料ダウンロード一覧.md" target="_blank" rel="noopener noreferrer">理科・社会の公的資料ダウンロード一覧 ↗</a><br><br><a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener noreferrer">国土地理院・地理院タイル（地形図・土地条件図） ↗</a><br><a href="https://www.data.jma.go.jp/risk/obsdl/" target="_blank" rel="noopener noreferrer">気象庁・過去の気象データ（CSVダウンロード） ↗</a></p>
  <small class="figure-credit">図版：KNOTオリジナル模式図。実際の地形図・観測値ではなく、地形や自然現象の読み取り練習用に作成。</small></div></section>
  <section class="workspace" id="workspace">
    <div class="toolbar"><div><p class="eyebrow">QUESTION SET</p><h2>演習を始める</h2></div><div class="filters"><label>教科<select id="subject"><option value="all">理科・社会</option><option value="science">理科</option><option value="social">社会</option></select></label><label>分野<select id="topic"><option value="all">すべての分野</option></select></label><label>問題数<select id="amount"><option value="10">10問</option><option value="20">20問</option><option value="all">全問</option><option value="wrong">苦手だけ</option></select></label></div></div>
    <div class="history"><span>累計 <b id="total">0</b> 問</span><span>正解 <b id="correct">0</b> 問</span><span>正答率 <b id="rate">—</b></span></div>
    <button class="start" id="start">演習を開始する <span>→</span></button>
  </section>
  <section class="quiz" id="quiz" hidden>
    <div class="quiz-meta"><span id="meta"></span><b id="progressText"></b></div><div class="progress"><i id="progress"></i></div>
    <h2 id="question"></h2><figure class="question-figure" id="question-figure" hidden><img id="question-image" alt=""><figcaption id="question-caption"></figcaption></figure><div class="choices" id="choices"></div>
    <div class="explanation" id="explanation" hidden aria-live="polite"></div>
    <div class="quiz-actions"><button id="quit" class="secondary">中断する</button><button id="next" class="start" disabled>次の問題 →</button></div>
  </section>
  <section class="result" id="result" hidden><p class="eyebrow">YOUR RESULT</p><h2>演習終了！</h2><div class="score"><strong id="score">0</strong><span> / <span id="max">0</span> 問正解</span></div><p id="resultMessage"></p><button class="start" id="retry">もう一度解く →</button></section>
  <footer class="note">※この問題セットは学習用のオリジナル問題です。実際の入試問題・公式解答ではありません。</footer>
</main>
<script>
import bank from '../../data/study/kosen-questions.json';
const $=id=>document.getElementById(id), KEY='knot-kosen-record-v1';
let record={answered:0,correct:0,wrong:[]},set=[],index=0,score=0,locked=false,lastConfig=null;
try{const v=JSON.parse(localStorage.getItem(KEY)||'null');if(v&&Number.isFinite(v.answered)&&Number.isFinite(v.correct)){record={answered:v.answered,correct:v.correct,wrong:Array.isArray(v.wrong)?v.wrong.filter(x=>typeof x==='string'):[]};}}catch{}
function save(){try{localStorage.setItem(KEY,JSON.stringify(record));}catch{}}
function fillTopics(){const subject=$('subject').value,select=$('topic'),previous=select.value;select.replaceChildren(new Option('すべての分野','all'));[...new Set(bank.filter(q=>subject==='all'||q.subject===(subject==='science'?'理科':'社会')).map(q=>q.topic))].forEach(t=>select.add(new Option(t,t)));if([...select.options].some(o=>o.value===previous))select.value=previous;}
$('subject').addEventListener('change',fillTopics);fillTopics();
function stats(){$('total').textContent=record.answered;$('correct').textContent=record.correct;$('rate').textContent=record.answered?Math.round(record.correct/record.answered*100)+'%':'—';}
function enterQuizMode(){document.documentElement.classList.add('kosen-quiz-active');if(!document.fullscreenElement&&document.documentElement.requestFullscreen){document.documentElement.requestFullscreen().catch(()=>{});}}
function leaveQuizMode(){document.documentElement.classList.remove('kosen-quiz-active');if(document.fullscreenElement&&document.exitFullscreen)document.exitFullscreen().catch(()=>{});}
document.addEventListener('fullscreenchange',()=>{if(!document.fullscreenElement)document.documentElement.classList.remove('kosen-quiz-active');});
function start(){const workspace=$('workspace'),quiz=$('quiz'),result=$('result');if(!workspace||!quiz||!result)return;lastConfig={subject:$('subject').value,topic:$('topic').value,amount:$('amount').value};let pool=bank.filter(q=>q&&q.choices?.length===4&&Number.isInteger(q.answer)&&q.answer>=0&&q.answer<4&&(lastConfig.subject==='all'||q.subject===(lastConfig.subject==='science'?'理科':'社会'))&&(lastConfig.topic==='all'||q.topic===lastConfig.topic));if(lastConfig.amount==='wrong')pool=pool.filter(q=>record.wrong.includes(q.id));pool=pool.slice().sort(()=>Math.random()-.5);if(lastConfig.amount!=='all'&&lastConfig.amount!=='wrong')pool=pool.slice(0,Number(lastConfig.amount));if(!pool.length){$('meta').textContent='この条件の問題はまだありません';return;}set=pool;index=0;score=0;result.hidden=true;workspace.hidden=true;quiz.hidden=false;enterQuizMode();render();}
function render(){locked=false;const q=set[index];$('meta').textContent=q.subject+' / '+q.topic+' / '+q.level;$('progressText').textContent=(index+1)+' / '+set.length;$('progress').style.width=(index/set.length*100)+'%';$('question').textContent=q.q;const figure=$('question-figure');if(q.figure){$('question-image').src=q.figure;$('question-image').alt=q.figureAlt||'問題資料';$('question-caption').textContent=q.figureAlt||'資料';figure.hidden=false;}else{figure.hidden=true;$('question-image').removeAttribute('src');}$('choices').replaceChildren();$('explanation').hidden=true;$('next').disabled=true;$('next').textContent=index===set.length-1?'結果を見る →':'次の問題 →';q.choices.forEach((choice,i)=>{const b=document.createElement('button');b.type='button';b.className='choice';const letter=document.createElement('b');letter.textContent=['A','B','C','D'][i];const text=document.createElement('span');text.textContent=choice;b.append(letter,text);b.addEventListener('click',()=>answer(i));$('choices').append(b);});}
function answer(n){if(locked)return;locked=true;const q=set[index],ok=n===q.answer;if(ok){score++;record.correct++;record.wrong=record.wrong.filter(id=>id!==q.id);}else if(!record.wrong.includes(q.id))record.wrong.push(q.id);record.answered++;save();stats();[...$('choices').children].forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===n)b.classList.add('wrong');});const box=$('explanation');box.replaceChildren();const result=document.createElement('strong');result.textContent=ok?'正解':'不正解';const detail=document.createElement('p');detail.textContent=q.explanation;box.append(result,detail);if(q.link){const link=document.createElement('a');link.href=q.link;link.className='summary-link';link.textContent='関連する要点まとめを見る →';box.append(link);}box.hidden=false;$('next').disabled=false;}
function finish(){leaveQuizMode();$('quiz').hidden=true;$('result').hidden=false;$('score').textContent=score;$('max').textContent=set.length;$('resultMessage').textContent=score===set.length?'全問正解！すばらしい。':score/set.length>=.7?'いい調子。解説を確認して弱点をつぶそう。':'解説を読み直して、もう一度挑戦しよう。';$('progress').style.width='100%';}
$('start').addEventListener('click',start);$('retry').addEventListener('click',()=>{$('result').hidden=true;$('workspace').hidden=false;if(lastConfig){$('subject').value=lastConfig.subject;fillTopics();$('topic').value=lastConfig.topic;$('amount').value=lastConfig.amount;}start();});$('next').addEventListener('click',()=>{if(!locked)return;if(index===set.length-1)finish();else{index++;render();}});$('quit').addEventListener('click',()=>{leaveQuizMode();$('quiz').hidden=true;$('workspace').hidden=false;});stats();
</script>
<style>
.beta-banner{display:flex;align-items:center;gap:12px;margin-top:18px;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.beta-banner>b{padding:6px 8px;border-radius:6px;background:var(--accent);color:#fff;font-size:10px}.beta-banner strong{font-size:12px}.beta-banner p{font-size:10px;color:var(--muted);margin:3px 0 0}.kosen-page{max-width:880px;margin:0 auto;padding:28px 0 55px}.back{font-size:12px;color:var(--accent)}.hero{padding:34px 0 25px;border-bottom:1px solid var(--line)}.eyebrow{font:10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);font-weight:800;margin:0 0 10px}.hero-row{display:flex;justify-content:space-between;gap:18px;align-items:center}.hero h1{font-size:clamp(32px,6vw,48px);letter-spacing:-.06em;margin:0;font-weight:900}.hero p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.8;margin:9px 0 0}.live{font:10px ui-monospace,monospace;color:var(--accent);border:1px solid var(--line);border-radius:7px;padding:9px 11px;white-space:nowrap}.hero-stats{display:flex;gap:0;margin-top:24px}.hero-stats div{display:grid;gap:3px;padding:0 24px;border-left:1px solid var(--line)}.hero-stats div:first-child{padding-left:0;border:0}.hero-stats strong{font-size:22px}.hero-stats small{font-size:10px;color:var(--muted)}.source-note{margin:20px 0;padding:17px 19px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}.source-note strong{font-size:12px}.source-note p{font-size:11px;line-height:1.8;color:var(--muted);margin:7px 0}.source-note a{font-size:11px;color:var(--accent);font-weight:750}.data-sources{margin:12px 0 4px;font-size:11px;line-height:2;color:var(--muted)}.data-sources strong{color:var(--text)}.figure-credit{display:block;margin-top:8px;font-size:10px;color:var(--muted)}.workspace,.quiz,.result{margin-top:18px;padding:23px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.toolbar{display:flex;justify-content:space-between;gap:20px;align-items:center}.toolbar h2{font-size:20px;margin:0}.toolbar .eyebrow{margin-bottom:5px}.filters{display:flex;gap:10px}.filters label{display:grid;gap:5px;font-size:10px;color:var(--muted)}.filters select{min-width:110px;padding:9px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text)}.history{display:flex;gap:18px;flex-wrap:wrap;margin:20px 0;color:var(--muted);font-size:11px}.history b{color:var(--text);font-size:14px;margin-left:4px}.start{border:0;border-radius:9px;background:var(--accent);color:#fff;padding:13px 18px;font-size:12px;font-weight:800;cursor:pointer}.start span{margin-left:14px}.quiz[hidden],.result[hidden]{display:none}.quiz-meta{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px}.progress{height:6px;background:var(--line);border-radius:10px;margin:12px 0 25px;overflow:hidden}.progress i{display:block;height:100%;background:var(--accent);width:0;transition:width .2s}.quiz h2{font-size:clamp(18px,3vw,23px);line-height:1.8;margin:0 0 20px}.question-figure{margin:12px 0 22px;padding:12px;border:1px solid var(--line);border-radius:12px;background:#f5f8fb}.question-figure[hidden]{display:none}.question-figure img{display:block;width:100%;max-height:420px;object-fit:contain}.question-figure figcaption{margin-top:7px;text-align:center;font-size:10px;color:#52677a}.choices{display:grid;grid-template-columns:1fr 1fr;gap:10px}.choice{display:flex;align-items:center;gap:12px;text-align:left;padding:14px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text);font:inherit;line-height:1.7;cursor:pointer}.choice b{width:27px;height:27px;flex:none;display:grid;place-items:center;border-radius:7px;background:var(--surface-soft);font-size:11px}.choice.correct{border-color:#259b68;background:color-mix(in srgb,#259b68 12%,var(--surface))}.choice.wrong{border-color:#d94c59;background:color-mix(in srgb,#d94c59 12%,var(--surface))}.choice:disabled{cursor:default}.explanation{margin-top:17px;padding:16px;border-radius:9px;background:var(--surface-soft);font-size:12px;line-height:1.8}.explanation p{margin:6px 0 0}.summary-link{display:inline-flex;margin-top:10px;color:var(--accent);font-size:11px;font-weight:800;text-decoration:underline;text-underline-offset:3px}.quiz-actions{display:flex;justify-content:space-between;gap:10px;margin-top:20px}.secondary{padding:12px 16px;border:1px solid var(--line);border-radius:9px;background:var(--surface-soft);color:var(--text);font-size:12px}.start:disabled{opacity:.45;cursor:not-allowed}.result{text-align:center;padding:30px}.result h2{font-size:25px}.score strong{font-size:55px}.score span{color:var(--muted)}.result p:not(.eyebrow){font-size:12px;color:var(--muted)}.note{margin-top:22px;color:var(--muted);font-size:10px;line-height:1.7}@media(max-width:620px){.kosen-page{padding-top:20px}.hero-row{align-items:flex-start}.hero h1{font-size:34px}.hero-stats div{padding:0 14px}.toolbar{align-items:flex-start;flex-direction:column}.filters{width:100%}.filters label{flex:1}.filters select{width:100%;min-width:0}.workspace,.quiz,.result{padding:17px}.choices{grid-template-columns:1fr}}
</style>
</StudyLayout>
<style is="global">
html.kosen-quiz-active,html.kosen-quiz-active body{width:100%;height:100%;overflow:hidden}
html.kosen-quiz-active body{background:var(--bg)!important}
html.kosen-quiz-active .site-header,html.kosen-quiz-active .site-footer{display:none!important}
html.kosen-quiz-active body main{height:100vh;min-height:100vh}
html.kosen-quiz-active .kosen-page{width:100%;max-width:900px;height:100vh;margin:0 auto;padding:clamp(14px,4vh,42px) clamp(14px,4vw,48px);display:flex;align-items:center;justify-content:center}
html.kosen-quiz-active .kosen-page>.back,html.kosen-quiz-active .kosen-page>.hero,html.kosen-quiz-active .kosen-page>.beta-banner,html.kosen-quiz-active .kosen-page>.source-note,html.kosen-quiz-active .kosen-page>#workspace,html.kosen-quiz-active .kosen-page>.note,html.kosen-quiz-active .kosen-page>#result{display:none!important}
html.kosen-quiz-active #quiz{width:100%;max-height:100%;overflow:auto;margin:0;padding:clamp(20px,4vw,46px);border-radius:22px;display:flex;flex-direction:column;justify-content:center;gap:clamp(12px,2vh,22px)}
html.kosen-quiz-active #quiz[hidden],html.kosen-quiz-active #result[hidden]{display:none!important}
html.kosen-quiz-active #question{font-size:clamp(22px,3vw,34px);line-height:1.65;margin:0}
html.kosen-quiz-active .choices{gap:clamp(10px,1.6vw,18px)}
html.kosen-quiz-active .choice{min-height:clamp(76px,12vh,118px);font-size:clamp(14px,1.5vw,18px);padding:clamp(13px,2vw,22px);border-radius:16px}
html.kosen-quiz-active .quiz-actions{margin:0}
@media(max-width:620px){html.kosen-quiz-active .kosen-page{padding:10px}html.kosen-quiz-active #quiz{padding:16px 12px;gap:14px}html.kosen-quiz-active #question{font-size:20px}html.kosen-quiz-active .choices{grid-template-columns:1fr 1fr;gap:8px}html.kosen-quiz-active .choice{min-height:94px;padding:10px 8px;font-size:12px;gap:7px}}
</style>
