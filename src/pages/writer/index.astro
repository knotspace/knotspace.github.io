---
import Layout from '../../layouts/Layout.astro';
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const supabaseUrl = 'https://rtzorqaigpeechqywjie.supabase.co';
const supabaseKey = 'sb_publishable_-yhc0QqTEEZTBWi9jTcFRA_-AVi-iP6';
---
<Layout title="投稿者ページ | KNOT" description="KNOTの記事下書きを作成・編集。" noindex>
  <main class="writer">
    <a class="back" href={BASE + 'mypage/'}>← マイページ</a>
    <header><span class="eyebrow">KNOT WRITER SPACE</span><h1>記事を書く</h1><p>ここで作成した記事は下書きとして保存され、管理者の確認後に公開されます。</p></header>
    <section class="panel">
      <input id="title" maxlength="120" placeholder="記事タイトル" aria-label="記事タイトル" />
      <input id="description" maxlength="300" placeholder="記事の説明（300文字以内）" aria-label="記事の説明" />
      <select id="category" aria-label="カテゴリー"><option>その他</option><option>お知らせ</option><option>英検・勉強法</option><option>本・読書</option><option>高校受験</option><option>勉強法</option><option>ガジェット</option><option>アプリ・ソフト</option><option>日記</option></select>
      <textarea id="body" maxlength="50000" rows="16" placeholder="本文を書く（Markdown対応）" aria-label="本文"></textarea>
      <div class="editor-foot"><span id="count">0 / 50000</span><div><button id="save" type="button">下書き保存</button><button id="submit" type="button">確認を依頼</button></div></div>
      <p id="message" role="status"></p>
    </section>
    <section class="panel"><h2>自分の記事</h2><div id="entries" class="entries">読み込み中...</div></section>
  </main>
  <script define:vars={{ supabaseUrl, supabaseKey, base: BASE }}>
    const $ = (id) => document.getElementById(id);
    let session;
    let currentId = null;
    const getSession = () => { try { return JSON.parse(localStorage.getItem('knot-auth') || 'null'); } catch { return null; } };
    const headers = () => ({ apikey: supabaseKey, Authorization: 'Bearer ' + session.access_token, 'Content-Type': 'application/json' });
    async function request(path, options = {}) {
      const res = await fetch(supabaseUrl + path, { ...options, headers: { ...headers(), ...(options.headers || {}) } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.message || data.msg || data.error || '通信に失敗しました。');
      return data;
    }
    function clearEditor() { currentId = null; $('title').value=''; $('description').value=''; $('category').value='その他'; $('body').value=''; $('count').textContent='0 / 50000'; }
    function edit(item) { currentId=item.id; $('title').value=item.title; $('description').value=item.description || ''; $('category').value=item.category || 'その他'; $('body').value=item.body || ''; $('count').textContent=$('body').value.length+' / 50000'; window.scrollTo({top:0,behavior:'smooth'}); }
    async function save(status) {
      const title=$('title').value.trim(), body=$('body').value;
      if (!title || !body.trim()) { $('message').textContent='タイトルと本文を入力してね。'; return; }
      const payload={title,description:$('description').value.trim(),category:$('category').value,body,status,updated_at:new Date().toISOString()};
      try {
        $('save').disabled=true; $('submit').disabled=true; $('message').textContent='保存中...';
        if (currentId) await request('/rest/v1/knot_submissions?id=eq.'+encodeURIComponent(currentId),{method:'PATCH',headers:{Prefer:'return=minimal'},body:JSON.stringify(payload)});
        else { const rows=await request('/rest/v1/knot_submissions',{method:'POST',headers:{Prefer:'return=representation'},body:JSON.stringify({...payload,author_id:session.user.id})}); currentId=rows[0]?.id || null; }
        $('message').textContent=status==='submitted'?'管理者に確認を依頼したよ。':'下書きを保存したよ。';
        await loadEntries();
      } catch(e) { $('message').textContent=e.message; }
      finally { $('save').disabled=false; $('submit').disabled=false; }
    }
    async function loadEntries() {
      const rows=await request('/rest/v1/knot_submissions?select=id,title,status,updated_at&author_id=eq.'+encodeURIComponent(session.user.id)+'&order=updated_at.desc');
      const root=$('entries'); root.replaceChildren();
      if (!rows.length) { root.textContent='まだ記事はありません。'; return; }
      rows.forEach(item=>{
        const row=document.createElement('div'); row.className='entry';
        const info=document.createElement('div'); const title=document.createElement('strong'); title.textContent=item.title; const status=document.createElement('span'); status.textContent={draft:'下書き',submitted:'確認待ち',reviewed:'確認済み'}[item.status]||item.status; info.append(title,status);
        const button=document.createElement('button'); button.textContent='編集'; button.addEventListener('click',async()=>{try{const data=await request('/rest/v1/knot_submissions?id=eq.'+encodeURIComponent(item.id)+'&select=*');if(data[0])edit(data[0]);}catch(e){$('message').textContent=e.message;}});
        row.append(info,button); root.append(row);
      });
    }
    $('body').addEventListener('input',()=>{$('count').textContent=$('body').value.length+' / 50000';});
    $('save').addEventListener('click',()=>save('draft'));
    $('submit').addEventListener('click',()=>save('submitted'));
    (async()=>{
      session=getSession();
      if(!session?.access_token){location.replace(base+'account/');return;}
      try {
        const user=await request('/auth/v1/user'); session.user=user;
        const role=await request('/rest/v1/knot_writer_roles?select=user_id&user_id=eq.'+encodeURIComponent(user.id));
        if(!role.length){$('message').textContent='投稿者権限がありません。管理者からの招待を確認してね。';$('save').disabled=true;$('submit').disabled=true;return;}
        await loadEntries();
      } catch(e){$('message').textContent=e.message;}
    })();
  </script>
</Layout>
<style>
.writer{max-width:850px;margin:0 auto;padding:42px 0 80px}.back{color:var(--muted);font-size:12px}.writer header{margin:25px 0}.eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.16em}.writer h1{margin:8px 0;color:var(--text);font-size:38px;letter-spacing:-.06em}.writer header p{color:var(--muted);font-size:13px;line-height:1.8}.panel{margin:15px 0;padding:24px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}.panel input,.panel select,.panel textarea{display:block;width:100%;margin:0 0 12px;padding:13px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text);font:inherit;font-size:13px}.panel textarea{resize:vertical;line-height:1.8}.editor-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px}.editor-foot div{display:flex;gap:8px}.panel button{padding:10px 15px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text);font-size:12px;font-weight:700;cursor:pointer}.panel button:last-child{background:var(--accent);color:white;border-color:var(--accent)}.panel button:disabled{opacity:.5}.panel h2{margin:0 0 15px;color:var(--text);font-size:18px}#message{min-height:20px;color:var(--accent);font-size:12px}.entry{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-top:1px solid var(--line)}.entry div{display:grid;gap:5px}.entry strong{color:var(--text);font-size:13px}.entry span{color:var(--muted);font-size:11px}.entry button{background:transparent!important;color:var(--text)!important}@media(max-width:600px){.writer{padding:30px 0 60px}.panel{padding:17px}.editor-foot{align-items:flex-start;flex-direction:column}.writer h1{font-size:32px}}
</style>
