---
import Layout from '../../../layouts/Layout.astro';

const playgroundUrl = 'https://playground.wordpress.net/?language=ja&wp=latest&url=%2Fwp-admin%2F&page-title=KNOT%20WordPress';
---

<Layout title="WordPress編集室 | KNOT" description="WordPress Playgroundを使ったKNOTの記事編集室。" noindex={true}>
  <section class="wp-shell">
    <div class="wp-heading">
      <div>
        <p class="eyebrow">KNOT CONTENT STUDIO</p>
        <h1>WordPress編集室</h1>
        <p class="intro">本物のWordPressをブラウザ内で起動。ブロックエディターやメディアライブラリを使って記事を編集できます。</p>
      </div>
      <a class="open-button" href={playgroundUrl} target="_blank" rel="noopener noreferrer">別画面で大きく開く ↗</a>
    </div>

    <div class="bridge-link">
      <div><strong>記事をKNOTのブログへ公開する</strong><p>WordPressで書いた記事をXMLで書き出して、KNOT用の記事ファイルに変換できます。</p></div>
      <a href="/admin/wordpress/import/">記事を取り込む →</a>
    </div>

    <div class="notice">
      <strong>最初に知っておいてね</strong>
      <p>WordPressはこのブラウザ内で動作します。記事や画像はWordPress Playground側のブラウザ保存領域に保存され、KNOTの公開サイトへはまだ自動反映されません。ブラウザのデータ削除などで失われる可能性があるため、作業後はPlaygroundの「Export」からZIPバックアップを保存してください。</p>
    </div>

    <div class="frame-wrap">
      <iframe
        src={playgroundUrl}
        title="KNOT WordPress Playground"
        loading="eager"
        allow="clipboard-read; clipboard-write; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>

    <div class="bottom-note">
      <span>WordPress Playground · PHP WebAssembly · SQLite in browser</span>
      <a href="/admin/">従来のKNOT管理画面へ戻る</a>
    </div>
  </section>
</Layout>

<style>
  .wp-shell{width:min(1500px,calc(100% - 36px));margin:0 auto;padding:42px 0 56px}
  .wp-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:22px}
  .eyebrow{margin:0 0 8px;color:var(--accent);font-size:10px;font-weight:850;letter-spacing:.18em}
  h1{margin:0;color:var(--text);font-size:clamp(27px,4vw,38px);letter-spacing:-.045em}
  .intro{max-width:700px;margin:10px 0 0;color:var(--muted);font-size:13px;line-height:1.9}
  .open-button{flex:none;display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--text);font-size:12px;font-weight:800;text-decoration:none}
  .open-button:hover{border-color:var(--accent);color:var(--accent)}
  .bridge-link{display:flex;justify-content:space-between;align-items:center;gap:18px;margin:0 0 16px;padding:16px 18px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--text)}
  .bridge-link strong{font-size:13px}.bridge-link p{margin:4px 0 0;color:var(--muted);font-size:12px;line-height:1.7}
  .bridge-link a{flex:none;padding:10px 14px;border-radius:999px;background:var(--accent);color:white;text-decoration:none;font-size:12px;font-weight:800}
  .notice{margin:0 0 16px;padding:15px 18px;border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;background:var(--surface);color:var(--text)}
  .notice strong{font-size:12px}
  .notice p{margin:5px 0 0;color:var(--muted);font-size:12px;line-height:1.85}
  .frame-wrap{height:min(78vh,900px);min-height:620px;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:0 14px 42px rgba(0,0,0,.12)}
  iframe{display:block;width:100%;height:100%;border:0;background:#fff}
  .bottom-note{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:13px;color:var(--muted);font-size:11px}
  .bottom-note a{color:var(--accent);font-weight:700;text-decoration:none}
  @media(max-width:700px){.wp-shell{width:min(100% - 22px,1500px);padding-top:26px}.wp-heading{align-items:flex-start;flex-direction:column}.frame-wrap{height:75vh;min-height:560px;border-radius:10px}.notice{padding:12px 14px}}
</style>
