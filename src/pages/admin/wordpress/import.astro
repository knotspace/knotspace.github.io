---
import Layout from '../../../../layouts/Layout.astro';
---
<Layout title="WordPress記事をKNOTへ取り込む | KNOT" description="WordPressのエクスポートXMLをKNOTの記事ファイルに変換します。" noindex={true}>
  <main class="import-shell">
    <a class="back" href="/admin/wordpress/">← WordPress編集室へ戻る</a>
    <p class="eyebrow">KNOT PUBLISH BRIDGE</p>
    <h1>WordPressの記事をKNOTへ</h1>
    <p class="lead">WordPressの標準エクスポート（XML）を読み込み、KNOTのブログ記事ファイル（Markdown）に変換します。</p>

    <section class="steps">
      <h2>取り込み手順</h2>
      <ol>
        <li>WordPressで「ツール → エクスポート」を開く</li>
        <li>「すべてのコンテンツ」を選んでエクスポートファイルを保存</li>
        <li>ここにXMLファイルを読み込む</li>
        <li>変換されたMarkdownをダウンロードして、GitHubの <code>src/content/blog/</code> に追加する</li>
      </ol>
    </section>

    <section class="upload">
      <label for="wxr-file">WordPressエクスポートXML</label>
      <input id="wxr-file" type="file" accept=".xml,text/xml,application/xml">
      <p class="hint">ファイルはこのブラウザ内で処理します。サーバーへアップロードしません。</p>
      <button id="convert" type="button" disabled>記事を読み込む</button>
      <p id="status" role="status" aria-live="polite">XMLファイルを選択してください。</p>
    </section>

    <section id="results" class="results" hidden>
      <div class="result-head"><h2>変換結果</h2><button id="download-all" type="button" class="secondary">すべてダウンロード</button></div>
      <p id="summary"></p>
      <div id="files" class="files"></div>
      <p class="footnote">※ WordPressの本文はHTMLブロックとして保持します。KNOT側で安全なタグだけを表示します。画像URLはWordPress側のURLを参照するため、画像も長期公開する場合はKNOT側へ移す必要があります。</p>
    </section>
  </main>
</Layout>

<script>
const input = document.querySelector('#wxr-file');
const convert = document.querySelector('#convert');
const status = document.querySelector('#status');
const results = document.querySelector('#results');
const filesEl = document.querySelector('#files');
const summary = document.querySelector('#summary');
const downloadAll = document.querySelector('#download-all');
let converted = [];

input?.addEventListener('change', () => {
  convert.disabled = !input.files?.[0];
  status.textContent = input.files?.[0] ? input.files[0].name + ' を選択しました。' : 'XMLファイルを選択してください。';
});

function textOf(node, selector) {
  return node.getElementsByTagName(selector)[0]?.textContent?.trim() ?? '';
}
function slugify(value) {
  const ascii = value.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return ascii || 'wordpress-' + Math.random().toString(36).slice(2, 9);
}
function yamlString(value) { return JSON.stringify(String(value ?? '')); }
function safeDate(value) {
  const date = new Date(value.replace(' ', 'T') + (/[zZ]|[+-]\d\d:\d\d$/.test(value) ? '' : 'Z'));
  return Number.isNaN(date.getTime()) ? new Date().toISOString() : date.toISOString();
}
function makeMarkdown(post) {
  const front = [
    '---',
    'title: ' + yamlString(post.title || '無題の記事'),
    'description: ' + yamlString(post.description || post.title || ''),
    'pubDate: ' + yamlString(post.date),
    'category: ' + yamlString('BLOG'),
    'blocks: ' + JSON.stringify([{ type: 'wordpress', html: post.html || '<p>本文はありません。</p>' }]),
    '---',
    '',
  ];
  return front.join('\n');
}
function download(file) {
  const blob = new Blob([file.content], {type:'text/markdown;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = file.name; document.body.append(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}
convert?.addEventListener('click', async () => {
  const file = input.files?.[0];
  if (!file) return;
  convert.disabled = true; status.textContent = 'XMLを解析しています…';
  try {
    const xml = new DOMParser().parseFromString(await file.text(), 'application/xml');
    if (xml.querySelector('parsererror')) throw new Error('XMLを読み取れません。WordPressのエクスポートXMLか確認してください。');
    const items = [...xml.getElementsByTagName('item')];
    const posts = items.map(item => {
      const type = textOf(item, 'wp:post_type');
      const state = textOf(item, 'wp:status');
      if (type !== 'post' || state !== 'publish') return null;
      const title = textOf(item, 'title') || '無題の記事';
      const content = item.getElementsByTagName('content:encoded')[0]?.textContent ?? '';
      const excerpt = item.getElementsByTagName('excerpt:encoded')[0]?.textContent ?? '';
      const date = safeDate(textOf(item, 'wp:post_date'));
      const originalSlug = textOf(item, 'wp:post_name');
      const slug = slugify(originalSlug || title);
      return {title, description: excerpt.replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim().slice(0,180), html:content, date, slug};
    }).filter(Boolean);
    if (!posts.length) throw new Error('公開済みのブログ記事が見つかりませんでした。エクスポート対象に「投稿」が含まれているか確認してください。');
    const used = new Set();
    converted = posts.map((post, index) => {
      let slug = post.slug;
      if (used.has(slug)) slug += '-' + (index + 1);
      used.add(slug);
      return {name: slug + '.md', content: makeMarkdown(post), title:post.title};
    });
    filesEl.replaceChildren();
    converted.forEach(file => {
      const row = document.createElement('div'); row.className = 'file-row';
      const label = document.createElement('span'); label.textContent = file.title + ' · ' + file.name;
      const button = document.createElement('button'); button.type = 'button'; button.textContent = 'ダウンロード';
      button.addEventListener('click', () => download(file));
      row.append(label, button); filesEl.append(row);
    });
    summary.textContent = converted.length + '件の記事を変換しました。';
    results.hidden = false;
    status.textContent = '変換が完了しました。';
  } catch (error) {
    status.textContent = error.message || '変換に失敗しました。';
    results.hidden = true;
  } finally { convert.disabled = false; }
});
downloadAll?.addEventListener('click', () => converted.forEach((file, index) => setTimeout(() => download(file), index * 250)));
</script>

<style>
.import-shell{width:min(900px,calc(100% - 32px));margin:0 auto;padding:38px 0 70px;color:var(--text)}
.back{display:inline-block;margin-bottom:28px;color:var(--muted);font-size:12px;text-decoration:none}
.eyebrow{margin:0 0 8px;color:var(--accent);font-size:10px;font-weight:850;letter-spacing:.18em}
h1{margin:0;font-size:clamp(27px,4vw,38px);letter-spacing:-.04em}
.lead{color:var(--muted);line-height:1.9;font-size:13px;margin:12px 0 26px}
.steps,.upload,.results{padding:20px;border:1px solid var(--line);border-radius:14px;background:var(--surface);margin-top:16px}
h2{font-size:16px;margin:0 0 12px}
.steps ol{padding-left:22px;margin:0;color:var(--muted);font-size:13px;line-height:2}
code{font-size:12px}
.upload label{display:block;font-size:13px;font-weight:800;margin-bottom:10px}
input[type=file]{display:block;width:100%;padding:12px;border:1px dashed var(--line);border-radius:9px;background:var(--surface);color:var(--text)}
.hint,.footnote{color:var(--muted);font-size:11px;line-height:1.8}
button{border:0;border-radius:9px;padding:11px 17px;background:var(--accent);color:white;font-weight:800;cursor:pointer}
button:disabled{opacity:.4;cursor:not-allowed}
#status{font-size:12px;color:var(--muted);min-height:1.5em}
.result-head{display:flex;justify-content:space-between;align-items:center;gap:12px}
.result-head h2{margin:0}
.secondary,.file-row button{background:transparent;color:var(--accent);border:1px solid var(--line);padding:8px 12px;font-size:11px}
#summary{font-size:13px;color:var(--muted)}
.files{display:grid;gap:8px}
.file-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px;border:1px solid var(--line);border-radius:9px;font-size:12px;min-width:0}
.file-row span{overflow-wrap:anywhere}
@media(max-width:600px){.import-shell{padding-top:24px}.steps,.upload,.results{padding:15px}.result-head{align-items:flex-start;flex-direction:column}.file-row{align-items:flex-start;flex-direction:column}}
</style>
