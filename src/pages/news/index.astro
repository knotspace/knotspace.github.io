---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const now = new Date();
const lastUpdated = (post) => new Date(Math.max(post.data.pubDate.valueOf(), post.data.updatedDate?.valueOf() ?? 0));
const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
const aiPosts = (await getCollection('blog'))
  .filter((post) => (post.data.aiGenerated || post.data.contentType === 'trend' || (post.body ?? '').trimStart().startsWith('**AI生成記事**')) && (!post.data.publishAt || post.data.publishAt <= now))
  .sort((a, b) => lastUpdated(b).valueOf() - lastUpdated(a).valueOf() || b.id.localeCompare(a.id));
const todayPosts = aiPosts.filter((post) => {
  const date = lastUpdated(post);
  return new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(date) === today;
});
const archivePosts = aiPosts;
const dateLabel = (date: Date) => date.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
const timeLabel = (date: Date) => date.toLocaleTimeString('ja-JP', { timeZone: 'Asia/Tokyo', hour: '2-digit', minute: '2-digit' });
const readingTime = (body = '') => Math.max(1, Math.ceil(body.length / 1000));
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const newsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'KNOT NEWS｜AI生成記事',
  description: 'KNOTがAIを活用して作成したニュース・トレンド記事。今日の更新と過去の記事を掲載。',
  url: new URL('/news/', Astro.site ?? Astro.url).href,
  inLanguage: 'ja-JP',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: aiPosts.length,
    itemListElement: aiPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url).href,
      name: post.data.title,
    })),
  },
};
const newsBreadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://knotspace.github.io/' },
    { '@type': 'ListItem', position: 2, name: 'NEWS｜AI生成記事', item: 'https://knotspace.github.io/news/' },
  ],
};
---
<Layout title="NEWS｜AI生成ニュース・トレンド記事 | KNOT" description="KNOTがAIを活用して作成したニュース・トレンド記事を掲載。今日更新した記事と、これまでに生成した記事をまとめて確認できます。" structuredData={[newsJsonLd, newsBreadcrumbJsonLd]}>
  <main class="ai-news">
    <header class="ai-news-head">
      <div class="ai-news-topline"><a href={BASE}>KNOT.</a><span>AI-ASSISTED NEWS & TREND DESK</span><span>{today.replaceAll('-', '.')}</span></div>
      <div class="ai-news-title"><span class="ai-news-kicker">NEWS / AI GENERATED ARTICLES</span><h1>News<span>.</span></h1><p>AIを活用して作成したニュース・トレンド記事をまとめています。</p></div>
      <nav class="ai-news-nav" aria-label="News内ナビゲーション"><a href="#today">今日の更新 <b>{todayPosts.length}</b></a><a href="#archive">これまでの記事 <b>{aiPosts.length}</b></a><a href={`${BASE}blog/`}>通常の記事一覧 ↗</a></nav>
    </header>

    <section class="ai-news-section" id="today">
      <div class="ai-news-section-heading"><div><span>TODAY / {today.replaceAll('-', '.')}</span><h2>今日更新した記事</h2></div><small>{todayPosts.length} ARTICLES</small></div>
      {todayPosts.length > 0 ? <div class="ai-news-grid">
        {todayPosts.map((post, index) => <a class="ai-news-card ai-news-card-feature" href={`${BASE}blog/${post.id}/`}>
          <div class="ai-news-thumb">{post.data.heroImage ? <img src={post.data.heroImage} alt="" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" width="720" height="420" /> : <span>NEWS / {String(index + 1).padStart(2,'0')}</span>}<b>AI GENERATED</b></div>
          <div class="ai-news-card-copy"><div class="ai-news-meta"><span>{post.data.category}</span><time datetime={lastUpdated(post).toISOString()}>{dateLabel(lastUpdated(post))} {timeLabel(lastUpdated(post))}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="ai-news-card-foot"><span>AI生成記事</span><span>約{readingTime(post.body)}分 ↗</span></div></div>
        </a>)}
      </div> : <div class="ai-news-empty"><strong>今日の新しい記事はまだありません。</strong><p>新しいAI生成記事が公開されると、ここに自動で表示されます。過去の記事は下の一覧から読めます。</p></div>}
    </section>

    <section class="ai-news-section ai-news-archive" id="archive">
      <div class="ai-news-section-heading"><div><span>ALL STORIES / ARCHIVE</span><h2>これまでに生成した記事</h2></div><small>{aiPosts.length} ARTICLES</small></div>
      <div class="ai-news-list">
        {archivePosts.map((post) => <a class="ai-news-row" href={`${BASE}blog/${post.id}/`}>
          <div class="ai-news-row-date"><time datetime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}>{dateLabel(post.data.updatedDate ?? post.data.pubDate)}</time><span>{timeLabel(post.data.updatedDate ?? post.data.pubDate)}</span></div>
          <div class="ai-news-row-content"><div class="ai-news-meta"><span>{post.data.category}</span><b>AI生成記事</b></div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="ai-news-arrow">↗</span>
        </a>)}
      </div>
      {aiPosts.length === 0 && <p class="ai-news-empty">公開中のAI生成記事はまだありません。</p>}
    </section>
    <footer class="ai-news-footer"><a href={BASE}>KNOT.</a><span>AIを活用して作成した記事を掲載しています。内容・数値は必ず参照元もご確認ください。</span><a href={`${BASE}blog/`}>通常の記事一覧へ ↗</a></footer>
  </main>
</Layout>

<style>
:global(html:has(.ai-news)){background:#f5f5f2;color:#191a1b}
:global(html:has(.ai-news) body){background:#f5f5f2;color:#191a1b}
:global(html:has(.ai-news) .site-header){max-width:1180px;background:transparent;border:0;border-bottom:1px solid #d8d8d2;border-radius:0;box-shadow:none}
:global(html:has(.ai-news) .site-footer){display:none}
.ai-news{--ink:#191a1b;--muted:#737570;--line:#d9dad5;--accent:#d34c3f;max-width:1180px;margin:auto;padding:12px 28px 50px;color:var(--ink);font-family:Arial,"Noto Sans JP",sans-serif}
.ai-news a{color:inherit;text-decoration:none}
.ai-news-topline{display:flex;justify-content:space-between;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);font:10px ui-monospace,monospace;letter-spacing:.12em;color:var(--muted)}
.ai-news-topline a{font:900 17px Arial,sans-serif;letter-spacing:-.07em;color:var(--ink)}
.ai-news-title{padding:54px 0 36px;border-bottom:1px solid var(--line)}
.ai-news-kicker,.ai-news-section-heading>div>span{font:10px ui-monospace,monospace;letter-spacing:.17em;color:var(--accent);font-weight:700}
.ai-news-title h1{font-size:clamp(66px,12vw,130px);letter-spacing:-.1em;line-height:.9;margin:17px 0 15px;font-weight:950}
.ai-news-title h1 span{color:var(--accent)}
.ai-news-title p{font-size:14px;color:var(--muted);margin:0}
.ai-news-nav{display:flex;gap:25px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line);font-size:11px;font-weight:700}
.ai-news-nav a:hover,.ai-news-row:hover h3{color:var(--accent)}
.ai-news-nav b{margin-left:5px;color:var(--accent)}
.ai-news-section{padding:44px 0 20px}
.ai-news-section-heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:20px}
.ai-news-section-heading h2{font-size:clamp(24px,3vw,34px);letter-spacing:-.05em;margin:9px 0 0}
.ai-news-section-heading>small{font:10px ui-monospace,monospace;color:var(--muted)}
.ai-news-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.ai-news-card{display:block;border:1px solid var(--line);background:#fff;min-width:0;transition:transform .2s,box-shadow .2s}
.ai-news-card:hover{transform:translateY(-3px);box-shadow:0 12px 30px #0000000b}
.ai-news-thumb{height:210px;position:relative;background:#e6e6e1;overflow:hidden;display:grid;place-items:center}
.ai-news-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.ai-news-thumb>span{font:800 25px Arial;color:#888}
.ai-news-thumb>b{position:absolute;left:12px;bottom:12px;background:#191a1b;color:#fff;padding:6px 9px;font:9px ui-monospace,monospace;letter-spacing:.12em}
.ai-news-card-copy{padding:19px 20px 17px}
.ai-news-meta{display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:10px;color:var(--muted)}
.ai-news-meta>span{color:var(--accent);font-weight:800}
.ai-news-meta time{font-variant-numeric:tabular-nums}
.ai-news-card h3{font-size:19px;line-height:1.55;letter-spacing:-.03em;margin:12px 0 8px}
.ai-news-card-copy>p,.ai-news-row-content>p{font-size:12px;line-height:1.9;color:var(--muted);margin:0}
.ai-news-card-foot{display:flex;justify-content:space-between;margin-top:17px;padding-top:12px;border-top:1px solid #eee;font-size:10px;color:var(--muted)}
.ai-news-card-foot span:first-child{color:var(--accent);font-weight:800}
.ai-news-empty{border:1px dashed #c8c9c3;padding:25px;background:#fff}
.ai-news-empty p{font-size:12px;color:var(--muted);line-height:1.8}
.ai-news-archive{border-top:1px solid var(--line);margin-top:40px}
.ai-news-list{border-top:1px solid var(--line)}
.ai-news-row{display:grid;grid-template-columns:120px minmax(0,1fr) 22px;gap:22px;padding:20px 8px;border-bottom:1px solid var(--line);align-items:center}
.ai-news-row-date{display:flex;flex-direction:column;gap:5px;font-size:11px;font-variant-numeric:tabular-nums}
.ai-news-row-date span{font-size:10px;color:var(--muted)}
.ai-news-row-content h3{font-size:17px;line-height:1.5;margin:7px 0 5px}
.ai-news-meta b{font-size:9px;color:var(--accent);border:1px solid #e5b8b1;padding:2px 6px;font-weight:700}
.ai-news-arrow{font-size:18px;color:var(--muted)}
.ai-news-footer{display:flex;justify-content:space-between;gap:20px;align-items:center;border-top:1px solid var(--line);padding:24px 0 0;margin-top:40px;font-size:10px;color:var(--muted)}
.ai-news-footer>a:first-child{font-size:17px;font-weight:900;color:var(--ink)}
.ai-news-footer>a:last-child{font-weight:800;color:var(--ink);white-space:nowrap}
@media(max-width:700px){.ai-news{padding:8px 16px 35px}.ai-news-topline{font-size:8px;flex-wrap:wrap}.ai-news-title{padding:43px 0 28px}.ai-news-title p{font-size:12px;line-height:1.8}.ai-news-nav{gap:14px;overflow-x:auto;font-size:10px;white-space:nowrap}.ai-news-section{padding-top:32px}.ai-news-grid{grid-template-columns:1fr;gap:14px}.ai-news-thumb{height:190px}.ai-news-row{grid-template-columns:1fr 20px;gap:7px;padding:17px 2px}.ai-news-row-date{grid-column:1/-1;flex-direction:row;align-items:center}.ai-news-row-content h3{font-size:15px}.ai-news-footer{align-items:flex-start;flex-direction:column;gap:12px;line-height:1.7}}
</style>
