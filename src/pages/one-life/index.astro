  else if(isLowChoicePeriod())$('clock-message').textContent='この時期は選択が少ないため、時間が自動で2倍速になります。';
 e.opts.forEach((o,i)=>{if(automatic)return;const b=document.createElement('button');b.className='choice-button';const strong=document.createElement('strong');strong.textContent=String.fromCharCode(65+i)+'. '+o.label;const small=document.createElement('small');small.textContent='この道を選ぶ';b.append(strong,small);b.disabled=!canAnswer;b.classList.toggle('is-disabled',!canAnswer);b.addEventListener('click',()=>choose(o));box.append(b);});
 $('diary-list').replaceChildren();state.diary.slice(-5).forEach(x=>{const li=document.createElement('li');li.textContent=x.title+' — '+x.log;$('diary-list').append(li);});
}
function choose(o){
 state.lastExamResult=null;
 Object.entries(o.effect||{}).forEach(([k,v])=>state.stats[k]=clamp(state.stats[k]+v));
 const randomEvents=[
  {title:'思いがけない出会い',log:'新しい人との出会いが、考え方を少し変えてくれた。',effect:{friends:6,happiness:4,experience:3}},
  {title:'小さな成功体験',log:'続けてきたことが形になり、自信につながった。',effect:{study:4,happiness:7}},
  {title:'体調を崩す',log:'無理が重なり、休むことの大切さを知った。',effect:{health:-8,happiness:-3}},
  {title:'夢中になれることを発見',log:'時間を忘れて取り組めることに出会った。',effect:{experience:7,happiness:6}},
  {title:'思うようにいかない日',log:'悔しい経験をしたが、次に向けて考えるきっかけになった。',effect:{happiness:-4,experience:4}},
  {title:'誰かに支えられる',log:'困ったときに手を差し伸べてくれる人がいた。',effect:{friends:5,happiness:6}}
 ];
 if(Math.random()<0.24){const event=randomEvents[Math.floor(Math.random()*randomEvents.length)];Object.entries(event.effect).forEach(([k,v])=>state.stats[k]=clamp(state.stats[k]+v));state.diary.push({title:event.title,log:event.log,choice:'人生の出来事'});}

 if(o.decision){
   const decision={...o.decision};
   const current=stages[state.step];
   if(['EXAM','UNIVERSITY EXAM','VOCATIONAL EXAM'].includes(current.tag)){
     const school=state.pendingSchool;
     if(school){
       const target=schoolDeviation(school) ?? (current.tag==='UNIVERSITY EXAM'?55:50);
       const examScore=35+state.stats.study*0.62+(Math.random()*12-6);
       const passed=examScore>=target;
       const result=passed?'pass':'fail';
       if(decision.examResult)decision.examResult=result;
       if(decision.highResult)decision.highResult=result;
       if(decision.uniResult)decision.uniResult=result;
       if(decision.vocationalResult)decision.vocationalResult=result;
       decision.selectedSchool={schoolCode:school.schoolCode,name:school.name,prefecture:school.prefecture,schoolType:school.schoolType,deviation:schoolDeviation(school)};
       state.lastExamResult={passed,school:school.name,score:Math.round(examScore),target};state.diary.push({title:'受験結果',log:school.name+'を受験。'+(passed?'合格！':'不合格。')+'（判定 '+Math.round(examScore)+' / 目安 '+target+'）',choice:passed?'合格':'不合格'});
       state.pendingSchool=null;
     }
   }
   Object.assign(state.decisions,decision);
 }
 const e=stages[state.step];state.diary.push({title:e.title,log:o.log,choice:o.label});
 if(state.lastExamResult)state.lastExamResult=null;
 state.step++;buildStages();
 state.yearRemaining=clockYearLength();state.waitingChoice=false;state.paused=false;
 try{localStorage.setItem('knot-life-sim-v2',JSON.stringify(state));}catch{}
 render();startClock();
}
function finish(){
 stopClock();$('game-screen').hidden=true;$('result-screen').hidden=false;
 const d=state.decisions,s=state.stats;
 let route=d.career==='university'?'大学進学':d.career==='vocational'?'専門学校':d.career==='work'?'就職':'起業';
 if(d.afterStudy==='startup')route='学びを経て起業';if(d.afterStudy==='work')route='学びを経て就職';
 if(d.education==='middle')route=(d.career==='work'?'中卒で就職':d.career==='vocational'?'中卒後に専門技術を学ぶ':'中卒後に起業');
 let title=s.experience>75?'挑戦を重ね、自分の道を切り開いた。':s.study>75?'学びを力に変えた人生。':s.friends>75?'人とのつながりに恵まれた人生。':'自分の選択で歩んだ人生。';
 $('ending-title').textContent=title;
 $('ending-copy').textContent=(state.name?state.name+'さん':'あなた')+'は、誕生から'+state.deathAge+'歳までの人生を歩んだ。35歳までは自分で選択し、36歳からは時の流れに身を任せながら、出会い、仕事、暮らし、さまざまな出来事を重ねた。最終的には「'+route+'」の道を歩み、'+state.deathAge+'歳で人生の幕を閉じた。';
 $('result-stats').replaceChildren();[['学力',s.study],['経験',s.experience],['健康',s.health],['幸福',s.happiness],['人とのつながり',s.friends]].forEach(([k,v])=>{const el=document.createElement('div'),b=document.createElement('b'),sp=document.createElement('span');b.textContent=v;sp.textContent=k;el.append(b,sp);$('result-stats').append(el);});
 $('result-reflection').textContent='35歳までに自分で選んだ道と、その後に訪れた予想外の出来事。そのすべてが、この人生を形づくった。学力や収入だけでは測れない、あなただけの一生だった。';
 const achievements=[];
 if(s.study>=70)achievements.push('学びを積み重ねた');
 if(s.experience>=70)achievements.push('挑戦を重ねた');
 if(s.health>=70)achievements.push('自分の健康を守った');
 if(s.happiness>=70)achievements.push('幸福を育てた');
 if(s.friends>=70)achievements.push('人とのつながりを育てた');
