   const note=document.createElement('small');note.textContent=state.lastExamResult.passed?'おめでとう！選んだ学校への進学ルートに進みます。':'今回は不合格。ここから別の進路を選べます。';
   banner.append(label,detail,note);
 }else banner.hidden=true;
