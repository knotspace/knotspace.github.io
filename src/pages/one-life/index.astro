     const empty=document.createElement('p');empty.className='picker-empty';
     empty.textContent=schoolsLoaded?state.prefecture+'の'+examType+'データは見つかりませんでした。別の都道府県を選ぶか、学校データの更新を待ってね。':'全国の学校データを読み込んでいます。少し待ってね。';
     picker.append(empty);
