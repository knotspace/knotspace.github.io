function stopClock(){if(clockHandle){clearInterval(clockHandle);clockHandle=null;}}
function clockYearLength(){return (Number(state?.durationMinutes)||30)*60000/Math.max(1,state?.estimatedYears||20);}
function isLowChoicePeriod(e=stages[state?.step]){return !!e&&!e.automatic&&!getExamType(e.tag)&&(e.opts?.length??0)<=2;}
function startClock(){
 stopClock();if(!state||$('game-screen').hidden||state.paused||state.waitingChoice)return;
 lastClockTick=Date.now();
 clockHandle=setInterval(()=>{
  if(!state||state.paused||state.waitingChoice)return;
  const now=Date.now(),delta=Math.min(1000,now-lastClockTick);lastClockTick=now;
  const periodSpeed=isLowChoicePeriod()?2:1;
   state.yearRemaining=Math.max(0,(state.yearRemaining??clockYearLength())-delta*(state.speed||1)*periodSpeed);
  const total=clockYearLength(),pct=Math.max(0,Math.min(100,(1-state.yearRemaining/total)*100));
  $('year-time-label').textContent=state.yearRemaining>0?Math.ceil(state.yearRemaining/1000)+'秒':'決断の時間';
  $('year-time-bar').style.width=pct+'%';
  if(state.yearRemaining<=0){
   stopClock();state.waitingChoice=true;
   const automatic=!!stages[state.step]?.automatic;
   $('clock-message').textContent=automatic?'36歳以降の人生が5倍速で自動進行しています。':state.auto?'おまかせで今年の選択を進めます。':isLowChoicePeriod()?'この時期は選択が少ないため、時間が自動で2倍速になります。':'今年の時間が経過した。選択肢から次の道を決めよう。';
   if(state.auto||automatic)chooseAutomatically();
   else {
    $('pause-game').textContent='再開';
    const canChoose=!getExamType(stages[state.step]?.tag)||!!state.pendingSchool;
    document.querySelectorAll('.choice-button').forEach(button=>button.disabled=!canChoose);
    try{localStorage.setItem('knot-life-sim-v2',JSON.stringify(state));}catch{}
   }
  }
 },250);
}
function updateClockUI(){
 const automatic=!!stages[state.step]?.automatic;
 if(automatic)state.speed=5;
 const total=clockYearLength();state.yearRemaining=state.yearRemaining??total;
 $('year-time-label').textContent=Math.ceil(state.yearRemaining/1000)+'秒';
 $('year-time-bar').style.width=Math.max(0,Math.min(100,(1-state.yearRemaining/total)*100))+'%';
 $('pause-game').textContent=state.waitingChoice?'決断待ち':state.paused?'再開':'一時停止';$('pause-game').disabled=!!state.waitingChoice;
 $('auto-choice').checked=!!state.auto;
 document.querySelectorAll('[data-speed]').forEach(b=>{b.classList.toggle('active',Number(b.dataset.speed)===(state.speed||1));b.disabled=automatic;});
 $('auto-choice').disabled=automatic;
}
function chooseAutomatically(){
 const current=stages[state.step];if(!current?.opts?.length)return;
 const type=getExamType(current.tag);
 if(type&&!state.pendingSchool){
  const available=schoolsForExam(current.tag);
  if(available.length)state.pendingSchool=available[Math.floor(Math.random()*available.length)];
  else {state.waitingChoice=true;state.auto=false;$('auto-choice').checked=false;$('clock-message').textContent='学校データを読み込めないため、受験校を選んでください。';render();return;}
 }
 choose(current.opts[Math.floor(Math.random()*current.opts.length)]);
}
function updateStats(){
 for(const k of ['study','experience','health','happiness','friends']){$('stat-'+k).textContent=state.stats[k];$('bar-'+k).style.width=state.stats[k]+'%';}
 $('progress-label').textContent=(state.step+1)+' / '+stages.length;$('progress-bar').style.width=((state.step+1)/stages.length*100)+'%';
 const e=stages[state.step];$('year-label').textContent=e.year;$('term-label').textContent=e.season;
}
function getExamType(tag){
 if(tag==='EXAM' && state.decisions.middleExam && !state.decisions.examResult) return '中学校';
 if(tag==='EXAM' && state.decisions.highExam && !state.decisions.highResult) return '高等学校';
 if(tag==='UNIVERSITY EXAM') return '大学';
 if(tag==='VOCATIONAL EXAM') return '専門学校';
 return null;
}
function schoolsForExam(tag){
 const type=getExamType(tag);
 if(!type)return [];
 const pref=state.examPrefecture||state.prefecture;
 return schoolRecords.filter(x=>{
   const t=String(x.schoolType||'');
   const match=type==='中学校' ? (/中学校|中等教育学校/.test(t) && (x.integratedSchool || /中等教育学校/.test(t) || x.ownership==='私立')) :
     type==='高等学校' ? /高等学校|中等教育学校|高等専門学校/.test(t) : type==='専門学校' ? /専修学校|各種学校/.test(t) : /大学/.test(t);
   return match && (!pref || x.prefecture===pref);
 }).sort((a,b)=>(schoolDeviation(b)||0)-(schoolDeviation(a)||0));
}
function schoolDeviation(s){
 const n=Number(s.deviation ?? s.deviationValue ?? s.hensachi ?? deviationMap.get(normalizeSchoolName(s.name))?.deviation);
 return Number.isFinite(n)&&n>0?n:null;
}
