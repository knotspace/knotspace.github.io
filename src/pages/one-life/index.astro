 if(d.highResult==='pass')achievements.push('高校受験に合格');
 if(d.uniResult==='pass')achievements.push('大学受験に合格');
 if(d.vocationalResult==='pass')achievements.push('専門学校に合格');
 if(d.career==='startup'||d.afterStudy==='startup')achievements.push('起業に挑戦');
 $('achievement-list').replaceChildren();
 const achTitle=document.createElement('h3');achTitle.textContent='この人生で獲得した記録';$('achievement-list').append(achTitle);
 achievements.forEach(label=>{const badge=document.createElement('span');badge.textContent='✦ '+label;$('achievement-list').append(badge);});

 let future='この人生は'+state.deathAge+'歳で幕を閉じた。選んだ道も、選ばなかった道も含め、歩んだ時間のすべてがこの人生の記録として残る。';
 if(d.education==='middle')future='中学校卒業後に選んだ道から、働きながら技術を身につける、定時制・通信制などで学び直す、資格を取る、転職するなどの選択肢が広がっていく。中卒であることだけで未来が決まるわけではない。';
 else if(d.career==='startup'||d.afterStudy==='startup')future='事業を3年間続けた経験は、成功・失敗にかかわらず大きな財産になる。顧客を理解する力、資金を管理する力、仲間と進める力を活かして、事業を育てる・方向転換する・就職して経験を活かすなどの未来が考えられる。';
 else if(d.career==='university')future='大学で得た知識や出会いを土台に、仕事で専門性を磨く道も、別の分野へ進む道もある。学び直しや転職も含め、選択肢はこれからも増やせる。';
 else if(d.career==='vocational')future='専門学校で身につけた技術と現場経験を重ね、専門職として成長する道がある。経験を積んで独立したり、別の技術を学び直したりする未来も考えられる。';
 $('future-copy').textContent=future;
 $('final-diary').replaceChildren();state.diary.forEach((x,i)=>{const li=document.createElement('li'),b=document.createElement('b'),p=document.createElement('p');b.textContent=String(i+1).padStart(2,'0')+' / '+x.title;p.textContent=x.log;li.append(b,p);$('final-diary').append(li);});
 try{
  const key='one-life-archive-v1',archive=JSON.parse(localStorage.getItem(key)||'[]');
  if(!state.archived){archive.unshift({name:state.name||'名もない人生',route,completedAt:new Date().toISOString(),stats:{...s},years:state.diary.length});localStorage.setItem(key,JSON.stringify(archive.slice(0,10)));state.archived=true;}
  localStorage.removeItem('knot-life-sim-v2');
 }catch{}
}
function start(){
 const t=document.querySelector('input[name="talent"]:checked')?.value||'balanced';
 const stats=t==='curious'?{study:48,experience:35,health:72,happiness:48,friends:32}:t==='social'?{study:35,experience:42,health:78,happiness:60,friends:48}:{study:40,experience:35,health:75,happiness:52,friends:38};
