ify-content:space-between;gap:15px;padding:17px 0}.game-top h2{font-size:25px;margin:4px 0}.game-top p:not(.eyebrow){font-size:11px;color:var(--muted);margin:0}.progress-wrap{width:min(180px,35%);font:10px ui-monospace,monospace;color:var(--muted)}.progress-track{height:6px;margin-top:8px;border-radius:8px;background:var(--surface-soft);overflow:hidden}.progress-track i{display:block;height:100%;width:0;background:var(--accent);transition:width .25s}.stats-panel{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:14px;border:1px solid var(--line);border-radius:13px;background:var(--surface)}.stats-panel>div{display:grid;grid-template-columns:1fr auto;gap:5px;align-items:center}.stats-panel span{font-size:10px;color:var(--muted)}.stats-panel strong{font-size:17px;font-variant-numeric:tabular-nums}.stats-panel i{grid-column:1/-1;height:5px;border-radius:5px;background:var(--surface-soft);overflow:hidden}.stats-panel i b{display:block;height:100%;width:45%;background:var(--accent);border-radius:5px}.event-card{margin-top:13px;padding:23px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 7%,var(--surface)),var(--surface))}.event-meta{display:flex;justify-content:space-between;font:9px ui-monospace,monospace;letter-spacing:.12em;color:var(--accent)}.event-scene{font-size:12px;color:var(--muted);line-height:1.8;margin:25px 0 5px}.event-card h3{font-size:clamp(22px,4vw,29px);letter-spacing:-.04em;margin:7px 0}.event-description{font-size:13px;line-height:1.9;color:var(--muted);margin:8px 0 19px}.choices{display:grid;gap:9px}.choice-button{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--text);text-align:left;cursor:pointer;font:inherit}.choice-button:hover{border-color:var(--accent)}.choice-button strong{font-size:12px}.choice-button small{font-size:9px;color:var(--muted);white-space:nowrap}.diary-log{margin:17px 0;padding:16px;border:1px solid var(--line);border-radius:12px}.diary-log h3,.timeline-heading{font-size:13px;margin:0 0 9px}.diary-log ol{margin:0;padding-left:20px;color:var(--muted);font-size:10px;line-height:1.9}.quiet-button{border:0;background:transparent;color:var(--muted);font:inherit;font-size:10px;text-decoration:underline;cursor:pointer}.result-panel{margin-top:12px}.result-panel h2{font-size:clamp(25px,5vw,38px);letter-spacing:-.05em;margin:10px 0}.ending-copy{font-size:13px;line-height:2;color:var(--muted)}.result-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:20px 0}.result-stats div{display:grid;gap:4px;padding:13px;border-radius:10px;background:var(--surface-soft)}.result-stats b{font-size:25px}.result-stats span{font-size:10px;color:var(--muted)}.result-message{padding:17px;border-left:3px solid var(--accent);background:var(--surface-soft);margin-top:16px}.result-message strong{font-size:12px}.result-message p{font-size:12px;line-height:1.8;color:var(--muted);margin:7px 0 0}.timeline-heading{margin:24px 0 10px}.final-diary{list-style:none;padding:0;margin:0}.final-diary li{padding:11px 0;border-bottom:1px solid var(--line)}.final-diary b{font-size:11px}.final-diary p{font-size:11px;color:var(--muted);margin:5px 0 0}.result-actions{display:flex;gap:10px;flex-wrap:wrap}.secondary-button{background:var(--surface-soft);color:var(--text);border:1px solid var(--line)}.native-select,.school-select,.school-search{width:100%;max-width:460px;padding:12px;border:1px solid var(--line);border-radius:8px;background:#101925;color:var(--text);font:inherit}
.exam-result-banner{margin:15px 0;padding:17px 20px;border:1px solid #3d526b;border-radius:12px;background:#172536}
.exam-result-banner>span{display:inline-block;font-size:24px;font-weight:950;letter-spacing:.08em}
.exam-result-banner.passed{border-color:#75c84b;background:#1b3021}.exam-result-banner.passed>span{color:#a6f36b}
.exam-result-banner.failed{border-color:#d77c73;background:#321f25}.exam-result-banner.failed>span{color:#ff9c90}
.exam-result-banner p{margin:7px 0;font-size:12px}.exam-result-banner small{font-size:10px;color:var(--muted)}
