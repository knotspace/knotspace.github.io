<style>.beta-mode-link{display:inline-flex;margin-top:18px;padding:10px 16px;border:1px solid #315d79;border-radius:999px;color:#315d79;text-decoration:none;font-size:12px;font-weight:800;transition:background .2s,color .2s}.beta-mode-link:hover{background:#315d79;color:#fff}
