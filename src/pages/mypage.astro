---
import Layout from '../layouts/Layout.astro';
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const supabaseUrl = 'https://rtzorqaigpeechqywjie.supabase.co';
const supabaseKey = 'sb_publishable_-yhc0QqTEEZTBWi9jTcFRA_-AVi-iP6';
---
<Layout title="マイページ | KNOT" description="KNOTのマイページ。" noindex>
  <main class="mypage">
    <header class="welcome"><span class="eyebrow">YOUR SPACE</span><h1>マイページ</h1><p id="user-email">ログイン情報を確認しています...</p></header>
    <section id="admin-panel" class="panel" hidden><span class="eyebrow">KNOT ADMIN</span><h2>管理人アカウント</h2><p>管理人権限が有効です。このアカウントはKNOTの管理者として登録されています。</p></section>
    <section id="writer-link" class="panel" hidden><span class="eyebrow">KNOT WRITER</span><h2>投稿者ワークスペース</h2><p>記事の下書きを作成・編集できます。公開操作はできません。</p><a href={BASE + 'writer/'}>記事を書く →</a></section>
    <section id="invite-panel" class="panel" hidden><span class="eyebrow">WRITER MANAGEMENT</span><h2>投稿者を招待</h2><p>先に相手に通常のKNOTアカウントを作成してもらい、その登録メールアドレスに投稿者権限を付与します。ここで作るSQLをSupabaseのSQL Editorで実行してください。</p><form id="invite-form"><label>登録済みメールアドレス<input id="invite-email" type="email" required placeholder="writer@example.com" /></label><button type="submit">権限付与SQLを作成</button></form><textarea id="writer-sql" rows="4" readonly placeholder="ここにSQLが表示されます"></textarea><button id="copy-writer-sql" type="button">SQLをコピー</button><p id="invite-message" role="status"></p><h3>投稿者から届いた記事</h3><div id="admin-submissions">読み込み中...</div></section>
    <section class="profile panel">
      <div><span class="eyebrow">PROFILE</span><h2>プロフィール</h2></div>
      <label>表示名<input id="display-name" maxlength="30" placeholder="表示名" /></label>
      <button id="save-profile" type="button">変更を保存</button>
      <p id="profile-message" role="status"></p>
    </section>
    <section class="panel"><span class="eyebrow">YOUR KNOT</span><h2>これから追加できる機能</h2><div class="feature-list"><div><strong>学習記録</strong><span>勉強時間や問題の正答率を記録</span></div><div><strong>お気に入り</strong><span>記事や名言をまとめて管理</span></div><div><strong>学習データ同期</strong><span>端末を変えても記録を引き継ぐ</span></div></div></section>
    <div class="actions"><a href={BASE}>ホームへ戻る</a><button id="logout" type="button">ログアウト</button></div>
  </main>
  <script define:vars={{ supabaseUrl, supabaseKey, base: BASE }}>
    const $ = (id) => document.getElementById(id);
    const readSession = () => { try { return JSON.parse(localStorage.getItem('knot-auth') || 'null'); } catch { return null; } };
    let session = readSession();
    if (!session?.access_token) location.replace(base + 'account/');
    const refreshSession = async () => {
      if (!session?.refresh_token) throw new Error('ログイン期限が切れました。再ログインしてください。');
      if (session.expires_at && session.expires_at > Date.now() + 60000) return;
      const response = await fetch(supabaseUrl + '/auth/v1/token?grant_type=refresh_token', {
        method: 'POST',
        headers: { apikey: supabaseKey, 'Content-Type': 'application/json' },
        body: JSON.stringify({ refresh_token: session.refresh_token })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.access_token || !data.refresh_token) {
        localStorage.removeItem('knot-auth');
        throw new Error('ログイン期限が切れました。再ログインしてください。');
      }
      session = { access_token: data.access_token, refresh_token: data.refresh_token, expires_at: Date.now() + (data.expires_in || 3600) * 1000, user: data.user || session.user };
      localStorage.setItem('knot-auth', JSON.stringify(session));
    };
    const headers = () => ({ apikey: supabaseKey, Authorization: 'Bearer ' + session.access_token, 'Content-Type': 'application/json' });
    const request = async (path, options = {}) => {
      await refreshSession();
      const response = await fetch(supabaseUrl + path, { ...options, headers: { ...headers(), ...(options.headers || {}) } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || data.msg || data.error || 'データを取得できませんでした。');
      return data;
    };
    const load = async () => {
      try {
        const user = await request('/auth/v1/user');
        $('user-email').textContent = user.email || '';
        const adminRows = await request('/rest/v1/knot_admins?select=user_id&user_id=eq.' + encodeURIComponent(user.id));
        if (adminRows.length) {
          $('admin-panel').hidden = false;
          $('invite-panel').hidden = false;
          loadAdminSubmissions();
        }
        const writerRows = await request('/rest/v1/knot_writer_roles?select=user_id&user_id=eq.' + encodeURIComponent(user.id));
        if (writerRows.length) $('writer-link').hidden = false;
        const rows = await request('/rest/v1/knot_profiles?select=display_name&user_id=eq.' + encodeURIComponent(user.id));
        if (rows[0]) $('display-name').value = rows[0].display_name || '';
        else {
          await request('/rest/v1/knot_profiles', { method: 'POST', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ user_id: user.id, display_name: user.user_metadata?.display_name || '' }) });
        }
      } catch (error) {
        $('profile-message').textContent = error.message + '。再ログインしてね。';
      }
    };
    async function loadAdminSubmissions() {
      try {
        const rows = await request('/rest/v1/knot_submissions?select=id,title,description,category,body,status,updated_at,author_id&order=updated_at.desc');
        const root = $('admin-submissions'); root.replaceChildren();
        if (!rows.length) { root.textContent = 'まだ投稿はありません。'; return; }
        rows.forEach(item => {
          const card = document.createElement('article'); card.className = 'submission';
          const title = document.createElement('strong'); title.textContent = item.title;
          const meta = document.createElement('p'); meta.textContent = (item.category || 'その他') + ' ・ ' + ({draft:'下書き',submitted:'確認依頼',reviewed:'確認済み'}[item.status] || item.status);
          const preview = document.createElement('pre'); preview.textContent = item.body;
          const copy = document.createElement('button'); copy.type='button'; copy.textContent='Markdownをコピー';
          copy.addEventListener('click', async () => { const md = '---\\ntitle: "'+item.title.replace(/"/g,'\\"')+'"\\ndescription: "'+(item.description||'').replace(/"/g,'\\"')+'"\\ncategory: "'+item.category+'"\\npubDate: "'+new Date().toISOString()+'"\\n---\\n\\n'+item.body; await navigator.clipboard.writeText(md); copy.textContent='コピーしました'; });
          const reviewed = document.createElement('button'); reviewed.type='button'; reviewed.textContent='確認済みにする';
          reviewed.addEventListener('click', async()=>{try{await request('/rest/v1/knot_submissions?id=eq.'+encodeURIComponent(item.id),{method:'PATCH',headers:{Prefer:'return=minimal'},body:JSON.stringify({status:'reviewed'})});loadAdminSubmissions();}catch(e){$('invite-message').textContent=e.message;}});
          card.append(title,meta,preview,copy,reviewed); root.append(card);
        });
      } catch(error) { $('admin-submissions').textContent = error.message; }
    }
    $('invite-form').addEventListener('submit', event => {
      event.preventDefault();
      const email = $('invite-email').value.trim().replace(/'/g, "''");
      if (!email) return;
      $('writer-sql').value = "insert into public.knot_writer_roles (user_id) select id from auth.users where lower(email) = lower('" + email + "') on conflict (user_id) do nothing;";
      $('invite-message').textContent = "SQLを作成したよ。SupabaseのSQL Editorで実行してね。";
    });
    $('copy-writer-sql').addEventListener('click', async () => {
      if (!$('writer-sql').value) { $('invite-message').textContent = "先にメールアドレスを入力してSQLを作成してね。"; return; }
      try { await navigator.clipboard.writeText($('writer-sql').value); $('invite-message').textContent = "SQLをコピーしました。"; }
      catch { $('invite-message').textContent = "SQL欄を選択して手動でコピーしてね。"; }
    });
    load();
    $('save-profile').addEventListener('click', async () => {
      const name = $('display-name').value.trim();
      if (!name) { $('profile-message').textContent = '表示名を入力してね。'; return; }
      $('save-profile').disabled = true;
      try {
        const user = await request('/auth/v1/user', { method: 'PUT', body: JSON.stringify({ data: { display_name: name } }) });
        await request('/rest/v1/knot_profiles?user_id=eq.' + encodeURIComponent(user.id), { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ display_name: name, updated_at: new Date().toISOString() }) });
        $('profile-message').textContent = '保存しました。';
      } catch (error) { $('profile-message').textContent = error.message; }
      finally { $('save-profile').disabled = false; }
    });
    $('logout').addEventListener('click', async () => {
      try { await request('/auth/v1/logout', { method: 'POST' }); } catch {}
      localStorage.removeItem('knot-auth');
      location.href = base + 'account/';
    });
  </script>
</Layout>
<style>
.mypage{max-width:760px;margin:0 auto;padding:52px 0 80px}.welcome{margin-bottom:28px}.eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.16em}.welcome h1{margin:9px 0;color:var(--text);font-size:clamp(32px,6vw,46px);letter-spacing:-.06em}.welcome p{color:var(--muted);font-size:13px}.panel{margin:14px 0;padding:25px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}.panel h2{margin:7px 0 18px;color:var(--text);font-size:19px}.panel a{color:var(--accent);font-size:13px;font-weight:700}.panel form{display:grid;gap:10px;max-width:420px}.panel input{padding:11px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text)}.panel form button,.submission button{padding:9px 13px;border:0;border-radius:8px;background:var(--accent);color:white;font-size:12px;font-weight:700}.submission{padding:15px 0;border-top:1px solid var(--line)}.submission strong{color:var(--text)}.submission p{color:var(--muted);font-size:11px}.submission pre{max-height:180px;overflow:auto;white-space:pre-wrap;padding:12px;border-radius:8px;background:var(--bg);color:var(--text);font-size:11px;line-height:1.7}.submission button{margin-right:8px;margin-top:8px}.profile label{display:grid;gap:7px;color:var(--muted);font-size:12px}.profile input{max-width:420px;padding:12px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text)}button{cursor:pointer}.profile button,.actions button{margin-top:12px;padding:10px 16px;border:0;border-radius:9px;background:var(--accent);color:white;font-size:12px;font-weight:800}.profile p{color:var(--accent);font-size:12px}.feature-list{display:grid;gap:0}.feature-list div{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-top:1px solid var(--line)}.feature-list strong{color:var(--text);font-size:13px}.feature-list span{color:var(--muted);font-size:11px}.actions{display:flex;justify-content:space-between;align-items:center;margin-top:25px}.actions a{color:var(--muted);font-size:12px}.actions button{margin:0;background:transparent;border:1px solid var(--line);color:var(--muted)}@media(max-width:600px){.mypage{padding:35px 0 60px}.panel{padding:20px}.feature-list div{flex-direction:column;gap:5px}}
</style>