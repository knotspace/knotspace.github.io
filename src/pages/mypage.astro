---
import Layout from '../layouts/Layout.astro';
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const supabaseUrl = 'https://rtzorqaigpeechqywjie.supabase.co';
const supabaseKey = 'sb_publishable_-yhc0QqTEEZTBWi9jTcFRA_-AVi-iP6';
---
<Layout title="マイページ | KNOT" description="KNOTのマイページ。" noindex>
  <main class="mypage">
    <header class="welcome"><span class="eyebrow">YOUR SPACE</span><h1>マイページ</h1><p id="user-email">ログイン情報を確認しています...</p></header>
    <section class="profile panel">
      <div><span class="eyebrow">PROFILE</span><h2>プロフィール</h2></div>
      <label>表示名<input id="display-name" maxlength="30" placeholder="表示名" /></label>
      <button id="save-profile" type="button">変更を保存</button>
      <p id="profile-message" role="status"></p>
    </section>
    <section class="panel"><span class="eyebrow">YOUR KNOT</span><h2>これから追加できる機能</h2><div class="feature-list"><div><strong>学習記録</strong><span>勉強時間や問題の正答率を記録</span></div><div><strong>お気に入り</strong><span>記事や名言をまとめて管理</span></div><div><strong>学習データ同期</strong><span>端末を変えても記録を引き継ぐ</span></div></div></section>
    <div class="actions"><a href={BASE}>ホームへ戻る</a><button id="logout" type="button">ログアウト</button></div>
  </main>
  <script define:vars={{ supabaseUrl, supabaseKey, base: BASE }}>
    const $ = (id) => document.getElementById(id);
    const readSession = () => { try { return JSON.parse(localStorage.getItem('knot-auth') || 'null'); } catch { return null; } };
    let session = readSession();
    if (!session?.access_token) location.replace(base + 'account/');
    const headers = () => ({ apikey: supabaseKey, Authorization: 'Bearer ' + session.access_token, 'Content-Type': 'application/json' });
    const request = async (path, options = {}) => {
      const response = await fetch(supabaseUrl + path, { ...options, headers: { ...headers(), ...(options.headers || {}) } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || data.msg || data.error || 'データを取得できませんでした。');
      return data;
    };
    const load = async () => {
      try {
        const user = await request('/auth/v1/user');
        $('user-email').textContent = user.email || '';
        const rows = await request('/rest/v1/knot_profiles?select=display_name&user_id=eq.' + encodeURIComponent(user.id));
        if (rows[0]) $('display-name').value = rows[0].display_name || '';
        else {
          await request('/rest/v1/knot_profiles', { method: 'POST', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ user_id: user.id, display_name: user.user_metadata?.display_name || '' }) });
        }
      } catch (error) {
        $('profile-message').textContent = error.message + '。再ログインしてね。';
      }
    };
    load();
    $('save-profile').addEventListener('click', async () => {
      const name = $('display-name').value.trim();
      if (!name) { $('profile-message').textContent = '表示名を入力してね。'; return; }
      $('save-profile').disabled = true;
      try {
        const user = await request('/auth/v1/user', { method: 'PUT', body: JSON.stringify({ data: { display_name: name } }) });
        await request('/rest/v1/knot_profiles?user_id=eq.' + encodeURIComponent(user.id), { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ display_name: name, updated_at: new Date().toISOString() }) });
        $('profile-message').textContent = '保存しました。';
      } catch (error) { $('profile-message').textContent = error.message; }
      finally { $('save-profile').disabled = false; }
    });
    $('logout').addEventListener('click', async () => {
      try { await request('/auth/v1/logout', { method: 'POST' }); } catch {}
      localStorage.removeItem('knot-auth');
      location.href = base + 'account/';
    });
  </script>
</Layout>
<style>
.mypage{max-width:760px;margin:0 auto;padding:52px 0 80px}.welcome{margin-bottom:28px}.eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.16em}.welcome h1{margin:9px 0;color:var(--text);font-size:clamp(32px,6vw,46px);letter-spacing:-.06em}.welcome p{color:var(--muted);font-size:13px}.panel{margin:14px 0;padding:25px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}.panel h2{margin:7px 0 18px;color:var(--text);font-size:19px}.profile label{display:grid;gap:7px;color:var(--muted);font-size:12px}.profile input{max-width:420px;padding:12px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text)}button{cursor:pointer}.profile button,.actions button{margin-top:12px;padding:10px 16px;border:0;border-radius:9px;background:var(--accent);color:white;font-size:12px;font-weight:800}.profile p{color:var(--accent);font-size:12px}.feature-list{display:grid;gap:0}.feature-list div{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-top:1px solid var(--line)}.feature-list strong{color:var(--text);font-size:13px}.feature-list span{color:var(--muted);font-size:11px}.actions{display:flex;justify-content:space-between;align-items:center;margin-top:25px}.actions a{color:var(--muted);font-size:12px}.actions button{margin:0;background:transparent;border:1px solid var(--line);color:var(--muted)}@media(max-width:600px){.mypage{padding:35px 0 60px}.panel{padding:20px}.feature-list div{flex-direction:column;gap:5px}}
</style>