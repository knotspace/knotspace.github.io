---
import StudyLayout from '../layouts/StudyLayout.astro';
import assetsData from '../data/study/knot-summary-assets.json';
import foundationData from '../data/study/study-foundation.json';
import examFocusData from '../data/study/public-exam-focus.json';
interface Props { title: string; subject: string; topic: string; description: string; intro: string; }
const { title, subject, topic, description, intro } = Astro.props;
const matchesTopic = (unit: string) => topic === 'all' || (topic === 'materials' ? true : topic === 'physics' ? /力|電流|電気|運動|仕事|エネルギー|音|光|レンズ|浮力/.test(unit) : topic === 'chemistry' ? /物質|水溶液|溶解|原子|分子|化学|酸化|還元|酸・アルカリ|気体|電池|中和/.test(unit) : topic === 'biology' ? /植物|動物|血液|刺激|生殖|遺伝|生態系|細胞|微生物/.test(unit) : topic === 'earth' ? /火山|火成岩|地震|地層|気象|太陽|月|星|天体/.test(unit) : topic === 'geography' ? /世界|日本|地形|農林水産|人口|貿易|気候|地図/.test(unit) : topic === 'history' ? /旧石器|飛鳥|鎌倉|安土|明治|昭和|江戸|近世|近代|古代|中世/.test(unit) : topic === 'civics' ? /憲法|国会|地方自治|経済|金融|国際社会|選挙|人権|政治|財政/.test(unit) : false);
const examFocus = examFocusData.topics[topic];
const resources = assetsData.resources.filter(item => (subject === '全教科' || item.subject === subject) && matchesTopic(item.unit));
const groups = [...new Map(resources.map(item => [item.unit, resources.filter(x => x.unit === item.unit)])).entries()].map(([unit, items]) => ({ unit, items }));
const subjectCode = subject === '理科' ? 'science' : 'social';
const terms = foundationData.questions.filter(q => (subject === '全教科' || q.subject === subjectCode) && (topic === 'all' || topic === 'materials' ? true : q.topic === ({physics:'物理',chemistry:'化学',biology:'生物',earth:'地学',geography:'地理',history:'歴史',civics:'公民'}[topic])));
---
<StudyLayout title={title + '｜要点まとめ｜KNOT Study'} description={description}>
<main class="summary-page">
  <a class="summary-back" href="../">← Studyホーム</a>
  <header class="summary-hero">
    <div class="summary-kicker">KNOT STUDY / TEXTBOOK NOTES</div>
    <div class="summary-hero-grid">
      <div><p class="summary-subject">{subject} · 要点まとめ</p><h1>{title}</h1><p class="summary-intro">{intro}</p><div class="summary-metrics"><span><b>{groups.length}</b> 単元</span><span><b>{resources.length}</b> 図解・表・資料</span><span><b>{terms.length}</b> 用語チェック</span></div></div>
      <div class="summary-hero-mark" aria-hidden="true"><span>STUDY</span><strong>{subject === '理科' ? 'SCI' : 'SOC'}</strong><small>KEY POINTS</small></div>
    </div>
    <div class="summary-progress-note"><span>LEARN → UNDERSTAND → REMEMBER</span><span>読むだけで終わらせず、説明できる状態へ。</span></div>
  </header>
  <nav class="summary-tools" aria-label="ページ内メニュー"><a href="#units">単元別まとめ</a><a href="#terms">重要語句</a><a href="../foundation/">問題演習へ →</a><label class="summary-search"><span>⌕</span><input id="summary-search" type="search" placeholder="単元・用語を検索"></label></nav>

  {examFocus && <section class="exam-focus" aria-labelledby="exam-focus-title">
    <div class="exam-focus-top"><div><p>03 / PAST EXAM ANALYSIS</p><h2 id="exam-focus-title">過去問から見る入試重点</h2></div><span>栃木県立入試・令和6〜7年度</span></div>
    <p class="exam-focus-lead">{examFocus.focus}</p>
    <div class="exam-focus-points">{examFocus.points.map((point,index)=><article><b>{String(index+1).padStart(2,'0')}</b><p>{point}</p></article>)}</div>
    <h3>実際の出題箇所</h3><div class="exam-evidence">{examFocus.evidence.map(item=><article><div><b>{item.year}</b><span>{item.file} · {item.page}</span></div><strong>{item.question}</strong><p>{item.topic}</p>{item.example && <div class="exam-example"><b>実際の出題内容（要約）</b><p>{item.example}</p></div>}</article>)}</div>
    <p class="exam-focus-caution">※「頻出」はこの2年分の確認範囲での重点を示すもので、今後の出題を保証するものではありません。大問・ページはアップロードされた問題冊子の表記に基づきます。</p>
  </section>}
  <section class="summary-section" id="units"><div class="summary-section-head"><div><p>01 / UNDERSTAND</p><h2>単元別・要点整理</h2></div><span>図解・比較表・資料で理解する</span></div>
    {groups.map((group, index) => <section class="unit-block" data-search-block>
      <header class="unit-heading"><span class="unit-number">{String(index + 1).padStart(2,'0')}</span><div><h3>{group.unit}</h3><p>{group.items.length}つの図解・資料で整理</p></div><span class="unit-chevron">＋</span></header>
      <div class="resource-grid">
        {group.items.map((item, itemIndex) => <article class="resource-card" data-search-card>
          <div class="resource-meta"><span>{item.type === 'diagram' ? 'KNOT図解' : item.type === 'table' ? '整理・比較表' : '写真・資料'}</span><small>{item.id.toUpperCase()}</small></div>
          <h4>{item.title}</h4><p class="resource-subtitle">{item.subtitle}</p>
          {item.type === 'diagram' && <div class="diagram-flow">{item.nodes.map((node, i) => { const parts = node.split('|'); return <div class="diagram-node"><span>{String(i+1).padStart(2,'0')}</span><strong>{parts[0]}</strong>{parts[1] && <small>{parts[1]}</small>}</div>; })}</div>}
          {item.type === 'table' && <div class="summary-table-wrap"><table class="summary-table"><tbody>{item.rows.map((row, ri) => <tr>{row.map((cell, ci) => <td class:list={{'table-key':ci===0}}>{cell}</td>)}</tr>)}</tbody></table></div>}
          {item.type === 'image' && item.image && <figure class="summary-image"><img src={item.image.src} alt={item.image.alt} loading="lazy"><figcaption>{item.image.caption}</figcaption></figure>}
          {item.note && <p class="resource-note">{item.note}</p>}
          <div class="resource-credit">KNOT STUDY · ORIGINAL LEARNING MATERIAL</div>
        </article>)}
      </div>
    </section>)}
  </section>
  <section class="summary-section terms-section" id="terms"><div class="summary-section-head"><div><p>02 / REMEMBER</p><h2>重要語句・確認ポイント</h2></div><span>タップして解説を確認</span></div>
    <div class="term-grid">{terms.map((q,index) => <details class="term-card" data-search-card><summary><span class="term-index">{String(index+1).padStart(2,'0')}</span><span><strong>{q.term}</strong><small>{q.prompt}</small></span><b>＋</b></summary><div class="term-explanation"><p>{q.explanation}</p><a href="../foundation/">この単元の問題を解く →</a></div></details>)}</div>
  </section>
  <section class="summary-finish"><p>CHECK YOUR UNDERSTANDING</p><h2>読んだら、問題で確かめよう。</h2><span>知識を「見たことがある」から「自分で使える」へ。</span><a href="../foundation/">基礎網羅問題に挑戦する <b>→</b></a></section>
  <footer class="summary-footer"><span>KNOT STUDY / TEXTBOOK NOTES</span><a href="./">要点まとめ一覧へ ↑</a></footer>
</main>
<script is:inline>
(() => {
 const input=document.getElementById('summary-search');
 if(!input)return;
 const cards=[...document.querySelectorAll('[data-search-card]')];
 const blocks=[...document.querySelectorAll('[data-search-block]')];
 input.addEventListener('input',()=>{
  const query=input.value.trim().toLocaleLowerCase();
  cards.forEach(card=>{card.hidden=!!query&&!card.textContent.toLocaleLowerCase().includes(query);});
  blocks.forEach(block=>{block.hidden=!!query&&!([...block.querySelectorAll('[data-search-card]')].some(card=>!card.hidden));});
 });
})();
</script>
<style>
.exam-focus{margin:24px 0 34px;padding:clamp(17px,3vw,26px);border:1px solid color-mix(in srgb,var(--accent) 35%,var(--line));border-radius:17px;background:color-mix(in srgb,var(--accent) 5%,var(--surface))}.exam-focus-top{display:flex;justify-content:space-between;align-items:end;gap:12px}.exam-focus-top>div>p{font:9px ui-monospace,monospace;letter-spacing:.16em;color:var(--accent);font-weight:900;margin:0 0 6px}.exam-focus-top h2{font-size:clamp(20px,3vw,27px);margin:0}.exam-focus-top>span{font-size:9px;color:var(--muted)}.exam-focus-lead{font-size:12px;line-height:1.9;color:var(--muted);margin:14px 0}.exam-focus-points{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.exam-focus-points article{display:flex;gap:10px;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.exam-focus-points b{color:var(--accent);font:800 10px ui-monospace,monospace}.exam-focus-points p{font-size:11px;line-height:1.8;margin:0}.exam-focus h3{font-size:13px;margin:19px 0 9px}.exam-evidence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.exam-evidence article{padding:11px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.exam-evidence article>div{display:flex;justify-content:space-between;gap:8px;font-size:9px;color:var(--muted)}.exam-evidence article>div b{color:var(--accent)}.exam-evidence strong{display:block;font-size:11px;margin:7px 0 3px}.exam-evidence p{font-size:10px;line-height:1.6;color:var(--muted);margin:0}.exam-evidence .exam-example{margin-top:9px;padding:10px;border-radius:8px;background:color-mix(in srgb,var(--accent) 7%,var(--surface));border:1px solid color-mix(in srgb,var(--accent) 20%,var(--line))}.exam-evidence .exam-example>b{display:block;font-size:9px;color:var(--accent);margin-bottom:4px}.exam-evidence .exam-example p{font-size:10px;line-height:1.8;color:var(--text);margin:0}.exam-focus-caution{font-size:9px;line-height:1.7;color:var(--muted);margin:12px 0 0}.summary-page{max-width:1120px;margin:0 auto;padding:22px 0 56px;color:var(--text)}.summary-back{display:inline-flex;margin-bottom:18px;color:var(--muted);font-size:12px;font-weight:700}.summary-hero{position:relative;overflow:hidden;padding:clamp(25px,5vw,54px);border:1px solid var(--line);border-radius:24px;background:linear-gradient(125deg,color-mix(in srgb,var(--accent) 15%,var(--surface)),var(--surface) 62%)}.summary-hero:after{content:'';position:absolute;width:340px;height:340px;right:-120px;top:-170px;border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);border-radius:50%;box-shadow:0 0 0 35px color-mix(in srgb,var(--accent) 4%,transparent),0 0 0 70px color-mix(in srgb,var(--accent) 3%,transparent)}.summary-kicker,.summary-section-head>div>p,.summary-finish>p{font:9px ui-monospace,monospace;letter-spacing:.18em;color:var(--accent);font-weight:900}.summary-hero-grid{display:flex;justify-content:space-between;align-items:center;gap:22px;position:relative;z-index:1}.summary-subject{font-size:12px;color:var(--accent);font-weight:800;margin:25px 0 8px}.summary-hero h1{font-size:clamp(34px,6vw,62px);line-height:1.15;letter-spacing:-.07em;margin:0;font-weight:950}.summary-intro{max-width:640px;font-size:13px;line-height:2;color:var(--muted);margin:17px 0 20px}.summary-metrics{display:flex;flex-wrap:wrap;gap:8px}.summary-metrics span{padding:9px 12px;border:1px solid var(--line);border-radius:9px;background:color-mix(in srgb,var(--surface) 70%,transparent);font-size:10px;color:var(--muted)}.summary-metrics b{font-size:15px;color:var(--text);margin-right:3px}.summary-hero-mark{width:148px;height:148px;flex:none;display:grid;place-content:center;text-align:center;border:1px solid color-mix(in srgb,var(--accent) 35%,var(--line));border-radius:50%;background:color-mix(in srgb,var(--surface) 65%,transparent);box-shadow:0 0 0 12px color-mix(in srgb,var(--accent) 5%,transparent)}.summary-hero-mark span,.summary-hero-mark small{font:8px ui-monospace,monospace;letter-spacing:.16em;color:var(--muted)}.summary-hero-mark strong{font-size:38px;letter-spacing:-.08em;color:var(--accent)}.summary-progress-note{display:flex;justify-content:space-between;gap:12px;margin-top:27px;padding-top:14px;border-top:1px solid var(--line);font-size:9px;color:var(--muted)}.summary-progress-note span:first-child{font:8px ui-monospace,monospace;letter-spacing:.12em;color:var(--accent)}.summary-tools{position:sticky;top:68px;z-index:20;display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:14px 0 34px;padding:10px;border:1px solid var(--line);border-radius:13px;background:color-mix(in srgb,var(--surface) 94%,transparent);backdrop-filter:blur(14px)}.summary-tools>a{padding:9px 12px;border-radius:8px;color:var(--muted);font-size:10px;font-weight:800}.summary-tools>a:hover{background:var(--surface-soft);color:var(--accent)}.summary-tools>a:nth-child(3){background:var(--accent);color:#071426}.summary-search{display:flex;align-items:center;gap:7px;min-width:180px;flex:1;padding:0 10px;border:1px solid var(--line);border-radius:8px;color:var(--muted)}.summary-search input{width:100%;min-width:0;padding:9px 0;border:0;outline:0;background:transparent;color:var(--text);font:inherit;font-size:11px}.summary-section{margin:38px 0}.summary-section-head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:17px}.summary-section-head>div>p{margin:0 0 6px}.summary-section-head h2{font-size:clamp(21px,3vw,28px);letter-spacing:-.05em;margin:0}.summary-section-head>span{font-size:10px;color:var(--muted)}.unit-block{margin:20px 0 28px;padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}.unit-heading{display:flex;align-items:center;gap:13px;padding:4px 4px 16px;border-bottom:1px solid var(--line)}.unit-number{display:grid;place-items:center;width:42px;height:42px;flex:none;border-radius:12px;background:color-mix(in srgb,var(--accent) 15%,var(--surface));color:var(--accent);font:800 13px ui-monospace,monospace}.unit-heading h3{font-size:17px;letter-spacing:-.03em;margin:0}.unit-heading p{font-size:10px;color:var(--muted);margin:4px 0 0}.unit-chevron{margin-left:auto;color:var(--accent);font-size:18px}.resource-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding-top:15px}.resource-card{min-width:0;padding:17px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}.resource-meta{display:flex;justify-content:space-between;gap:10px;align-items:center}.resource-meta span{padding:5px 8px;border-radius:6px;background:color-mix(in srgb,var(--accent) 13%,var(--surface));color:var(--accent);font-size:9px;font-weight:850}.resource-meta small{font:8px ui-monospace,monospace;color:var(--muted)}.resource-card h4{font-size:14px;line-height:1.5;margin:12px 0 4px}.resource-subtitle{font-size:10px;color:var(--muted);margin:0 0 13px}.diagram-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.diagram-node{position:relative;display:grid;align-content:center;gap:5px;min-height:88px;padding:9px 6px;text-align:center;border:1px solid color-mix(in srgb,var(--accent) 25%,var(--line));border-radius:9px;background:color-mix(in srgb,var(--accent) 6%,var(--surface))}.diagram-node:not(:last-child):after{content:'›';position:absolute;right:-11px;top:50%;transform:translate(50%,-50%);color:var(--accent);font-size:18px;font-weight:900}.diagram-node>span{font:8px ui-monospace,monospace;color:var(--accent)}.diagram-node strong{font-size:10px;line-height:1.45;overflow-wrap:anywhere}.diagram-node small{font-size:8px;line-height:1.5;color:var(--muted)}.summary-table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:9px}.summary-table{width:100%;border-collapse:collapse;font-size:10px;line-height:1.6}.summary-table td{padding:10px 9px;border-bottom:1px solid var(--line);vertical-align:top}.summary-table tr:last-child td{border-bottom:0}.summary-table td+td{border-left:1px solid var(--line)}.summary-table .table-key{width:24%;font-weight:850;color:var(--accent);background:color-mix(in srgb,var(--accent) 7%,var(--surface))}.resource-note{font-size:10px;line-height:1.8;color:var(--muted);margin:12px 0 0}.summary-image{margin:8px 0}.summary-image img{display:block;width:100%;max-height:260px;object-fit:contain;background:#fff;border-radius:8px}.summary-image figcaption{font-size:9px;color:var(--muted);margin-top:6px}.resource-credit{margin-top:13px;padding-top:9px;border-top:1px solid var(--line);font:7px ui-monospace,monospace;letter-spacing:.12em;color:var(--muted)}.term-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.term-card{border:1px solid var(--line);border-radius:11px;background:var(--surface);overflow:hidden}.term-card summary{display:flex;align-items:center;gap:10px;padding:13px;cursor:pointer;list-style:none}.term-card summary::-webkit-details-marker{display:none}.term-index{font:9px ui-monospace,monospace;color:var(--accent)}.term-card summary>span:nth-child(2){display:grid;gap:4px;min-width:0;flex:1}.term-card summary strong{font-size:12px}.term-card summary small{font-size:9px;line-height:1.6;color:var(--muted)}.term-card summary>b{color:var(--accent);font-size:16px}.term-card[open] summary>b{transform:rotate(45deg)}.term-explanation{padding:0 14px 14px 38px}.term-explanation p{font-size:10px;line-height:1.8;margin:0 0 8px;color:var(--muted)}.term-explanation a{font-size:9px;color:var(--accent);font-weight:850}.summary-finish{margin:40px 0 20px;padding:clamp(23px,4vw,40px);border-radius:18px;background:linear-gradient(120deg,color-mix(in srgb,var(--accent) 17%,var(--surface)),var(--surface));border:1px solid var(--line)}.summary-finish h2{font-size:clamp(21px,3vw,30px);margin:8px 0}.summary-finish>span{display:block;font-size:11px;color:var(--muted)}.summary-finish>a{display:inline-flex;gap:30px;margin-top:18px;padding:13px 17px;border-radius:9px;background:var(--accent);color:#071426;font-size:11px;font-weight:900}.summary-footer{display:flex;justify-content:space-between;gap:10px;padding-top:17px;border-top:1px solid var(--line);font:8px ui-monospace,monospace;letter-spacing:.1em;color:var(--muted)}.summary-footer a{color:var(--accent)}
.resource-card[hidden],.term-card[hidden],.unit-block[hidden]{display:none!important}
@media(max-width:760px){.exam-focus-points,.exam-evidence{grid-template-columns:1fr}.exam-focus-top{align-items:flex-start;flex-direction:column}.summary-page{padding-top:15px}.summary-hero-grid{align-items:flex-start}.summary-hero-mark{width:86px;height:86px}.summary-hero-mark strong{font-size:26px}.summary-tools{top:58px}.summary-progress-note{flex-direction:column;gap:6px}.resource-grid{grid-template-columns:1fr}.term-grid{grid-template-columns:1fr}.summary-section-head{align-items:flex-start;flex-direction:column}.unit-block{padding:12px}.diagram-flow{gap:9px}.diagram-node{min-height:76px}.diagram-node strong{font-size:9px}.resource-card{padding:14px}}
@media(max-width:420px){.summary-hero-mark{display:none}.summary-hero h1{font-size:36px}.summary-tools{gap:3px}.summary-tools>a{padding:8px 9px}.summary-search{min-width:100%;order:5}.diagram-flow{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.diagram-node:not(:last-child):after{display:none}.summary-table{font-size:9px}}
</style>
</StudyLayout>