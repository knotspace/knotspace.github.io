---
const { categories = [], limit = 17 } = Astro.props;
---
<section class="commons-gallery" data-categories={JSON.stringify(categories)} data-limit={limit} aria-label="関連写真・図版・資料">
  <div class="commons-gallery-head">
    <b>関連写真・図版・資料</b>
    <span class="commons-gallery-count">資料を探しています（目標{limit}点）</span>
  </div>
  <div class="commons-gallery-grid"></div>
  <p class="commons-gallery-credit">画像を選ぶとWikimedia Commonsの原資料ページが開きます。作者名・ライセンス・利用条件は各資料ページでも確認できます。</p>
</section>
<script>
  async function commonsRequest(params) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 9000);
    try {
      const response = await fetch('https://commons.wikimedia.org/w/api.php?' + params.toString(), {
        signal: controller.signal,
        headers: { Accept: 'application/json' }
      });
      if (!response.ok) return null;
      const data = await response.json();
      return data.error ? null : data;
    } catch {
      return null;
    } finally {
      clearTimeout(timeout);
    }
  }

  async function fetchCategoryFiles(category, limit) {
    const params = new URLSearchParams({
      action: 'query',
      generator: 'categorymembers',
      gcmtitle: 'Category:' + category,
      gcmtype: 'file',
      gcmlimit: String(Math.min(100, limit)),
      prop: 'imageinfo',
      iiprop: 'url|extmetadata',
      iiurlwidth: '560',
      format: 'json',
      origin: '*'
    });
    const data = await commonsRequest(params);
    return Object.values(data?.query?.pages || {});
  }

  async function searchFiles(query, limit) {
    const params = new URLSearchParams({
      action: 'query',
      generator: 'search',
      gsrsearch: query,
      gsrnamespace: '6',
      gsrlimit: String(Math.min(100, limit)),
      prop: 'imageinfo',
      iiprop: 'url|extmetadata',
      iiurlwidth: '560',
      format: 'json',
      origin: '*'
    });
    const data = await commonsRequest(params);
    return Object.values(data?.query?.pages || {});
  }

  function cleanMetadata(value, fallback) {
    if (!value || typeof value !== 'string') return fallback;
    return value.replace(/<[^>]*>/g, '')
      .replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&')
      .replace(/&quot;/gi, '"').replace(/&#39;/gi, "'")
      .replace(/&#x27;/gi, "'").trim() || fallback;
  }

  const allowedImage = /\.(jpe?g|png|gif|svg|webp|tiff?|bmp)$/i;
  document.querySelectorAll('.commons-gallery:not([data-loaded])').forEach(async (gallery) => {
    gallery.dataset.loaded = 'true';
    let categories = [];
    try { categories = JSON.parse(gallery.dataset.categories || '[]'); } catch { categories = []; }
    const limit = Math.max(1, Number(gallery.dataset.limit || 17));
    const grid = gallery.querySelector('.commons-gallery-grid');
    const count = gallery.querySelector('.commons-gallery-count');
    const seen = new Set();
    const items = [];

    const addPages = (pages) => {
      for (const page of pages) {
        const info = page.imageinfo?.[0];
        const title = (page.title || '').replace(/^File:/, '');
        if (!info || seen.has(page.pageid) || !allowedImage.test(title) || !(info.thumburl || info.url) || !info.descriptionurl) continue;
        seen.add(page.pageid);
        items.push({
          title: title.replace(/\.[^.]+$/, '').replaceAll('_', ' '),
          image: info.thumburl || info.url,
          source: info.descriptionurl,
          license: cleanMetadata(info.extmetadata?.LicenseShortName?.value, 'ライセンス要確認'),
          author: cleanMetadata(info.extmetadata?.Artist?.value, '作者情報は原資料で確認')
        });
        if (items.length >= limit) break;
      }
    };

    for (const category of categories) {
      if (items.length >= limit) break;
      addPages(await fetchCategoryFiles(category, limit - items.length + 5));
      if (items.length < limit) addPages(await searchFiles(category, limit - items.length + 5));
    }

    let loaded = 0;
    let failed = 0;
    const updateCount = () => {
      const missing = Math.max(0, limit - loaded - failed);
      count.textContent = loaded + '点表示 / ' + items.length + '点取得（目標' + limit + '点）' +
        (missing ? '・あと' + missing + '点不足' : '');
    };

    for (const item of items) {
      const link = document.createElement('a');
      link.className = 'commons-gallery-item';
      link.href = item.source;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';

      const img = document.createElement('img');
      img.src = item.image;
      img.alt = item.title;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.addEventListener('load', () => { loaded += 1; updateCount(); }, { once: true });
      img.addEventListener('error', () => { failed += 1; link.remove(); updateCount(); }, { once: true });

      const caption = document.createElement('span');
      caption.className = 'commons-gallery-title';
      caption.textContent = item.title;
      const author = document.createElement('small');
      author.textContent = '作者：' + item.author;
      const license = document.createElement('small');
      license.textContent = 'ライセンス：' + item.license;
      link.append(img, caption, author, license);
      grid.append(link);
    }

    if (!items.length) {
      count.textContent = '資料を取得できませんでした（通信またはカテゴリを確認）';
      const note = document.createElement('p');
      note.className = 'commons-gallery-empty';
      note.textContent = 'この単元の資料カテゴリを見直す必要があります。';
      grid.append(note);
    } else {
      updateCount();
    }
  });
</script>
<style is:global>
.commons-gallery{margin:14px 0 20px;padding:13px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
.commons-gallery-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:11px}
.commons-gallery-head b{font-size:13px}
.commons-gallery-count{font-size:10px;color:var(--muted);text-align:right}
.commons-gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(125px,1fr));gap:10px}
.commons-gallery-item{display:grid;grid-template-rows:110px auto auto auto;gap:5px;min-width:0;text-decoration:none;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:6px;background:var(--surface-soft)}
.commons-gallery-item img{width:100%;height:110px;object-fit:contain;border-radius:5px;background:var(--surface)}
.commons-gallery-title{font-size:10px;line-height:1.45;overflow-wrap:anywhere}
.commons-gallery-item small{font-size:9px;line-height:1.3;color:var(--muted);overflow-wrap:anywhere}
.commons-gallery-credit{font-size:10px;line-height:1.6;color:var(--muted);margin:10px 0 0}
.commons-gallery-empty{font-size:11px;color:var(--muted)}
@media(max-width:520px){.commons-gallery-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.commons-gallery-item{grid-template-rows:84px auto auto auto;padding:4px}.commons-gallery-item img{height:84px}}
</style>
