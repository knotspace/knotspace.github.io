---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = '日々の発見や好きなことを発信する、たかブロ。',
  image,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageImage = image ? new URL(image, Astro.url).href : undefined;
const BASE = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="たかブロ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {pageImage && <meta property="og:image" content={pageImage} />}
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={BASE} aria-label="たかブロ ホーム">
          <span class="brand-mark">T</span>
          <span>たかブロ<span class="brand-dot">.</span></span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href={BASE}>ホーム</a>
          <a href={`${BASE}#articles`}>記事一覧</a>
          <a class="nav-cta" href="https://github.com/Shiratakihot/Astro" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <a class="footer-brand" href={BASE}>たかブロ<span class="brand-dot">.</span></a>
        <p>好きなことを、好きなように。</p>
        <span>© {new Date().getFullYear()} たかブロ. Built with Astro.</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b1220;
    --surface: #111c2e;
    --line: rgba(148, 163, 184, .14);
    --text: #f4f7fb;
    --muted: #9aa9bd;
    --accent: #82b2ff;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: radial-gradient(ellipse at 50% -18%, rgba(61,112,190,.18), transparent 42rem), var(--bg);
    color: var(--text);
    font-family: "DM Sans", "Noto Sans JP", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  .site-shell { width: min(100% - 48px, 1080px); margin: 0 auto; }
  .site-header { min-height: 88px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); }
  .brand { display:inline-flex; align-items:center; gap:11px; font-size:21px; font-weight:900; letter-spacing:-.06em; }
  .brand-mark { display:grid; place-items:center; width:34px; height:34px; border-radius:11px; color:#081322; background:linear-gradient(135deg,#b5d3ff,#5c98f6); font-size:17px; box-shadow:0 5px 22px rgba(79,141,247,.25); }
  .brand-dot { color:var(--accent); }
  nav { display:flex; align-items:center; gap:29px; color:var(--muted); font-size:13px; font-weight:600; }
  nav a { transition:color .2s ease; }
  nav a:hover { color:var(--text); }
  nav .nav-cta { color:var(--text); border:1px solid var(--line); padding:9px 14px; border-radius:999px; }
  main { min-height:65vh; }
  .site-footer { margin-top:100px; padding:27px 0 34px; border-top:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; gap:18px; color:#718198; font-size:11px; }
  .footer-brand { color:var(--text); font-size:15px; font-weight:900; }
  .site-footer p { margin:0; }
  @media (max-width:620px) {
    .site-shell { width:min(100% - 32px,1080px); }
    .site-header { min-height:72px; }
    nav { gap:15px; font-size:12px; }
    nav .nav-cta { display:none; }
    .site-footer { margin-top:70px; flex-direction:column; align-items:flex-start; gap:8px; }
  }
</style>
