
---
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  studyMode?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Web制作や日々の興味、ランニングなどを記録する個人ブログ。',
  image,
  noindex = false,
  studyMode = false,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageImage = image ? new URL(image, Astro.url).href : new URL('/og-default.svg', Astro.site ?? Astro.url).href;
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'KNOT',
  url: Astro.site?.toString() ?? 'https://knotspace.github.io/',
  inLanguage: 'ja-JP',
  description: 'Web制作、PC・アプリ、本・読書、勉強や日々の興味を記録する個人ブログ。',
};
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="author" content="KNOT" />
    <meta name="color-scheme" content="dark light" />
    <meta name="site-base" content={BASE} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="manifest" href={`${BASE}manifest.webmanifest`} />

    <link rel="alternate" type="application/rss+xml" title="KNOT RSS" href={`${BASE}rss.xml`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg?v=5`} sizes="any" />
    <link rel="shortcut icon" href={`${BASE}favicon.svg?v=5`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${BASE}favicon.svg?v=5`} />

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('knot-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>


    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="KNOT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content={`${title} | KNOT`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImage} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {structuredData && (Array.isArray(structuredData) ? structuredData : [structuredData]).map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <title>{title}</title>
  </head>

  <body>
    <div class:list={["site-shell", { "study-shell": studyMode }]}>
      {!studyMode && <header class="site-header">
        <a class="brand" href={BASE} aria-label="KNOT ホーム">
          KNOT<span class="brand-dot">.</span>
        </a>

        <nav aria-label="メインナビゲーション">
          <a href={BASE}>ホーム</a>
          <a href={`${BASE}blog/`}>記事一覧</a>
          <a href={`${BASE}study/`}>Study</a>
          <a href={`${BASE}bookmarks/`}>あとで読む</a>
          <a href={`${BASE}about/`}>プロフィール</a>

          <a class="account-link" id="account-link" href={`${BASE}account/`} aria-label="ログイン / マイページ" title="ログイン / マイページ">♙</a>

          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="テーマを切り替える"
            title="テーマを切り替える"
          >
            <span id="theme-icon">☀</span>
          </button>

          <a
            class="github-link"
            href="https://github.com/knotspace/knotspace.github.io"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            ↗
          </a>
        </nav>
      </header>}

      <main>
        <slot />
      </main>

      <aside id="pwa-install-prompt" class="pwa-prompt" hidden aria-live="polite">
        <div><strong>KNOTをアプリとして使う</strong><p id="pwa-install-description">ホーム画面に追加すると、次回からすぐに開けるよ。</p></div>
        <button id="pwa-install-button" type="button">インストール</button>
        <button id="pwa-install-close" type="button" aria-label="閉じる">×</button>
      </aside>
      {!studyMode && <footer class="site-footer">
        <a class="footer-brand" href={BASE}>
          KNOT<span class="brand-dot">.</span>
        </a>
        <p>Web制作や日々の興味を記録する個人ブログ。</p>
        <span>© {new Date().getFullYear()} KNOT. Built with Astro.</span>
      </footer>}
      {studyMode && <nav class="study-bottom-nav" aria-label="Study navigation"><a href={`${BASE}`}><span aria-hidden="true">⌂</span> HOMEへ戻る</a></nav>}
    </div>

    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const root = document.documentElement;

        if (!button || !icon) return;

        const updateIcon = () => {
          const isDark = root.dataset.theme !== 'light';

          icon.textContent = isDark ? '☀' : '☾';

          if (isDark) {
            button.setAttribute('aria-label', 'ライトモードに切り替える');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0b1220');
          } else {
            button.setAttribute('aria-label', 'ダークモードに切り替える');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f7f8fa');
          }
        };

        updateIcon();

        button.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';

          root.dataset.theme = nextTheme;

          try {
            localStorage.setItem('knot-theme', nextTheme);
          } catch {}

          updateIcon();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        if (!('serviceWorker' in navigator)) return;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((error) => console.warn('KNOT offline support unavailable:', error));
        });
        const prompt = document.getElementById('pwa-install-prompt');
        const installButton = document.getElementById('pwa-install-button');
        const closeButton = document.getElementById('pwa-install-close');
        const description = document.getElementById('pwa-install-description');
        if (!prompt || !installButton || !closeButton) return;
        let installEvent;
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        if (isStandalone) return;
        const dismissed = sessionStorage.getItem('knot-pwa-dismissed');
        window.addEventListener('beforeinstallprompt', (event) => {
          event.preventDefault();
          installEvent = event;
          if (!dismissed) prompt.hidden = false;
        });
        window.addEventListener('appinstalled', () => { prompt.hidden = true; installEvent = null; });
        if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !dismissed) {
          description.textContent = 'Safariの共有ボタンから「ホーム画面に追加」を選んでね。';
          installButton.hidden = true;
          prompt.hidden = false;
        }
        installButton.addEventListener('click', async () => {
          if (!installEvent) return;
          installEvent.prompt();
          await installEvent.userChoice;
          installEvent = null;
          prompt.hidden = true;
        });
        closeButton.addEventListener('click', () => {
          prompt.hidden = true;
          sessionStorage.setItem('knot-pwa-dismissed', '1');
        });
      })();
    </script>
    <script is:inline id="knot-account-shortcut">
      (() => {
        const link = document.getElementById('account-link');
        if (!link) return;
        const base = document.querySelector('meta[name="site-base"]')?.content || '/';
        const update = () => {
          let loggedIn = false;
          try {
            const session = JSON.parse(localStorage.getItem('knot-auth') || 'null');
            loggedIn = Boolean(session?.access_token);
          } catch {}
          link.href = base + (loggedIn ? 'mypage/' : 'account/');
          link.title = loggedIn ? 'マイページ' : 'ログイン / アカウント';
          link.setAttribute('aria-label', link.title);
          link.textContent = loggedIn ? '♙' : '♙';
        };
        update();
        window.addEventListener('storage', update);
        link.addEventListener('click', (event) => {
          update();
          if (link.href.endsWith('/mypage/')) {
            event.preventDefault();
            window.location.href = link.href;
          }
        });
      })();
    </script>
    <script is:inline id="knot-search-shortcut">
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          window.location.href = `${document.querySelector('meta[name="site-base"]')?.content || '/'}blog/?focus=search`;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .study-shell{width:min(100% - 36px,1080px);padding-bottom:82px}
  .study-bottom-nav{position:fixed;z-index:1000;left:0;right:0;bottom:0;display:flex;justify-content:center;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px);border-top:1px solid var(--line)}
  .study-bottom-nav a{display:flex;align-items:center;justify-content:center;gap:9px;width:min(520px,100%);min-height:44px;border-radius:12px;background:var(--surface);border:1px solid var(--line);color:var(--text);font-size:12px;font-weight:800}
  .study-bottom-nav a span{font-size:18px;color:var(--accent)}
  .pwa-prompt{position:fixed;z-index:9999;left:50%;bottom:22px;transform:translateX(-50%);width:min(560px,calc(100% - 28px));display:flex;align-items:center;gap:14px;padding:15px 16px;border:1px solid var(--line);border-radius:15px;background:var(--surface);color:var(--text);box-shadow:0 16px 50px rgba(0,0,0,.28)}
  .pwa-prompt[hidden]{display:none}
  .pwa-prompt>div{flex:1;min-width:0}.pwa-prompt strong{font-size:13px}.pwa-prompt p{font-size:11px;color:var(--muted);line-height:1.6;margin:4px 0 0}
  .pwa-prompt button{border:0;border-radius:9px;padding:10px 13px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;cursor:pointer}
  .pwa-prompt #pwa-install-close{background:transparent;color:var(--muted);font-size:20px;padding:3px 7px}
  @media(max-width:520px){.pwa-prompt{bottom:12px;gap:8px;padding:12px}.pwa-prompt button{padding:9px 10px}}

  :root {
    color-scheme: dark;
    --bg: #0b1220;
    --surface: #111c2e;
    --surface-soft: rgba(17, 28, 46, .6);
    --line: rgba(148, 163, 184, .14);
    --text: #f4f7fb;
    --muted: #9aa9bd;
    --accent: #82b2ff;
    --article-text: #c4cedc;
    --code-bg: #142137;
  }

  html[data-theme="light"] {
    color-scheme: light;
    --bg: #f5f6f8;
    --surface: #ffffff;
    --surface-soft: #ffffff;
    --line: #e2e6ed;
    --text: #172033;
    --muted: #596579;
    --accent: #3478f6;
    --article-text: #465366;
    --code-bg: #edf2f8;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(ellipse at 50% -18%, rgba(61,112,190,.12), transparent 42rem),
      var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP", sans-serif;
    -webkit-font-smoothing: antialiased;
    transition: background .25s ease, color .25s ease;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  .site-shell {
    width: min(100% - 48px, 1080px);
    margin: 0 auto;
  }

  .site-header {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -.09em;
    transition: opacity .2s ease;
  }

  .brand:hover {
    opacity: .7;
  }

  .brand-dot {
    color: var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 25px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }

  nav a {
    transition: color .2s ease;
  }

  nav a:hover {
    color: var(--text);
  }

  .account-link{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--line);border-radius:50%;color:var(--muted);font-size:17px;transition:color .2s,border-color .2s}
  .account-link:hover{color:var(--accent);border-color:var(--accent)}

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    font-size: 17px;
    cursor: pointer;
    transition: transform .2s, background .2s;
  }

  .theme-toggle:hover {
    transform: rotate(15deg);
    background: var(--code-bg);
  }

  .github-link {
    color: var(--muted);
    font-size: 13px;
    opacity: .55;
  }

  .github-link:hover {
    opacity: 1;
  }

  main {
    min-height: 65vh;
  }

  .site-footer {
    margin-top: 100px;
    padding: 27px 0 34px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: var(--muted);
    font-size: 11px;
  }

  .footer-brand {
    color: var(--text);
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -.08em;
  }

  .site-footer p {
    margin: 0;
  }

  html[data-theme="light"] body {
    background: var(--bg);
    color: var(--text);
  }

  html[data-theme="light"] .site-shell {
    color: var(--text);
  }

  html[data-theme="light"] .site-header,
  html[data-theme="light"] .site-footer {
    border-color: var(--line);
  }

  html[data-theme="light"] .site-footer {
    color: var(--muted);
  }

  html[data-theme="light"] .footer-brand {
    color: var(--text);
  }

  html[data-theme="light"] .theme-toggle {
    background: #ffffff;
    color: #172033;
    border-color: #e2e6ed;
  }

  html[data-theme="light"] nav {
    color: var(--muted);
  }

  html[data-theme="light"] nav a:hover {
    color: var(--text);
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(100% - 32px, 1080px);
    }

    .site-header {
      min-height: 72px;
    }

    nav {
      gap: 15px;
      font-size: 12px;
    }

    .github-link {
      display: none;
    }

    .site-footer {
      margin-top: 70px;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
