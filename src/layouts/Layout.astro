
---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = '中学3年生の日々感じたことを書いていく、備忘録的なブログです。',
  image,
} = Astro.props;

const BASE = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageImage = image ? new URL(image, Astro.url).href : undefined;
const faviconURL = `${BASE}favicon.svg?v=3`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={faviconURL} />
    <link rel="shortcut icon" type="image/svg+xml" href={faviconURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Noto+Sans+JP:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KNOT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {pageImage && <meta property="og:image" content={pageImage} />}

    <title>{title}</title>
  </head>

  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={BASE} aria-label="KNOT ホーム">
          KNOT<span class="brand-dot">.</span>
        </a>

        <nav aria-label="メインナビゲーション">
          <a href={BASE}>ホーム</a>
          <a href={`${BASE}blog/`}>記事一覧</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-main">
          <a class="footer-brand" href={BASE}>
            KNOT<span class="brand-dot">.</span>
          </a>
          <p>日々のことを、少しずつ。</p>
        </div>

        <div class="footer-bottom">
          <span>
            © {new Date().getFullYear()}
            <a
              class="copyright-link"
              href="https://github.com/knotspace/knotspace.github.io"
              target="_blank"
              rel="noreferrer"
            >KNOT.</a>
          </span>
          <span>Built with Astro.</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b1220;
    --surface: #111c2e;
    --surface-light: #152238;
    --line: rgba(148, 163, 184, .16);
    --text: #f4f7fb;
    --muted: #9aa9bd;
    --accent: #82b2ff;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(ellipse at 50% -18%, rgba(61,112,190,.10), transparent 42rem),
      var(--bg);
    color: var(--text);
    font-family: "DM Sans", "Noto Sans JP", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-shell {
    width: min(100% - 48px, 1120px);
    margin: 0 auto;
  }

  .site-header {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -.09em;
    transition: opacity .2s ease;
  }

  .brand:hover {
    opacity: .7;
  }

  .brand-dot {
    color: var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }

  nav a {
    transition: color .2s ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }

  main {
    min-height: 65vh;
  }

  .site-footer {
    margin-top: 90px;
    padding: 28px 0 24px;
    border-top: 1px solid var(--line);
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .footer-brand {
    font-size: 19px;
    font-weight: 900;
    letter-spacing: -.08em;
  }

  .footer-main p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    color: #718198;
    font-size: 10px;
  }

  .copyright-link {
    color: inherit;
    transition: color .2s ease;
  }

  .copyright-link:hover {
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(100% - 32px, 1120px);
    }

    .site-header {
      min-height: 70px;
    }

    nav {
      gap: 19px;
      font-size: 12px;
    }

    .site-footer {
      margin-top: 65px;
    }
  }
</style>
