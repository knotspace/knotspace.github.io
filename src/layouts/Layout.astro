
---
import '../styles/site/layout.css';
import siteSettings from '../data/site-settings.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteSettings.siteDescription,
  image,
  noindex = false,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageImage = image ? new URL(image, Astro.url).href : new URL('/og-default.svg', Astro.site ?? Astro.url).href;
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'KNOT',
  url: Astro.site?.toString() ?? 'https://knotspace.github.io/',
  inLanguage: 'ja-JP',
  description: siteSettings.siteDescription,
};
const structuredItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const articleStructuredData = structuredItems.find((item) =>
  ['Article', 'BlogPosting', 'NewsArticle'].includes(String(item['@type']))
);
const isArticlePage = Boolean(articleStructuredData);
const BASE = import.meta.env.BASE_URL;
const navHref = (path: string) => /^https?:\/\//i.test(path) ? path : BASE + path.replace(/^\/+/, '');
---

<!doctype html>
<html lang="ja" data-theme="dark" data-app-mode="site">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <meta name="author" content="KNOT" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="site-base" content={BASE} />
    <link rel="canonical" href={canonicalURL} />
    {image && <link rel="preload" as="image" href={pageImage} fetchpriority="high" />}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://giscus.app" />
    <link rel="dns-prefetch" href="https://rtzorqaigpeechqywjie.supabase.co" />

    <link rel="alternate" type="application/rss+xml" title="KNOT RSS" href={`${BASE}rss.xml`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg?v=5`} sizes="any" />
    <link rel="shortcut icon" href={`${BASE}favicon.svg?v=5`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${BASE}favicon.svg?v=5`} />

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('knot-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>


    <meta property="og:type" content={isArticlePage ? "article" : "website"} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="KNOT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content={`${title} | KNOT`} />
    {articleStructuredData?.datePublished && <meta property="article:published_time" content={String(articleStructuredData.datePublished)} />}
    {articleStructuredData?.dateModified && <meta property="article:modified_time" content={String(articleStructuredData.dateModified)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content={`${title} | KNOT`} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {structuredItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <title>{title}</title>
  </head>

  <body>
    <div class="site-shell">
      
      
      <header class="site-header">
        <a class="brand" href={BASE} aria-label="KNOT ホーム">
          KNOT<span class="brand-dot">.</span>
        </a>

        <nav aria-label="メインナビゲーション">
          {siteSettings.navigation.map((item) => <a href={navHref(item.url)}>{item.label}</a>)}<a href={navHref("/game/")}>GAME</a><button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="テーマを切り替える"
            title="テーマを切り替える"
          >
            <span id="theme-icon">☀</span>
          </button>

          <a
            class="github-link"
            href="https://github.com/knotspace/knotspace.github.io"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            ↗
          </a>
        </nav>
      </header>

      <main>
        <slot />
        <section class="knot-maker-banner" aria-label="KNOT制作">
          <a class="knot-maker-mark" href={navHref('/studio/')}>K.</a>
          <div class="knot-maker-copy"><span>INSIDE KNOT / MAKING LOG</span><strong>このサイトも、Studyも。KNOTが自分でつくっている。</strong><p>機能を考え、コードを書き、公開して、使いながら改善する。制作の裏側と更新記録をまとめています。</p></div>
          <a class="knot-maker-link" href={navHref('/studio/')}>KNOT制作を見る <span>↗</span></a>
        </section>
      </main>

      <footer class="site-footer">
        <a class="footer-brand" href={BASE}>
          KNOT<span class="brand-dot">.</span>
        </a>
        <p>{siteSettings.footerText} <a href={navHref("/studio/")}>KNOT制作・開発記録 ↗</a></p>
        <span>{siteSettings.footerNote} · © {new Date().getFullYear()} KNOT. Built with Astro.</span>
      </footer>
      
    </div>

    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const root = document.documentElement;

        if (!button || !icon) return;

        const updateIcon = () => {
          const isDark = root.dataset.theme !== 'light';

          icon.textContent = isDark ? '☀' : '☾';

          if (isDark) {
            button.setAttribute('aria-label', 'ライトモードに切り替える');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0b1220');
          } else {
            button.setAttribute('aria-label', 'ダークモードに切り替える');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f7f8fa');
          }
        };

        updateIcon();

        button.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';

          root.dataset.theme = nextTheme;

          try {
            localStorage.setItem('knot-theme', nextTheme);
          } catch {}

          updateIcon();
        });
      })();
    </script>
    <script is:inline>
      // KNOT本体はPWA化しない。旧ルートSWだけを解除し、Study/Adminの専用SWは残す。
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", async () => {
          try {
            const registrations = await navigator.serviceWorker.getRegistrations();
            const rootScope = new URL(document.querySelector('meta[name="site-base"]')?.content || "/", location.origin).href;
            await Promise.all(registrations.filter((registration) => registration.scope === rootScope).map((registration) => registration.unregister()));
            const keys = await caches.keys();
            await Promise.all(keys.filter((key) => key.startsWith("knot-shell-")).map((key) => caches.delete(key)));
          } catch (error) { console.warn("旧KNOT PWAの解除に失敗しました:", error); }
        });
      }
    </script>
    <script is:inline id="knot-search-shortcut">
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          window.location.href = `${document.querySelector('meta[name="site-base"]')?.content || '/'}blog/?focus=search`;
        }
      });
    </script>
  </body>
<style is="global">
.knot-maker-banner{display:flex;align-items:center;gap:18px;margin:46px auto 0;padding:20px 22px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(115deg,color-mix(in srgb,var(--accent) 10%,var(--surface)),var(--surface));}
.knot-maker-mark{display:grid;place-items:center;flex:0 0 48px;width:48px;height:48px;border-radius:14px;background:var(--accent);color:#081323;font-size:22px;font-weight:950;letter-spacing:-.1em}
.knot-maker-copy{min-width:0;flex:1}.knot-maker-copy>span{display:block;color:var(--accent);font:9px ui-monospace,monospace;letter-spacing:.15em}.knot-maker-copy strong{display:block;margin-top:5px;font-size:14px;letter-spacing:-.02em}.knot-maker-copy p{margin:5px 0 0;color:var(--muted);font-size:11px;line-height:1.7}
.knot-maker-link{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;padding:11px 14px;border:1px solid var(--line);border-radius:999px;font-size:11px;font-weight:800;color:var(--text)}.knot-maker-link span{color:var(--accent)}
.site-footer p a{margin-left:7px;color:var(--accent);font-weight:750}
@media(max-width:620px){.knot-maker-banner{align-items:flex-start;flex-wrap:wrap;gap:12px;margin-top:32px;padding:16px}.knot-maker-mark{width:40px;height:40px;flex-basis:40px}.knot-maker-copy{width:calc(100% - 54px)}.knot-maker-copy strong{font-size:12px}.knot-maker-copy p{font-size:10px}.knot-maker-link{margin-left:52px;padding:9px 12px}}
</style>
</html>


