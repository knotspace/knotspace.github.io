
---
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  studyMode?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Web制作や日々の興味、ランニングなどを記録する個人ブログ。',
  image,
  noindex = false,
  studyMode = false,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageImage = image ? new URL(image, Astro.url).href : new URL('/og-default.svg', Astro.site ?? Astro.url).href;
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'KNOT',
  url: Astro.site?.toString() ?? 'https://knotspace.github.io/',
  inLanguage: 'ja-JP',
  description: 'Web制作、PC・アプリ、本・読書、勉強や日々の興味を記録する個人ブログ。',
};
const BASE = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isStudyActive = (path: string) => currentPath === path || (currentPath.startsWith(path) && path !== `${BASE}study/`);
---

<!doctype html>
<html lang="ja" data-theme="dark" data-app-mode={studyMode ? "study" : "site"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="author" content="KNOT" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="site-base" content={BASE} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="manifest" href={studyMode ? `${BASE}study.webmanifest` : `${BASE}manifest.webmanifest`} />

    <link rel="alternate" type="application/rss+xml" title="KNOT RSS" href={`${BASE}rss.xml`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg?v=5`} sizes="any" />
    <link rel="shortcut icon" href={`${BASE}favicon.svg?v=5`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${BASE}favicon.svg?v=5`} />

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('knot-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>


    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="KNOT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content={`${title} | KNOT`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImage} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {structuredData && (Array.isArray(structuredData) ? structuredData : [structuredData]).map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <title>{title}</title>
  </head>

  <body>
    <div class:list={["site-shell", { "study-shell": studyMode, "study-app-shell": studyMode }]}>
      {studyMode && <aside class="study-sidebar" aria-label="Studyメニュー">
        <a class="study-brand" href={`${BASE}study/`}><span class="study-brand-mark">K</span><span><strong>KNOT<span>.</span></strong><small>STUDY</small></span></a>
        <div class="sidebar-label">LEARN</div>
        <a class:list={["study-nav-item", { active: currentPath === `${BASE}study/` }]} href={`${BASE}study/`}><span>⌂</span>ホーム</a>
        <a class:list={["study-nav-item", { active: isStudyActive(`${BASE}study/foundation/`) || isStudyActive(`${BASE}study/solve/`) }]} href={`${BASE}study/foundation/`}><span>✎</span>基礎演習</a>
        <a class:list={["study-nav-item", { active: isStudyActive(`${BASE}study/kosen/`) }]} href={`${BASE}study/kosen/`}><span>⌁</span>高専対策</a>
        <a class:list={["study-nav-item", { active: isStudyActive(`${BASE}study/mock/`) }]} href={`${BASE}study/mock/`}><span>▤</span>模試に挑戦</a>
        <div class="sidebar-label second">KNOWLEDGE</div>
        <a class:list={["study-nav-item", { active: isStudyActive(`${BASE}study/summary/`) }]} href={`${BASE}study/summary/`}><span>▦</span>要点まとめ</a>
        <a class:list={["study-nav-item", { active: isStudyActive(`${BASE}study/tools/`) }]} href={`${BASE}study/tools/`}><span>◷</span>学習ツール</a>
        <div class="sidebar-spacer"></div>
        <a class="study-back-site" href={BASE}><span>↗</span> KNOT本体へ戻る</a>
        <div class="sidebar-foot">KNOT STUDY <span>·</span> LEARN EVERY DAY</div>
      </aside>}
      {studyMode && <header class="study-appbar">
        <a class="study-mobile-brand" href={`${BASE}study/`}><span class="study-brand-mark">K</span><strong>KNOT<span>.</span> STUDY</strong></a>
        <div class="study-appbar-right"><span class="study-appbar-caption">YOUR LEARNING SPACE</span><button class="theme-toggle study-theme-toggle" id="theme-toggle" type="button" aria-label="テーマを切り替える" title="テーマを切り替える"><span id="theme-icon">☀</span></button></div>
      </header>}
      {!studyMode && <header class="site-header">
        <a class="brand" href={BASE} aria-label="KNOT ホーム">
          KNOT<span class="brand-dot">.</span>
        </a>

        <nav aria-label="メインナビゲーション">
          <a href={BASE}>ホーム</a>
          <a href={`${BASE}blog/`}>記事一覧</a>
          <a href={`${BASE}study/`}>Study</a>
          <a href={`${BASE}bookmarks/`}>あとで読む</a>
          <a href={`${BASE}about/`}>プロフィール</a>

          <a class="account-link" id="account-link" href={`${BASE}account/`} aria-label="ログイン / マイページ" title="ログイン / マイページ">♙</a>

          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="テーマを切り替える"
            title="テーマを切り替える"
          >
            <span id="theme-icon">☀</span>
          </button>

          <a
            class="github-link"
            href="https://github.com/knotspace/knotspace.github.io"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            ↗
          </a>
        </nav>
      </header>}

      <main class:list={{ "study-app-main": studyMode }}>
        <slot />
      </main>

      <aside id="pwa-install-prompt" class="pwa-prompt" hidden aria-live="polite">
        <div><strong>{studyMode ? "KNOT Studyをアプリとして使う" : "KNOTをアプリとして使う"}</strong><p id="pwa-install-description">{studyMode ? "ホーム画面に追加すると、Studyをすぐに開けるよ。" : "ホーム画面に追加すると、次回からすぐに開けるよ。"}</p></div>
        <button id="pwa-install-button" type="button">インストール</button>
        <button id="pwa-install-close" type="button" aria-label="閉じる">×</button>
      </aside>
      {!studyMode && <footer class="site-footer">
        <a class="footer-brand" href={BASE}>
          KNOT<span class="brand-dot">.</span>
        </a>
        <p>Web制作や日々の興味を記録する個人ブログ。</p>
        <span>© {new Date().getFullYear()} KNOT. Built with Astro.</span>
      </footer>}
      {studyMode && <nav class="study-bottom-nav" aria-label="Study navigation">
        <a class:list={{ active: currentPath === `${BASE}study/` }} href={`${BASE}study/`}><span>⌂</span><small>ホーム</small></a>
        <a class:list={{ active: isStudyActive(`${BASE}study/foundation/`) || isStudyActive(`${BASE}study/solve/`) }} href={`${BASE}study/foundation/`}><span>✎</span><small>演習</small></a>
        <a class:list={{ active: isStudyActive(`${BASE}study/summary/`) }} href={`${BASE}study/summary/`}><span>▦</span><small>要点</small></a>
        <a class:list={{ active: isStudyActive(`${BASE}study/mock/`) }} href={`${BASE}study/mock/`}><span>▤</span><small>模試</small></a>
      </nav>}
    </div>

    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const root = document.documentElement;

        if (!button || !icon) return;

        const updateIcon = () => {
          const isDark = root.dataset.theme !== 'light';

          icon.textContent = isDark ? '☀' : '☾';

          if (isDark) {
            button.setAttribute('aria-label', 'ライトモードに切り替える');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0b1220');
          } else {
            button.setAttribute('aria-label', 'ダークモードに切り替える');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f7f8fa');
          }
        };

        updateIcon();

        button.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';

          root.dataset.theme = nextTheme;

          try {
            localStorage.setItem('knot-theme', nextTheme);
          } catch {}

          updateIcon();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        if (!('serviceWorker' in navigator)) return;
        window.addEventListener('load', () => {
          const base = document.querySelector('meta[name="site-base"]')?.content || '/';
          const isStudy = document.documentElement.dataset.appMode === 'study';
          const worker = base + (isStudy ? 'study-sw.js' : 'sw.js');
          const options = isStudy ? { scope: base + 'study/' } : undefined;
          navigator.serviceWorker.register(worker, options).catch((error) => console.warn('KNOT offline support unavailable:', error));
        });
        const prompt = document.getElementById('pwa-install-prompt');
        const installButton = document.getElementById('pwa-install-button');
        const closeButton = document.getElementById('pwa-install-close');
        const description = document.getElementById('pwa-install-description');
        if (!prompt || !installButton || !closeButton) return;
        let installEvent;
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        if (isStandalone) return;
        const dismissKey = document.documentElement.dataset.appMode === 'study' ? 'knot-study-pwa-dismissed' : 'knot-pwa-dismissed';
        const dismissed = sessionStorage.getItem(dismissKey);
        window.addEventListener('beforeinstallprompt', (event) => {
          event.preventDefault();
          installEvent = event;
          if (!dismissed) prompt.hidden = false;
        });
        window.addEventListener('appinstalled', () => { prompt.hidden = true; installEvent = null; });
        if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !dismissed) {
          description.textContent = 'Safariの共有ボタンから「ホーム画面に追加」を選んでね。';
          installButton.hidden = true;
          prompt.hidden = false;
        }
        installButton.addEventListener('click', async () => {
          if (!installEvent) return;
          installEvent.prompt();
          await installEvent.userChoice;
          installEvent = null;
          prompt.hidden = true;
        });
        closeButton.addEventListener('click', () => {
          prompt.hidden = true;
          sessionStorage.setItem(dismissKey, '1');
        });
      })();
    </script>
    <script is:inline id="knot-account-shortcut">
      (() => {
        const link = document.getElementById('account-link');
        if (!link) return;
        const base = document.querySelector('meta[name="site-base"]')?.content || '/';
        const update = () => {
          let loggedIn = false;
          try {
            const session = JSON.parse(localStorage.getItem('knot-auth') || 'null');
            loggedIn = Boolean(session?.access_token);
          } catch {}
          link.href = base + (loggedIn ? 'mypage/' : 'account/');
          link.title = loggedIn ? 'マイページ' : 'ログイン / アカウント';
          link.setAttribute('aria-label', link.title);
          link.textContent = loggedIn ? '♙' : '♙';
        };
        update();
        window.addEventListener('storage', update);
        link.addEventListener('click', (event) => {
          update();
          if (link.href.endsWith('/mypage/')) {
            event.preventDefault();
            window.location.href = link.href;
          }
        });
      })();
    </script>
    <script is:inline id="knot-search-shortcut">
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          window.location.href = `${document.querySelector('meta[name="site-base"]')?.content || '/'}blog/?focus=search`;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .study-shell{width:100%;max-width:none;margin:0;padding:0}
  .study-app-shell{min-height:100dvh}
  .study-sidebar{position:fixed;z-index:1100;inset:0 auto 0 0;width:236px;padding:26px 17px 18px;background:var(--surface);border-right:1px solid var(--line);display:flex;flex-direction:column}
  .study-brand{display:flex;align-items:center;gap:11px;padding:0 8px 30px;color:var(--text)}
  .study-brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:var(--accent);color:#071426;font-size:21px;font-weight:950;box-shadow:0 6px 18px color-mix(in srgb,var(--accent) 25%,transparent)}
  .study-brand>span:last-child{display:grid;gap:1px}.study-brand strong{font-size:18px;letter-spacing:-.07em}.study-brand strong span,.study-mobile-brand strong span{color:var(--accent)}.study-brand small{font:9px ui-monospace,monospace;letter-spacing:.2em;color:var(--muted)}
  .sidebar-label{padding:0 11px;margin:2px 0 9px;color:var(--muted);font:9px ui-monospace,monospace;letter-spacing:.16em;font-weight:800}
  .sidebar-label.second{margin-top:28px}
  .study-nav-item{display:flex;align-items:center;gap:13px;min-height:44px;padding:0 12px;border-radius:10px;color:var(--muted);font-size:12px;font-weight:700;transition:background .15s,color .15s}
  .study-nav-item>span{display:grid;place-items:center;width:22px;font-size:17px;color:var(--muted)}
  .study-nav-item:hover{background:var(--surface-soft);color:var(--text)}
  .study-nav-item.active{background:color-mix(in srgb,var(--accent) 13%,var(--surface));color:var(--accent)}
  .study-nav-item.active>span{color:var(--accent)}
  .sidebar-spacer{flex:1}
  .study-back-site{display:flex;gap:9px;align-items:center;padding:12px;color:var(--muted);font-size:11px;border-top:1px solid var(--line)}
  .study-back-site span{color:var(--accent)}
  .sidebar-foot{padding:9px 12px 0;color:var(--muted);font:8px ui-monospace,monospace;letter-spacing:.1em;opacity:.7}
  .sidebar-foot span{color:var(--accent)}
  .study-appbar{position:fixed;z-index:1050;top:0;left:236px;right:0;height:68px;padding:0 30px;display:flex;align-items:center;justify-content:space-between;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
  .study-mobile-brand{display:none;align-items:center;gap:9px;color:var(--text)}
  .study-mobile-brand .study-brand-mark{width:30px;height:30px;font-size:16px;border-radius:9px}
  .study-mobile-brand strong{font-size:14px;letter-spacing:-.04em}
  .study-appbar-right{display:flex;align-items:center;gap:17px}
  .study-appbar-caption{font:9px ui-monospace,monospace;letter-spacing:.14em;color:var(--muted)}
  .study-theme-toggle{width:34px;height:34px;border-radius:10px}
  .study-app-main{margin-left:236px;padding:68px 30px 30px;min-height:100dvh}
  .study-bottom-nav{display:none}
  .study-app-shell .pwa-prompt{bottom:22px}
  .study-app-shell .study-app-main>main{min-height:calc(100dvh - 100px)}
  @media(max-width:760px){
    .study-sidebar{display:none}
    .study-appbar{left:0;height:58px;padding:0 17px}
    .study-mobile-brand{display:flex}
    .study-appbar-caption{display:none}
    .study-app-main{margin-left:0;padding:58px 17px 92px}
    .study-bottom-nav{position:fixed;z-index:1200;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(4,1fr);padding:7px 12px calc(7px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(20px);border-top:1px solid var(--line)}
    .study-bottom-nav a{display:grid;justify-items:center;align-content:center;gap:3px;min-height:48px;color:var(--muted);border-radius:10px}
    .study-bottom-nav a span{font-size:19px;line-height:1}
    .study-bottom-nav a small{font-size:9px;font-weight:700}
    .study-bottom-nav a.active{color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent)}
    .study-app-shell .pwa-prompt{bottom:78px}
  }
  @media(min-width:761px){.study-appbar{justify-content:flex-end}}
  .pwa-prompt{position:fixed;z-index:9999;left:50%;bottom:22px;transform:translateX(-50%);width:min(560px,calc(100% - 28px));display:flex;align-items:center;gap:14px;padding:15px 16px;border:1px solid var(--line);border-radius:15px;background:var(--surface);color:var(--text);box-shadow:0 16px 50px rgba(0,0,0,.28)}
  .pwa-prompt[hidden]{display:none}
  .pwa-prompt>div{flex:1;min-width:0}.pwa-prompt strong{font-size:13px}.pwa-prompt p{font-size:11px;color:var(--muted);line-height:1.6;margin:4px 0 0}
  .pwa-prompt button{border:0;border-radius:9px;padding:10px 13px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;cursor:pointer}
  .pwa-prompt #pwa-install-close{background:transparent;color:var(--muted);font-size:20px;padding:3px 7px}
  @media(max-width:520px){.pwa-prompt{bottom:12px;gap:8px;padding:12px}.pwa-prompt button{padding:9px 10px}}

  :root {
    color-scheme: dark;
    --bg: #0b1220;
    --surface: #111c2e;
    --surface-soft: rgba(17, 28, 46, .6);
    --line: rgba(148, 163, 184, .14);
    --text: #f4f7fb;
    --muted: #9aa9bd;
    --accent: #82b2ff;
    --article-text: #c4cedc;
    --code-bg: #142137;
  }

  html[data-theme="light"] {
    color-scheme: light;
    --bg: #f5f6f8;
    --surface: #ffffff;
    --surface-soft: #ffffff;
    --line: #e2e6ed;
    --text: #172033;
    --muted: #596579;
    --accent: #3478f6;
    --article-text: #465366;
    --code-bg: #edf2f8;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(ellipse at 50% -18%, rgba(61,112,190,.12), transparent 42rem),
      var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP", sans-serif;
    -webkit-font-smoothing: antialiased;
    transition: background .25s ease, color .25s ease;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  .site-shell {
    width: min(100% - 48px, 1120px);
    margin: 0 auto;
  }

  .site-header {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -.09em;
    transition: opacity .2s ease;
  }

  .brand:hover {
    opacity: .7;
  }

  .brand-dot {
    color: var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 25px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }

  nav a {
    transition: color .2s ease;
  }

  nav a:hover {
    color: var(--text);
  }

  .account-link{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--line);border-radius:50%;color:var(--muted);font-size:17px;transition:color .2s,border-color .2s}
  .account-link:hover{color:var(--accent);border-color:var(--accent)}

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    font-size: 17px;
    cursor: pointer;
    transition: transform .2s, background .2s;
  }

  .theme-toggle:hover {
    transform: rotate(15deg);
    background: var(--code-bg);
  }

  .github-link {
    color: var(--muted);
    font-size: 13px;
    opacity: .55;
  }

  .github-link:hover {
    opacity: 1;
  }

  main {
    min-height: 65vh;
  }

  .site-footer {
    margin-top: 100px;
    padding: 27px 0 34px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: var(--muted);
    font-size: 11px;
  }

  .footer-brand {
    color: var(--text);
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -.08em;
  }

  .site-footer p {
    margin: 0;
  }

  html[data-theme="light"] body {
    background: var(--bg);
    color: var(--text);
  }

  html[data-theme="light"] .site-shell {
    color: var(--text);
  }

  html[data-theme="light"] .site-header,
  html[data-theme="light"] .site-footer {
    border-color: var(--line);
  }

  html[data-theme="light"] .site-footer {
    color: var(--muted);
  }

  html[data-theme="light"] .footer-brand {
    color: var(--text);
  }

  html[data-theme="light"] .theme-toggle {
    background: #ffffff;
    color: #172033;
    border-color: #e2e6ed;
  }

  html[data-theme="light"] nav {
    color: var(--muted);
  }

  html[data-theme="light"] nav a:hover {
    color: var(--text);
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(100% - 32px, 1080px);
    }

