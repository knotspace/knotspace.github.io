---
import '../styles/study/layout.css';
interface Props { title: string; description?: string; noindex?: boolean; manifestUrl?: string; }
const { title, description = '理科・社会の基礎網羅問題に取り組める学習スペース。', noindex = false, manifestUrl } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || (currentPath.startsWith(path) && path !== `${BASE}study/`);
const pageImage = new URL('/og-default.svg', Astro.site ?? Astro.url).href;
const websiteJsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'KNOT Study', url: new URL('study/', Astro.site ?? Astro.url).href, inLanguage: 'ja-JP', description };
---
<!doctype html>
<html lang="ja" data-theme="dark" data-app-mode="study">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#0b1220" /><meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
<meta name="googlebot" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
<meta name="author" content="KNOT Study" /><meta name="color-scheme" content="dark light" /><meta name="referrer" content="strict-origin-when-cross-origin" /><meta name="site-base" content={BASE} />
<link rel="canonical" href={canonicalURL} /><link rel="manifest" href={manifestUrl || `${BASE}study/manifest.webmanifest`} /><link rel="icon" type="image/svg+xml" href={`${BASE}study/icon.svg?v=2`} sizes="any" /><link rel="shortcut icon" href={`${BASE}study/icon.svg?v=2`} type="image/svg+xml" /><link rel="apple-touch-icon" href={`${BASE}study/icon.svg?v=2`} />
<meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" /><meta property="og:site_name" content="KNOT Study" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalURL} /><meta property="og:image" content={pageImage} /><meta property="og:image:alt" content={`${title} | KNOT Study`} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={pageImage} /><meta name="twitter:image:alt" content={`${title} | KNOT Study`} /><script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} /><title>{title}</title>
<script is:inline>try { const savedTheme = localStorage.getItem('knot-study-theme') || localStorage.getItem('knot-theme'); if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme; } catch {}</script>
</head>
<body>
<div class="study-shell">
<aside class="study-sidebar" aria-label="Studyメニュー">
<a class="study-brand" href={`${BASE}study/`}><span class="study-brand-mark">K</span><span><strong>KNOT<span>.</span></strong><small>STUDY</small></span></a>
<div class="sidebar-label">LEARN</div>
<a class:list={["study-nav-item", { active: currentPath === `${BASE}study/` }]} href={`${BASE}study/`}><span>⌂</span>ホーム</a>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/foundation/`) }]} href={`${BASE}study/foundation/`}><span>✎</span>基礎網羅問題</a>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/public-exam/`) }]} href={`${BASE}study/public-exam/`}><span>▣</span>公立高校入試問題精講</a>\n<a class:list={["study-nav-item", { active: isActive(`${BASE}study/summary/`) }]} href={`${BASE}study/summary/`}><span>▤</span>要点まとめ</a>
<div class="sidebar-spacer"></div><a class="study-back-site" href={BASE}><span>↗</span> KNOT本体へ戻る</a><div class="sidebar-foot">KNOT STUDY <span>·</span> LEARN EVERY DAY</div>
</aside>
<header class="study-appbar"><a class="study-mobile-brand" href={`${BASE}study/`}><span class="study-brand-mark">K</span><strong>KNOT<span>.</span> STUDY</strong></a><div class="study-appbar-right"><a class="study-maker-shortcut" href={`${BASE}studio/`}>KNOT制作 ↗</a><span class="study-appbar-caption">YOUR LEARNING SPACE</span><button class="theme-toggle study-theme-toggle" id="theme-toggle" type="button" aria-label="テーマを切り替える" title="テーマを切り替える"><span id="theme-icon">☀</span></button></div></header>
<main class="study-app-main"><slot />
<section class="study-maker-banner" aria-label="KNOT制作・開発記録">
  <div class="study-maker-icon">K.</div>
  <div><span>BUILT BY KNOT</span><strong>Studyをつくっているのも、KNOT。</strong><p>問題・解説・機能を少しずつ追加しながら、自分たちで開発と改善を続けています。</p></div>
  <a href={`${BASE}studio/`}>制作の裏側を見る ↗</a>
</section>
</main>
<aside id="pwa-install-prompt" class="pwa-prompt" hidden aria-live="polite"><div><strong id="pwa-install-title">KNOT Studyをアプリとして使う</strong><p id="pwa-install-description">ホーム画面に追加すると、Studyをすぐに開けるよ。</p></div><button id="pwa-install-button" type="button">インストール</button><button id="pwa-install-close" type="button" aria-label="閉じる">×</button></aside>
<nav class="study-bottom-nav" aria-label="Study navigation">
<a class:list={{ active: currentPath === `${BASE}study/` }} href={`${BASE}study/`}><span>⌂</span><small>ホーム</small></a><a class:list={{ active: isActive(`${BASE}study/foundation/`) }} href={`${BASE}study/foundation/`}><span>✎</span><small>問題演習</small></a><a class:list={{ active: isActive(`${BASE}study/summary/`) }} href={`${BASE}study/summary/`}><span>▤</span><small>要点まとめ</small></a>
</nav>
</div>
<script is:inline>
(() => { const button=document.getElementById('theme-toggle'),icon=document.getElementById('theme-icon'),root=document.documentElement;if(!button||!icon)return;const update=()=>{const dark=root.dataset.theme!=='light';icon.textContent=dark?'☀':'☾';button.setAttribute('aria-label',dark?'ライトモードに切り替える':'ダークモードに切り替える');document.querySelector('meta[name="theme-color"]')?.setAttribute('content',dark?'#0b1220':'#f7f8fa');};update();button.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('knot-study-theme',next);localStorage.setItem('knot-theme',next);}catch{}update();});})();
</script>
<script is:inline>
(() => {
  if (!('serviceWorker' in navigator)) return;
  window.addEventListener('load', () => {
    const base = document.querySelector('meta[name="site-base"]')?.content || '/';
    navigator.serviceWorker.register(base + 'study-sw.js', { scope: base + 'study/', updateViaCache: 'none' })
      .catch((error) => console.warn('KNOT Study offline support unavailable:', error));
  });
  const prompt = document.getElementById('pwa-install-prompt');
  const installButton = document.getElementById('pwa-install-button');
  const closeButton = document.getElementById('pwa-install-close');
  const description = document.getElementById('pwa-install-description');
  const title = document.getElementById('pwa-install-title');
  if (!prompt || !installButton || !closeButton) return;
  const secretPage = location.pathname.includes('/quiet-practice-7c2e91/');
  const hasSecretAccess = () => { try { return sessionStorage.getItem('knot-study-secret-unlocked') === '1'; } catch { return false; } };
  const canPrompt = () => !secretPage || hasSecretAccess();
  if (secretPage) {
    if (title) title.textContent = '高専絶対合格をアプリとして使う';
    if (description) description.textContent = '秘密モードにログインすると、この学習ページをアプリとして追加できるよ。';
  }
  let installEvent;
  let dismissed = false;
  try { dismissed = sessionStorage.getItem(secretPage ? 'kosen-absolute-pwa-dismissed' : 'knot-study-pwa-dismissed') === '1'; } catch {}
  if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true) return;
  window.addEventListener('knot-secret-unlocked', () => { if (installEvent && !dismissed) prompt.hidden = false; });
  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    installEvent = event;
    if (!dismissed && canPrompt()) prompt.hidden = false;
  });
  window.addEventListener('appinstalled', () => { prompt.hidden = true; installEvent = null; });
  if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !dismissed && canPrompt()) {
    description.textContent = 'Safariの共有ボタンから「ホーム画面に追加」を選んでね。';
    installButton.hidden = true;
    prompt.hidden = false;
  }
  installButton.addEventListener('click', async () => {
    if (!installEvent) return;
    installEvent.prompt();
    await installEvent.userChoice;
    installEvent = null;
    prompt.hidden = true;
  });
  closeButton.addEventListener('click', () => {
    prompt.hidden = true;
    try { sessionStorage.setItem(secretPage ? 'kosen-absolute-pwa-dismissed' : 'knot-study-pwa-dismissed', '1'); } catch {}
  });
})();
</script>
<style is="global">
.study-maker-banner{display:flex;align-items:center;gap:14px;margin:26px 0 10px;padding:16px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(110deg,color-mix(in srgb,var(--accent) 10%,var(--surface)),var(--surface))}
.study-maker-icon{display:grid;place-items:center;flex:0 0 42px;width:42px;height:42px;border-radius:12px;background:var(--accent);color:#081323;font-size:19px;font-weight:950}
.study-maker-banner>div:nth-child(2){flex:1;min-width:0}.study-maker-banner>div:nth-child(2)>span{display:block;color:var(--accent);font:9px ui-monospace,monospace;letter-spacing:.14em}.study-maker-banner strong{display:block;margin-top:4px;font-size:12px}.study-maker-banner p{margin:4px 0 0;color:var(--muted);font-size:10px;line-height:1.6}.study-maker-banner>a{white-space:nowrap;color:var(--accent);font-size:10px;font-weight:850}
.study-maker-shortcut{color:var(--accent);font-size:10px;font-weight:800;padding:7px 10px;border:1px solid var(--line);border-radius:999px}
.maker-nav{margin-top:5px;border-top:1px solid var(--line);padding-top:15px!important;color:var(--accent)!important}
@media(max-width:760px){.study-maker-banner{align-items:flex-start;flex-wrap:wrap;gap:10px;margin-top:18px}.study-maker-banner>div:nth-child(2){width:calc(100% - 54px)}.study-maker-banner>a{margin-left:52px}.study-maker-shortcut{font-size:9px;padding:6px 8px}}
html.quiz-active .study-sidebar,
html.quiz-active .study-appbar,
html.quiz-active .study-bottom-nav,
html.private-quiz-active .study-sidebar,
html.private-quiz-active .study-appbar,
html.private-quiz-active .study-bottom-nav{display:none!important}
html.quiz-active .study-app-main,
html.private-quiz-active .study-app-main{margin:0!important;padding:0!important;width:100%!important;height:100vh!important;min-height:100vh!important}
html.quiz-active .study-app-main>main,
html.private-quiz-active .study-app-main>main{width:100%!important;min-height:100vh!important}
html.quiz-active .study-maker-banner,
html.private-quiz-active .study-maker-banner,
html.quiz-active .pwa-prompt,
html.private-quiz-active .pwa-prompt{display:none!important}
</style>
</body></html>
