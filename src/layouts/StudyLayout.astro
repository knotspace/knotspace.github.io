---
import '../styles/study/layout.css';
interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description = 'KNOT Study。中学理科・社会の学習と入試対策を進める学習スペース。', noindex = false } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || (currentPath.startsWith(path) && path !== `${BASE}study/`);
const pageImage = new URL('/og-default.svg', Astro.site ?? Astro.url).href;
const websiteJsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'KNOT Study', url: new URL('study/', Astro.site ?? Astro.url).href, inLanguage: 'ja-JP', description };
---
<!doctype html>
<html lang="ja" data-theme="dark" data-app-mode="study">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#0b1220" /><meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
<meta name="googlebot" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
<meta name="author" content="KNOT Study" /><meta name="color-scheme" content="dark light" /><meta name="referrer" content="strict-origin-when-cross-origin" /><meta name="site-base" content={BASE} />
<link rel="canonical" href={canonicalURL} /><link rel="preconnect" href="https://images.unsplash.com" crossorigin /><link rel="manifest" href={`${BASE}study/manifest.webmanifest`} /><link rel="icon" type="image/svg+xml" href={`${BASE}study/icon.svg`} sizes="any" /><link rel="shortcut icon" href={`${BASE}study/icon.svg`} type="image/svg+xml" /><link rel="apple-touch-icon" href={`${BASE}study/icon.svg`} />
<meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" /><meta property="og:site_name" content="KNOT Study" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalURL} /><meta property="og:image" content={pageImage} /><meta property="og:image:alt" content={`${title} | KNOT Study`} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={pageImage} /><meta name="twitter:image:alt" content={`${title} | KNOT Study`} /><script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} /><title>{title}</title>
<script is:inline>try { const savedTheme = localStorage.getItem('knot-study-theme') || localStorage.getItem('knot-theme'); if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme; } catch {}</script>
</head>
<body>
<div class="study-shell">
<aside class="study-sidebar" aria-label="Studyメニュー">
<a class="study-brand" href={`${BASE}study/`}><span class="study-brand-mark">K</span><span><strong>KNOT<span>.</span></strong><small>STUDY</small></span></a>
<div class="sidebar-label">LEARN</div>
<a class:list={["study-nav-item", { active: currentPath === `${BASE}study/` }]} href={`${BASE}study/`}><span>⌂</span>ホーム</a>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/foundation/`) || isActive(`${BASE}study/solve/`) }]} href={`${BASE}study/foundation/`}><span>✎</span>基礎演習</a>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/kosen/`) }]} href={`${BASE}study/kosen/`}><span>⌁</span>高専対策</a>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/mock/`) }]} href={`${BASE}study/mock/`}><span>▤</span>模試に挑戦</a>
<div class="sidebar-label second">KNOWLEDGE</div>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/summary/`) }]} href={`${BASE}study/summary/`}><span>▦</span>要点まとめ</a>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/tools/`) }]} href={`${BASE}study/tools/`}><span>◷</span>学習ツール</a>
<a class:list={["study-nav-item", { active: isActive(`${BASE}study/updates/`) }]} href={`${BASE}study/updates/`}><span>↻</span>更新情報・使い方</a>
<div class="sidebar-spacer"></div><a class="study-back-site" href={BASE}><span>↗</span> KNOT本体へ戻る</a><div class="sidebar-foot">KNOT STUDY <span>·</span> LEARN EVERY DAY</div>
</aside>
<header class="study-appbar"><a class="study-mobile-brand" href={`${BASE}study/`}><span class="study-brand-mark">K</span><strong>KNOT<span>.</span> STUDY</strong></a><div class="study-appbar-right"><span class="study-appbar-caption">YOUR LEARNING SPACE</span><button class="theme-toggle study-theme-toggle" id="theme-toggle" type="button" aria-label="テーマを切り替える" title="テーマを切り替える"><span id="theme-icon">☀</span></button></div></header>
<main class="study-app-main"><slot /></main>
<aside id="pwa-install-prompt" class="pwa-prompt" hidden aria-live="polite"><div><strong>KNOT Studyをアプリとして使う</strong><p id="pwa-install-description">ホーム画面に追加すると、Studyをすぐに開けるよ。</p></div><button id="pwa-install-button" type="button">インストール</button><button id="pwa-install-close" type="button" aria-label="閉じる">×</button></aside>
<nav class="study-bottom-nav" aria-label="Study navigation">
<a class:list={{ active: currentPath === `${BASE}study/` }} href={`${BASE}study/`}><span>⌂</span><small>ホーム</small></a><a class:list={{ active: isActive(`${BASE}study/foundation/`) || isActive(`${BASE}study/solve/`) }} href={`${BASE}study/foundation/`}><span>✎</span><small>演習</small></a><a class:list={{ active: isActive(`${BASE}study/summary/`) }} href={`${BASE}study/summary/`}><span>▦</span><small>要点</small></a><a class:list={{ active: isActive(`${BASE}study/mock/`) }} href={`${BASE}study/mock/`}><span>▤</span><small>模試</small></a>
</nav>
</div>
<script is:inline>
(() => { const button=document.getElementById('theme-toggle'),icon=document.getElementById('theme-icon'),root=document.documentElement;if(!button||!icon)return;const update=()=>{const dark=root.dataset.theme!=='light';icon.textContent=dark?'☀':'☾';button.setAttribute('aria-label',dark?'ライトモードに切り替える':'ダークモードに切り替える');document.querySelector('meta[name="theme-color"]')?.setAttribute('content',dark?'#0b1220':'#f7f8fa');};update();button.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('knot-study-theme',next);localStorage.setItem('knot-theme',next);}catch{}update();});})();
</script>
<script is:inline>
(() => {
  if (!('serviceWorker' in navigator)) return;
  window.addEventListener('load', () => {
    const base = document.querySelector('meta[name="site-base"]')?.content || '/';
    navigator.serviceWorker.register(base + 'study-sw.js', { scope: base + 'study/', updateViaCache: 'none' })
      .then((registration) => registration.update())
      .catch((error) => console.warn('KNOT Study offline support unavailable:', error));
  });
  const prompt = document.getElementById('pwa-install-prompt');
  const installButton = document.getElementById('pwa-install-button');
  const closeButton = document.getElementById('pwa-install-close');
  const description = document.getElementById('pwa-install-description');
  if (!prompt || !installButton || !closeButton) return;
  let installEvent;
  let dismissed = false;
  try { dismissed = sessionStorage.getItem('knot-study-pwa-dismissed') === '1'; } catch {}
  if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true) return;
  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    installEvent = event;
    if (!dismissed) prompt.hidden = false;
  });
  window.addEventListener('appinstalled', () => { prompt.hidden = true; installEvent = null; });
  if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !dismissed) {
    description.textContent = 'Safariの共有ボタンから「ホーム画面に追加」を選んでね。';
    installButton.hidden = true;
    prompt.hidden = false;
  }
  installButton.addEventListener('click', async () => {
    if (!installEvent) return;
    installEvent.prompt();
    await installEvent.userChoice;
    installEvent = null;
    prompt.hidden = true;
  });
  closeButton.addEventListener('click', () => {
    prompt.hidden = true;
    try { sessionStorage.setItem('knot-study-pwa-dismissed', '1'); } catch {}
  });
})();
</script>
<style is="global">
html.quiz-active .study-sidebar,html.quiz-active .study-appbar,html.quiz-active .study-bottom-nav,
html.kosen-quiz-active .study-sidebar,html.kosen-quiz-active .study-appbar,html.kosen-quiz-active .study-bottom-nav,
html.solve-quiz-active .study-sidebar,html.solve-quiz-active .study-appbar,html.solve-quiz-active .study-bottom-nav{display:none!important}
html.quiz-active .study-app-main,html.kosen-quiz-active .study-app-main,html.solve-quiz-active .study-app-main{margin:0!important;padding:0!important;width:100%;height:100vh;min-height:100vh}
html.quiz-active .study-app-main>main,html.kosen-quiz-active .study-app-main>main,html.solve-quiz-active .study-app-main>main{min-height:100vh}
html.quiz-active .pwa-prompt,html.kosen-quiz-active .pwa-prompt,html.solve-quiz-active .pwa-prompt{display:none!important}
</style>
</body></html>
