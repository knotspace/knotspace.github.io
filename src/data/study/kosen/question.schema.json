{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knotspace.github.io/study/kosen/question.schema.json",
  "title": "KNOT Study 高専入試 問題(教科別DB共通スキーマ v1)",
  "description": "数学・理科・英語・国語・社会の教科別DBで共通に使う問題スキーマ。原本PDFの文章・図表は格納しない。provenance.type は knot-original(完全独自) と knot-reconstructed(過去問の出題意図を分析して新規構成)のみ。公式原文を表す種別は意図的に存在させない。",
  "type": "object",
  "required": [
    "schemaVersion", "id", "subject", "unit", "tier", "learningGoal", "estimatedSeconds",
    "stem", "choices", "answerIndex", "answerRationale", "solutionSteps", "choiceNotes",
    "summaryLink", "provenance", "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^kosen-(math|sci|eng|jpn|soc)-(orig|r[0-9]{1,2})-[a-z0-9-]+-[0-9]{3}$",
      "description": "安定ID。例: kosen-math-r7-func-001。一度公開したIDは再利用・変更しない(進捗データが参照する)。"
    },
    "subject": { "enum": ["math", "science", "english", "japanese", "social-studies"] },
    "unit": { "type": "string", "description": "単元キー。教科ごとの単元一覧(units.json)に存在すること。" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tier": { "enum": ["basic", "standard", "applied", "advanced"], "description": "基礎確認 / 合格に直結する標準 / 応用 / 発展" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "learningGoal": { "type": "string", "minLength": 8, "description": "この問題で身につける力・考え方" },
    "estimatedSeconds": { "type": "integer", "minimum": 15, "maximum": 900 },
    "stem": { "type": "string", "minLength": 5 },
    "choices": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "answerIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
    "answerRationale": { "type": "string", "minLength": 10, "description": "正答の根拠(1〜2文)" },
    "solutionSteps": { "type": "array", "minItems": 2, "items": { "type": "string" }, "description": "段階的解説。数学・理科は途中式・単位・条件確認を含める。" },
    "choiceNotes": {
      "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" },
      "description": "choices と同じ順。正解には「正解」と理由、誤答にはどこで間違えやすいかを書く。"
    },
    "figureRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.svg$" },
      "description": "独自作成SVGのファイル名。原本の図表は使わない。"
    },
    "summaryLink": { "type": "string", "pattern": "^/study/summary/[a-z]+/(#[a-z0-9-]+)?$" },
    "provenance": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["knot-original", "knot-reconstructed"] },
        "references": {
          "type": "array",
          "description": "knot-reconstructed では必須(1件以上)。実際に原本で確認できた年度・大問・小問だけを書く。",
          "items": {
            "type": "object",
            "required": ["year", "subject", "big", "aspect", "ledgerId"],
            "additionalProperties": false,
            "properties": {
              "year": { "type": "string", "examples": ["令和7年度"] },
              "subject": { "type": "string" },
              "big": { "type": "string", "examples": ["大問2"] },
              "sub": { "type": "string", "examples": ["(1)"] },
              "pages": { "type": "string" },
              "aspect": { "type": "string", "description": "参考にした要素(問う力・出題形式・思考手順など)。文章・数値・図の流用ではない。" },
              "ledgerId": { "type": "string", "description": "source-ledger.json の id" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "knot-reconstructed" } } },
          "then": { "required": ["references"], "properties": { "references": { "minItems": 1 } } }
        }
      ]
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["draft", "recomputed", "reviewed", "published"], "description": "published は recomputed と reviewed を両方通過した問題のみ" },
        "recomputedBy": { "type": "string", "description": "独立した再計算・再確認を行った工程(スクリプト名や別工程の識別子)" },
        "recomputedAt": { "type": "string", "format": "date" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "singleCorrectAnswer": { "type": "boolean" },
            "noAmbiguity": { "type": "boolean" },
            "figureConsistent": { "type": "boolean" },
            "explanationNoLeap": { "type": "boolean" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "aliasOf": { "type": "string", "description": "重複統合時の正規ID。旧IDは削除せず別名として残し、進捗データを壊さない。" },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "change"],
        "additionalProperties": false,
        "properties": { "date": { "type": "string", "format": "date" }, "change": { "type": "string" } }
      }
    }
  }
}
